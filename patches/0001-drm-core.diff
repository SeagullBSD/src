+	    dir->slot == 0 ? DMA_RESV_USAGE_WRITE : DMA_RESV_USAGE_READ, fence) {
+		if (!dma_fence_is_signaled(fence)) {
+			complete = false;
+			break;
+		}
+	}
+	if (complete) {
+		mtx_enter(&resv->fences_lock);
+		dir->certified = true;
+		dir->certified_generation = resv->poll_epoch[dir->slot];
+		mtx_leave(&resv->fences_lock);
+	}
+	dma_resv_unlock(resv);
