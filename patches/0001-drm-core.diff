+int
+dmabuf_stat(struct file *fp, struct stat *st, struct proc *p)
+{
+	struct dma_buf *dmabuf = fp->f_data;
+
+	memset(st, 0, sizeof(*st));
+	st->st_size = dmabuf->size;
+	st->st_mode = S_IFIFO;	/* XXX */
+	return (0);
+}
+
+int
+dmabuf_close(struct file *fp, struct proc *p)
+{
+	struct dma_buf *dmabuf = fp->f_data;
+
+	fp->f_data = NULL;
+	KERNEL_LOCK();
+	dmabuf->ops->release(dmabuf);
+	if (dmabuf->owns_resv)
+		dma_resv_fini(&dmabuf->local_resv);
+	KERNEL_UNLOCK();
+	free(dmabuf, M_DRM, sizeof(struct dma_buf));
+	return (0);
+}
+
+int
+dmabuf_seek(struct file *fp, off_t *offset, int whence, struct proc *p)
+{
+	struct dma_buf *dmabuf = fp->f_data;
+	off_t newoff;
+
+	if (*offset != 0)
+		return (EINVAL);
+
+	switch (whence) {
+	case SEEK_SET:
+		newoff = 0;
+		break;
+	case SEEK_END:
+		newoff = dmabuf->size;
+		break;
+	default:
+		return (EINVAL);
+	}
+	mtx_enter(&fp->f_mtx);
+	fp->f_offset = newoff;
+	mtx_leave(&fp->f_mtx);
+	*offset = newoff;
+	return (0);
+}
