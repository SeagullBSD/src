+struct dmabuf_pager {
+	struct uvm_object uobj;
+	struct kref refs;
+	struct dma_buf *buf;
+	struct drm_gem_object *import_obj;
+	voff_t map_base;
+};
+
+static void
+dmabuf_pager_reference(struct uvm_object *uobj)
+{
+	struct dmabuf_pager *pager = container_of(uobj, struct dmabuf_pager, uobj);
+	kref_get(&pager->refs);
+}
+
+static void
+dmabuf_pager_release(struct kref *ref)
+{
+	struct dmabuf_pager *pager = container_of(ref, struct dmabuf_pager, refs);
+
+	uvm_obj_destroy(&pager->uobj);
+	if (pager->import_obj != NULL) {
+		if (pager->import_obj->funcs->mmap_pin != NULL)
+			pager->import_obj->funcs->mmap_unpin(pager->import_obj);
+		drm_gem_object_put(pager->import_obj);
+	} else
+		pager->buf->ops->unpin(pager->buf);
+	dma_buf_put(pager->buf);
+	free(pager, M_DRM, sizeof(*pager));
+}
+
+static void
+dmabuf_pager_detach(struct uvm_object *uobj)
+{
+	struct dmabuf_pager *pager = container_of(uobj, struct dmabuf_pager, uobj);
+	kref_put(&pager->refs, dmabuf_pager_release);
+}
+
+static int
+dmabuf_pager_fault(struct uvm_faultinfo *ufi, vaddr_t vaddr, vm_page_t *pps,
+    int npages, int centeridx, vm_fault_t fault_type, vm_prot_t access, int flags)
+{
+	struct uvm_object *uobj = ufi->entry->object.uvm_obj;
+	struct dmabuf_pager *pager = container_of(uobj, struct dmabuf_pager, uobj);
+	voff_t offset = ufi->entry->offset + (vaddr - ufi->entry->start);
+	vm_prot_t prot = ufi->entry->protection;
+	paddr_t paddr;
+	int i, error = 0;
+
+	if (UVM_ET_ISCOPYONWRITE(ufi->entry)) {
+		error = EACCES;
+		goto out;
+	}
+	if (offset < pager->map_base) {
+		error = EINVAL;
+		goto out;
+	}
+	offset -= pager->map_base;
+	for (i = 0; i < npages; i++, offset += PAGE_SIZE, vaddr += PAGE_SIZE) {
+		if (((flags & PGO_ALLPAGES) == 0 && i != centeridx) ||
+		    pps[i] == PGO_DONTCARE)
+			continue;
+		error = -dma_buf_page_map(pager->buf, offset, prot, &paddr);
+		if (error)
+			break;
+		if (pmap_enter(ufi->orig_map->pmap, vaddr, paddr, prot,
+		    PMAP_CANFAIL | prot) != 0) {
+			pmap_update(ufi->orig_map->pmap);
+			uvmfault_unlockall(ufi, ufi->entry->aref.ar_amap, uobj);
+			uvm_wait("dmabuf");
+			return ERESTART;
+		}
+	}
+	pmap_update(ufi->orig_map->pmap);
+out:
+	uvmfault_unlockall(ufi, ufi->entry->aref.ar_amap, uobj);
+	return error;
+}
+
+static boolean_t
+dmabuf_pager_flush(struct uvm_object *uobj, voff_t start, voff_t end, int flags)
+{
+	return TRUE;
+}
+
+static const struct uvm_pagerops dmabuf_pager_ops = {
+	.pgo_reference = dmabuf_pager_reference,
+	.pgo_detach = dmabuf_pager_detach,
+	.pgo_fault = dmabuf_pager_fault,
+	.pgo_flush = dmabuf_pager_flush,
+};
+
+int
+dma_buf_mmap_pager(struct dma_buf *buf, struct drm_gem_object *import_obj,
+    off_t offset, size_t size, vm_prot_t prot, voff_t map_base,
+    struct uvm_object **out)
+{
+	struct dmabuf_pager *pager;
+	paddr_t paddr;
+	int ret;
+
+	if (offset < 0 || (offset & PAGE_MASK) || !size ||
+	    (uint64_t)offset > buf->size || size > buf->size - offset)
+		return EINVAL;
+	if (!buf->ops->page_map)
+		return EOPNOTSUPP;
+	if (import_obj != NULL) {
+		KASSERT(import_obj->import_attach != NULL &&
+		    import_obj->import_attach->dmabuf == buf);
+		if (import_obj->funcs->mmap_pin != NULL) {
+			KASSERT(import_obj->funcs->mmap_unpin != NULL);
+			ret = import_obj->funcs->mmap_pin(import_obj);
+			if (ret)
+				return -ret;
+		}
+	} else {
+		if (!buf->ops->pin || !buf->ops->unpin)
+			return EOPNOTSUPP;
+		ret = buf->ops->pin(buf);
+		if (ret)
+			return -ret;
+	}
+	ret = dma_buf_page_map(buf, offset, prot, &paddr);
+	if (ret) {
+		if (import_obj != NULL) {
+			if (import_obj->funcs->mmap_pin != NULL)
+				import_obj->funcs->mmap_unpin(import_obj);
+		} else
+			buf->ops->unpin(buf);
+		return -ret;
+	}
+	pager = malloc(sizeof(*pager), M_DRM, M_WAITOK | M_ZERO);
+	kref_init(&pager->refs);
+	get_dma_buf(buf);
+	pager->buf = buf;
+	if (import_obj != NULL)
+		drm_gem_object_get(import_obj);
+	pager->import_obj = import_obj;
+	pager->map_base = map_base;
+	uvm_obj_init(&pager->uobj, &dmabuf_pager_ops, 1);
+	*out = &pager->uobj;
+	return 0;
+}
+
+/* Caller must hold the exporter or imported object's mmap pin. */
+int
+dma_buf_mmap_protect(struct dma_buf *buf, off_t offset, size_t size,
+    int prot, int *maxprot)
+{
+	paddr_t base, mapped;
+	size_t pos;
+	unsigned int rejected = 0;
+	int allowed = prot, bit, candidate, subset, ret;
+
+	if ((prot & ~*maxprot) != 0 ||
+	    (*maxprot & ~(PROT_READ | PROT_WRITE | PROT_EXEC)) != 0)
+		return EACCES;
+	/*
+	 * mprotect does not call the exporter for resident pages.  Check each
+	 * possible protection against one baseline per page; a rejected
+	 * combination cannot contribute to the final maximum.  The bitmap
+	 * avoids both storing per-page baselines and probing a combination
+	 * again after it has already been rejected.
+	 */
+	for (pos = 0; pos < size; pos += PAGE_SIZE) {
+		if (pos > (uint64_t)INT64_MAX - (uint64_t)offset) {
+			ret = EINVAL;
+			goto fail;
+		}
+		ret = -dma_buf_page_map(buf, offset + pos, prot, &base);
+		if (ret)
+			goto fail;
+		for (subset = *maxprot; subset != 0;
+		    subset = (subset - 1) & *maxprot) {
+			if (subset == prot || (rejected & (1U << subset)))
+				continue;
+			ret = -dma_buf_page_map(buf, offset + pos, subset,
+			    &mapped);
+			if (ret == EACCES || ret == EOPNOTSUPP ||
+			    (ret == 0 && mapped != base)) {
+				rejected |= 1U << subset;
+				continue;
+			}
+			if (ret)
+				goto fail;
+		}
+	}
+	/* maxprot cannot express a hole among the requested rights. */
+	for (subset = prot; subset != 0; subset = (subset - 1) & prot) {
+		if (rejected & (1U << subset)) {
+			ret = EACCES;
+			goto fail;
+		}
+	}
+	/* Retain rights in the same order as the original validation. */
+	for (bit = PROT_READ; bit <= PROT_EXEC; bit <<= 1) {
+		if ((*maxprot & bit) == 0 || (allowed & bit) != 0)
+			continue;
+		candidate = allowed | bit;
+		for (subset = candidate; subset != 0;
+		    subset = (subset - 1) & candidate) {
+			if (rejected & (1U << subset))
+				break;
+		}
+		if (subset == 0)
+			allowed = candidate;
+	}
+	*maxprot = allowed;
+	return 0;
+fail:
+	return ret;
+}
+
+static int
+dmabuf_mmap(struct file *fp, off_t offset, size_t size, int prot,
+    int *maxprot, struct uvm_object **out)
+{
+	struct dma_buf *buf = fp->f_data;
+	int ret;
+
+	ret = dma_buf_mmap_pager(buf, NULL, offset, size, prot, 0, out);
+	if (ret)
+		return ret;
+	ret = dma_buf_mmap_protect(buf, offset, size, prot, maxprot);
+	if (ret) {
+		(*out)->pgops->pgo_detach(*out);
+		*out = NULL;
+	}
+	return ret;
+}
