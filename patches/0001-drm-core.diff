+/* A prepared replacement owns its own references, independently of the
+ * currently published list and the separately exposed dependency references. */
+struct dma_resv_batch_entry {
+	struct dma_resv *obj;
+	struct dma_resv_list *prepared;
+	struct dma_resv_list *retired;
+	uint64_t generation;
+};
+
+struct dma_resv_batch {
+	struct dma_resv_batch_entry *entries;
+	struct dma_fence **dependencies;
+	unsigned int count, num_dependencies;
+	bool locked, committed;
+};
+
+static int
+dma_resv_batch_entry_compare(const void *a, const void *b)
+{
+	const struct dma_resv_batch_entry *ea = a, *eb = b;
+	uintptr_t pa = (uintptr_t)ea->obj, pb = (uintptr_t)eb->obj;
+
+	return (pa > pb) - (pa < pb);
+}
+
+void
+dma_resv_batch_destroy(struct dma_resv_batch *batch)
+{
+	unsigned int i;
+
+	if (!batch)
+		return;
+	KASSERT(!batch->locked);
+	for (i = 0; i < batch->num_dependencies; i++)
+		dma_fence_put(batch->dependencies[i]);
+	for (i = 0; i < batch->count; i++) {
+		dma_resv_list_free(batch->entries[i].prepared);
+		dma_resv_list_free(batch->entries[i].retired);
+	}
+	kfree(batch->dependencies);
+	kfree(batch->entries);
+	kfree(batch);
+}
+
+struct dma_resv_batch *
+dma_resv_batch_prepare(struct dma_resv **objects, unsigned int count)
+{
+	struct dma_resv_batch *batch;
+	struct dma_resv_list *old, *copy;
+	struct dma_resv *obj;
+	struct dma_fence *fence;
+	enum dma_resv_usage usage;
+	unsigned int i, j, k, n, total = 0;
+	int error = -ENOMEM;
+
+	batch = kzalloc(sizeof(*batch), GFP_KERNEL);
+	if (!batch)
+		return ERR_PTR(-ENOMEM);
+	if (count) {
+		batch->entries = kcalloc(count, sizeof(*batch->entries), GFP_KERNEL);
+		if (!batch->entries)
+			goto fail;
+	}
+	for (i = 0; i < count; i++) {
+		if (!objects[i]) {
+			error = -EINVAL;
+			goto fail;
+		}
+		batch->entries[i].obj = objects[i];
+	}
+	if (count > 1)
+		sort(batch->entries, count, sizeof(*batch->entries),
+		    dma_resv_batch_entry_compare, NULL);
+	for (i = 0; i < count; i++) {
+		if (batch->count && batch->entries[i].obj ==
+		    batch->entries[batch->count - 1].obj)
+			continue;
+		batch->entries[batch->count++].obj = batch->entries[i].obj;
+	}
+
+	for (i = 0; i < batch->count; i++) {
+		struct dma_resv_batch_entry *entry = &batch->entries[i];
+		unsigned int attempts = 0;
+
+		obj = entry->obj;
+		for (;;) {
+			mtx_enter(&obj->fences_lock);
+			old = obj->fences;
+			n = old ? old->num_fences : 0;
+			mtx_leave(&obj->fences_lock);
+			if (n == ~0U) {
+				error = -EOVERFLOW;
+				goto fail;
+			}
+			copy = dma_resv_list_alloc(n + 1);
+			if (!copy)
+				goto fail;
+			copy->num_fences = 0;
+			mtx_enter(&obj->fences_lock);
+			old = obj->fences;
+			if (old && old->num_fences > n) {
+				mtx_leave(&obj->fences_lock);
+				kfree(copy);
+				if (++attempts == 3) {
+					error = -EAGAIN;
+					goto fail;
+				}
+				continue;
+			}
+			n = old ? old->num_fences : 0;
+			entry->generation = obj->fences_generation;
+			mtx_leave(&obj->fences_lock);
+			for (j = 0; j < n;) {
+				unsigned int end = j + min(n - j, DMA_RESV_POLL_BATCH);
+
+				mtx_enter(&obj->fences_lock);
+				if (entry->generation != obj->fences_generation) {
+					mtx_leave(&obj->fences_lock);
+					break;
+				}
+				old = obj->fences;
+				for (; j < end; j++) {
+					dma_resv_list_entry(old, j, NULL, &fence, &usage);
+					dma_resv_list_set(copy, j, dma_fence_get(fence), usage);
+				}
+				copy->num_fences = j;
+				mtx_leave(&obj->fences_lock);
+			}
+			if (j != n) {
+				dma_resv_list_free(copy);
+				if (++attempts == 3) {
+					error = -EAGAIN;
+					goto fail;
+				}
+				continue;
+			}
+			entry->prepared = copy;
+			break;
+		}
+		/* Fence polling and reference drops may invoke arbitrary callbacks. */
+		for (j = 0, k = 0; j < n; j++) {
+			dma_resv_list_entry(copy, j, NULL, &fence, &usage);
+			if (dma_fence_is_signaled(fence)) {
+				dma_fence_put(fence);
+				continue;
+			}
+			dma_resv_list_set(copy, k++, fence, usage);
+		}
+		copy->num_fences = n = k;
+		if (n > ~0U - total) {
+			error = -EOVERFLOW;
+			goto fail;
+		}
+		total += n;
+	}
+	if (total) {
+		batch->dependencies = kcalloc(total, sizeof(*batch->dependencies),
+		    GFP_KERNEL);
+		if (!batch->dependencies)
+			goto fail;
+	}
+	for (i = 0; i < batch->count; i++) {
+		copy = batch->entries[i].prepared;
+		for (j = 0; j < copy->num_fences; j++) {
+			dma_resv_list_entry(copy, j, NULL, &fence, &usage);
+			if (usage <= DMA_RESV_USAGE_READ)
+				batch->dependencies[batch->num_dependencies++] =
+				    dma_fence_get(fence);
+		}
+	}
+	return batch;
+fail:
+	dma_resv_batch_destroy(batch);
+	return ERR_PTR(error);
+}
+
+unsigned int
+dma_resv_batch_num_fences(const struct dma_resv_batch *batch)
+{
+	return batch->num_dependencies;
+}
+
+struct dma_fence *
+dma_resv_batch_fence(const struct dma_resv_batch *batch, unsigned int index)
+{
+	KASSERT(index < batch->num_dependencies);
+	return batch->dependencies[index];
+}
+
+/* Acquire each reservation at most once; never wait on contention. */
+int
+dma_resv_batch_trylock(struct dma_resv_batch *batch)
+{
+	unsigned int i, j;
+
+	if (batch->locked || batch->committed)
+		return -EINVAL;
+	for (i = 0; i < batch->count; i++) {
+		if (dma_resv_trylock(batch->entries[i].obj))
+			continue;
+		for (j = 0; j < i; j++)
+			dma_resv_unlock(batch->entries[j].obj);
+		return -EAGAIN;
+	}
+	batch->locked = true;
+	return 0;
+}
+
+int
+dma_resv_batch_commit_locked(struct dma_resv_batch *batch,
+    struct dma_fence *fence)
+{
+	struct dma_resv_batch_entry *entry;
+	struct dma_resv *obj;
+	struct dma_fence *existing;
+	enum dma_resv_usage usage;
+	unsigned int j, existing_mask, added_mask;
+	unsigned int i;
+	bool stale;
+
+	if (!batch->locked || batch->committed || !fence)
+		return -EINVAL;
+	for (i = 0; i < batch->count; i++) {
+		entry = &batch->entries[i];
+		obj = entry->obj;
+		mtx_enter(&obj->fences_lock);
+		stale = entry->generation != obj->fences_generation;
+		mtx_leave(&obj->fences_lock);
+		if (stale)
+			return -EAGAIN;
+	}
+	for (i = 0; i < batch->count; i++) {
+		entry = &batch->entries[i];
+		obj = entry->obj;
+		existing_mask = 0;
+		for (j = 0; j < entry->prepared->num_fences; j++) {
+			dma_resv_list_entry(entry->prepared, j, NULL, &existing, &usage);
+			if (existing == fence)
+				existing_mask |= dma_resv_poll_mask(existing, usage);
+		}
+		dma_resv_list_set(entry->prepared, entry->prepared->num_fences++,
+		    dma_fence_get(fence), DMA_RESV_USAGE_WRITE);
+		mtx_enter(&obj->fences_lock);
+		entry->retired = obj->fences;
+		rcu_assign_pointer(obj->fences, entry->prepared);
+		obj->fences_generation++;
+		obj->poll_layout_generation++;
+		added_mask = dma_resv_poll_mask(fence, DMA_RESV_USAGE_WRITE) &
+		    ~existing_mask;
+		dma_resv_changed_mask_locked(obj, added_mask, 0);
+		mtx_leave(&obj->fences_lock);
+		entry->prepared = NULL;
+	}
+	batch->committed = true;
+	return 0;
+}
+
+void
+dma_resv_batch_unlock(struct dma_resv_batch *batch)
+{
+	unsigned int i;
+
+	KASSERT(batch->locked);
+	for (i = 0; i < batch->count; i++)
+		dma_resv_unlock(batch->entries[i].obj);
+	batch->locked = false;
+}
