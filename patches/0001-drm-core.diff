+/* Merge-owned arrays are flattened on subsequent merges. Other containers
+ * remain atomic: in particular an any-of array or a chain can have its own
+ * completion/error semantics that are not equivalent to all of its leaves. */
+struct syncfile_merge_walk {
+	struct dma_fence **fences;
+	unsigned int count, capacity, visited;
+};
+
+static int
+syncfile_merge_append(struct syncfile_merge_walk *walk, struct dma_fence *fence)
+{
+	struct dma_fence **new;
+	unsigned int capacity;
+
+	if (walk->count == walk->capacity) {
+		capacity = walk->capacity ? walk->capacity * 2 : 8;
+		if (capacity > SYNCFILE_MAX_VISITS ||
+		    capacity > MALLOC_MAX / sizeof(*new))
+			return EOVERFLOW;
+		new = malloc((size_t)capacity * sizeof(*new), M_DRM,
+		    M_WAITOK | M_CANFAIL);
+		if (new == NULL)
+			return ENOMEM;
+		if (walk->count != 0)
+			memcpy(new, walk->fences, walk->count * sizeof(*new));
+		free(walk->fences, M_DRM, 0);
+		walk->fences = new;
+		walk->capacity = capacity;
+	}
+	walk->fences[walk->count++] = dma_fence_get(fence);
+	return 0;
+}
+
+/* Validate opaque containers too, so enabling the result cannot recurse
+ * through an unbounded pre-existing array/chain graph. Chain links may be
+ * pruned concurrently and therefore are acquired under prev_lock. */
+static int
+syncfile_merge_walk_fence(struct dma_fence *fence,
+    struct syncfile_merge_walk *walk, unsigned int depth, bool collect)
+{
+	struct dma_fence_array *array;
+	struct dma_fence_chain *node;
+	struct dma_fence *chain, *next;
+	unsigned int i;
+	bool flatten;
+	int error;
+
+	if (depth >= SYNCFILE_MAX_DEPTH || ++walk->visited > SYNCFILE_MAX_VISITS)
+		return EOVERFLOW;
+	array = to_dma_fence_array(fence);
+	if (array != NULL) {
+		flatten = collect && array->sync_file_merge;
+		for (i = 0; i < array->num_fences; i++) {
+			error = syncfile_merge_walk_fence(array->fences[i], walk,
+			    depth + 1, flatten);
+			if (error != 0)
+				return error;
+		}
+		return collect && !flatten ? syncfile_merge_append(walk, fence) : 0;
+	}
+	if (dma_fence_is_chain(fence)) {
+		chain = dma_fence_get(fence);
+		while (chain != NULL) {
+			if (++walk->visited > SYNCFILE_MAX_VISITS) {
+				dma_fence_put(chain);
+				return EOVERFLOW;
+			}
+			node = to_dma_fence_chain(chain);
+			if (node == NULL) {
+				error = syncfile_merge_walk_fence(chain, walk,
+				    depth + 1, false);
+				dma_fence_put(chain);
+				if (error != 0)
+					return error;
+				break;
+			}
+			mtx_enter(&node->prev_lock);
+			next = dma_fence_get(node->prev);
+			mtx_leave(&node->prev_lock);
+			error = syncfile_merge_walk_fence(node->fence, walk,
+			    depth + 1, false);
+			dma_fence_put(chain);
+			if (error != 0) {
+				dma_fence_put(next);
+				return error;
+			}
+			chain = next;
+		}
+	}
+	return collect ? syncfile_merge_append(walk, fence) : 0;
+}
+
+static int
+syncfile_merge_compare(const void *a, const void *b)
+{
+	struct dma_fence *x = *(struct dma_fence * const *)a;
+	struct dma_fence *y = *(struct dma_fence * const *)b;
+
+	if (x->context != y->context)
+		return x->context < y->context ? -1 : 1;
+	if (dma_fence_is_later(y, x))
+		return 1;
+	if (dma_fence_is_later(x, y))
+		return -1;
+	return 0;
+}
+
+static int
+syncfile_merge_fences(struct dma_fence *a, struct dma_fence *b,
+    struct dma_fence **result)
+{
+	struct syncfile_merge_walk walk = {0};
+	struct dma_fence_array *array;
+	unsigned int i, count;
+	ktime_t timestamp = ns_to_ktime(0), completed;
+	int error;
+
+	*result = NULL;
+	error = syncfile_merge_walk_fence(a, &walk, 0, true);
+	if (!error)
+		error = syncfile_merge_walk_fence(b, &walk, 0, true);
+	if (error)
+		goto out;
+	/* Linux discards completed inputs, including their errors. Preserve the
+	 * latest completion timestamp when every input has already finished. */
+	for (i = 0, count = 0; i < walk.count; i++) {
+		if (dma_fence_is_signaled(walk.fences[i])) {
+			completed = dma_fence_timestamp(walk.fences[i]);
+			if (ktime_after(completed, timestamp))
+				timestamp = completed;
+			dma_fence_put(walk.fences[i]);
+		} else {
+			walk.fences[count++] = walk.fences[i];
+		}
+	}
+	walk.count = count;
+	if (count == 0) {
+		*result = dma_fence_allocate_private_stub(timestamp);
+		if (*result == NULL)
+			error = ENOMEM;
+		goto out;
+	}
+	sort(walk.fences, walk.count, sizeof(*walk.fences),
+	    syncfile_merge_compare, NULL);
+	for (i = 0, count = 0; i < walk.count; i++) {
+		if (count && walk.fences[i]->context ==
+		    walk.fences[count - 1]->context)
+			dma_fence_put(walk.fences[i]);
+		else
+			walk.fences[count++] = walk.fences[i];
+	}
+	walk.count = count;
+	if (count == 1) {
+		*result = walk.fences[0];
+		walk.count = 0;
+		goto out;
+	}
+	array = dma_fence_array_create(count, walk.fences,
+	    dma_fence_context_alloc(1), 1, false);
+	if (array == NULL) {
+		error = ENOMEM;
+		goto out;
+	}
+	array->sync_file_merge = true;
+	*result = &array->base;
+	return 0;
+out:
+	for (i = 0; i < walk.count; i++)
+		dma_fence_put(walk.fences[i]);
+	free(walk.fences, M_DRM, 0);
+	return error;
+}
