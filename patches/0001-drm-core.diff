+/* Check a finite cursor without holding fences_lock across provider calls. */
+static void
+dmabuf_poll_refresh(struct dmabuf_poll_direction *dir)
+{
+	struct dma_resv *resv = dir->watch->resv;
+	struct dma_resv_poll_cursor cursor;
+	struct dma_fence *fences[DMA_RESV_POLL_BATCH];
+	unsigned int i, count;
+	bool complete = true, done = false;
+	int error = 0;
+
+	mtx_enter(&resv->fences_lock);
+	if (dir->certified &&
+	    dir->certified_generation == resv->poll_epoch[dir->slot]) {
+		mtx_leave(&resv->fences_lock);
+		return;
+	}
+	mtx_leave(&resv->fences_lock);
+	dma_resv_poll_cursor_init(&cursor, resv,
+	    dir->slot == 0 ? DMA_RESV_USAGE_WRITE : DMA_RESV_USAGE_READ);
+	while (!done && complete) {
+		error = dma_resv_poll_cursor_next(&cursor, fences, &count, &done);
+		if (error != 0)
+			break;
+		for (i = 0; i < count; i++) {
+			if (!dma_fence_is_signaled(fences[i]))
+				complete = false;
+			dma_fence_put(fences[i]);
+		}
+	}
+	mtx_enter(&resv->fences_lock);
+	if (error == 0 && complete && done &&
+	    cursor.epoch == resv->poll_epoch[dir->slot]) {
+		dir->certified = true;
+		dir->certified_generation = cursor.epoch;
+	} else if (complete && (error != 0 || done)) {
+		mtx_leave(&resv->fences_lock);
+		dmabuf_poll_refresh_locked(dir);
+		return;
+	}
+	mtx_leave(&resv->fences_lock);
