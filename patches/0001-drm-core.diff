+struct dma_buf *
+dma_buf_export(const struct dma_buf_export_info *info)
+{
+	struct proc *p = curproc;
+	struct dma_buf *dmabuf;
+	struct file *fp;
+
+	fp = fnew(p);
+	if (fp == NULL)
+		return ERR_PTR(-ENFILE);
+	fp->f_type = DTYPE_DMABUF;
+	fp->f_flag = FFLAGS(info->flags) & (FREAD | FWRITE);
+	fp->f_ops = &dmabufops;
+	dmabuf = malloc(sizeof(struct dma_buf), M_DRM, M_WAITOK | M_ZERO);
+	dmabuf->priv = info->priv;
+	dmabuf->ops = info->ops;
+	dmabuf->size = info->size;
+	dmabuf->resv = info->resv;
+	if (dmabuf->resv == NULL) {
+		dma_resv_init(&dmabuf->local_resv);
+		dmabuf->resv = &dmabuf->local_resv;
+		dmabuf->owns_resv = true;
+	}
+	dmabuf->file = fp;
+	fp->f_data = dmabuf;
+	INIT_LIST_HEAD(&dmabuf->attachments);
+	return dmabuf;
+}
+
+struct dma_buf *
+dma_buf_get(int fd)
+{
+	struct proc *p = curproc;
+	struct filedesc *fdp = p->p_fd;
+	struct file *fp;
+
+	if ((fp = fd_getfile(fdp, fd)) == NULL)
+		return ERR_PTR(-EBADF);
+
+	if (fp->f_type != DTYPE_DMABUF) {
+		FRELE(fp, p);
+		return ERR_PTR(-EINVAL);
+	}
+
+	return fp->f_data;
+}
+
+void
+dma_buf_put(struct dma_buf *dmabuf)
+{
+	KASSERT(dmabuf);
+	KASSERT(dmabuf->file);
+
+	FRELE(dmabuf->file, curproc);
+}
+
+int
+dma_buf_fd(struct dma_buf *dmabuf, int flags)
+{
+	struct proc *p = curproc;
+	struct filedesc *fdp = p->p_fd;
+	struct file *fp = dmabuf->file;
+	int fd, cloexec, error;
+
+	cloexec = (flags & O_CLOEXEC) ? UF_EXCLOSE : 0;
+
+	fdplock(fdp);
+restart:
+	if ((error = fdalloc(p, 0, &fd)) != 0) {
+		if (error == ENOSPC) {
+			fdexpand(p);
+			goto restart;
+		}
+		fdpunlock(fdp);
+		return -error;
+	}
+
+	fdinsert(fdp, fd, cloexec, fp);
+	fdpunlock(fdp);
+
+	return fd;
+}
+
+void
+get_dma_buf(struct dma_buf *dmabuf)
+{
+	FREF(dmabuf->file);
+}
+
+struct dma_buf_attachment *
+dma_buf_attach(struct dma_buf *buf, struct device *dev)
+{
+	struct dma_buf_attachment *attach;
+	int ret;
+
+	if (!dev || !buf->ops->map_dma_buf || !buf->ops->unmap_dma_buf)
+		return ERR_PTR(-EINVAL);
+	attach = malloc(sizeof(*attach), M_DRM, M_WAITOK | M_ZERO);
+	attach->dmabuf = buf;
+	attach->dev = dev;
+	INIT_LIST_HEAD(&attach->node);
+	INIT_LIST_HEAD(&attach->mappings);
+	if (buf->ops->attach && (ret = buf->ops->attach(buf, attach)) != 0) {
+		free(attach, M_DRM, sizeof(*attach));
+		return ERR_PTR(ret);
+	}
+	dma_resv_lock(buf->resv, NULL);
+	list_add_tail(&attach->node, &buf->attachments);
+	dma_resv_unlock(buf->resv);
+	return attach;
+}
+
+void
+dma_buf_detach(struct dma_buf *buf, struct dma_buf_attachment *attach)
+{
+	dma_resv_lock(buf->resv, NULL);
+	KASSERT(list_empty(&attach->mappings));
+	list_del(&attach->node);
+	dma_resv_unlock(buf->resv);
+	if (buf->ops->detach)
+		buf->ops->detach(buf, attach);
+	free(attach, M_DRM, sizeof(*attach));
+}
+
+struct sg_table *
+dma_buf_map_attachment_unlocked(struct dma_buf_attachment *attach,
+    enum dma_data_direction dir)
+{
+	struct dma_buf *buf = attach->dmabuf;
+	struct dmabuf_mapping *mapping;
+	struct sg_table *sgt;
+
+	if (dir != DMA_TO_DEVICE && dir != DMA_FROM_DEVICE &&
+	    dir != DMA_BIDIRECTIONAL)
+		return ERR_PTR(-EINVAL);
+	mapping = malloc(sizeof(*mapping), M_DRM, M_WAITOK | M_ZERO);
+	dma_resv_lock(buf->resv, NULL);
+	sgt = buf->ops->map_dma_buf(attach, dir);
+	if (!IS_ERR_OR_NULL(sgt)) {
+		mapping->sgt = sgt;
+		mapping->dmat = dma_tag_lookup(attach->dev);
+		mapping->dir = dir;
+		list_add_tail(&mapping->node, &attach->mappings);
+	}
+	dma_resv_unlock(buf->resv);
+	if (IS_ERR_OR_NULL(sgt)) {
+		free(mapping, M_DRM, sizeof(*mapping));
+		if (sgt == NULL)
+			return ERR_PTR(-EINVAL);
+	}
+	return sgt;
+}
+
+void
+dma_buf_unmap_attachment_unlocked(struct dma_buf_attachment *attach,
+    struct sg_table *sgt, enum dma_data_direction dir)
+{
+	struct dma_buf *buf = attach->dmabuf;
+	struct dmabuf_mapping *mapping;
+
+	dma_resv_lock(buf->resv, NULL);
+	list_for_each_entry(mapping, &attach->mappings, node) {
+		if (mapping->sgt == sgt && mapping->dir == dir) {
+			list_del(&mapping->node);
+			buf->ops->unmap_dma_buf(attach, sgt, dir);
+			dma_resv_unlock(buf->resv);
+			free(mapping, M_DRM, sizeof(*mapping));
+			return;
+		}
+	}
+	dma_resv_unlock(buf->resv);
+	KASSERT(0);
+}
