+/* Bound both nesting and total visits, including shared DAG paths. */
+#define SYNCFILE_MAX_DEPTH 32
+#define SYNCFILE_MAX_VISITS 65536U
+struct syncfile_walk {
+	struct sync_fence_info *entries;
+	uint32_t count, capacity, visited;
+	int status, fill, probe;
+};
+
+static int
+syncfile_walk_fence(struct dma_fence *fence, struct syncfile_walk *walk,
+    unsigned int depth)
+{
+	struct dma_fence_array *array;
+	struct dma_fence_chain *node;
+	struct dma_fence *chain, *contained, *next;
+	struct sync_fence_info *entry;
+	unsigned int i;
+	int error, status, prior;
+
+	if (depth >= SYNCFILE_MAX_DEPTH || walk->visited >= SYNCFILE_MAX_VISITS)
+		return EOVERFLOW;
+	walk->visited++;
+	array = to_dma_fence_array(fence);
+	if (array != NULL) {
+		for (i = 0; i < array->num_fences; i++) {
+			error = syncfile_walk_fence(array->fences[i], walk, depth + 1);
+			if (error != 0)
+				return error;
+		}
+		return 0;
+	}
+	if (dma_fence_is_chain(fence)) {
+		/* Do not use chain_walk here: its internal pruning can visit an
+		 * unbounded number of signaled links in a single call. */
+		chain = dma_fence_get(fence);
+		prior = 0;
+		while (chain != NULL) {
+			if (walk->visited >= SYNCFILE_MAX_VISITS) {
+				dma_fence_put(chain);
+				return EOVERFLOW;
+			}
+			walk->visited++;
+			node = to_dma_fence_chain(chain);
+			if (node != NULL) {
+				contained = node->fence;
+				mtx_enter(&node->prev_lock);
+				next = dma_fence_get(node->prev);
+				mtx_leave(&node->prev_lock);
+			} else {
+				contained = chain;
+				next = NULL;
+			}
+			/* chain_walk skips signaled predecessors, but not the head.
+			 * Bound nested status probes before invoking their callbacks. */
+			if (prior && !walk->probe) {
+				if (!test_bit(DMA_FENCE_FLAG_SIGNALED_BIT,
+				    &contained->flags) &&
+				    (dma_fence_is_array(contained) ||
+				    dma_fence_is_chain(contained))) {
+					struct syncfile_walk probe = {0};
+
+					probe.visited = walk->visited;
+					probe.probe = 1;
+					error = syncfile_walk_fence(contained, &probe,
+					    depth + 1);
+					walk->visited = probe.visited;
+					if (error != 0) {
+						dma_fence_put(chain);
+						dma_fence_put(next);
+						return error;
+					}
+				}
+				if (dma_fence_is_signaled(contained)) {
+					dma_fence_put(chain);
+					chain = next;
+					continue;
+				}
+			}
+			error = syncfile_walk_fence(contained, walk, depth + 1);
+			dma_fence_put(chain);
+			if (error != 0) {
+				dma_fence_put(next);
+				return error;
+			}
+			prior = 1;
+			chain = next;
+		}
+		return 0;
+	}
+	if (walk->count == UINT32_MAX ||
+	    (walk->fill && walk->count >= walk->capacity))
+		return EOVERFLOW;
+	if (walk->fill) {
+		entry = &walk->entries[walk->count];
+		strlcpy(entry->obj_name, syncfile_timeline_name(fence),
+		    sizeof(entry->obj_name));
+		strlcpy(entry->driver_name, syncfile_driver_name(fence),
+		    sizeof(entry->driver_name));
+		status = dma_fence_get_status(fence);
+		entry->status = status;
+		if (dma_fence_is_signaled(fence))
+			entry->timestamp_ns = ktime_to_ns(dma_fence_timestamp(fence));
+		if (walk->status > 0)
+			walk->status = status;
+	}
+	walk->count++;
+	return 0;
+}
