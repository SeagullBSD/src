+	struct syncobj_eventfd_entry *event;
+	struct syncobj_poll_watch *watch;
+	struct dma_fence *fence;
+	int ret;
+
+	while (!list_empty(&pub->eventfds)) {
+		event = list_first_entry(&pub->eventfds,
+		    struct syncobj_eventfd_entry, node);
+		list_del_init(&event->node);
+		fence = event->fence;
+		ret = dma_fence_chain_find_seqno(&fence, event->point);
+		KASSERT(ret == 0);
+		(void)ret;
+		if (fence == NULL)
+			fence = dma_fence_get_stub();
+		event->fence = fence;
+		if (event->flags & DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE) {
+			eventfd_signal(event->ev_fd_ctx);
+			syncobj_eventfd_entry_free(event);
+		} else {
+			ret = dma_fence_add_callback(fence, &event->fence_cb,
+			    syncobj_eventfd_entry_fence_func);
+			if (ret == -ENOENT) {
+				eventfd_signal(event->ev_fd_ctx);
+				syncobj_eventfd_entry_free(event);
+			}
+		}
+	}
+	while (!list_empty(&pub->poll_watches)) {
+		watch = list_first_entry(&pub->poll_watches,
+		    struct syncobj_poll_watch, node);
+		list_del_init(&watch->node);
+		fence = watch->snapshot;
+		watch->snapshot = NULL;
+		syncobj_poll_watch_arm(watch, fence);
+		dma_fence_put(&watch->base);
+	}
+	/* Preserve the normal add-point collection pass, but not under the
+	 * submit gate: walking may signal fences and release references. */
+	if (pub->timeline)
+		dma_fence_chain_for_each(fence, pub->old_fence);
+	dma_fence_put(pub->old_fence);
+}
+EXPORT_SYMBOL(drm_syncobj_publish_finish);
+#endif
 
