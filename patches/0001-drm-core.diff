+			klist_init_rwlock(&watch->dir[i].notes,
+			    &watch->dir[i].notes_lock);
+		}
+		mtx_enter(&resv->fences_lock);
+		KASSERT(resv->observer == NULL);
+		resv->observer = &watch->observer;
+		mtx_leave(&resv->fences_lock);
+	}
+	dir = &watch->dir[slot];
+	kn->kn_fop = &dmabuf_filtops;
+	note->dir = dir;
+	kn->kn_hook = note;
+	rw_enter_write(&dir->notes_lock);
+	klist_insert_locked(&dir->notes, kn);
+	mtx_enter(&resv->fences_lock);
+	dir->users++;
+	watch->users++;
+	dmabuf_poll_schedule_locked(watch);
+	mtx_leave(&resv->fences_lock);
+	rw_exit_write(&dir->notes_lock);
+	rw_exit_write(&dmabuf_poll_watches_lock);
+	return 0;
+}
