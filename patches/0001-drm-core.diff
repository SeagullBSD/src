+/* A mask is conservative if a fence signals while publication is in flight. */
+static unsigned int
+dma_resv_poll_mask(struct dma_fence *fence, enum dma_resv_usage usage)
+{
+	if (fence == NULL || usage > DMA_RESV_USAGE_READ ||
+	    test_bit(DMA_FENCE_FLAG_SIGNALED_BIT, &fence->flags))
+		return 0;
+	return usage <= DMA_RESV_USAGE_WRITE ?
+	    DMA_RESV_POLL_READ | DMA_RESV_POLL_WRITE : DMA_RESV_POLL_WRITE;
+}
+
+static void
+dma_resv_changed_mask_locked(struct dma_resv *obj, unsigned int added,
+    unsigned int removed)
+{
+	unsigned int changed = added | removed;
+
+	MUTEX_ASSERT_LOCKED(&obj->fences_lock);
+	if (changed & DMA_RESV_POLL_READ)
+		obj->poll_epoch[0]++;
+	if (changed & DMA_RESV_POLL_WRITE)
+		obj->poll_epoch[1]++;
+	if (changed != 0 && obj->observer != NULL)
+		obj->observer->changed(obj->observer, added, changed);
+}
+
+static void
+dma_resv_changed_locked(struct dma_resv *obj, struct dma_fence *fence,
+    enum dma_resv_usage usage)
+{
+	dma_resv_changed_mask_locked(obj, dma_resv_poll_mask(fence, usage), 0);
+}
+
+/* Layout generation pins indices, not the list pointer.  In-place changes and
+ * appends preserve the original index range; relevant changes advance epoch.
+ * Compaction and replacement by a reordered list invalidate the layout.
+ * Fence signaling only removes dependencies. */
+void
+dma_resv_poll_cursor_init(struct dma_resv_poll_cursor *cursor,
+    struct dma_resv *obj, enum dma_resv_usage limit)
+{
+	unsigned int slot = limit == DMA_RESV_USAGE_WRITE ? 0 : 1;
+
+	cursor->obj = obj;
+	cursor->limit = limit;
+	cursor->index = 0;
+	mtx_enter(&obj->fences_lock);
+	cursor->layout_generation = obj->poll_layout_generation;
+	cursor->epoch = obj->poll_epoch[slot];
+	cursor->count = obj->fences != NULL ? obj->fences->num_fences : 0;
+	mtx_leave(&obj->fences_lock);
+}
+
+int
+dma_resv_poll_cursor_next(struct dma_resv_poll_cursor *cursor,
+    struct dma_fence **fences, unsigned int *count, bool *done)
+{
+	struct dma_resv *obj = cursor->obj;
+	struct dma_resv_list *list;
+	struct dma_fence *fence;
+	enum dma_resv_usage usage;
+	unsigned int n = 0, scanned = 0;
+	unsigned int slot = cursor->limit == DMA_RESV_USAGE_WRITE ? 0 : 1;
+
+	*count = 0;
+	*done = false;
+	mtx_enter(&obj->fences_lock);
+	if (cursor->layout_generation != obj->poll_layout_generation ||
+	    cursor->epoch != obj->poll_epoch[slot]) {
+		mtx_leave(&obj->fences_lock);
+		return -EAGAIN;
+	}
+	list = obj->fences;
+	while (cursor->index < cursor->count &&
+	    scanned++ < DMA_RESV_POLL_BATCH) {
+		dma_resv_list_entry(list, cursor->index++, NULL, &fence, &usage);
+		if (usage <= cursor->limit &&
+		    !test_bit(DMA_FENCE_FLAG_SIGNALED_BIT, &fence->flags))
+			fences[n++] = dma_fence_get(fence);
+	}
+	*done = cursor->index == cursor->count;
+	mtx_leave(&obj->fences_lock);
+	*count = n;
+	return 0;
+}
