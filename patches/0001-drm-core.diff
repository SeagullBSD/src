+/* sys_ioctl passes the original user pointer for this command. */
+static int
+syncfile_ioctl_merge(struct sync_file *sf, void *user)
+{
+	struct sync_merge_data data;
+	struct dma_fence *other = NULL, *merged = NULL;
+	struct sync_file *out = NULL;
+	int fd, error;
+
+	fd = get_unused_fd_flags(O_CLOEXEC);
+	if (fd < 0)
+		return -fd;
+	if (copyin(user, &data, sizeof(data)) != 0) {
+		error = EFAULT;
+		goto fail;
+	}
+	if (data.flags || data.pad) {
+		error = EINVAL;
+		goto fail;
+	}
+	other = sync_file_get_fence(data.fd2);
+	if (other == NULL) {
+		error = ENOENT;
+		goto fail;
+	}
+	error = syncfile_merge_fences(sf->fence, other, &merged);
+	if (error != 0)
+		goto fail;
+	out = sync_file_alloc_unarmed(merged);
+	if (out == NULL) {
+		error = ENOMEM;
+		goto fail;
+	}
+	data.name[sizeof(data.name) - 1] = '\0';
+	strlcpy(out->user_name, data.name, sizeof(out->user_name));
+	data.fence = fd;
+	if (copyout(&data, user, sizeof(data)) != 0) {
+		error = EFAULT;
+		goto fail;
+	}
+	/* No callbacks are armed until copyout succeeds; rollback cannot leave
+	 * an otherwise unreachable composite pinned on unsignaled children. */
+	dma_fence_add_callback(out->fence, &out->callback, syncfile_fence_notify);
+	fd_install(fd, out->file);
+	dma_fence_put(merged);
+	dma_fence_put(other);
+	return 0;
+fail:
+	if (out != NULL)
+		fput(out->file);
+	dma_fence_put(merged);
+	dma_fence_put(other);
+	put_unused_fd(fd);
+	return error;
+}
