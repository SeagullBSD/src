+int
+dma_buf_page_map(struct dma_buf *buf, off_t offset, vm_prot_t prot,
+    paddr_t *paddr)
+{
+	if (offset < 0 || (offset & PAGE_MASK) || (uint64_t)offset >= buf->size)
+		return -EINVAL;
+	if (!buf->ops->page_map)
+		return -EOPNOTSUPP;
+	return buf->ops->page_map(buf, offset, prot, paddr);
+}
