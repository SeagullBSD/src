+/* Non-vnode files supply a referenced pager; mapping consumes that reference. */
+int
+uvm_mmapobject(vm_map_t map, vaddr_t *addr, vsize_t size, vm_prot_t prot,
+    int flags, struct file *fp, voff_t off, vsize_t locklimit)
+{
+	struct uvm_object *uobj = NULL;
+	vm_prot_t maxprot, file_maxprot;
+	unsigned int uvmflag = 0;
+	int error;
+
+	if ((flags & MAP_FIXED) == 0)
+		*addr = round_page(*addr);
+	else {
+		if (*addr & PAGE_MASK)
+			return EINVAL;
+		uvmflag |= UVM_FLAG_FIXED;
+		if ((flags & __MAP_NOREPLACE) == 0)
+			uvmflag |= UVM_FLAG_UNMAP;
+	}
+	if (flags & MAP_CONCEAL)
+		uvmflag |= UVM_FLAG_CONCEAL;
+	maxprot = PROT_EXEC;
+	if (fp->f_flag & FREAD)
+		maxprot |= PROT_READ;
+	if (fp->f_flag & FWRITE)
+		maxprot |= PROT_WRITE;
+	file_maxprot = maxprot;
+	error = fp->f_ops->fo_mmap(fp, off, size, prot, &maxprot, &uobj);
+	if (error)
+		return error;
+	if (uobj == NULL)
+		return EINVAL;
+	maxprot &= file_maxprot;
+	if ((prot & maxprot) != prot) {
+		uobj->pgops->pgo_detach(uobj);
+		return EACCES;
+	}
+	uvmflag = UVM_MAPFLAG(prot, maxprot, MAP_INHERIT_SHARE, MADV_RANDOM,
+	    uvmflag);
+	error = uvm_map(map, addr, size, uobj, off, 0, uvmflag);
+	if (error) {
+		uobj->pgops->pgo_detach(uobj);
+		return error;
+	}
+	return uvm_mmaplock(map, addr, size, prot, locklimit);
 }
 
