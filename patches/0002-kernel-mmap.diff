 	*lock = &mo->ro_lock;
 }
 
+int
+_rw_obj_tryalloc(struct rwlock **lock, const char *name,
+    struct lock_type *type)
+{
+	struct rwlock_obj *mo;
+
+	mo = pool_get(&rwlock_obj_pool, PR_NOWAIT);
+	if (mo == NULL)
+		return 0;
+	mo->ro_magic = RWLOCK_OBJ_MAGIC;
+	_rw_init_flags(&mo->ro_lock, name, 0, type, 0);
+	mo->ro_refcnt = 1;
+	*lock = &mo->ro_lock;
+	return 1;
+}
