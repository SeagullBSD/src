+/* IRQ-safe: retain replies in order when the hardware FIFO is full. */
+static int
+rtkit_send_reply(struct rtkit_state *state, uint32_t endpoint,
+    uint64_t type, uint64_t data)
+{
+	struct aplmbox_msg msg;
+	u_int index;
+	int error = 0;
+
+	msg.data0 = (type << RTKIT_MGMT_TYPE_SHIFT) | data;
+	msg.data1 = endpoint;
+	mtx_enter(&state->send_mtx);
+	if (state->reply_stopped)
+		error = ESHUTDOWN;
+	else if (endpoint == RTKIT_EP_CRASHLOG &&
+	    __atomic_load_n(&state->crash_requests, __ATOMIC_ACQUIRE) >= 2) {
+		error = ECANCELED;
+		goto out;
+	} else if ((error = __atomic_load_n(&state->protocol_error,
+	    __ATOMIC_ACQUIRE)) != 0) {
+		/* Preserve the first permanent fault. */
+	} else if (state->reply_error)
+		error = state->reply_error;
+	else if (state->reply_count == 0) {
+		error = mbox_send(state->mc, &msg, sizeof(msg));
+		if (error == EBUSY) {
+			state->reply_deadline = nsecuptime() +
+			    RTKIT_REPLY_TIMEOUT_NS;
+			error = 0;
+		} else {
+			if (error)
+				state->reply_error = error;
+			goto out;
+		}
+	}
+	if (!error) {
+		if (state->reply_count == RTKIT_REPLY_QUEUE_SIZE) {
+			error = state->reply_error = ENOBUFS;
+		} else {
+			index = (state->reply_head + state->reply_count) %
+			    RTKIT_REPLY_QUEUE_SIZE;
+			state->reply_queue[index] = msg;
+			if (state->reply_count++ == 0) {
+				state->reply_timer_used = 1;
+				timeout_add_msec(&state->reply_timeout, 1);
+			}
+		}
+	}
+out:
+	mtx_leave(&state->send_mtx);
+	if (error && error != ESHUTDOWN && error != ECANCELED)
+		rtkit_reply_fault(state, error);
+	return error;
+}
+
+/*
+ * Process-context startup sends can encounter a full transmit FIFO during a
+ * burst.  Apple mailbox EBUSY means neither message word was written.  Do not
+ * hold send_mtx across the wait: receive callbacks also need to send replies.
+ * Other senders may run between attempts, but this message is sent at most once.
+ */
+static int
+rtkit_send_wait(struct rtkit_state *state, uint32_t endpoint, uint64_t type,
+    uint64_t data)
+{
+	uint64_t deadline, now, remaining;
+	int error, tries = 0;
+
+	deadline = cold ? 0 : nsecuptime() + 500000000ULL;
+	for (;;) {
+		error = rtkit_send(state, endpoint, type, data);
+		if (error != EBUSY)
+			return error;
+		if (cold) {
+			if (++tries >= 500)
+				return EBUSY;
+			/* Firmware may need an RX acknowledgement to drain TX. */
+			error = rtkit_poll(state);
+			if (error && error != EWOULDBLOCK)
+				return error;
+			delay(1000);
+			continue;
+		}
+		now = nsecuptime();
+		if (now >= deadline)
+			return EBUSY;
+		remaining = deadline - now;
+		error = tsleep_nsec(&state->mc, PWAIT, "rtktx",
+		    min(remaining, 1000000ULL));
+		if (error && error != EWOULDBLOCK)
+			return error;
+	}
+}
+
+/* Cold boot has no runnable timeout thread; finish queued replies here. */
+static int
+rtkit_flush_replies_cold(struct rtkit_state *state)
+{
+	int error, pending, tries;
+
+	for (tries = 0; tries < 1000; tries++) {
+		mtx_enter(&state->send_mtx);
+		error = rtkit_retry_replies_locked(state);
+		pending = state->reply_count != 0;
+		mtx_leave(&state->send_mtx);
+		if (error) {
+			rtkit_reply_fault(state, error);
+			return error;
+		}
+		if (!pending)
+			return __atomic_load_n(&state->protocol_error,
+			    __ATOMIC_ACQUIRE);
+		error = rtkit_poll(state);
+		if (error && error != EWOULDBLOCK)
+			return error;
+		delay(1000);
+	}
+	mtx_enter(&state->send_mtx);
+	if (state->reply_count == 0 && !state->reply_error) {
+		mtx_leave(&state->send_mtx);
+		return __atomic_load_n(&state->protocol_error, __ATOMIC_ACQUIRE);
+	}
+	if (!state->reply_error)
+		state->reply_error = ETIMEDOUT;
+	error = state->reply_error;
+	mtx_leave(&state->send_mtx);
+	rtkit_reply_fault(state, error);
+	return error;
 }
 
