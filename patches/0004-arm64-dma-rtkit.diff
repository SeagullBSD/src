+static int rtkit_retry_replies_locked(struct rtkit_state *);
+
+static void
+rtkit_reply_fault_task(void *arg)
+{
+	struct rtkit_state *state = arg;
+	struct rtkit *rk = state->rk;
+	int error;
+
+	mtx_enter(&state->send_mtx);
+	error = state->reply_error;
+	if (!error)
+		error = __atomic_load_n(&state->protocol_error, __ATOMIC_ACQUIRE);
+	mtx_leave(&state->send_mtx);
+	/* Stop a level-triggered RX storm while retaining unread FIFO data. */
+	if (error && state->mc != NULL &&
+	    !__atomic_load_n(&state->mailbox_paused, __ATOMIC_ACQUIRE) &&
+	    mbox_pause(state->mc, 0) == 0) {
+		mtx_enter(&state->request_mtx);
+		state->rx_stopped = 1;
+		__atomic_store_n(&state->mailbox_paused, 1, __ATOMIC_RELEASE);
+		mtx_leave(&state->request_mtx);
+	}
+	if (error && rk && rk->rk_fault)
+		rk->rk_fault(rk->rk_cookie, error);
+}
+
+static void
+rtkit_reply_fault(struct rtkit_state *state, int error)
+{
+	int expected = 0;
+
+	if (!error)
+		return;
+	(void)__atomic_compare_exchange_n(&state->protocol_error, &expected,
+	    error, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+	if (__atomic_exchange_n(&state->reply_fault_reported, 1,
+	    __ATOMIC_ACQ_REL))
+		return;
+	wakeup(&state->epmap_complete);
+	wakeup(&state->iop_pwrstate);
+	wakeup(&state->ap_pwrstate);
+	printf("rtkit: %s: protocol failure (%d)\n",
+	    state->node_name, error);
+	task_add(systqmp, &state->reply_fault_task);
+}
+
+static void
+rtkit_protocol_fault(struct rtkit_state *state, int error)
+{
+	rtkit_reply_fault(state, error);
+}
