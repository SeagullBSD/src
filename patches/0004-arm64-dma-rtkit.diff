+/* Caller holds send_mtx. A successful send removes exactly one reply. */
+static int
+rtkit_retry_replies_locked(struct rtkit_state *state)
+{
+	struct aplmbox_msg *msg;
+	int error;
+
+	while (state->reply_count != 0 && !state->reply_stopped &&
+	    !state->reply_error) {
+		msg = &state->reply_queue[state->reply_head];
+		if (msg->data1 == RTKIT_EP_CRASHLOG &&
+		    __atomic_load_n(&state->crash_requests, __ATOMIC_ACQUIRE) >= 2) {
+			state->reply_head = (state->reply_head + 1) %
+			    RTKIT_REPLY_QUEUE_SIZE;
+			state->reply_count--;
+			state->reply_deadline = nsecuptime() + RTKIT_REPLY_TIMEOUT_NS;
+			continue;
+		}
+		error = mbox_send(state->mc, msg, sizeof(*msg));
+		if (error == EBUSY) {
+			if (nsecuptime() >= state->reply_deadline)
+				state->reply_error = ETIMEDOUT;
+			break;
+		}
+		if (error) {
+			state->reply_error = error;
+			break;
+		}
+		state->reply_head = (state->reply_head + 1) %
+		    RTKIT_REPLY_QUEUE_SIZE;
+		state->reply_count--;
+		state->reply_deadline = nsecuptime() + RTKIT_REPLY_TIMEOUT_NS;
+	}
+	return state->reply_error;
+}
