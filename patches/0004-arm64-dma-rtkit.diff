+/* Firmware owns these pages; only the kernel virtual mapping is ours. */
+static int
+rtkit_map_firmware(struct rtkit_state *state, bus_addr_t addr,
+    bus_size_t size, caddr_t *kvap)
+{
+	struct rtkit *rk = state->rk;
