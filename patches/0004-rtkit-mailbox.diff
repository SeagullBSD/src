diff -u -p -r1.32 ofw_misc.h
--- sys/dev/ofw/ofw_misc.h	5 Sep 2026 20:36:56 -0000	1.32
+++ sys/dev/ofw/ofw_misc.h	20 Nov 2026 17:45:58 -0000
@@ -293,16 +293,22 @@ struct mbox_client {
 	void	*mc_rx_arg;
 	int	mc_flags;
 #define MC_WAKEUP		0x00000001
+#define MC_PAUSED		0x00000002	/* claim with RX paused */
 };
 
 struct mbox_channel;
 
 struct mbox_device {
 	int	md_node;
+	int	md_flags;
+#define MBOX_DEVICE_PAUSED_CLAIM	0x01
 	void	*md_cookie;
 	void	*(*md_channel)(void *, uint32_t *, struct mbox_client *);
 	int	(*md_recv)(void *, void *, size_t);
 	int	(*md_send)(void *, const void *, size_t);
+	int	(*md_detach)(void *, void (*)(void *), void *);
+	int	(*md_pause)(void *, int);
+	int	(*md_resume)(void *);
 
 	LIST_ENTRY(mbox_device) md_list;
 	uint32_t md_phandle;
@@ -316,6 +322,18 @@ struct mbox_channel *mbox_channel_idx(in
 
 int	mbox_send(struct mbox_channel *, const void *, size_t);
 int	mbox_recv(struct mbox_channel *, void *, size_t);
+/*
+ * Pause blocks receive callbacks and retains pending FIFO data.  Explicit
+ * receive remains available.  NOSLEEP returns EBUSY rather than waiting.
+ * Resume re-enables delivery, including messages already pending.
+ */
+#define MBOX_PAUSE_NOSLEEP	0x01
+int	mbox_pause(struct mbox_channel *, int);
+int	mbox_resume(struct mbox_channel *);
+/* Caller serializes channel users; detach waits for receive callbacks. */
+int	mbox_detach(struct mbox_channel *);
+/* Release only after detach and after all send/receive users have stopped. */
+void	mbox_free(struct mbox_channel *);
 
 /* hwlock support */
 
