--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_uat.c	Tue Nov 17 10:10:17 2026
@@ -0,0 +1,2803 @@
+/* SPDX-License-Identifier: MIT */
+/* UAT lower- and upper-half page table primitives. */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/stdint.h>
+#include <sys/errno.h>
+#include <sys/mutex.h>
+#include <sys/rwlock.h>
+#include <sys/task.h>
+#include <sys/time.h>
+#include <sys/timeout.h>
+#include <sys/tree.h>
+#include <machine/bus.h>
+#include <linux/dma-resv.h>
+#include <drm/drm_gem.h>
+
+#include "agx_uat.h"
+#include "agx_hw_t8103.h"
+
+/* Linux rbtree headers redefine RB_ROOT as a constant; the native tree
+ * generator below needs the OpenBSD function-like accessor. */
+#undef RB_ROOT
+#define RB_ROOT(head) ((head)->rbh_root)
+
+#define UAT_NPTE		(AGX_PAGE_SIZE / sizeof(uint64_t))
+#define UAT_INDEX_MASK		(UAT_NPTE - 1)
+#define UAT_TABLE		3ULL
+#define UAT_AF			(1ULL << 10)
+#define UAT_NG			(1ULL << 11)
+#define UAT_AP_GPU		(2ULL << 6)
+#define UAT_AP_FW		(1ULL << 6)
+/* Preserve out-of-range address bits so borrowed descriptors fail closed. */
+#define UAT_PA_MASK		(((1ULL << 52) - 1) & ~AGX_PAGE_MASK)
+#define UAT_UNCACHED		(2ULL << 2)
+#define UAT_PXN			(1ULL << 53)
+#define UAT_UXN			(1ULL << 54)
+#define UAT_GPU_ACCESS		(1ULL << 55)
+
+unsigned int
+agx_uat_oas_for_chip(uint32_t chip_id)
+{
+	switch (chip_id) {
+	case 0x8103:
+		return AGX_T8103_UAT_OAS;
+	case 0x6021:
+		return 42;
+	default:
+		return 0;
+	}
+}
+
+struct agx_uat_node {
+	struct agx_mem *mem;
+	bus_space_tag_t iot;
+	bus_space_handle_t ioh;
+	paddr_t pa;
+	uint64_t *entries;
+	uint64_t owned[UAT_NPTE / 64];
+	uint64_t cache_pending[UAT_NPTE / 64];
+	struct agx_uat_node **children;
+	struct agx_uat_node *reclaim_next;
+};
+
+struct agx_uat_pt {
+	bus_dma_tag_t dmat;
+	bus_space_tag_t iot;
+	int kernel;
+	unsigned int oas;
+	struct rwlock lock;
+	struct agx_uat_handoff *handoff;	/* private VM roots only */
+	struct agx_uat_node *root;
+};
+
+/* A private, fully mapped table, prepared without either VM or PT lock. */
+struct agx_uat_reserve {
+	struct agx_uat_node *node;
+	int level;
+	int needed;
+};
+
+static void agx_uat_pt_tlbi(struct agx_uat_pt *, uint64_t, uint64_t);
+
+static int
+agx_uat_node_new(bus_dma_tag_t dmat, unsigned int oas, int level,
+    struct agx_uat_node **out)
+{
+	struct agx_uat_node *node;
+	int error;
+
+	node = malloc(sizeof(*node), M_DEVBUF, M_NOWAIT | M_CANFAIL | M_ZERO);
+	if (node == NULL)
+		return ENOMEM;
+	if (level != 0) {
+		node->children = mallocarray(UAT_NPTE, sizeof(*node->children),
+		    M_DEVBUF, M_NOWAIT | M_CANFAIL | M_ZERO);
+		if (node->children == NULL) {
+			free(node, M_DEVBUF, sizeof(*node));
+			return ENOMEM;
+		}
+	}
+	error = agx_mem_alloc(dmat, AGX_PAGE_SIZE, oas, &node->mem);
+	if (error != 0) {
+		if (node->children != NULL)
+			free(node->children, M_DEVBUF,
+			    UAT_NPTE * sizeof(*node->children));
+		free(node, M_DEVBUF, sizeof(*node));
+		return error;
+	}
+	node->pa = node->mem->segs[0].ds_addr;
+	node->entries = node->mem->kva;
+	*out = node;
+	return 0;
+}
+
+
+/* All table allocations remain NOWAIT; retries are bounded and interruptible. */
+static int
+agx_uat_create_mem(bus_dma_tag_t dmat, unsigned int oas, int level,
+    const void *waitchan, struct agx_uat_node **node, struct agx_mem **mem)
+{
+	int error, i;
+
+	for (i = 0; i < 16; i++) {
+		if (node != NULL)
+			error = agx_uat_node_new(dmat, oas, level, node);
+		else
+			error = agx_mem_alloc(dmat, AGX_PAGE_SIZE, oas, mem);
+		if (error != ENOMEM || i == 15)
+			return error;
+		error = tsleep_nsec(waitchan, PWAIT | PCATCH, "agxvmem",
+		    MSEC_TO_NSEC(10));
+		if (error != 0 && error != EWOULDBLOCK)
+			return error;
+	}
+	return ENOMEM;
+}
+
+static void
+agx_uat_node_free(struct agx_uat_node *node)
+{
+	unsigned int i;
+
+	if (node->children != NULL) {
+		for (i = 0; i < UAT_NPTE; i++)
+			if (node->children[i] != NULL)
+				agx_uat_node_free(node->children[i]);
+		free(node->children, M_DEVBUF,
+		    UAT_NPTE * sizeof(*node->children));
+	}
+	if (node->mem != NULL)
+		agx_mem_free(node->mem);
+	else
+		bus_space_unmap(node->iot, node->ioh, AGX_PAGE_SIZE);
+	free(node, M_DEVBUF, sizeof(*node));
+}
+
+static int
+agx_uat_node_borrow(struct agx_uat_pt *pt, paddr_t pa, int level,
+    struct agx_uat_node **out)
+{
+	struct agx_uat_node *node;
+	int error;
+
+	if ((pa & AGX_PAGE_MASK) != 0 || pa >= (1ULL << pt->oas))
+		return EINVAL;
+	node = malloc(sizeof(*node), M_DEVBUF, M_NOWAIT | M_CANFAIL | M_ZERO);
+	if (node == NULL)
+		return ENOMEM;
+	node->iot = pt->iot;
+	node->pa = pa;
+	error = bus_space_map(pt->iot, pa, AGX_PAGE_SIZE,
+	    BUS_SPACE_MAP_PREFETCHABLE, &node->ioh);
+	if (error != 0) {
+		free(node, M_DEVBUF, sizeof(*node));
+		return error;
+	}
+	node->entries = bus_space_vaddr(pt->iot, node->ioh);
+	if (node->entries == NULL) {
+		bus_space_unmap(pt->iot, node->ioh, AGX_PAGE_SIZE);
+		free(node, M_DEVBUF, sizeof(*node));
+		return EIO;
+	}
+	if (level != 0) {
+		node->children = mallocarray(UAT_NPTE, sizeof(*node->children),
+		    M_DEVBUF, M_NOWAIT | M_CANFAIL | M_ZERO);
+		if (node->children == NULL) {
+			bus_space_unmap(pt->iot, node->ioh, AGX_PAGE_SIZE);
+			free(node, M_DEVBUF, sizeof(*node));
+			return ENOMEM;
+		}
+	}
+	*out = node;
+	return 0;
+}
+
+/* Called only after the hardware is unable to walk these tables. */
+static void
+agx_uat_node_detach(struct agx_uat_node *node)
+{
+	unsigned int i;
+
+	if (node->children == NULL) {
+		for (i = 0; i < UAT_NPTE; i++)
+			if (node->owned[i / 64] & (1ULL << (i % 64)))
+				__atomic_store_n(&node->entries[i], 0,
+				    __ATOMIC_RELEASE);
+		return;
+	}
+	for (i = 0; i < UAT_NPTE; i++) {
+		if (node->children[i] == NULL)
+			continue;
+		if (node->children[i]->mem != NULL)
+			__atomic_store_n(&node->entries[i], 0, __ATOMIC_RELEASE);
+		else
+			agx_uat_node_detach(node->children[i]);
+	}
+}
+
+static int
+agx_uat_leaf(struct agx_uat_pt *pt, uint64_t va, int create,
+    uint64_t **ptep, struct agx_uat_node **leaf,
+    struct agx_uat_reserve *reserve)
+{
+	struct agx_uat_node *node, *child;
+	uint64_t *entries, desc;
+	unsigned int index;
+	int level, error;
+
+	va &= (1ULL << 39) - 1;
+	node = pt->root;
+	for (level = 2; level > 0; level--) {
+		index = (va >> (AGX_PAGE_SHIFT + 11 * level)) &
+		    UAT_INDEX_MASK;
+		child = node->children[index];
+		if (child == NULL) {
+			entries = node->entries;
+			desc = __atomic_load_n(&entries[index], __ATOMIC_ACQUIRE);
+			if (desc != 0) {
+				if (!pt->kernel || (desc & 3) != UAT_TABLE)
+					return EIO;
+				error = agx_uat_node_borrow(pt, desc & UAT_PA_MASK,
+				    level - 1, &child);
+				if (error != 0)
+					return error;
+				node->children[index] = child;
+				node = child;
+				continue;
+			}
+			if (!create) {
+				*ptep = NULL;
+				*leaf = NULL;
+				return 0;
+			}
+			if (reserve != NULL) {
+				if (reserve->node == NULL ||
+				    reserve->level != level - 1) {
+					reserve->needed = level - 1;
+					return ENOMEM;
+				}
+				child = reserve->node;
+				reserve->node = NULL;
+			} else {
+				error = agx_uat_node_new(pt->dmat, pt->oas,
+				    level - 1, &child);
+				if (error != 0)
+					return error;
+			}
+			node->children[index] = child;
+			entries = node->entries;
+			__atomic_store_n(&entries[index],
+			    child->pa | UAT_TABLE, __ATOMIC_RELEASE);
+		}
+		node = child;
+	}
+	entries = node->entries;
+	*leaf = node;
+	*ptep = &entries[(va >> AGX_PAGE_SHIFT) & UAT_INDEX_MASK];
+	return 0;
+}
+
+/* Valid only while holding pt->lock; table reclamation also takes that lock. */
+struct agx_uat_leaf_cursor {
+	struct agx_uat_node *leaf;
+	uint64_t base;
+	int valid;
+};
+
+static inline int
+agx_uat_leaf_cached(struct agx_uat_pt *pt, uint64_t va, int create,
+    uint64_t **ptep, struct agx_uat_node **leaf,
+    struct agx_uat_reserve *reserve, struct agx_uat_leaf_cursor *cursor)
+{
+	uint64_t base = va & ~(((uint64_t)UAT_NPTE << AGX_PAGE_SHIFT) - 1);
+	int error;
+
+	if (!cursor->valid || cursor->base != base ||
+	    (create && cursor->leaf == NULL)) {
+		error = agx_uat_leaf(pt, va, create, ptep, leaf, reserve);
+		if (error != 0) {
+			cursor->valid = 0;
+			return error;
+		}
+		cursor->base = base;
+		cursor->leaf = *leaf;
+		cursor->valid = 1;
+	} else {
+		*leaf = cursor->leaf;
+		*ptep = *leaf == NULL ? NULL : &(*leaf)->entries[
+		    (va >> AGX_PAGE_SHIFT) & UAT_INDEX_MASK];
+	}
+	return 0;
+}
+
+static int
+agx_uat_range_valid(uint64_t va, uint64_t size)
+{
+	return size != 0 && ((va | size) & AGX_PAGE_MASK) == 0 &&
+	    va >= AGX_UAT_USER_BASE && va < AGX_UAT_USER_TOP &&
+	    size <= AGX_UAT_USER_TOP - va;
+}
+
+int
+agx_uat_pt_create(bus_dma_tag_t dmat, unsigned int oas, struct agx_uat_pt **out)
+{
+	struct agx_uat_pt *pt;
+	int error;
+
+	if (dmat == NULL || out == NULL || !AGX_UAT_OAS_VALID(oas))
+		return EINVAL;
+	*out = NULL;
+	pt = malloc(sizeof(*pt), M_DEVBUF, M_WAITOK | M_ZERO);
+	pt->dmat = dmat;
+	pt->oas = oas;
+	rw_init(&pt->lock, "agxuat");
+	error = agx_uat_node_new(dmat, oas, 2, &pt->root);
+	if (error != 0) {
+		free(pt, M_DEVBUF, sizeof(*pt));
+		return error;
+	}
+	*out = pt;
+	return 0;
+}
+
+/* Prepare an unpublished VM root with bounded process-context backpressure. */
+static int
+agx_uat_pt_create_vm(bus_dma_tag_t dmat, unsigned int oas,
+    const void *waitchan, struct agx_uat_pt **out)
+{
+	struct agx_uat_pt *pt;
+	int error;
+
+	pt = malloc(sizeof(*pt), M_DEVBUF, M_WAITOK | M_ZERO);
+	pt->dmat = dmat;
+	pt->oas = oas;
+	rw_init(&pt->lock, "agxuat");
+	error = agx_uat_create_mem(dmat, oas, 2, waitchan, &pt->root, NULL);
+	if (error != 0) {
+		free(pt, M_DEVBUF, sizeof(*pt));
+		return error;
+	}
+	*out = pt;
+	return 0;
+}
+
+int
+agx_uat_pt_create_kernel(bus_dma_tag_t dmat, bus_space_tag_t iot, paddr_t pa,
+    unsigned int oas, struct agx_uat_pt **out)
+{
+	struct agx_uat_pt *pt;
+	int error;
+
+	if (dmat == NULL || iot == NULL || out == NULL || !AGX_UAT_OAS_VALID(oas))
+		return EINVAL;
+	*out = NULL;
+	pt = malloc(sizeof(*pt), M_DEVBUF, M_WAITOK | M_ZERO);
+	pt->dmat = dmat;
+	pt->iot = iot;
+	pt->oas = oas;
+	pt->kernel = 1;
+	rw_init(&pt->lock, "agxkpt");
+	error = agx_uat_node_borrow(pt, pa, 2, &pt->root);
+	if (error != 0) {
+		free(pt, M_DEVBUF, sizeof(*pt));
+		return error;
+	}
+	*out = pt;
+	return 0;
+}
+
+unsigned int
+agx_uat_pt_oas(const struct agx_uat_pt *pt)
+{
+	return pt->oas;
+}
+
+void
+agx_uat_pt_destroy(struct agx_uat_pt *pt)
+{
+	if (pt == NULL)
+		return;
+	agx_uat_node_detach(pt->root);
+	/* The owner must already have detached the root and stopped the GPU. */
+	agx_tlbi_sync();
+	agx_tlbi_all();
+	agx_tlbi_sync();
+	agx_uat_node_free(pt->root);
+	free(pt, M_DEVBUF, sizeof(*pt));
+}
+
+paddr_t
+agx_uat_pt_root(struct agx_uat_pt *pt)
+{
+	return pt->root->pa;
+}
+
+static int
+agx_uat_kernel_range_valid(uint64_t va, uint64_t size)
+{
+	return size != 0 && ((va | size) & AGX_PAGE_MASK) == 0 &&
+	    va >= AGX_UAT_KERNEL_BASE && va < AGX_UAT_KERNEL_TOP &&
+	    size <= AGX_UAT_KERNEL_TOP - va;
+}
+
+static int
+agx_uat_pt_map_prepared(struct agx_uat_pt *pt, uint64_t va,
+    struct agx_mem *mem, uint64_t offset, uint64_t size, uint64_t pteflags,
+    int repeat, int replace, int allow_dummy, struct agx_uat_reserve *reserve)
+{
+	struct agx_uat_node *leaf;
+	struct agx_uat_leaf_cursor cursor = { 0 };
+	uint64_t *pte, pos, needed, index, old;
+	paddr_t phys;
+	int error, need_break = 0;
+
+	if (pt == NULL ||
+	    !(pt->kernel ? agx_uat_kernel_range_valid(va, size) :
+	    (agx_uat_range_valid(va, size) || (allow_dummy &&
+	    va == AGX_UAT_USER_TOP && size == AGX_PAGE_SIZE))) ||
+	    (offset & AGX_PAGE_MASK) != 0 || (repeat != 0 && repeat != 1))
+		return EINVAL;
+	needed = repeat ? AGX_PAGE_SIZE : size;
+	if (mem != NULL) {
+		if (mem->oas != pt->oas || offset > mem->size ||
+		    needed > mem->size - offset)
+			return EINVAL;
+		/* The caller must hold the pin through mapping and its lifetime.
+		 * Check it before breaking any existing translations. */
+		error = agx_mem_phys(mem, offset, &phys);
+		if (error != 0)
+			return error;
+	} else if (!pt->kernel || repeat || offset >= (1ULL << pt->oas) ||
+	    size > (1ULL << pt->oas) - offset)
+		return EINVAL;
+	if (reserve != NULL)
+		reserve->needed = -1;
+	rw_enter_write(&pt->lock);
+	/* No leaf PTE changes until allocation and collision checks succeed. */
+	for (pos = 0; pos < size; pos += AGX_PAGE_SIZE) {
+		error = agx_uat_leaf_cached(pt, va + pos, 1, &pte, &leaf,
+		    reserve, &cursor);
+		if (error != 0)
+			goto out;
+		old = __atomic_load_n(pte, __ATOMIC_RELAXED);
+		if (old != 0 && !replace) {
+			error = EEXIST;
+			goto out;
+		}
+		index = ((va + pos) >> AGX_PAGE_SHIFT) & UAT_INDEX_MASK;
+		/* A TLB invalidation cannot discard firmware's cached data. */
+		if (leaf->cache_pending[index / 64] & (1ULL << (index % 64))) {
+			error = EBUSY;
+			goto out;
+		}
+		if (replace && old != 0)
+			need_break = 1;
+	}
+	if (replace && need_break) {
+		/* Break before make: callers must quiesce GPU users of the range. */
+		for (pos = 0; pos < size; pos += AGX_PAGE_SIZE) {
+			agx_uat_leaf_cached(pt, va + pos, 0, &pte, &leaf,
+			    NULL, &cursor);
+			__atomic_store_n(pte, 0, __ATOMIC_RELEASE);
+		}
+		agx_uat_pt_tlbi(pt, va, size);
+	}
+	if (mem != NULL && repeat)
+		agx_mem_phys(mem, offset, &phys);
+	for (pos = 0; pos < size; pos += AGX_PAGE_SIZE) {
+		agx_uat_leaf_cached(pt, va + pos, 0, &pte, &leaf, NULL,
+		    &cursor);
+		if (mem != NULL) {
+			if (!repeat)
+				agx_mem_phys(mem, offset + pos, &phys);
+		} else
+			phys = offset + pos;
+		__atomic_store_n(pte, phys | pteflags, __ATOMIC_RELEASE);
+		index = ((va + pos) >> AGX_PAGE_SHIFT) & UAT_INDEX_MASK;
+		leaf->owned[index / 64] |= 1ULL << (index % 64);
+		if ((pteflags & (7ULL << 2)) == 0)
+			leaf->cache_pending[index / 64] |= 1ULL << (index % 64);
+	}
+	agx_uat_pt_tlbi(pt, va, size);
+	error = 0;
+out:
+	rw_exit_write(&pt->lock);
+	return error;
+}
+
+static int
+agx_uat_pt_map_common(struct agx_uat_pt *pt, uint64_t va,
+    struct agx_mem *mem, uint64_t offset, uint64_t size, uint64_t pteflags,
+    int repeat, int replace, int allow_dummy)
+{
+	return agx_uat_pt_map_prepared(pt, va, mem, offset, size, pteflags,
+	    repeat, replace, allow_dummy, NULL);
+}
+
+/* Prepare one leaf span at a time; committed PTEs are not touched here. */
+static int
+agx_uat_pt_prepare(struct agx_uat_pt *pt, uint64_t va, uint64_t size,
+    uint64_t *cursor, struct agx_uat_reserve *reserve)
+{
+	struct agx_uat_node *leaf;
+	uint64_t *pte, span = (uint64_t)UAT_NPTE << AGX_PAGE_SHIFT;
+	int error = 0;
+
+	reserve->needed = -1;
+	rw_enter_write(&pt->lock);
+	while (*cursor < size) {
+		error = agx_uat_leaf(pt, va + *cursor, 1, &pte, &leaf,
+		    reserve);
+		if (error != 0)
+			break;
+		*cursor += MIN(size - *cursor, span - ((va + *cursor) &
+		    (span - 1)));
+	}
+	rw_exit_write(&pt->lock);
+	return error;
+}
+
+static int
+agx_uat_gpu_flags(enum agx_uat_gpu_prot prot, uint64_t *flags)
+{
+	*flags = UAT_TABLE | UAT_AF | UAT_NG | UAT_AP_GPU |
+	    UAT_UNCACHED | UAT_GPU_ACCESS;
+	switch (prot) {
+	case AGX_UAT_GPU_RO:
+		return 0;
+	case AGX_UAT_GPU_WO:
+		*flags |= UAT_PXN;
+		return 0;
+	case AGX_UAT_GPU_RW:
+		*flags |= UAT_UXN;
+		return 0;
+	default:
+		return EINVAL;
+	}
+}
+
+int
+agx_uat_pt_map(struct agx_uat_pt *pt, uint64_t va, struct agx_mem *mem,
+    uint64_t offset, uint64_t size, enum agx_uat_gpu_prot prot, int repeat)
+{
+	uint64_t flags;
+	int error;
+
+	if (pt == NULL || pt->kernel)
+		return EINVAL;
+	error = agx_uat_gpu_flags(prot, &flags);
+	return error ? error : agx_uat_pt_map_common(pt, va, mem, offset, size,
+	    flags, repeat, 0, 0);
+}
+
+int
+agx_uat_pt_replace(struct agx_uat_pt *pt, uint64_t va, struct agx_mem *mem,
+    uint64_t offset, uint64_t size, enum agx_uat_gpu_prot prot, int repeat)
+{
+	uint64_t flags;
+	int error;
+
+	if (pt == NULL || pt->kernel)
+		return EINVAL;
+	error = agx_uat_gpu_flags(prot, &flags);
+	return error ? error : agx_uat_pt_map_common(pt, va, mem, offset, size,
+	    flags, repeat, 1, 0);
+}
+
+int
+agx_uat_pt_map_dummy(struct agx_uat_pt *pt, struct agx_mem *mem)
+{
+	uint64_t flags;
+
+	if (pt == NULL || pt->kernel)
+		return EINVAL;
+	agx_uat_gpu_flags(AGX_UAT_GPU_RW, &flags);
+	return agx_uat_pt_map_common(pt, AGX_UAT_USER_TOP, mem, 0,
+	    AGX_PAGE_SIZE, flags, 0, 0, 1);
+}
+
+/* The PT is private until this mapping is complete. */
+static int
+agx_uat_pt_map_dummy_vm(struct agx_uat_pt *pt, struct agx_mem *mem,
+    const void *waitchan)
+{
+	struct agx_uat_reserve reserve = { .needed = -1 };
+	uint64_t flags;
+	int error;
+
+	agx_uat_gpu_flags(AGX_UAT_GPU_RW, &flags);
+	for (;;) {
+		error = agx_uat_pt_map_prepared(pt, AGX_UAT_USER_TOP, mem, 0,
+		    AGX_PAGE_SIZE, flags, 0, 0, 1, &reserve);
+		if (error != ENOMEM || reserve.needed < 0)
+			break;
+		if (reserve.node != NULL) {
+			agx_uat_node_free(reserve.node);
+			reserve.node = NULL;
+		}
+		reserve.level = reserve.needed;
+		error = agx_uat_create_mem(pt->dmat, pt->oas, reserve.level,
+		    waitchan, &reserve.node, NULL);
+		if (error != 0)
+			break;
+	}
+	if (reserve.node != NULL)
+		agx_uat_node_free(reserve.node);
+	return error;
+}
+
+int
+agx_uat_pt_map_kernel(struct agx_uat_pt *pt, uint64_t va, struct agx_mem *mem,
+    uint64_t offset, uint64_t size, enum agx_uat_fw_prot prot)
+{
+	uint64_t flags = UAT_TABLE | UAT_AF | UAT_UNCACHED | UAT_GPU_ACCESS;
+
+	if (pt == NULL || !pt->kernel || mem == NULL)
+		return EINVAL;
+	switch (prot) {
+	case AGX_UAT_FW_SHARED_RW:
+		flags |= UAT_AP_FW | UAT_UXN;
+		break;
+	case AGX_UAT_FW_SHARED_RO:
+		flags |= UAT_AP_FW;
+		break;
+	case AGX_UAT_FW_GPU_SHARED_RW:
+		flags |= UAT_UXN | UAT_PXN;
+		break;
+	case AGX_UAT_FW_RW_GPU_RO:
+		flags |= UAT_AP_FW | UAT_UXN | UAT_PXN;
+		break;
+	case AGX_UAT_FW_PRIV_RW:
+		flags = (flags & ~UAT_UNCACHED) | UAT_AP_FW | UAT_UXN;
+		break;
+	case AGX_UAT_FW_GPU_PRIV_RW:
+		flags = (flags & ~UAT_UNCACHED) | UAT_UXN | UAT_PXN;
+		break;
+	case AGX_UAT_FW_RW_GPU_RO_PRIV:
+		flags = (flags & ~UAT_UNCACHED) | UAT_AP_FW | UAT_UXN | UAT_PXN;
+		break;
+	default:
+		return EINVAL;
+	}
+	return agx_uat_pt_map_common(pt, va, mem, offset, size, flags, 0, 0, 0);
+}
+
+int
+agx_uat_pt_map_io(struct agx_uat_pt *pt, uint64_t va, paddr_t pa,
+    uint64_t size, int writable)
+{
+	uint64_t flags = UAT_TABLE | UAT_AF | UAT_GPU_ACCESS | UAT_AP_FW |
+	    (1ULL << 2);
+
+	if (pt == NULL || !pt->kernel || (writable != 0 && writable != 1))
+		return EINVAL;
+	if (writable)
+		flags |= UAT_UXN;
+	return agx_uat_pt_map_common(pt, va, NULL, pa, size, flags, 0, 0, 0);
+}
+
+int
+agx_uat_pt_map_fw_shared_phys(struct agx_uat_pt *pt, uint64_t va,
+    paddr_t pa, uint64_t size)
+{
+	uint64_t flags = UAT_TABLE | UAT_AF | UAT_UNCACHED | UAT_GPU_ACCESS |
+	    UAT_AP_FW | UAT_UXN;
+
+	if (pt == NULL || !pt->kernel)
+		return EINVAL;
+	return agx_uat_pt_map_common(pt, va, NULL, pa, size, flags, 0, 0, 0);
+}
+
+int
+agx_uat_pt_unmap(struct agx_uat_pt *pt, uint64_t va, uint64_t size)
+{
+	struct agx_uat_node *leaf;
+	struct agx_uat_leaf_cursor cursor = { 0 };
+	uint64_t *pte, pos, index, value;
+	int error, changed = 0;
+
+	if (pt == NULL || !(pt->kernel ? agx_uat_kernel_range_valid(va, size) :
+	    agx_uat_range_valid(va, size)))
+		return EINVAL;
+	rw_enter_write(&pt->lock);
+	/* Refuse to remove a bootloader-owned mapping, including partially. */
+	for (pos = 0; pos < size;) {
+		error = agx_uat_leaf_cached(pt, va + pos, 0, &pte, &leaf,
+		    NULL, &cursor);
+		if (error != 0)
+			goto out;
+		if (pte == NULL) {
+			/* A missing leaf covers an entire 32 MiB UAT block. */
+			pos += MIN(size - pos, ((uint64_t)UAT_NPTE <<
+			    AGX_PAGE_SHIFT) - ((va + pos) &
+			    (((uint64_t)UAT_NPTE << AGX_PAGE_SHIFT) - 1)));
+			continue;
+		}
+		index = ((va + pos) >> AGX_PAGE_SHIFT) & UAT_INDEX_MASK;
+		value = __atomic_load_n(pte, __ATOMIC_RELAXED);
+		if (pt->kernel && value != 0 &&
+		    !(leaf->owned[index / 64] & (1ULL << (index % 64)))) {
+			error = EACCES;
+			goto out;
+		}
+		if (leaf->cache_pending[index / 64] & (1ULL << (index % 64))) {
+			error = EBUSY;
+			goto out;
+		}
+		pos += AGX_PAGE_SIZE;
+	}
+	for (pos = 0; pos < size;) {
+		agx_uat_leaf_cached(pt, va + pos, 0, &pte, &leaf, NULL,
+		    &cursor);
+		if (pte == NULL) {
+			pos += MIN(size - pos, ((uint64_t)UAT_NPTE <<
+			    AGX_PAGE_SHIFT) - ((va + pos) &
+			    (((uint64_t)UAT_NPTE << AGX_PAGE_SHIFT) - 1)));
+			continue;
+		}
+		if (__atomic_load_n(pte, __ATOMIC_RELAXED) != 0) {
+			__atomic_store_n(pte, 0, __ATOMIC_RELEASE);
+			changed = 1;
+		}
+		index = ((va + pos) >> AGX_PAGE_SHIFT) & UAT_INDEX_MASK;
+		leaf->owned[index / 64] &= ~(1ULL << (index % 64));
+		pos += AGX_PAGE_SIZE;
+	}
+	/* Empty unmaps may run alongside jobs; there is no translation to
+	 * invalidate in that case.  In particular, avoid a system-wide TLBI. */
+	if (changed) {
+		agx_uat_pt_tlbi(pt, va, size);
+	}
+	error = 0;
+out:
+	rw_exit_write(&pt->lock);
+	return error;
+}
+
+#define UAT_HANDOFF_MAGIC	0x4b1d000000000002ULL
+#define UAT_CONTEXTS		64
+#define UAT_TTBR_VALID		1ULL
+
+struct agx_uat_flush_info {
+	uint64_t state, addr, size;
+};
+
+struct agx_uat_handoff_data {
+	uint64_t magic_ap, magic_fw;
+	uint8_t lock_ap, lock_fw, pad0[2];
+	uint32_t turn, cur_slot, pad1;
+	struct agx_uat_flush_info flush[UAT_CONTEXTS + 1];
+	uint8_t unk2, pad2[7];
+	uint64_t unk3;
+};
+
+struct agx_uat_ttbs {
+	uint64_t ttb0, ttb1;
+};
+
+CTASSERT(sizeof(struct agx_uat_flush_info) == 24);
+CTASSERT(__builtin_offsetof(struct agx_uat_handoff_data, turn) == 20);
+CTASSERT(__builtin_offsetof(struct agx_uat_handoff_data, cur_slot) == 24);
+CTASSERT(__builtin_offsetof(struct agx_uat_handoff_data, flush) == 32);
+CTASSERT(__builtin_offsetof(struct agx_uat_handoff_data, unk3) == 1600);
+CTASSERT(sizeof(struct agx_uat_handoff_data) == 1608);
+CTASSERT(sizeof(struct agx_uat_ttbs) == 16);
+
+struct agx_uat_slot {
+	const void *owner;
+	paddr_t root;
+	unsigned int users;
+	uint64_t age;
+};
+
+struct agx_uat_handoff {
+	bus_space_tag_t iot;
+	unsigned int oas;
+	paddr_t kernel_ttb1;
+	int map_kernel_to_user;
+	bus_space_handle_t handoff_io, ttbs_io;
+	struct agx_uat_handoff_data *data;
+	struct agx_uat_ttbs *ttbs;
+	struct rwlock lock;
+	struct mutex reclaim_mtx;	/* poison versus completed detach */
+	struct agx_uat_slot slots[UAT_CONTEXTS];
+	uint64_t age;
+	unsigned int vm_count;
+	int started, stopped, poisoned;
+};
+
+/* Safe from the RTKit crash callback; stopping hardware is separate. */
+void
+agx_uat_handoff_poison(struct agx_uat_handoff *h)
+{
+	if (h != NULL) {
+		mtx_enter(&h->reclaim_mtx);
+		__atomic_store_n(&h->poisoned, 1, __ATOMIC_RELEASE);
+		mtx_leave(&h->reclaim_mtx);
+		wakeup(h);
+	}
+}
+
+/* AP callers serialize with h->lock before entering Dekker's lock. */
+static int
+agx_uat_handoff_lock(struct agx_uat_handoff *h)
+{
+	struct agx_uat_handoff_data *d = h->data;
+	int boot = cold || panicstr != NULL;
+	uint64_t start = boot ? 0 : nsecuptime();
+	unsigned int i;
+
+	__atomic_store_n(&d->lock_ap, 1, __ATOMIC_RELAXED);
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	/* Check for acquisition before the deadline: a delayed wake cannot
+	 * determine whether firmware released before or after the deadline. */
+	for (i = 0; i < 100000; i++) {
+		if (__atomic_load_n(&d->lock_fw, __ATOMIC_RELAXED) == 0) {
+			__atomic_thread_fence(__ATOMIC_ACQUIRE);
+			return 0;
+		}
+		if (__atomic_load_n(&d->turn, __ATOMIC_RELAXED) != 0) {
+			__atomic_store_n(&d->lock_ap, 0, __ATOMIC_RELAXED);
+			/* Firmware may withdraw without changing its turn.  Reassert
+			 * AP intent and recheck both sides before entering. */
+			while (i < 100000 &&
+			    __atomic_load_n(&d->turn, __ATOMIC_RELAXED) != 0 &&
+			    __atomic_load_n(&d->lock_fw, __ATOMIC_RELAXED) != 0) {
+				if (!boot && !cold && panicstr == NULL && i >= 100) {
+					if (nsecuptime() - start >= SEC_TO_NSEC(1))
+						goto timeout;
+					(void)tsleep_nsec(&nowake, PWAIT, "agxuat",
+					    MSEC_TO_NSEC(1));
+				} else
+					delay(10);
+				i++;
+			}
+			__atomic_store_n(&d->lock_ap, 1, __ATOMIC_RELAXED);
+			__atomic_thread_fence(__ATOMIC_SEQ_CST);
+			continue;
+		}
+		/* With our turn, keep the intent flag set so firmware cannot
+		 * repeatedly reacquire ahead of us.  No lock is held yet. */
+		if (!boot && !cold && panicstr == NULL && i >= 100) {
+			if (nsecuptime() - start >= SEC_TO_NSEC(1))
+				goto timeout;
+			(void)tsleep_nsec(&nowake, PWAIT, "agxuat",
+			    MSEC_TO_NSEC(1));
+		} else
+			delay(10);
+	}
+timeout:
+	__atomic_store_n(&d->lock_ap, 0, __ATOMIC_RELEASE);
+	return ETIMEDOUT;
+}
+
+static void
+agx_uat_handoff_unlock(struct agx_uat_handoff *h)
+{
+	__atomic_store_n(&h->data->turn, 1, __ATOMIC_RELAXED);
+	__atomic_store_n(&h->data->lock_ap, 0, __ATOMIC_RELEASE);
+}
+
+/*
+ * A VM owns a private lower root whose leaves are all non-global. Pin the
+ * TTBs against AP slot recycling and firmware handoff through invalidation.
+ * Never wait for either lock while holding the PT lock: fault inspection has
+ * the reverse order and nonblocking mutations must remain nonblocking.
+ * Kernel/boot roots and uncertain ownership retain the global path.
+ *
+ * A detached root needs only completed stores: slot reassignment invalidates
+ * its former ASID before releasing h->lock, and later publication invalidates
+ * the new ASID before allowing jobs. Firmware data-cache flush and detach are
+ * separate protocols and remain required.
+ */
+static void
+agx_uat_pt_tlbi(struct agx_uat_pt *pt, uint64_t va, uint64_t size)
+{
+	struct agx_uat_handoff *h = pt->handoff;
+	uint64_t mask = 0, ttb0, ttb1, pos, root = pt->root->pa;
+	const uint64_t ttbr_pa_mask = ((1ULL << 48) - 1) & ~AGX_PAGE_MASK;
+	unsigned int i;
+	int locked = 0;
+
+	/* Bound per-page TLBI work; large ranges retain the global path. */
+	if (size > 64 * AGX_PAGE_SIZE)
+		goto global;
+	if (h == NULL || pt->kernel ||
+	    rw_enter(&h->lock, RW_WRITE | RW_NOSLEEP) != 0)
+		goto global;
+	if (!h->started || h->stopped ||
+	    __atomic_load_n(&h->poisoned, __ATOMIC_ACQUIRE))
+		goto unlock_global;
+	/* One-shot Dekker acquisition, like slot_forget_try. */
+	__atomic_store_n(&h->data->lock_ap, 1, __ATOMIC_RELAXED);
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	locked = 1;
+	if (__atomic_load_n(&h->data->lock_fw, __ATOMIC_RELAXED) != 0)
+		goto unlock_global;
+	__atomic_thread_fence(__ATOMIC_ACQUIRE);
+	for (i = 0; i < UAT_CONTEXTS; i++) {
+		ttb0 = __atomic_load_n(&h->ttbs[i].ttb0, __ATOMIC_ACQUIRE);
+		ttb1 = __atomic_load_n(&h->ttbs[i].ttb1, __ATOMIC_ACQUIRE);
+		/* An upper alias could contain global entries. */
+		if ((ttb1 & UAT_TTBR_VALID) && (ttb1 & ttbr_pa_mask) == root)
+			goto unlock_global;
+		if ((ttb0 & UAT_TTBR_VALID) && (ttb0 & ttbr_pa_mask) == root) {
+			if (i == 0 || h->slots[i].owner == NULL ||
+			    h->slots[i].root != root || ttb0 !=
+			    (root | UAT_TTBR_VALID | ((uint64_t)i << 48)))
+				goto unlock_global;
+			mask |= 1ULL << i;
+		} else if (i != 0 && h->slots[i].owner != NULL &&
+		    h->slots[i].root == root)
+			goto unlock_global;
+	}
+	agx_tlbi_sync();
+	for (i = 1; i < UAT_CONTEXTS; i++)
+		if (mask & (1ULL << i))
+			for (pos = 0; pos < size; pos += AGX_PAGE_SIZE)
+				agx_tlbi_page(i, va + pos);
+	agx_tlbi_sync();
+	agx_uat_handoff_unlock(h);
+	rw_exit_write(&h->lock);
+	return;
+unlock_global:
+	if (locked)
+		agx_uat_handoff_unlock(h);
+	rw_exit_write(&h->lock);
+global:
+	agx_tlbi_sync();
+	agx_tlbi_all();
+	agx_tlbi_sync();
+}
+
+static int
+agx_uat_root_valid(paddr_t root, unsigned int oas)
+{
+	return (root & AGX_PAGE_MASK) == 0 && root < (1ULL << oas);
+}
+
+int
+agx_uat_handoff_create(bus_space_tag_t iot, paddr_t handoff_pa,
+    size_t handoff_size, paddr_t ttbs_pa, size_t ttbs_size,
+    unsigned int oas, int map_kernel_to_user, struct agx_uat_handoff **out)
+{
+	struct agx_uat_handoff *h;
+	int error;
+
+	if (iot == NULL || out == NULL || !AGX_UAT_OAS_VALID(oas) ||
+	    (map_kernel_to_user != 0 && map_kernel_to_user != 1) ||
+	    handoff_size < sizeof(*h->data) ||
+	    ttbs_size < UAT_CONTEXTS * sizeof(*h->ttbs) ||
+	    (handoff_pa & 7) != 0 || (ttbs_pa & 7) != 0 ||
+	    handoff_pa > (paddr_t)-1 - sizeof(*h->data) ||
+	    ttbs_pa > (paddr_t)-1 - UAT_CONTEXTS * sizeof(*h->ttbs))
+		return EINVAL;
+	*out = NULL;
+	h = malloc(sizeof(*h), M_DEVBUF, M_WAITOK | M_ZERO);
+	h->iot = iot;
+	h->oas = oas;
+	h->map_kernel_to_user = map_kernel_to_user;
+	rw_init(&h->lock, "agxhnd");
+	mtx_init(&h->reclaim_mtx, IPL_HIGH);
+	error = bus_space_map(iot, handoff_pa, sizeof(*h->data),
+	    BUS_SPACE_MAP_PREFETCHABLE, &h->handoff_io);
+	if (error != 0)
+		goto free_h;
+	error = bus_space_map(iot, ttbs_pa, UAT_CONTEXTS * sizeof(*h->ttbs),
+	    BUS_SPACE_MAP_PREFETCHABLE, &h->ttbs_io);
+	if (error != 0)
+		goto unmap_handoff;
+	h->data = bus_space_vaddr(iot, h->handoff_io);
+	h->ttbs = bus_space_vaddr(iot, h->ttbs_io);
+	if (h->data == NULL || h->ttbs == NULL) {
+		error = EIO;
+		bus_space_unmap(iot, h->ttbs_io,
+		    UAT_CONTEXTS * sizeof(*h->ttbs));
+		goto unmap_handoff;
+	}
+	*out = h;
+	return 0;
+unmap_handoff:
+	bus_space_unmap(iot, h->handoff_io, sizeof(*h->data));
+free_h:
+	free(h, M_DEVBUF, sizeof(*h));
+	return error;
+}
+
+int
+agx_uat_handoff_start(struct agx_uat_handoff *h, paddr_t lower,
+    paddr_t upper)
+{
+	unsigned int i;
+	int error = ETIMEDOUT;
+
+	if (h == NULL || !agx_uat_root_valid(lower, h->oas) ||
+	    !agx_uat_root_valid(upper, h->oas))
+		return EINVAL;
+	rw_enter_write(&h->lock);
+	if (h->started || h->stopped ||
+	    __atomic_load_n(&h->poisoned, __ATOMIC_ACQUIRE)) {
+		error = EBUSY;
+		goto out;
+	}
+	__atomic_store_n(&h->data->magic_ap, UAT_HANDOFF_MAGIC, __ATOMIC_RELAXED);
+	__atomic_store_n(&h->data->cur_slot, 0, __ATOMIC_RELAXED);
+	__atomic_store_n(&h->data->unk2, 0, __ATOMIC_RELAXED);
+	__atomic_store_n(&h->data->unk3, 0, __ATOMIC_RELAXED);
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	for (i = 0; i < 100; i++) {
+		error = agx_uat_handoff_lock(h);
+		if (error != 0)
+			goto out;
+		if (__atomic_load_n(&h->data->magic_fw, __ATOMIC_RELAXED) ==
+		    UAT_HANDOFF_MAGIC)
+			break;
+		agx_uat_handoff_unlock(h);
+		if (cold)
+			delay(10000);
+		else
+			(void)tsleep_nsec(h, PWAIT, "agxready", MSEC_TO_NSEC(10));
+	}
+	if (i == 100) {
+		error = ETIMEDOUT;
+		goto out;
+	}
+	for (i = 0; i <= UAT_CONTEXTS; i++) {
+		__atomic_store_n(&h->data->flush[i].state, 0, __ATOMIC_RELAXED);
+		__atomic_store_n(&h->data->flush[i].addr, 0, __ATOMIC_RELAXED);
+		__atomic_store_n(&h->data->flush[i].size, 0, __ATOMIC_RELAXED);
+	}
+	for (i = 1; i < UAT_CONTEXTS; i++) {
+		__atomic_store_n(&h->ttbs[i].ttb0, 0, __ATOMIC_RELAXED);
+		__atomic_store_n(&h->ttbs[i].ttb1, 0, __ATOMIC_RELAXED);
+	}
+	/* Do not publish either root after poison has won admission. */
+	mtx_enter(&h->reclaim_mtx);
+	if (__atomic_load_n(&h->poisoned, __ATOMIC_ACQUIRE)) {
+		mtx_leave(&h->reclaim_mtx);
+		agx_uat_handoff_unlock(h);
+		error = EIO;
+		goto out;
+	}
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	__atomic_store_n(&h->ttbs[0].ttb0, lower | UAT_TTBR_VALID,
+	    __ATOMIC_SEQ_CST);
+	__atomic_store_n(&h->ttbs[0].ttb1, upper | UAT_TTBR_VALID,
+	    __ATOMIC_SEQ_CST);
+	h->kernel_ttb1 = upper;
+	h->started = 1;
+	mtx_leave(&h->reclaim_mtx);
+	agx_uat_handoff_unlock(h);
+	error = 0;
+out:
+	rw_exit_write(&h->lock);
+	return error;
+}
+
+int
+agx_uat_handoff_stop(struct agx_uat_handoff *h)
+{
+	unsigned int i;
+
+	if (h == NULL)
+		return EINVAL;
+	/* This is valid only after firmware and GPU have stopped. */
+	rw_enter_write(&h->lock);
+	for (i = 1; i < UAT_CONTEXTS; i++) {
+		if (h->slots[i].users != 0) {
+			rw_exit_write(&h->lock);
+			return EBUSY;
+		}
+	}
+	h->stopped = 1;
+	for (i = 0; i < UAT_CONTEXTS; i++) {
+		__atomic_store_n(&h->ttbs[i].ttb0, 0, __ATOMIC_RELEASE);
+		__atomic_store_n(&h->ttbs[i].ttb1, 0, __ATOMIC_RELEASE);
+	}
+	agx_tlbi_sync();
+	agx_tlbi_all();
+	agx_tlbi_sync();
+	rw_exit_write(&h->lock);
+	wakeup(h);
+	return 0;
+}
+
+int
+agx_uat_handoff_is_stopped(struct agx_uat_handoff *h)
+{
+	int stopped;
+
+	if (h == NULL)
+		return 0;
+	rw_enter_read(&h->lock);
+	stopped = h->stopped;
+	rw_exit_read(&h->lock);
+	return stopped;
+}
+
+int
+agx_uat_handoff_destroy(struct agx_uat_handoff *h)
+{
+	if (h == NULL)
+		return EINVAL;
+	/* The owner must exclude new VM creation before calling destroy. */
+	rw_enter_write(&h->lock);
+	if (h->vm_count != 0 || (h->started && !h->stopped)) {
+		rw_exit_write(&h->lock);
+		return EBUSY;
+	}
+	rw_exit_write(&h->lock);
+	bus_space_unmap(h->iot, h->ttbs_io, UAT_CONTEXTS * sizeof(*h->ttbs));
+	bus_space_unmap(h->iot, h->handoff_io, sizeof(*h->data));
+	free(h, M_DEVBUF, sizeof(*h));
+	return 0;
+}
+
+int
+agx_uat_slot_bind(struct agx_uat_handoff *h, const void *owner, paddr_t root,
+    uint32_t *slotp)
+{
+	struct agx_uat_slot *slot;
+	uint64_t oldest = UINT64_MAX;
+	uint32_t current, selected = 0, i;
+	int error;
+
+	if (h == NULL || owner == NULL || slotp == NULL ||
+	    !agx_uat_root_valid(root, h->oas))
+		return EINVAL;
+	rw_enter_write(&h->lock);
+	if (!h->started || h->stopped ||
+	    __atomic_load_n(&h->poisoned, __ATOMIC_ACQUIRE)) {
+		error = EIO;
+		goto out;
+	}
+	for (i = 1; i < UAT_CONTEXTS; i++) {
+		if (h->slots[i].owner == owner) {
+			if (h->slots[i].root != root ||
+			    h->slots[i].users == UINT_MAX) {
+				error = EINVAL;
+				goto out;
+			}
+			mtx_enter(&h->reclaim_mtx);
+			if (__atomic_load_n(&h->poisoned, __ATOMIC_ACQUIRE))
+				error = EIO;
+			else {
+				h->slots[i].users++;
+				*slotp = i;
+				error = 0;
+			}
+			mtx_leave(&h->reclaim_mtx);
+			goto out;
+		}
+	}
+	error = agx_uat_handoff_lock(h);
+	if (error != 0)
+		goto out;
+	current = __atomic_load_n(&h->data->cur_slot, __ATOMIC_RELAXED);
+	for (i = 1; i < UAT_CONTEXTS; i++) {
+		slot = &h->slots[i];
+		if (slot->users == 0 && i != current &&
+		    (selected == 0 || slot->age < oldest)) {
+			selected = i;
+			oldest = slot->age;
+		}
+	}
+	if (selected == 0) {
+		agx_uat_handoff_unlock(h);
+		error = EBUSY;
+		goto out;
+	}
+	/* Publish a new slot only if poison has not won the admission race. */
+	mtx_enter(&h->reclaim_mtx);
+	if (__atomic_load_n(&h->poisoned, __ATOMIC_ACQUIRE)) {
+		mtx_leave(&h->reclaim_mtx);
+		agx_uat_handoff_unlock(h);
+		error = EIO;
+		goto out;
+	}
+	__atomic_store_n(&h->ttbs[selected].ttb0,
+	    root | UAT_TTBR_VALID | ((uint64_t)selected << 48), __ATOMIC_RELEASE);
+	/* G14X scenes require the kernel upper table in user slots. */
+	__atomic_store_n(&h->ttbs[selected].ttb1, h->map_kernel_to_user ?
+	    h->kernel_ttb1 | UAT_TTBR_VALID | ((uint64_t)selected << 48) : 0,
+	    __ATOMIC_RELEASE);
+	slot = &h->slots[selected];
+	slot->owner = owner;
+	slot->root = root;
+	slot->users = 1;
+	slot->age = ++h->age;
+	mtx_leave(&h->reclaim_mtx);
+	agx_uat_handoff_unlock(h);
+	agx_tlbi_sync();
+	agx_tlbi_asid(selected);
+	agx_tlbi_sync();
+	/* A failure observed before return must not admit a new job. */
+	if (__atomic_load_n(&h->poisoned, __ATOMIC_ACQUIRE)) {
+		slot->users = 0;
+		error = EIO;
+		goto out;
+	}
+	*slotp = selected;
+	error = 0;
+out:
+	rw_exit_write(&h->lock);
+	return error;
+}
+
+int
+agx_uat_slot_unbind(struct agx_uat_handoff *h, const void *owner)
+{
+	unsigned int i;
+	int error = EINVAL;
+
+	if (h == NULL || owner == NULL)
+		return EINVAL;
+	rw_enter_write(&h->lock);
+	for (i = 1; i < UAT_CONTEXTS; i++) {
+		if (h->slots[i].owner == owner && h->slots[i].users != 0) {
+			h->slots[i].users--;
+			h->slots[i].age = ++h->age;
+			error = 0;
+			break;
+		}
+	}
+	rw_exit_write(&h->lock);
+	return error;
+}
+
+/* Reclamation is optional: never spin on the firmware handoff lock. */
+static int
+agx_uat_slot_forget_try(struct agx_uat_handoff *h, const void *owner)
+{
+	unsigned int i;
+	int error = 0;
+
+	if (rw_enter(&h->lock, RW_WRITE | RW_NOSLEEP) != 0)
+		return EBUSY;
+	if (__atomic_load_n(&h->poisoned, __ATOMIC_ACQUIRE) && !h->stopped) {
+		error = EIO;
+		goto out;
+	}
+	for (i = 1; i < UAT_CONTEXTS; i++)
+		if (h->slots[i].owner == owner)
+			break;
+	if (i == UAT_CONTEXTS)
+		goto approve;
+	if (h->slots[i].users != 0) {
+		error = EBUSY;
+		goto out;
+	}
+	if (!h->stopped) {
+		/* A one-shot Dekker attempt: back off if firmware is interested. */
+		__atomic_store_n(&h->data->lock_ap, 1, __ATOMIC_RELAXED);
+		__atomic_thread_fence(__ATOMIC_SEQ_CST);
+		if (__atomic_load_n(&h->data->lock_fw, __ATOMIC_RELAXED) != 0) {
+			agx_uat_handoff_unlock(h);
+			error = EBUSY;
+			goto out;
+		}
+		__atomic_thread_fence(__ATOMIC_ACQUIRE);
+		if (__atomic_load_n(&h->data->cur_slot, __ATOMIC_RELAXED) == i) {
+			agx_uat_handoff_unlock(h);
+			error = EBUSY;
+			goto out;
+		}
+		__atomic_store_n(&h->ttbs[i].ttb0, 0, __ATOMIC_RELEASE);
+		__atomic_store_n(&h->ttbs[i].ttb1, 0, __ATOMIC_RELEASE);
+		agx_uat_handoff_unlock(h);
+		agx_tlbi_sync();
+		agx_tlbi_asid(i);
+		agx_tlbi_sync();
+	}
+approve:
+	/* VM lock keeps this approved, detached root unpublished until done. */
+	mtx_enter(&h->reclaim_mtx);
+	if (__atomic_load_n(&h->poisoned, __ATOMIC_ACQUIRE) && !h->stopped)
+		error = EIO;
+	else if (i != UAT_CONTEXTS)
+		memset(&h->slots[i], 0, sizeof(h->slots[i]));
+	mtx_leave(&h->reclaim_mtx);
+out:
+	rw_exit_write(&h->lock);
+	return error;
+}
+
+int
+agx_uat_handoff_flush(struct agx_uat_handoff *h, uint32_t slot, uint64_t va,
+    uint64_t size, agx_uat_flush_fn flush, void *cookie)
+{
+	struct agx_uat_flush_info *f;
+	int error;
+
+	if (h == NULL || flush == NULL || slot == 0 || slot > UAT_CONTEXTS || size == 0 ||
+	    ((va | size) & AGX_PAGE_MASK) != 0 ||
+	    (size >> AGX_PAGE_SHIFT) > UINT16_MAX || va > UINT64_MAX - size)
+		return EINVAL;
+	rw_enter_write(&h->lock);
+	if (!h->started || h->stopped ||
+	    __atomic_load_n(&h->poisoned, __ATOMIC_ACQUIRE)) {
+		error = EIO;
+		goto out;
+	}
+	if (slot < UAT_CONTEXTS) {
+		if (h->slots[slot].owner == NULL || h->slots[slot].users == 0) {
+			error = EINVAL;
+			goto out;
+		}
+		error = agx_uat_handoff_lock(h);
+		if (error != 0)
+			goto out;
+		if (__atomic_load_n(&h->data->cur_slot, __ATOMIC_RELAXED) != slot) {
+			/* Firmware flushes its cache on context switches. */
+			agx_uat_handoff_unlock(h);
+			error = 0;
+			goto out;
+		}
+		agx_uat_handoff_unlock(h);
+	}
+	/* h->lock pins the slot ownership through callback completion. */
+	f = &h->data->flush[slot];
+	if (__atomic_load_n(&f->state, __ATOMIC_ACQUIRE) != 0) {
+		error = EBUSY;
+		goto out;
+	}
+	__atomic_store_n(&f->addr, va, __ATOMIC_RELAXED);
+	__atomic_store_n(&f->size, size, __ATOMIC_RELAXED);
+	__atomic_store_n(&f->state, 1, __ATOMIC_RELEASE);
+	error = flush(cookie, va, size, slot);
+	if (error != 0 || __atomic_load_n(&f->state, __ATOMIC_ACQUIRE) != 2) {
+		agx_uat_handoff_poison(h);
+		if (error == 0)
+			error = EIO;
+		goto out;
+	}
+	__atomic_store_n(&f->state, 0, __ATOMIC_RELEASE);
+out:
+	rw_exit_write(&h->lock);
+	return error;
+}
+
+struct agx_vm_binding {
+	TAILQ_ENTRY(agx_vm_binding) link;
+	RB_ENTRY(agx_vm_binding) bo_link;
+	struct task retire_task;
+	const void *owner;
+	struct drm_gem_object *gem;
+	struct agx_mem *mem;
+	uint64_t va, size, offset;
+	uint64_t born_epoch;
+	enum agx_uat_gpu_prot prot;
+	int repeat;
+};
+TAILQ_HEAD(agx_vm_bindings, agx_vm_binding);
+RB_HEAD(agx_vm_bo_tree, agx_vm_binding);
+
+static int
+agx_vm_bo_compare(struct agx_vm_binding *a, struct agx_vm_binding *b)
+{
+	uintptr_t x, y;
+
+	x = (uintptr_t)a->gem; y = (uintptr_t)b->gem;
+	if (x != y)
+		return x < y ? -1 : 1;
+	x = (uintptr_t)a->mem; y = (uintptr_t)b->mem;
+	if (x != y)
+		return x < y ? -1 : 1;
+	x = (uintptr_t)a; y = (uintptr_t)b;
+	return (x > y) - (x < y);
+}
+
+RB_PROTOTYPE_STATIC(agx_vm_bo_tree, agx_vm_binding, bo_link,
+    agx_vm_bo_compare);
+RB_GENERATE_STATIC(agx_vm_bo_tree, agx_vm_binding, bo_link,
+    agx_vm_bo_compare);
+
+struct agx_vm_snapshot_cache {
+	struct task retire_task;
+	struct agx_vm_snapshot_entry *entries;
+	size_t count;
+	unsigned int refs;
+};
+
+struct agx_vm {
+	struct rwlock lock;
+	struct agx_uat_handoff *handoff;
+	struct agx_uat_pt *pt;
+	struct agx_mem *dummy;
+	struct dma_resv resv;
+	struct timeout reap_timeout;
+	struct task reap_task;
+	struct timeout reclaim_timeout;
+	struct task reclaim_task;
+	uint64_t reclaim_generation, reclaim_pass;
+	unsigned int reclaim_cursor, reclaim_backoff;
+	int reclaim_armed;
+	struct agx_vm_bindings mappings;
+	/* Same bindings, ordered by GEM, mem and binding address, under lock. */
+	struct agx_vm_bo_tree bo_mappings;
+	struct agx_vm_snapshot_cache *snapshot;
+	uint64_t active_epoch;
+	uint64_t kernel_start, kernel_end;
+	unsigned int refs, active, tails, mutators;
+	int retired, closing;
+};
+
+/* User UAT is 39 bits: eight root entries, each with 2048 leaves. */
+#define UAT_RECLAIM_ROOTS (1U << (39 - AGX_PAGE_SHIFT - 22))
+#define UAT_RECLAIM_LEAVES 16
+
+static int
+agx_uat_node_empty(struct agx_uat_node *node)
+{
+	unsigned int i;
+
+	if (node == NULL || node->mem == NULL)
+		return 0;
+	for (i = 0; i < UAT_NPTE / 64; i++)
+		if (node->owned[i] != 0 || node->cache_pending[i] != 0)
+			return 0;
+	for (i = 0; i < UAT_NPTE; i++)
+		if (__atomic_load_n(&node->entries[i], __ATOMIC_ACQUIRE) != 0 ||
+		    (node->children != NULL && node->children[i] != NULL))
+			return 0;
+	return 1;
+}
+
+/* Avoid evicting a VM slot when this bounded scan finds no empty table. */
+static int
+agx_vm_reclaim_probe(struct agx_vm *vm)
+{
+	struct agx_uat_pt *pt = vm->pt;
+	struct agx_uat_node *root = pt->root, *mid, *leaf;
+	unsigned int rootidx, mididx, examined = 0;
+	int found = 0;
+
+	rw_enter_read(&pt->lock);
+	while (vm->reclaim_cursor < UAT_RECLAIM_ROOTS * UAT_NPTE) {
+		rootidx = vm->reclaim_cursor / UAT_NPTE;
+		mididx = vm->reclaim_cursor % UAT_NPTE;
+		mid = root->children[rootidx];
+		if (mid == NULL || mid->mem == NULL || mid->children == NULL ||
+		    __atomic_load_n(&root->entries[rootidx], __ATOMIC_ACQUIRE) !=
+		    (mid->pa | UAT_TABLE)) {
+			vm->reclaim_cursor = (rootidx + 1) * UAT_NPTE;
+			continue;
+		}
+		leaf = mid->children[mididx];
+		if (leaf != NULL) {
+			examined++;
+			if (leaf->children == NULL && agx_uat_node_empty(leaf) &&
+			    __atomic_load_n(&mid->entries[mididx], __ATOMIC_ACQUIRE) ==
+			    (leaf->pa | UAT_TABLE)) {
+				found = 1;
+				break;
+			}
+		}
+		if (mididx == UAT_NPTE - 1 && agx_uat_node_empty(mid)) {
+			found = 1;
+			break;
+		}
+		vm->reclaim_cursor++;
+		if (examined == UAT_RECLAIM_LEAVES)
+			break;
+	}
+	rw_exit_read(&pt->lock);
+	return found;
+}
+
+/* The caller holds vm->lock and has detached this VM's hardware slot. */
+static int
+agx_vm_reclaim_batch(struct agx_vm *vm)
+{
+	struct agx_uat_pt *pt = vm->pt;
+	struct agx_uat_node *root = pt->root, *mid, *leaf, *list = NULL, *next;
+	unsigned int rootidx, mididx, examined = 0;
+
+	KASSERT(!pt->kernel);
+	rw_enter_write(&pt->lock);
+	while (vm->reclaim_cursor < UAT_RECLAIM_ROOTS * UAT_NPTE) {
+		rootidx = vm->reclaim_cursor / UAT_NPTE;
+		mididx = vm->reclaim_cursor % UAT_NPTE;
+		mid = root->children[rootidx];
+		if (mid == NULL || mid->mem == NULL || mid->children == NULL ||
+		    __atomic_load_n(&root->entries[rootidx], __ATOMIC_ACQUIRE) !=
+		    (mid->pa | UAT_TABLE)) {
+			vm->reclaim_cursor = (rootidx + 1) * UAT_NPTE;
+			continue;
+		}
+		vm->reclaim_cursor++;
+		leaf = mid->children[mididx];
+		if (leaf != NULL) {
+			examined++;
+			if (leaf->children == NULL && agx_uat_node_empty(leaf) &&
+			    __atomic_load_n(&mid->entries[mididx], __ATOMIC_ACQUIRE) ==
+			    (leaf->pa | UAT_TABLE)) {
+				__atomic_store_n(&mid->entries[mididx], 0, __ATOMIC_RELEASE);
+				mid->children[mididx] = NULL;
+				leaf->reclaim_next = list;
+				list = leaf;
+			}
+		}
+		if (mididx == UAT_NPTE - 1 && agx_uat_node_empty(mid)) {
+			__atomic_store_n(&root->entries[rootidx], 0, __ATOMIC_RELEASE);
+			root->children[rootidx] = NULL;
+			mid->reclaim_next = list;
+			list = mid;
+		}
+		if (examined == UAT_RECLAIM_LEAVES)
+			break;
+	}
+	if (list != NULL) {
+		/* Match the existing VM teardown's all-level invalidation. */
+		agx_tlbi_sync();
+		agx_tlbi_all();
+		agx_tlbi_sync();
+	}
+	rw_exit_write(&pt->lock);
+	while (list != NULL) {
+		next = list->reclaim_next;
+		agx_uat_node_free(list);
+		list = next;
+	}
+	return vm->reclaim_cursor == UAT_RECLAIM_ROOTS * UAT_NPTE;
+}
+
+static void
+agx_vm_reclaim_timeout(void *arg)
+{
+	struct agx_vm *vm = arg;
+
+	task_add(systqmp, &vm->reclaim_task);
+}
+
+/* vm->lock protects both the worker reference and request generation. */
+static void
+agx_vm_reclaim_request(struct agx_vm *vm)
+{
+	if (vm->closing || vm->retired)
+		return;
+	vm->reclaim_generation++;
+	if (vm->reclaim_armed || vm->refs == UINT_MAX)
+		return;
+	vm->refs++;
+	vm->reclaim_armed = 1;
+	vm->reclaim_cursor = 0;
+	vm->reclaim_pass = vm->reclaim_generation;
+	vm->reclaim_backoff = 100;
+	timeout_add_msec(&vm->reclaim_timeout, vm->reclaim_backoff);
+}
+
+static void
+agx_vm_reclaim_task(void *arg)
+{
+	struct agx_vm *vm = arg;
+	int error, done;
+
+	rw_enter_write(&vm->lock);
+	/* The worker's reference alone must never keep an idle VM alive. */
+	if (vm->refs == 1 || vm->closing ||
+	    (__atomic_load_n(&vm->handoff->poisoned, __ATOMIC_ACQUIRE) &&
+	    !agx_uat_handoff_is_stopped(vm->handoff)))
+		goto release;
+	if (vm->active || vm->tails || vm->mutators)
+		goto retry;
+	if (vm->reclaim_pass != vm->reclaim_generation) {
+		vm->reclaim_cursor = 0;
+		vm->reclaim_pass = vm->reclaim_generation;
+	}
+	if (!agx_vm_reclaim_probe(vm)) {
+		if (vm->reclaim_cursor == UAT_RECLAIM_ROOTS * UAT_NPTE)
+			goto release;
+		goto continue_scan;
+	}
+	error = agx_uat_slot_forget_try(vm->handoff, vm);
+	if (error == EIO)
+		goto release;
+	if (error != 0)
+		goto retry;
+	done = agx_vm_reclaim_batch(vm);
+	if (done)
+		goto release;
+continue_scan:
+	vm->reclaim_backoff = 100;
+	timeout_add_msec(&vm->reclaim_timeout, 1);
+	rw_exit_write(&vm->lock);
+	return;
+retry:
+	timeout_add_msec(&vm->reclaim_timeout, vm->reclaim_backoff);
+	vm->reclaim_backoff = MIN(vm->reclaim_backoff * 2, 5000U);
+	rw_exit_write(&vm->lock);
+	return;
+release:
+	vm->reclaim_armed = 0;
+	rw_exit_write(&vm->lock);
+	(void)agx_vm_put(vm);
+}
+
+/* The handoff read lock pins the slot owner.  VM lock ordering is inverted
+ * here, so both locks are strictly try-only and no pointers escape. */
+int
+agx_uat_fault_snapshot(struct agx_uat_handoff *h, uint32_t slot, uint64_t va,
+    struct agx_uat_fault_snapshot *out)
+{
+	struct agx_vm *vm;
+	struct agx_vm_binding *b;
+
+	if (h == NULL || out == NULL || slot == 0 || slot >= UAT_CONTEXTS)
+		return EINVAL;
+	memset(out, 0, sizeof(*out));
+	if (rw_enter(&h->lock, RW_READ | RW_NOSLEEP) != 0)
+		return EBUSY;
+	vm = (struct agx_vm *)h->slots[slot].owner;
+	if (vm == NULL) {
+		rw_exit_read(&h->lock);
+		return ENOENT;
+	}
+	if (rw_enter(&vm->lock, RW_READ | RW_NOSLEEP) != 0) {
+		rw_exit_read(&h->lock);
+		return EBUSY;
+	}
+	out->slot_age = h->slots[slot].age;
+	out->slot_users = h->slots[slot].users;
+	out->active = vm->active;
+	out->tails = vm->tails;
+	out->mutators = vm->mutators;
+	out->closing = vm->closing;
+	out->kernel_start = vm->kernel_start;
+	out->kernel_end = vm->kernel_end;
+	TAILQ_FOREACH(b, &vm->mappings, link) {
+		if (out->mappings == 512) {
+			out->truncated = 1;
+			break;
+		}
+		out->mappings++;
+		if (b->va <= va) {
+			out->prev_start = b->va;
+			out->prev_end = b->va + b->size;
+			out->prev_valid = 1;
+		} else {
+			out->next_start = b->va;
+			out->next_end = b->va + b->size;
+			out->next_valid = 1;
+			break;
+		}
+	}
+	rw_exit_read(&vm->lock);
+	rw_exit_read(&h->lock);
+	return 0;
+}
+/* Snapshot pins may be released from nonblocking mutation paths. */
+static void
+agx_vm_snapshot_retire(void *arg)
+{
+	struct agx_vm_snapshot_cache *cache = arg;
+	size_t i;
+
+	for (i = 0; i < cache->count; i++) {
+		agx_mem_retire_end(cache->entries[i].mem);
+		drm_gem_object_put(cache->entries[i].gem);
+	}
+	if (cache->entries != NULL)
+		free(cache->entries, M_DEVBUF,
+		    cache->count * sizeof(*cache->entries));
+	free(cache, M_DEVBUF, sizeof(*cache));
+}
+
+static void
+agx_vm_snapshot_put(struct agx_vm_snapshot_cache *cache)
+{
+	size_t i;
+
+	if (cache == NULL ||
+	    __atomic_sub_fetch(&cache->refs, 1, __ATOMIC_ACQ_REL) != 0)
+		return;
+	for (i = 0; i < cache->count; i++)
+		agx_mem_retire_begin(cache->entries[i].mem);
+	task_add(systq, &cache->retire_task);
+}
+
+/* VM lock serializes cache publication and invalidation. */
+static void
+agx_vm_snapshot_invalidate(struct agx_vm *vm)
+{
+	struct agx_vm_snapshot_cache *cache = vm->snapshot;
+
+	vm->snapshot = NULL;
+	agx_vm_snapshot_put(cache);
+}
+
+
+static void
+agx_vm_free(struct agx_vm *vm)
+{
+	struct agx_uat_handoff *h = vm->handoff;
+	struct agx_vm_binding *binding;
+
+	agx_vm_snapshot_invalidate(vm);
+	dma_resv_fini(&vm->resv);
+	agx_uat_pt_destroy(vm->pt);
+	agx_mem_free(vm->dummy);
+	while ((binding = TAILQ_FIRST(&vm->mappings)) != NULL) {
+		TAILQ_REMOVE(&vm->mappings, binding, link);
+		RB_REMOVE(agx_vm_bo_tree, &vm->bo_mappings, binding);
+		agx_mem_unpin(binding->mem);
+		drm_gem_object_put(binding->gem);
+		free(binding, M_DEVBUF, sizeof(*binding));
+	}
+	rw_enter_write(&h->lock);
+	h->vm_count--;
+	rw_exit_write(&h->lock);
+	free(vm, M_DEVBUF, sizeof(*vm));
+}
+
+static void
+agx_vm_reap_task(void *arg)
+{
+	struct agx_vm *vm = arg;
+
+	if (agx_uat_slot_forget_try(vm->handoff, vm) != 0) {
+		timeout_add_msec(&vm->reap_timeout, 100);
+		return;
+	}
+	agx_vm_free(vm);
+}
+
+static void
+agx_vm_reap_timeout(void *arg)
+{
+	struct agx_vm *vm = arg;
+
+	task_add(systq, &vm->reap_task);
+}
+
+int
+agx_vm_create(struct agx_uat_handoff *handoff, bus_dma_tag_t dmat,
+    uint64_t start, uint64_t end, struct agx_vm **out)
+{
+	static struct timeval last_failure;
+	static const struct timeval log_interval = { 1, 0 };
+	const char *stage = "root";
+	struct agx_vm *vm;
+	int error;
+
+	if (handoff == NULL || dmat == NULL || out == NULL ||
+	    start < AGX_UAT_USER_BASE || end > AGX_UAT_USER_TOP || end <= start ||
+	    ((start | end) & AGX_PAGE_MASK) != 0 || end - start < 0x20000000)
+		return EINVAL;
+	*out = NULL;
+	rw_enter_write(&handoff->lock);
+	if (handoff->stopped || handoff->vm_count == UINT_MAX) {
+		rw_exit_write(&handoff->lock);
+		return EBUSY;
+	}
+	handoff->vm_count++;
+	rw_exit_write(&handoff->lock);
+	vm = malloc(sizeof(*vm), M_DEVBUF, M_WAITOK | M_ZERO);
+	rw_init(&vm->lock, "agxvm");
+	TAILQ_INIT(&vm->mappings);
+	RB_INIT(&vm->bo_mappings);
+	dma_resv_init(&vm->resv);
+	timeout_set(&vm->reap_timeout, agx_vm_reap_timeout, vm);
+	task_set(&vm->reap_task, agx_vm_reap_task, vm);
+	timeout_set(&vm->reclaim_timeout, agx_vm_reclaim_timeout, vm);
+	task_set(&vm->reclaim_task, agx_vm_reclaim_task, vm);
+	vm->handoff = handoff;
+	/* Buffer allocator ranges use the firmware's 32K granularity. */
+	vm->kernel_start = (start + 0x7fff) & ~0x7fffULL;
+	vm->kernel_end = end & ~0x7fffULL;
+	vm->refs = 1;
+	error = agx_uat_pt_create_vm(dmat, handoff->oas, handoff, &vm->pt);
+	if (error != 0)
+		goto free_vm;
+	vm->pt->handoff = handoff;
+	stage = "dummy backing";
+	error = agx_uat_create_mem(dmat, handoff->oas, 0, handoff, NULL,
+	    &vm->dummy);
+	if (error != 0)
+		goto free_pt;
+	stage = "dummy page tables";
+	error = agx_uat_pt_map_dummy_vm(vm->pt, vm->dummy, handoff);
+	if (error != 0)
+		goto free_dummy;
+	*out = vm;
+	return 0;
+free_dummy:
+	agx_mem_free(vm->dummy);
+free_pt:
+	agx_uat_pt_destroy(vm->pt);
+free_vm:
+	dma_resv_fini(&vm->resv);
+	rw_enter_write(&handoff->lock);
+	handoff->vm_count--;
+	rw_exit_write(&handoff->lock);
+	if (error != EINTR && error != ERESTART &&
+	    ratecheck(&last_failure, &log_interval))
+		printf("agx: VM_CREATE %s failed: %d\n", stage, error);
+	free(vm, M_DEVBUF, sizeof(*vm));
+	return error;
+}
+
+unsigned int
+agx_vm_oas(const struct agx_vm *vm)
+{
+	return vm->handoff->oas;
+}
+
+struct dma_resv *
+agx_vm_resv(struct agx_vm *vm)
+{
+	return vm == NULL ? NULL : &vm->resv;
+}
+
+int
+agx_vm_reset_proven(struct agx_vm *vm)
+{
+	return vm != NULL && agx_uat_handoff_is_stopped(vm->handoff);
+}
+
+int
+agx_vm_get(struct agx_vm *vm)
+{
+	int error = 0;
+
+	if (vm == NULL)
+		return EINVAL;
+	rw_enter_write(&vm->lock);
+	if (vm->retired || vm->refs == 0)
+		error = EINVAL;
+	else if (vm->refs == UINT_MAX)
+		error = EOVERFLOW;
+	else
+		vm->refs++;
+	rw_exit_write(&vm->lock);
+	return error;
+}
+
+int
+agx_vm_put(struct agx_vm *vm)
+{
+	int error;
+
+	if (vm == NULL)
+		return EINVAL;
+	rw_enter_write(&vm->lock);
+	if (vm->retired || vm->refs == 0) {
+		rw_exit_write(&vm->lock);
+		return EINVAL;
+	}
+	if (vm->refs > 1) {
+		vm->refs--;
+		rw_exit_write(&vm->lock);
+		return 0;
+	}
+	/* The root cannot be freed while firmware still selects its slot. */
+	error = agx_uat_slot_forget_try(vm->handoff, vm);
+	vm->refs = 0;
+	vm->retired = 1;
+	if (error != 0) {
+		/* Keep the root and backing until a later safe handoff or stop. */
+		timeout_add_msec(&vm->reap_timeout, 100);
+		rw_exit_write(&vm->lock);
+		return 0;
+	}
+	rw_exit_write(&vm->lock);
+	agx_vm_free(vm);
+	return 0;
+}
+
+int
+agx_vm_bind(struct agx_vm *vm, uint32_t *slot, const int *cancel,
+    const int *stopped)
+{
+	struct agx_vm_binding *b;
+	int error;
+
+	if (vm == NULL || slot == NULL)
+		return EINVAL;
+	rw_enter_write(&vm->lock);
+	for (;;) {
+		if (cancel != NULL &&
+		    (error = __atomic_load_n(cancel, __ATOMIC_ACQUIRE)) != 0)
+			goto out;
+		if (stopped != NULL &&
+		    __atomic_load_n(stopped, __ATOMIC_ACQUIRE)) {
+			error = ENODEV;
+			goto out;
+		}
+		if (__atomic_load_n(&vm->handoff->poisoned, __ATOMIC_ACQUIRE)) {
+			error = EIO;
+			goto out;
+		}
+		if (vm->mutators == 0)
+			break;
+		/* Cancellation has no wakeup; bound its observation latency. */
+		error = rwsleep_nsec(vm->handoff, &vm->lock, PWAIT | PCATCH,
+		    "agxvmb", 100000000ULL);
+		if (error != 0 && error != EWOULDBLOCK)
+			goto out;
+	}
+	if (vm->refs == UINT_MAX || vm->active == UINT_MAX) {
+		error = EOVERFLOW;
+		goto out;
+	}
+	error = agx_uat_slot_bind(vm->handoff, vm, agx_uat_pt_root(vm->pt), slot);
+	if (error == 0) {
+		if (vm->active == 0 && ++vm->active_epoch == 0) {
+			/* Rebase only when no executing bindings remain. */
+			TAILQ_FOREACH(b, &vm->mappings, link)
+				b->born_epoch = 0;
+			vm->active_epoch = 1;
+		}
+		vm->refs++;
+		vm->active++;
+	}
+out:
+	rw_exit_write(&vm->lock);
+	return error;
+}
+
+int
+agx_vm_unbind(struct agx_vm *vm)
+{
+	int error;
+
+	if (vm == NULL)
+		return EINVAL;
+	rw_enter_write(&vm->lock);
+	if (vm->active == 0) {
+		rw_exit_write(&vm->lock);
+		return EINVAL;
+	}
+	error = agx_uat_slot_unbind(vm->handoff, vm);
+	if (error == 0 && --vm->active == 0)
+		wakeup(vm->handoff);
+	rw_exit_write(&vm->lock);
+	return error != 0 ? error : agx_vm_put(vm);
+}
+
+int
+agx_vm_tail_pin(struct agx_vm *vm, uint32_t *slot)
+{
+	int error;
+
+	if (vm == NULL || slot == NULL)
+		return EINVAL;
+	rw_enter_write(&vm->lock);
+	/* An executing binding guarantees this owner already holds its slot. */
+	if (vm->active == 0) {
+		error = EINVAL;
+		goto out;
+	}
+	if (vm->refs == UINT_MAX || vm->tails == UINT_MAX) {
+		error = EOVERFLOW;
+		goto out;
+	}
+	error = agx_uat_slot_bind(vm->handoff, vm, agx_uat_pt_root(vm->pt), slot);
+	if (error == 0) {
+		vm->refs++;
+		vm->tails++;
+	}
+out:
+	rw_exit_write(&vm->lock);
+	return error;
+}
+
+int
+agx_vm_tail_unpin(struct agx_vm *vm)
+{
+	int error;
+
+	if (vm == NULL)
+		return EINVAL;
+	rw_enter_write(&vm->lock);
+	if (vm->tails == 0) {
+		rw_exit_write(&vm->lock);
+		return EINVAL;
+	}
+	error = agx_uat_slot_unbind(vm->handoff, vm);
+	if (error == 0)
+		vm->tails--;
+	rw_exit_write(&vm->lock);
+	return error != 0 ? error : agx_vm_put(vm);
+}
+
+static int
+agx_vm_user_range(struct agx_vm *vm, uint64_t va, uint64_t size)
+{
+	return agx_uat_range_valid(va, size) &&
+	    (va + size <= vm->kernel_start || va >= vm->kernel_end);
+}
+
+/* A running job can address any mapped BO, not just its explicit commands.
+ * New aliases are safe only when the same pair was mapped continuously since
+ * before this active cohort began, and is therefore in every job snapshot.
+ * Empty-range unmaps do not change any existing translation. */
+static int
+agx_vm_mutation_disjoint(struct agx_vm *vm, uint64_t va, uint64_t size,
+    struct drm_gem_object *gem, struct agx_mem *mem)
+{
+	struct agx_vm_binding *b;
+	int stable = gem == NULL;
+
+	if (size == 0)
+		return 0;
+	TAILQ_FOREACH(b, &vm->mappings, link) {
+		if (b->va < va + size && va < b->va + b->size)
+			return 0;
+		if (b->gem == gem && b->mem == mem &&
+		    b->born_epoch != vm->active_epoch)
+			stable = 1;
+	}
+	return stable;
+}
+
+/* The caller holds the VM and, if supplied, cancel ticket throughout. */
+static int
+agx_vm_mutation_enter_common(struct agx_vm *vm,
+    const volatile unsigned int *cancel, int user, int no_wait,
+    uint64_t va, uint64_t size, struct drm_gem_object *gem,
+    struct agx_mem *mem)
+{
+	int error;
+
+	if (no_wait) {
+		if (rw_enter(&vm->lock, RW_WRITE | RW_NOSLEEP) != 0)
+			return EAGAIN;
+	} else {
+		rw_enter_write(&vm->lock);
+	}
+	if (vm->mutators == UINT_MAX) {
+		rw_exit_write(&vm->lock);
+		return EOVERFLOW;
+	}
+	vm->mutators++;
+	for (;;) {
+		if (cancel != NULL &&
+		    __atomic_load_n(cancel, __ATOMIC_ACQUIRE) != 0) {
+			error = ECANCELED;
+			break;
+		}
+		if (user && vm->closing) {
+			error = ENOENT;
+			break;
+		}
+		if (__atomic_load_n(&vm->handoff->poisoned, __ATOMIC_ACQUIRE) &&
+		    !agx_uat_handoff_is_stopped(vm->handoff)) {
+			error = EIO;
+			break;
+		}
+		if (vm->active == 0 || (user &&
+		    agx_vm_mutation_disjoint(vm, va, size, gem, mem)))
+			return 0;
+		if (no_wait) {
+			error = EAGAIN;
+			break;
+		}
+		/* Ticket stores have no wakeup; the timeout bounds observation. */
+		error = rwsleep_nsec(vm->handoff, &vm->lock, PWAIT | PCATCH,
+		    "agxvmm", 100000000ULL);
+		if (error != 0 && error != EWOULDBLOCK)
+			break;
+	}
+	if (--vm->mutators == 0)
+		wakeup(vm->handoff);
+	rw_exit_write(&vm->lock);
+	return error;
+}
+
+static int
+agx_vm_mutation_enter(struct agx_vm *vm, const volatile unsigned int *cancel,
+    int user)
+{
+	return agx_vm_mutation_enter_common(vm, cancel, user, 0, 0, 0,
+	    NULL, NULL);
+}
+
+static void
+agx_vm_mutation_exit(struct agx_vm *vm)
+{
+	if (--vm->mutators == 0)
+		wakeup(vm->handoff);
+	rw_exit_write(&vm->lock);
+}
+
+static void
+agx_vm_binding_retire_task(void *arg)
+{
+	struct agx_vm_binding *b = arg;
+
+	agx_mem_retire_end(b->mem);
+	drm_gem_object_put(b->gem);
+	free(b, M_DEVBUF, sizeof(*b));
+}
+
+/* Called without the VM lock; a deferred task owns both pin and GEM. */
+static void
+agx_vm_binding_drop(struct agx_vm_binding *b, int no_wait)
+{
+	if (no_wait) {
+		agx_mem_retire_begin(b->mem);
+		task_add(systq, &b->retire_task);
+	} else {
+		agx_mem_unpin(b->mem);
+		drm_gem_object_put(b->gem);
+		free(b, M_DEVBUF, sizeof(*b));
+	}
+}
+
+static void
+agx_vm_bindings_drop(struct agx_vm_bindings *bindings, int no_wait)
+{
+	struct agx_vm_binding *b;
+
+	while ((b = TAILQ_FIRST(bindings)) != NULL) {
+		TAILQ_REMOVE(bindings, b, link);
+		agx_vm_binding_drop(b, no_wait);
+	}
+}
+
+/*
+ * Revoke user mappings without waiting for active jobs.  Their scheduler
+ * snapshots retain BO backing until actual retirement, even if a later GPU
+ * access faults.  The VM lock serializes this with snapshots and bind commits.
+ */
+static int
+agx_vm_revoke_matching(struct agx_vm *vm, const void *owner,
+    struct drm_gem_object *gem, int all)
+{
+	struct agx_vm_binding *b, *next;
+	struct agx_vm_bindings dead;
+	int error = 0, found = 0;
+
+	if (vm == NULL || (!all && (owner == NULL || gem == NULL)))
+		return EINVAL;
+	TAILQ_INIT(&dead);
+	rw_enter_write(&vm->lock);
+	if (all) {
+		vm->closing = 1;
+		wakeup(vm->handoff);
+	}
+	TAILQ_FOREACH(b, &vm->mappings, link) {
+		if (all || (b->owner == owner && b->gem == gem)) {
+			found = 1;
+			break;
+		}
+	}
+	if (!found)
+		goto out;
+	if (__atomic_load_n(&vm->handoff->poisoned, __ATOMIC_ACQUIRE) &&
+	    !agx_uat_handoff_is_stopped(vm->handoff)) {
+		error = EIO;
+		goto retain;
+	}
+	TAILQ_FOREACH(b, &vm->mappings, link) {
+		if (!all && (b->owner != owner || b->gem != gem))
+			continue;
+		error = agx_uat_pt_unmap(vm->pt, b->va, b->size);
+		if (error != 0) {
+			agx_uat_handoff_poison(vm->handoff);
+			goto retain;
+		}
+		agx_vm_reclaim_request(vm);
+	}
+	if (__atomic_load_n(&vm->handoff->poisoned, __ATOMIC_ACQUIRE) &&
+	    !agx_uat_handoff_is_stopped(vm->handoff)) {
+		error = EIO;
+		goto retain;
+	}
+	for (b = TAILQ_FIRST(&vm->mappings); b != NULL; b = next) {
+		next = TAILQ_NEXT(b, link);
+		if (!all && (b->owner != owner || b->gem != gem))
+			continue;
+		TAILQ_REMOVE(&vm->mappings, b, link);
+		RB_REMOVE(agx_vm_bo_tree, &vm->bo_mappings, b);
+		TAILQ_INSERT_TAIL(&dead, b, link);
+	}
+	agx_vm_snapshot_invalidate(vm);
+	goto out;
+retain:
+	/* The owner token may disappear; keep all BO references on failure. */
+	TAILQ_FOREACH(b, &vm->mappings, link) {
+		if (all || (b->owner == owner && b->gem == gem))
+			b->owner = NULL;
+	}
+out:
+	rw_exit_write(&vm->lock);
+	agx_vm_bindings_drop(&dead, 0);
+	return error;
+}
+
+int
+agx_vm_unmap_bo_revoke(struct agx_vm *vm, const void *owner,
+    struct drm_gem_object *gem)
+{
+	return agx_vm_revoke_matching(vm, owner, gem, 0);
+}
+
+int
+agx_vm_unmap_all_revoke(struct agx_vm *vm)
+{
+	return agx_vm_revoke_matching(vm, NULL, NULL, 1);
+}
+
+/* At most one existing interval can span both ends of the removed range. */
+static int
+agx_vm_split_prepare(struct agx_vm *vm, uint64_t va, uint64_t end,
+    struct agx_vm_binding **out)
+{
+	struct agx_vm_binding *b, *split;
+
+	*out = NULL;
+	TAILQ_FOREACH(b, &vm->mappings, link) {
+		if (b->va < va && b->va + b->size > end) {
+			split = malloc(sizeof(*split), M_DEVBUF, M_NOWAIT | M_CANFAIL);
+			if (split == NULL)
+				return ENOMEM;
+			*split = *b;
+			task_set(&split->retire_task, agx_vm_binding_retire_task, split);
+			agx_mem_pin_ref(split->mem);
+			drm_gem_object_get(split->gem);
+			*out = split;
+			break;
+		}
+	}
+	return 0;
+}
+
+static void
+agx_vm_remove_range(struct agx_vm *vm, uint64_t va, uint64_t end,
+    struct agx_vm_binding *split, struct agx_vm_bindings *dead)
+{
+	struct agx_vm_binding *b, *next;
+	uint64_t old_end, delta;
+
+	for (b = TAILQ_FIRST(&vm->mappings); b != NULL; b = next) {
+		next = TAILQ_NEXT(b, link);
+		old_end = b->va + b->size;
+		if (old_end <= va)
+			continue;
+		if (b->va >= end)
+			break;
+		if (b->va < va && old_end > end) {
+			delta = end - b->va;
+			split->va = end;
+			split->size = old_end - end;
+			if (!split->repeat)
+				split->offset += delta;
+			b->size = va - b->va;
+			TAILQ_INSERT_AFTER(&vm->mappings, b, split, link);
+			/* RB_INSERT replaces the linkage copied by split_prepare. */
+			RB_INSERT(agx_vm_bo_tree, &vm->bo_mappings, split);
+			break;
+		}
+		if (b->va < va) {
+			b->size = va - b->va;
+			continue;
+		}
+		if (old_end > end) {
+			delta = end - b->va;
+			b->va = end;
+			b->size = old_end - end;
+			if (!b->repeat)
+				b->offset += delta;
+			break;
+		}
+		TAILQ_REMOVE(&vm->mappings, b, link);
+		RB_REMOVE(agx_vm_bo_tree, &vm->bo_mappings, b);
+		TAILQ_INSERT_TAIL(dead, b, link);
+	}
+}
+
+static void
+agx_vm_insert_binding(struct agx_vm *vm, struct agx_vm_binding *binding)
+{
+	struct agx_vm_binding *b;
+
+	RB_INSERT(agx_vm_bo_tree, &vm->bo_mappings, binding);
+
+	TAILQ_FOREACH(b, &vm->mappings, link) {
+		if (b->va > binding->va) {
+			TAILQ_INSERT_BEFORE(b, binding, link);
+			return;
+		}
+	}
+	TAILQ_INSERT_TAIL(&vm->mappings, binding, link);
+}
+
+static int
+agx_vm_map_object(struct agx_vm *vm, const void *owner, uint64_t va,
+    struct drm_gem_object *gem, struct agx_mem *mem, uint64_t offset,
+    uint64_t size, enum agx_uat_gpu_prot prot, int repeat, int replace,
+    const volatile unsigned int *cancel, int no_wait)
+{
+	struct agx_vm_binding *binding, *split = NULL;
+	struct agx_vm_bindings dead;
+	struct agx_uat_reserve reserve = { NULL, 0, -1 };
+	uint64_t cursor = 0, flags, needed;
+	unsigned int failures = 0, restarts = 0;
+	int error;
+
+	if (vm == NULL || owner == NULL || gem == NULL || mem == NULL ||
+	    !agx_vm_user_range(vm, va, size) || (offset & AGX_PAGE_MASK) ||
+	    (repeat != 0 && repeat != 1) || mem->oas != vm->pt->oas)
+		return EINVAL;
+	needed = repeat ? AGX_PAGE_SIZE : size;
+	if (offset > mem->size || needed > mem->size - offset ||
+	    agx_uat_gpu_flags(prot, &flags) != 0)
+		return EINVAL;
+	binding = malloc(sizeof(*binding), M_DEVBUF,
+	    (no_wait ? M_NOWAIT | M_CANFAIL : M_WAITOK) | M_ZERO);
+	if (binding == NULL)
+		return ENOMEM;
+	task_set(&binding->retire_task, agx_vm_binding_retire_task, binding);
+	binding->owner = owner;
+	binding->gem = gem;
+	binding->mem = mem;
+	binding->va = va;
+	binding->size = size;
+	binding->offset = offset;
+	binding->prot = prot;
+	binding->repeat = repeat;
+	drm_gem_object_get(gem);
+	error = agx_mem_pin(mem, no_wait);
+	if (error != 0) {
+		drm_gem_object_put(gem);
+		free(binding, M_DEVBUF, sizeof(*binding));
+		return error;
+	}
+	TAILQ_INIT(&dead);
+	for (;;) {
+		error = agx_vm_mutation_enter_common(vm, cancel, 1,
+		    no_wait || reserve.node != NULL, va, size, gem, mem);
+		if (!no_wait && error == EAGAIN && reserve.node != NULL) {
+			agx_uat_node_free(reserve.node);
+			reserve.node = NULL;
+			if (++restarts < 32)
+				continue;
+			/* EAGAIN is retried indefinitely by libdrm's ioctl wrapper. */
+			error = EBUSY;
+		}
+		if (error != 0)
+			goto fail;
+		error = agx_uat_pt_prepare(vm->pt, va, size, &cursor, &reserve);
+		if (error == 0 && replace)
+			error = agx_vm_split_prepare(vm, va, va + size, &split);
+		/* Commit remains serialized against close, cancellation and binds. */
+		if (error == 0 && cancel != NULL &&
+		    __atomic_load_n(cancel, __ATOMIC_ACQUIRE) != 0)
+			error = ECANCELED;
+		if (error == 0) {
+			error = agx_uat_pt_map_prepared(vm->pt, va, mem, offset,
+			    size, flags, repeat, replace, 0, &reserve);
+			if (error == ENOMEM && reserve.needed >= 0) {
+				/* An earlier span was reclaimed while we were unlocked. */
+				cursor = 0;
+				if (no_wait) {
+					error = EAGAIN;
+					reserve.needed = -1;
+				} else if (++restarts >= 32)
+					reserve.needed = -1;
+			}
+		}
+		if (error == 0) {
+			if (!agx_vm_mutation_disjoint(vm, va, size, gem, mem))
+				agx_vm_snapshot_invalidate(vm);
+			if (replace)
+				agx_vm_remove_range(vm, va, va + size, split, &dead);
+			binding->born_epoch = vm->active ? vm->active_epoch : 0;
+			agx_vm_insert_binding(vm, binding);
+			binding = NULL;
+			split = NULL;
+		}
+		agx_vm_mutation_exit(vm);
+		if (split != NULL) {
+			agx_vm_binding_drop(split, no_wait);
+			split = NULL;
+		}
+		if (error != ENOMEM || reserve.needed < 0)
+			break;
+		if (reserve.node != NULL) {
+			agx_uat_node_free(reserve.node);
+			reserve.node = NULL;
+		}
+		reserve.level = reserve.needed;
+		error = agx_uat_node_new(vm->pt->dmat, vm->pt->oas,
+		    reserve.level, &reserve.node);
+		if (!no_wait && error == ENOMEM && ++failures < 16) {
+			/* No private table, VM lock, or PT lock is held here. */
+			error = tsleep_nsec(vm->handoff, PWAIT | PCATCH,
+			    "agxptmem", MSEC_TO_NSEC(10));
+			if (error == 0 || error == EWOULDBLOCK)
+				continue;
+		}
+		if (error != 0)
+			break;
+	}
+	agx_vm_bindings_drop(&dead, no_wait);
+fail:
+	if (reserve.node != NULL)
+		agx_uat_node_free(reserve.node);
+	if (error != 0) {
+		/* Partially installed tables remain usable by later binds. Avoid
+		 * waiting for a busy VM merely to schedule their reclamation. */
+		if (!no_wait) {
+			rw_enter_write(&vm->lock);
+			agx_vm_reclaim_request(vm);
+			rw_exit_write(&vm->lock);
+		} else if (rw_enter(&vm->lock, RW_WRITE | RW_NOSLEEP) == 0) {
+			agx_vm_reclaim_request(vm);
+			rw_exit_write(&vm->lock);
+		}
+	}
+	if (binding != NULL)
+		agx_vm_binding_drop(binding, no_wait);
+	return error;
+}
+
+int
+agx_vm_map(struct agx_vm *vm, const void *owner, uint64_t va,
+    struct drm_gem_object *gem, struct agx_mem *mem, uint64_t offset,
+    uint64_t size, enum agx_uat_gpu_prot prot, int repeat)
+{
+	return agx_vm_map_object(vm, owner, va, gem, mem, offset, size, prot,
+	    repeat, 0, NULL, 0);
+}
+
+int
+agx_vm_replace(struct agx_vm *vm, const void *owner, uint64_t va,
+    struct drm_gem_object *gem, struct agx_mem *mem, uint64_t offset,
+    uint64_t size, enum agx_uat_gpu_prot prot, int repeat)
+{
+	return agx_vm_map_object(vm, owner, va, gem, mem, offset, size, prot,
+	    repeat, 1, NULL, 0);
+}
+
+int
+agx_vm_replace_cancelable(struct agx_vm *vm, const void *owner, uint64_t va,
+    struct drm_gem_object *gem, struct agx_mem *mem, uint64_t offset,
+    uint64_t size, enum agx_uat_gpu_prot prot, int repeat,
+    const volatile unsigned int *cancel, int no_wait)
+{
+	int error;
+
+	if (cancel == NULL)
+		return EINVAL;
+	error = agx_vm_map_object(vm, owner, va, gem, mem, offset, size, prot,
+	    repeat, 1, cancel, no_wait);
+	/* drmIoctl retries EAGAIN indefinitely, defeating nonblocking requests. */
+	return no_wait && error == EAGAIN ? EBUSY : error;
+}
+
+int
+agx_vm_unmap(struct agx_vm *vm, uint64_t va, uint64_t size)
+{
+	struct agx_vm_binding *split;
+	struct agx_vm_bindings dead;
+	int error, disjoint;
+
+	if (vm == NULL || !agx_vm_user_range(vm, va, size))
+		return EINVAL;
+	TAILQ_INIT(&dead);
+	error = agx_vm_mutation_enter_common(vm, NULL, 1, 0, va, size,
+	    NULL, NULL);
+	if (error != 0)
+		return error;
+	error = agx_vm_split_prepare(vm, va, va + size, &split);
+	if (error != 0) {
+		agx_vm_mutation_exit(vm);
+		return error;
+	}
+	disjoint = agx_vm_mutation_disjoint(vm, va, size, NULL, NULL);
+	error = agx_uat_pt_unmap(vm->pt, va, size);
+	if (error == 0) {
+		if (!disjoint)
+			agx_vm_snapshot_invalidate(vm);
+		agx_vm_remove_range(vm, va, va + size, split, &dead);
+		if (!disjoint)
+			agx_vm_reclaim_request(vm);
+		split = NULL;
+	}
+	agx_vm_mutation_exit(vm);
+	agx_vm_bindings_drop(&dead, 0);
+	if (split != NULL)
+		agx_vm_binding_drop(split, 0);
+	return error;
+}
+
+
+int
+agx_vm_snapshot(struct agx_vm *vm, struct agx_vm_snapshot *snapshot)
+{
+	struct agx_vm_snapshot_cache *cache;
+	struct agx_vm_binding *b, *prev;
+	size_t count = 0, i = 0;
+	unsigned int refs;
+	int error = 0;
+
+	if (vm == NULL || snapshot == NULL)
+		return EINVAL;
+	memset(snapshot, 0, sizeof(*snapshot));
+	rw_enter_write(&vm->lock);
+	if (vm->active == 0) {
+		error = EINVAL;
+		goto out;
+	}
+	if (RB_EMPTY(&vm->bo_mappings))
+		goto out;
+	cache = vm->snapshot;
+	if (cache == NULL) {
+		/* Preserve distinct pairs even when the same GEM has mismatched
+		 * backing, so the scheduler can reject that mismatch. */
+		prev = NULL;
+		RB_FOREACH(b, agx_vm_bo_tree, &vm->bo_mappings) {
+			if (prev != NULL && prev->gem == b->gem && prev->mem == b->mem)
+				continue;
+			prev = b;
+			if (count == MALLOC_MAX / sizeof(*cache->entries)) {
+				error = ENOMEM;
+				goto out;
+			}
+			count++;
+		}
+		cache = malloc(sizeof(*cache), M_DEVBUF,
+		    M_NOWAIT | M_CANFAIL | M_ZERO);
+		if (cache == NULL) {
+			error = ENOMEM;
+			goto out;
+		}
+		if (count != 0) {
+			cache->entries = mallocarray(count, sizeof(*cache->entries),
+			    M_DEVBUF, M_NOWAIT | M_CANFAIL);
+			if (cache->entries == NULL) {
+				free(cache, M_DEVBUF, sizeof(*cache));
+				error = ENOMEM;
+				goto out;
+			}
+		}
+		cache->count = count;
+		cache->refs = 1; /* VM cache reference */
+		task_set(&cache->retire_task, agx_vm_snapshot_retire, cache);
+		prev = NULL;
+		RB_FOREACH(b, agx_vm_bo_tree, &vm->bo_mappings) {
+			if (prev != NULL && prev->gem == b->gem && prev->mem == b->mem)
+				continue;
+			prev = b;
+			agx_mem_pin_ref(b->mem);
+			drm_gem_object_get(b->gem);
+			cache->entries[i].gem = b->gem;
+			cache->entries[i].mem = b->mem;
+			i++;
+		}
+		vm->snapshot = cache;
+	}
+	refs = __atomic_load_n(&cache->refs, __ATOMIC_RELAXED);
+	do {
+		if (refs == UINT_MAX) {
+			error = EOVERFLOW;
+			goto out;
+		}
+	} while (!__atomic_compare_exchange_n(&cache->refs, &refs, refs + 1,
+	    0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE));
+	snapshot->entries = cache->entries;
+	snapshot->count = cache->count;
+	snapshot->cache = cache;
+out:
+	rw_exit_write(&vm->lock);
+	return error;
+}
+
+void
+agx_vm_snapshot_fini(struct agx_vm_snapshot *snapshot)
+{
+	if (snapshot == NULL)
+		return;
+	agx_vm_snapshot_put(snapshot->cache);
+	memset(snapshot, 0, sizeof(*snapshot));
+}
+
+int
+agx_vm_internal_range(struct agx_vm *vm, enum agx_vm_internal_kind kind,
+    uint64_t *start, uint64_t *end)
+{
+	uint64_t mid;
+
+	if (vm == NULL || start == NULL || end == NULL ||
+	    (kind != AGX_VM_GPU_SHARED && kind != AGX_VM_GPU_FW_PRIVATE))
+		return EINVAL;
+	mid = vm->kernel_start +
+	    (((vm->kernel_end - vm->kernel_start) >> 1) & ~0x7fffULL);
+	*start = kind == AGX_VM_GPU_SHARED ? vm->kernel_start : mid;
+	*end = kind == AGX_VM_GPU_SHARED ? mid : vm->kernel_end;
+	return 0;
+}
+
+static int
+agx_vm_internal_valid(struct agx_vm *vm, uint64_t va, uint64_t size,
+    enum agx_vm_internal_kind kind)
+{
+	uint64_t start, end;
+
+	if (agx_vm_internal_range(vm, kind, &start, &end) != 0 ||
+	    !agx_uat_range_valid(va, size))
+		return 0;
+	return va >= start && va < end && size <= end - va;
+}
+
+int
+agx_vm_map_internal(struct agx_vm *vm, uint64_t va, struct agx_mem *mem,
+    uint64_t size, enum agx_vm_internal_kind kind)
+{
+	uint64_t flags;
+	int error;
+
+	if (vm == NULL || mem == NULL || mem->pages != NULL ||
+	    mem->cache != AGX_MEM_NOCACHE ||
+	    !agx_vm_internal_valid(vm, va, size, kind))
+		return EINVAL;
+	if (kind == AGX_VM_GPU_SHARED)
+		agx_uat_gpu_flags(AGX_UAT_GPU_RW, &flags);
+	else
+		flags = UAT_TABLE | UAT_AF | UAT_NG | UAT_GPU_ACCESS |
+		    UAT_UXN | UAT_PXN;
+	/* Only new mappings are installed; active jobs may trigger heap growth. */
+	rw_enter_write(&vm->lock);
+	if (__atomic_load_n(&vm->handoff->poisoned, __ATOMIC_ACQUIRE) ||
+	    agx_uat_handoff_is_stopped(vm->handoff))
+		error = EIO;
+	else
+		error = agx_uat_pt_map_common(vm->pt, va, mem, 0, size, flags,
+		    0, 0, 0);
+	if (error != 0)
+		agx_vm_reclaim_request(vm);
+	rw_exit_write(&vm->lock);
+	return error;
+}
+
+/* Convert cached firmware mappings to uncached before its cache flush. */
+static int
+agx_uat_pt_uncache(struct agx_uat_pt *pt, uint64_t va, uint64_t size)
+{
+	struct agx_uat_node *leaf;
+	struct agx_uat_leaf_cursor cursor = { 0 };
+	uint64_t *pte, pos, index, value;
+	int error;
+
+	rw_enter_write(&pt->lock);
+	for (pos = 0; pos < size; pos += AGX_PAGE_SIZE) {
+		error = agx_uat_leaf_cached(pt, va + pos, 0, &pte, &leaf,
+		    NULL, &cursor);
+		if (error != 0)
+			goto out;
+		index = ((va + pos) >> AGX_PAGE_SHIFT) & UAT_INDEX_MASK;
+		if (pte == NULL || *pte == 0 ||
+		    !(leaf->owned[index / 64] & (1ULL << (index % 64)))) {
+			error = EINVAL;
+			goto out;
+		}
+	}
+	for (pos = 0; pos < size; pos += AGX_PAGE_SIZE) {
+		agx_uat_leaf_cached(pt, va + pos, 0, &pte, &leaf, NULL,
+		    &cursor);
+		value = __atomic_load_n(pte, __ATOMIC_RELAXED);
+		value = (value & ~(7ULL << 2)) | UAT_UNCACHED;
+		__atomic_store_n(pte, value, __ATOMIC_RELEASE);
+	}
+	agx_uat_pt_tlbi(pt, va, size);
+	error = 0;
+out:
+	rw_exit_write(&pt->lock);
+	return error;
+}
+
+/* Call only after the associated firmware flush completed successfully. */
+static void
+agx_uat_pt_flush_complete(struct agx_uat_pt *pt, uint64_t va, uint64_t size)
+{
+	struct agx_uat_node *leaf;
+	struct agx_uat_leaf_cursor cursor = { 0 };
+	uint64_t *pte, pos, index;
+
+	rw_enter_write(&pt->lock);
+	for (pos = 0; pos < size; pos += AGX_PAGE_SIZE) {
+		agx_uat_leaf_cached(pt, va + pos, 0, &pte, &leaf, NULL,
+		    &cursor);
+		if (pte != NULL) {
+			index = ((va + pos) >> AGX_PAGE_SHIFT) & UAT_INDEX_MASK;
+			leaf->cache_pending[index / 64] &= ~(1ULL << (index % 64));
+		}
+	}
+	rw_exit_write(&pt->lock);
+}
+
+int
+agx_uat_pt_unmap_cached(struct agx_uat_pt *pt, struct agx_uat_handoff *h,
+    uint64_t va, uint64_t size, agx_uat_flush_fn flush, void *cookie)
+{
+	uint64_t pos, chunk;
+	int error;
+
+	if (pt == NULL || !pt->kernel || h == NULL || flush == NULL ||
+	    !agx_uat_kernel_range_valid(va, size))
+		return EINVAL;
+	error = agx_uat_pt_uncache(pt, va, size);
+	for (pos = 0; error == 0 && pos < size; pos += chunk) {
+		chunk = MIN(size - pos, (uint64_t)UINT16_MAX << AGX_PAGE_SHIFT);
+		error = agx_uat_handoff_flush(h, UAT_CONTEXTS, va + pos, chunk,
+		    flush, cookie);
+	}
+	if (error != 0)
+		return error;
+	agx_uat_pt_flush_complete(pt, va, size);
+	return agx_uat_pt_unmap(pt, va, size);
+}
+
+int
+agx_uat_pt_unmap_after_reset(struct agx_uat_pt *pt,
+    struct agx_uat_handoff *h, uint64_t va, uint64_t size)
+{
+	int stopped, error;
+
+	if (pt == NULL || h == NULL ||
+	    !(pt->kernel ? agx_uat_kernel_range_valid(va, size) :
+	    agx_uat_range_valid(va, size)))
+		return EINVAL;
+	rw_enter_read(&h->lock);
+	stopped = h->stopped;
+	rw_exit_read(&h->lock);
+	if (!stopped)
+		return EBUSY;
+	/* stop is recorded only after the owner proves caches invalidated. */
+	error = agx_uat_pt_uncache(pt, va, size);
+	if (error != 0)
+		return error;
+	agx_uat_pt_flush_complete(pt, va, size);
+	return agx_uat_pt_unmap(pt, va, size);
+}
+
+int
+agx_vm_unmap_internal(struct agx_vm *vm, uint64_t va, uint64_t size,
+    enum agx_vm_internal_kind kind, agx_uat_flush_fn flush, void *cookie)
+{
+	uint64_t pos, chunk;
+	uint32_t slot;
+	int error, unbind_error;
+
+	if (vm == NULL || !agx_vm_internal_valid(vm, va, size, kind))
+		return EINVAL;
+	error = agx_vm_mutation_enter(vm, NULL, 0);
+	if (error != 0)
+		return error;
+	if (kind == AGX_VM_GPU_FW_PRIVATE) {
+		if (flush == NULL) {
+			error = agx_uat_pt_unmap_after_reset(vm->pt, vm->handoff,
+			    va, size);
+			goto out;
+		}
+		/* Pin ownership against slot recycling throughout the flush. */
+		error = agx_uat_slot_bind(vm->handoff, vm,
+		    agx_uat_pt_root(vm->pt), &slot);
+		if (error != 0)
+			goto out;
+		error = agx_uat_pt_uncache(vm->pt, va, size);
+		for (pos = 0; error == 0 && pos < size; pos += chunk) {
+			chunk = MIN(size - pos, (uint64_t)UINT16_MAX << AGX_PAGE_SHIFT);
+			error = agx_uat_handoff_flush(vm->handoff, slot, va + pos,
+			    chunk, flush, cookie);
+		}
+		unbind_error = agx_uat_slot_unbind(vm->handoff, vm);
+		if (error == 0)
+			error = unbind_error;
+		if (error == 0)
+			agx_uat_pt_flush_complete(vm->pt, va, size);
+		if (error == 0)
+			error = agx_uat_pt_unmap(vm->pt, va, size);
+	} else
+		error = agx_uat_pt_unmap(vm->pt, va, size);
+out:
+	if (error == 0)
+		agx_vm_reclaim_request(vm);
+	agx_vm_mutation_exit(vm);
+	return error;
+}
