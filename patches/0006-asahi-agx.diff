+int
+agx_tvb_init_work(struct agx_fw_init_buffer *work, uint32_t vm_slot,
+    uint32_t buffer_slot, uint32_t blocks, uint64_t buffer_va, uint32_t stamp)
+{
+	if (buffer_slot >= 127 || blocks == 0 || buffer_va == 0)
+		return EINVAL;
+	memset(work, 0, sizeof(*work));
+	work->tag = AGX_FW_CMD_INIT_BUFFER;
+	work->vm_slot = vm_slot;
+	work->buffer_slot = buffer_slot;
+	work->block_count = blocks;
+	work->buffer = buffer_va;
+	work->stamp_value = stamp;
+	return 0;
+}
+
+static int
+agx_scene_object(struct agx_heap *heap, size_t size, size_t align,
+    struct agx_object **out)
+{
+	int error;
+
+	error = agx_object_alloc(heap, size, align, out);
+	if (error != 0)
+		return error;
+	if ((*out)->cpu == NULL) {
+		agx_object_free(*out);
+		*out = NULL;
+		return EINVAL;
+	}
+	/* Heap suballocations are reused and do not arrive zeroed. */
+	memset((*out)->cpu, 0, (*out)->size);
+	return 0;
+}
+
+void
+agx_scene_free(struct agx_scene_resources *scene)
+{
+	agx_object_free(scene->scene);
+	agx_object_free(scene->control_word);
+	agx_object_free(scene->cluster_meta);
+	agx_object_free(scene->cluster_tilemaps);
+	agx_object_free(scene->tpc);
+	agx_object_free(scene->preempt);
+	agx_object_free(scene->tilemap);
+	agx_object_free(scene->heapmeta);
+	agx_object_free(scene->user_buffer);
+	memset(scene, 0, sizeof(*scene));
+}
+
+int
+agx_scene_alloc(struct agx_heap *shared, struct agx_heap *user,
+    struct agx_heap *private, struct agx_heap *gpu,
+    const struct agx_tile_info *tile, unsigned int version, int g14x,
+    uint32_t clusters, uint64_t stats_va, struct agx_scene_resources *out)
+{
+	struct agx_scene_resources s;
+	struct agx_fw_buffer_scene_12_3 *scene12;
+	struct agx_fw_buffer_scene_13_5 *scene13;
+	struct agx_fw_buffer_scene_g14x_13_5 *sceneg;
+	size_t scene_size, tpc_size, preempt_clusters, meta_size;
+	int error;
+
+	if ((version != 12 && version != 13) || (g14x && version != 13) ||
+	    (!g14x && clusters != 1) || clusters == 0 || clusters > 4 ||
+	    gpu == NULL || stats_va == 0 || tile->tilemap_size == 0 ||
+	    tile->tpc_size == 0 || tile->layermeta_size > SIZE_MAX - 0x200 ||
+	    tile->tpc_size > SIZE_MAX - 0x3fff ||
+	    (clusters > 1 && tile->tilemap_size > SIZE_MAX / 64))
+		return EINVAL;
