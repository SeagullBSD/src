+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/errno.h>
+#include <sys/mount.h>
+#include <sys/proc.h>
+#include <sys/rwlock.h>
+#include <sys/stdint.h>
+#include <machine/bus.h>
+#include <machine/cpufunc.h>
