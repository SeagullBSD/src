+/* SPDX-License-Identifier: MIT */
+#ifndef _AGX_RENDER_HIGH_H_
+#define _AGX_RENDER_HIGH_H_
+
+#include "agx_queue.h"
+#include "agx_object.h"
+
+struct agx_render_job {
+	struct agx_tile_info tile;
+	struct agx_scene_resources scene;
+	struct agx_object *vertex, *fragment, *vertex_seq, *fragment_seq;
+	struct agx_object *timestamps, *init_buffer, *barrier, *aux_fb;
+	unsigned int version, g14x;
