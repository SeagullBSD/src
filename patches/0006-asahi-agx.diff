+	agx_gpu_context_put(owner->context);
+	return error;
+fail:
+	(void)agx_queue_owner_release(owner);
+	return error;
+}
+
+int
+agx_queue_owner_preflight(struct agx_queue_owner *owner,
+    const uint32_t counts[3], const uint32_t slots[3])
+{
+	struct agx_wq_ring *ring;
+	uint32_t done, distance;
+	unsigned int i;
+
+	if (owner == NULL || counts == NULL || slots == NULL)
+		return EINVAL;
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		if (counts[i] == 0)
+			continue;
+		ring = &owner->pipes[i].ring;
+		if (slots[i] >= AGX_EVENT_SLOTS || ring->size < 2 ||
+		    ring->pending >= ring->size || ring->wptr >= ring->size)
+			return EINVAL;
+		if (ring->needs_notify || ring->needs_kick ||
+		    (ring->pending != 0 && ring->event_slot != slots[i]) ||
+		    counts[i] > ring->size - 1 - ring->pending)
+			return EBUSY;
+		done = __atomic_load_n(&ring->state->gpu_doneptr, __ATOMIC_ACQUIRE);
+		if (done >= ring->size)
+			return EIO;
+		distance = done >= ring->wptr ? done - ring->wptr :
+		    ring->size - ring->wptr + done;
+		if (distance == 0)
+			distance = ring->size;
+		if (counts[i] >= distance)
+			return EBUSY;
+	}
+	return 0;
+}
+
+
+int
+agx_queue_owner_get(struct agx_queue_owner *owner)
+{
+	int error = 0;
+
+	if (owner == NULL)
+		return EINVAL;
+	rw_enter_write(&owner->ref_lock);
+	if (owner->refs == 0)
+		error = ENODEV;
+	else if (owner->refs == UINT_MAX)
+		error = EOVERFLOW;
+	else
+		owner->refs++;
+	rw_exit_write(&owner->ref_lock);
+	return error;
+}
+
+void
+agx_queue_owner_put(struct agx_queue_owner *owner)
+{
+	int last;
+
+	if (owner == NULL)
+		return;
+	rw_enter_write(&owner->ref_lock);
+	KASSERT(owner->refs != 0);
+	last = --owner->refs == 0;
+	rw_exit_write(&owner->ref_lock);
+	if (last)
+		task_add(agx_queue_jobs_taskq(owner), &owner->teardown_task);
+}
+
+static void
+agx_queue_owner_retry(void *cookie)
+{
+	struct agx_queue_owner *owner = cookie;
+
+	task_add(agx_queue_jobs_taskq(owner), &owner->teardown_task);
+}
+
+static void
+agx_queue_owner_teardown(void *cookie)
+{
+	struct agx_queue_owner *owner = cookie;
+	int error;
+
+	/* Detached scheduler jobs may outlive the AGX queue, but not its shell. */
+	timeout_del_barrier(&owner->teardown_retry);
+	if (agx_queue_jobs_close(owner) != 0) {
+		timeout_add_msec(&owner->teardown_retry, 1);
+		return;
+	}
+	error = owner->scheduler != NULL ?
+	    agx_sched_orphan(owner->scheduler) : 0;
+	if (error == EBUSY) {
+		timeout_add_msec(&owner->teardown_retry, 1);
+		return;
+	}
+	if (error != 0) {
+		printf("agx: retaining queue after scheduler teardown error %d\n",
+		    error);
+		return;
+	}
+	owner->scheduler = NULL;
+	error = agx_gpu_context_invalidate(owner->context);
+	if (error == EBUSY) {
+		timeout_add_msec(&owner->teardown_retry, 1);
+		return;
+	}
+	if (error != 0) {
+		printf("agx: retaining queue after context invalidation error %d\n",
+		    error);
+		return;
+	}
+	/* Drop tail objects and their root/slot pins only after DestroyContext ACK. */
+	error = agx_queue_jobs_fini(owner);
+	if (error != 0)
+		return;
+	/* This may free owner through the context release callback. */
+	agx_gpu_context_put(owner->context);
+}
+
+struct agx_sched *
+agx_queue_owner_sched(struct agx_queue_owner *owner)
+{
+	return owner->scheduler;
+}
+
+int
+agx_queue_owner_counters(struct agx_queue_owner *owner, uint32_t count,
+    uint64_t *first)
+{
+	int error = 0;
+
+	if (owner == NULL || first == NULL || count == 0)
+		return EINVAL;
+	rw_enter_write(&owner->ref_lock);
+	if (owner->refs == 0)
+		error = ENODEV;
+	else if (owner->counter > UINT64_MAX - count)
+		error = EOVERFLOW;
+	else {
+		*first = owner->counter;
+		owner->counter += count;
+	}
+	rw_exit_write(&owner->ref_lock);
+	return error;
+}
+
+void
+agx_queue_owner_assemble_enter(struct agx_queue_owner *owner)
+{
+	rw_enter_write(&owner->assembly_lock);
+}
+
+void
+agx_queue_owner_assemble_leave(struct agx_queue_owner *owner)
+{
+	rw_exit_write(&owner->assembly_lock);
+}
