@@ -0,0 +1,401 @@
+/* SPDX-License-Identifier: MIT */
+/* T8103 and T6021 compute parameter marshalling from the Asahi UAPI. */
+#include <sys/types.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <drm/asahi_drm.h>
+
+#include "agx_queue.h"
+#include "agx_object.h"
+
+#define AGX_G14X_COMPUTE_PREEMPT1_SIZE 0x25980U
+
+_Static_assert(sizeof(struct agx_fw_register) == 12, "G14X register size");
+_Static_assert(sizeof(struct agx_fw_register_array) == 0x710, "G14X register array size");
+_Static_assert(offsetof(struct agx_fw_compute_g14x_13_5, registers) == 0x20,
+    "G14X compute register offset");
+_Static_assert(offsetof(struct agx_fw_compute_g14x_13_5, microsequence) == 0x750,
+    "G14X compute microsequence offset");
+_Static_assert(offsetof(struct agx_fw_start_compute_g14x_13_5, registers) == 0x14,
+    "G14X start compute register offset");
+
+static int
+agx_compute_job_object(struct agx_heap *heap, size_t size, struct agx_object **out)
+{
+	int error;
+
+	error = agx_object_alloc(heap, size, 16, out);
+	if (error != 0)
+		return error;
+	if ((*out)->cpu == NULL) {
+		agx_object_free(*out);
+		*out = NULL;
+		return EINVAL;
+	}
+	memset((*out)->cpu, 0, (*out)->size);
+	return 0;
+}
+
+void
+agx_compute_job_free(struct agx_compute_job *job)
+{
+	agx_object_free(job->work);
+	agx_object_free(job->microseq);
+	agx_object_free(job->preempt);
+	agx_object_free(job->timestamps);
+	memset(job, 0, sizeof(*job));
+}
+
+int
+agx_compute_job_alloc(struct agx_heap *gpu_ro, struct agx_heap *private,
+    struct agx_heap *user, struct agx_heap *shared, unsigned int version,
+    int g14x, struct agx_compute_job *out)
+{
+	struct agx_compute_job job;
+	size_t work_size, seq_size;
+	int error;
+
+	if ((version != 12 && version != 13) || (g14x && version != 13))
+		return EINVAL;
+	memset(&job, 0, sizeof(job));
+	job.version = version;
+	job.g14x = g14x;
+	work_size = g14x ? sizeof(struct agx_fw_compute_g14x_13_5) :
+	    version == 12 ? sizeof(struct agx_fw_compute_12_3) :
+	    sizeof(struct agx_fw_compute_13_5);
+	seq_size = (g14x ? sizeof(struct agx_fw_start_compute_g14x_13_5) :
+	    sizeof(struct agx_fw_start_compute_13_5)) +
+	    2 * sizeof(struct agx_fw_microseq_timestamp_13_5) +
+	    sizeof(struct agx_fw_finalize_compute_13_5) + 2 * sizeof(uint32_t);
+	error = agx_compute_job_object(gpu_ro, work_size, &job.work);
+	if (error != 0)
+		goto fail;
+	error = agx_compute_job_object(private, seq_size, &job.microseq);
+	if (error != 0)
+		goto fail;
+	error = agx_compute_job_object(user, g14x ?
+	    AGX_G14X_COMPUTE_PREEMPT1_SIZE + 32 : AGX_COMPUTE_PREEMPT_SIZE,
+	    &job.preempt);
+	if (error != 0)
+		goto fail;
+	error = agx_compute_job_object(shared, sizeof(struct agx_fw_job_timestamps),
+	    &job.timestamps);
+	if (error != 0)
+		goto fail;
+	*out = job;
+	return 0;
+fail:
+	agx_compute_job_free(&job);
+	return error;
+}
+
+int
+agx_compute_job_encode(struct agx_compute_job *job,
+    const struct drm_asahi_cmd_compute *cmd, uint64_t usc_exec_base,
+    const struct agx_compute_microseq_args *micro_args,
+    const struct agx_compute_work_args *work_args)
+{
+	struct agx_compute_microseq_args micro;
+	struct agx_compute_work_args work;
+	struct agx_compute_setup setup;
+	struct agx_microseq seq;
+	int error;
+
+	if (job->encoded || job->work == NULL || job->microseq == NULL ||
+	    job->preempt == NULL || job->timestamps == NULL ||
+	    micro_args->vm_slot != work_args->vm_slot ||
+	    micro_args->fw_stamp_va != work_args->fw_stamp_va ||
+	    micro_args->stamp_value != work_args->stamp_value ||
+	    micro_args->event_seq != work_args->event_seq ||
+	    micro_args->event_generation != work_args->queue_id ||
+	    micro_args->counter != work_args->counter)
+		return EINVAL;
+	error = agx_compute_setup(cmd, job->version, job->g14x, usc_exec_base,
+	    job->preempt->gpu, &setup);
+	if (error != 0)
+		return error;
+	micro = *micro_args;
+	work = *work_args;
+	micro.work_va = job->work->gpu;
+	micro.g14x = job->g14x;
+	work.work_va = job->work->gpu;
+	micro.timestamps = work.user_start_va != 0 || work.user_end_va != 0;
+	seq.bytes = job->microseq->cpu;
+	seq.size = 0;
+	seq.capacity = job->microseq->size;
+	error = agx_compute_microseq(&seq, job->version, &micro);
+	if (error != 0)
+		return error;
+	work.microseq_va = job->microseq->gpu;
+	work.microseq_size = seq.size;
+	work.timestamps_start_va = job->timestamps->gpu +
+	    offsetof(struct agx_fw_job_timestamps, start);
+	work.timestamps_end_va = job->timestamps->gpu +
+	    offsetof(struct agx_fw_job_timestamps, end);
+	error = agx_compute_work(job->work->cpu, job->work->size, job->version, &setup, &work);
+	if (error != 0)
+		return error;
+	job->encoded = 1;
+	return 0;
+}
+
+int
+agx_compute_setup(const struct drm_asahi_cmd_compute *cmd, unsigned int version,
+    int g14x, uint64_t usc_exec_base, uint64_t preempt_va,
+    struct agx_compute_setup *out)
+{
+	struct agx_compute_setup s;
+	size_t preempt1_size = g14x ? AGX_G14X_COMPUTE_PREEMPT1_SIZE : 0x7f80;
+
+	if ((version != 12 && version != 13) || (g14x && version != 13) ||
+	    cmd->flags != 0 || preempt_va == 0 ||
+	    preempt_va > UINT64_MAX - preempt1_size - 32)
+		return EINVAL;
+
+	memset(&s, 0, sizeof(s));
+	s.g14x = g14x;
+	s.params1.preempt_buf1 = preempt_va;
+	s.params1.cdm_ctrl_stream_base.value = cmd->cdm_ctrl_stream_base;
+	s.params1.preempt_buf2 = preempt_va + preempt1_size;
+	s.params1.preempt_buf3 = preempt_va + preempt1_size + 8;
+	s.params1.preempt_buf4 = preempt_va + preempt1_size + 16;
+	s.params1.preempt_buf5 = preempt_va + preempt1_size + 24;
+	s.params1.usc_exec_base_cp.value = usc_exec_base;
+	s.params1.unk_38.value = 0x8c60;
+	s.params1.helper_program = cmd->helper.binary;
+	s.params1.helper_arg.value = cmd->helper.data;
+	s.params1.helper_cfg = cmd->helper.cfg;
+	s.params1.unk_58 = 1;
+	if (version == 12) {
+		s.params2.v12.preempt_buf1 = preempt_va;
+		s.params2.v12.cdm_ctrl_stream_end.value = cmd->cdm_ctrl_stream_end;
+	} else {
+		s.params2.v13.preempt_buf1 = preempt_va;
+		s.params2.v13.cdm_ctrl_stream_end.value = cmd->cdm_ctrl_stream_end;
+		if (g14x)
+			s.params2.v13.unk_g14x = 0x24201;
+	}
+	s.encoder.unk_mask = 0xffffffff;
+	s.encoder.sampler_array.value = cmd->sampler_heap;
+	s.encoder.sampler_count = cmd->sampler_count;
+	s.encoder.sampler_max = cmd->sampler_count + 1;
+	*out = s;
+	return 0;
+}
+
+int
+agx_compute_work(void *dst, size_t size, unsigned int version,
+    const struct agx_compute_setup *setup, const struct agx_compute_work_args *a)
+{
+	struct agx_fw_compute_12_3 *w12;
+	struct agx_fw_compute_13_5 *w13;
+	struct agx_fw_compute_g14x_13_5 *wg;
+	struct agx_fw_register_array *r;
+	size_t needed;
+
+	if (version == 12 && !setup->g14x)
+		needed = sizeof(*w12);
+	else if (version == 13)
+		needed = setup->g14x ? sizeof(*wg) : sizeof(*w13);
+	else
+		return EINVAL;
+	if (size < needed || a->notifier_va == 0 || a->microseq_va == 0 ||
+	    a->microseq_size == 0 || a->stamp_va == 0 || a->fw_stamp_va == 0 ||
+	    a->timestamps_start_va == 0 || a->timestamps_end_va == 0 ||
+	    a->stamp_slot >= 128 || a->flush_stamps > 1 ||
+	    (setup->g14x && (a->work_va == 0 ||
+	    a->work_va > UINT64_MAX - sizeof(*wg))))
+		return EINVAL;
+	memset(dst, 0, needed);
+#define INIT_WORK(w) do { \
+	(w)->tag = AGX_FW_CMD_COMPUTE; (w)->vm_slot = a->vm_slot; \
+	(w)->notifier = a->notifier_va; \
+	(w)->microsequence = a->microseq_va; \
+	(w)->microsequence_size = a->microseq_size; \
+	(w)->encoder_params = setup->encoder; \
+	(w)->meta.stamp = a->stamp_va; (w)->meta.fw_stamp = a->fw_stamp_va; \
+	(w)->meta.stamp_value = a->stamp_value; (w)->meta.stamp_slot = a->stamp_slot; \
+	(w)->meta.flush_stamps = a->flush_stamps; \
+	(w)->meta.event_seq = (uint32_t)a->event_seq; \
+	(w)->timestamp_pointers.start_addr = a->timestamps_start_va; \
+	(w)->timestamp_pointers.end_addr = a->timestamps_end_va; \
+	(w)->user_timestamp_pointers.start_addr = a->user_start_va; \
+	(w)->user_timestamp_pointers.end_addr = a->user_end_va; \
+	(w)->client_sequence = (uint8_t)a->queue_id; \
+} while (0)
+	if (version == 12) {
+		w12 = dst;
+		INIT_WORK(w12);
+		w12->job_params1 = setup->params1;
+		w12->job_params2 = setup->params2.v12;
+	} else if (!setup->g14x) {
+		w13 = dst;
+		INIT_WORK(w13);
+		w13->job_params1 = setup->params1;
+		w13->job_params2 = setup->params2.v13;
+		w13->counter.value = a->counter;
+	} else {
+		wg = dst;
+		INIT_WORK(wg);
+		wg->job_params2 = setup->params2.v13;
+		wg->counter.value = a->counter;
+		r = &wg->registers;
+		r->addr = a->work_va + offsetof(struct agx_fw_compute_g14x_13_5,
+		    registers.registers);
+#define REG(n, v) do { \
+		r->registers[r->count].number = (n); \
+		r->registers[r->count++].value.value = (v); \
+	} while (0)
+		REG(0x1a510, setup->params1.preempt_buf1);
+		REG(0x1a420, setup->params1.cdm_ctrl_stream_base.value);
+		REG(0x1a4d0, setup->params1.preempt_buf2);
+		REG(0x1a4d8, setup->params1.preempt_buf3);
+		REG(0x1a4e0, setup->params1.preempt_buf4);
+		REG(0x1a4e8, setup->params1.preempt_buf5);
+		REG(0x10071, setup->params1.usc_exec_base_cp.value);
+		REG(0x11841, setup->params1.helper_program);
+		REG(0x11849, setup->params1.helper_arg.value);
+		REG(0x11f81, setup->params1.helper_cfg);
+		REG(0x1a440, 0x24201);
+		REG(0x12091, 0);
+#undef REG
+		r->length = r->count * sizeof(r->registers[0]);
+	}
+#undef INIT_WORK
+	return 0;
+}
+
+/* Build the selected firmware operations into caller-owned storage. */
+int
+agx_compute_microseq(struct agx_microseq *seq, unsigned int version,
+    const struct agx_compute_microseq_args *a)
+{
+	struct agx_fw_start_compute_12_3 start12;
+	struct agx_fw_start_compute_13_5 start13;
+	struct agx_fw_start_compute_g14x_13_5 startg;
+	struct agx_fw_finalize_compute_12_3 end12;
+	struct agx_fw_finalize_compute_13_5 end13;
+	struct agx_fw_microseq_timestamp_12_3 ts12;
+	struct agx_fw_microseq_timestamp_13_5 ts13;
+	uint64_t unk, params1, params2, regs = 0, command_time, ts_ptr, user_ts, flag, ctx;
+	uint32_t op;
+	int32_t start, off, ignored;
+	size_t original;
+	int error, i;
+
+	if ((version != 12 && version != 13) || (a->g14x && version != 13) ||
+	    a->work_va == 0 || a->stats_va == 0 || a->queue_va == 0 ||
+	    a->fw_stamp_va == 0 || (version == 13 && a->notifier_buf_va == 0) ||
+	    a->attachments.count > AGX_MAX_ATTACHMENTS ||
+	    a->work_va > UINT64_MAX - (a->g14x ?
+	    sizeof(struct agx_fw_compute_g14x_13_5) :
+	    sizeof(struct agx_fw_compute_13_5)))
+		return EINVAL;
+	if (version == 12) {
+#define W12(field) (a->work_va + offsetof(struct agx_fw_compute_12_3, field))
+		unk = W12(unk_pointee); params1 = W12(job_params1);
+		params2 = W12(job_params2); command_time = W12(command_time);
+		ts_ptr = W12(timestamp_pointers); user_ts = W12(user_timestamp_pointers);
+#undef W12
+		flag = ctx = 0;
+	} else if (a->g14x) {
+#define WG(field) (a->work_va + offsetof(struct agx_fw_compute_g14x_13_5, field))
+		unk = WG(unk_pointee); params1 = 0; regs = WG(registers);
+		params2 = WG(job_params2); command_time = WG(command_time);
+		ts_ptr = WG(timestamp_pointers); user_ts = WG(user_timestamp_pointers);
+		flag = WG(unk_flag); ctx = WG(context_store_req);
+#undef WG
+	} else {
+#define W13(field) (a->work_va + offsetof(struct agx_fw_compute_13_5, field))
+		unk = W13(unk_pointee); params1 = W13(job_params1);
+		params2 = W13(job_params2); command_time = W13(command_time);
+		ts_ptr = W13(timestamp_pointers); user_ts = W13(user_timestamp_pointers);
+		flag = W13(unk_flag); ctx = W13(context_store_req);
+#undef W13
+	}
+	original = seq->size;
+#define START(s) do { \
+	memset(&(s), 0, sizeof(s)); \
+	(s).header = AGX_FW_OP_START_COMPUTE; (s).unk_pointer = unk; \
+	(s).job_params1 = params1; (s).stats = a->stats_va; \
+	(s).work_queue = a->queue_va; (s).vm_slot = a->vm_slot; \
+	(s).unk_28 = 1; (s).event_generation = a->event_generation; \
+	(s).event_seq.value = a->event_seq; (s).job_params2 = params2; \
+	(s).attachments = a->attachments; \
+} while (0)
+	if (version == 12) {
+		START(start12);
+		error = agx_microseq_append(seq, &start12, sizeof(start12), &start);
+	} else if (a->g14x) {
+		START(startg);
+		startg.registers = regs; startg.unk_flag = flag;
+		startg.counter.value = a->counter;
+		startg.notifier_buf = a->notifier_buf_va;
+		error = agx_microseq_append(seq, &startg, sizeof(startg), &start);
+	} else {
+		START(start13);
+		start13.unk_flag = flag; start13.counter.value = a->counter;
+		start13.notifier_buf = a->notifier_buf_va;
+		error = agx_microseq_append(seq, &start13, sizeof(start13), &start);
+	}
+#undef START
+	if (error != 0)
+		goto fail;
+	for (i = 0; i < 2; i++) {
+		if (i == 1) {
+			op = a->g14x ? AGX_FW_OP_WAIT_IDLE2 :
+			    AGX_FW_OP_WAIT_IDLE | (AGX_FW_MICROSEQ_PIPE_COMPUTE << 8);
+			error = agx_microseq_append(seq, &op, sizeof(op), &ignored);
+			if (error != 0)
+				goto fail;
+		}
+		if (!a->timestamps)
+			continue;
+#define TS(t) do { \
+	memset(&(t), 0, sizeof(t)); \
+	(t).header = AGX_FW_OP_TIMESTAMP | (i == 0 ? 0x80000000U : 0); \
+	(t).command_time = command_time; (t).ts_pointers = ts_ptr; \
+	(t).update_ts = ts_ptr + (i == 0 ? 0 : sizeof(uint64_t)); \
+	(t).work_queue = a->queue_va; (t).user_ts_pointers = user_ts; \
+} while (0)
+		if (version == 12) {
+			TS(ts12);
+			error = agx_microseq_append(seq, &ts12, sizeof(ts12), &ignored);
+		} else {
+			TS(ts13); ts13.unk_ts = ctx;
+			error = agx_microseq_append(seq, &ts13, sizeof(ts13), &ignored);
+		}
+#undef TS
+		if (error != 0)
+			goto fail;
+	}
+	error = agx_microseq_branch(seq, start, &off);
+	if (error != 0)
+		goto fail;
+#define FINAL(s) do { \
+	memset(&(s), 0, sizeof(s)); (s).header = AGX_FW_OP_FINALIZE_COMPUTE; \
+	(s).stats = a->stats_va; (s).work_queue = a->queue_va; \
+	(s).vm_slot = a->vm_slot; (s).job_params2 = params2; \
+	(s).fw_stamp = a->fw_stamp_va; (s).stamp_value = a->stamp_value; \
+	(s).restart_branch_offset = off; \
+	(s).has_attachments = a->attachments.count != 0; \
+} while (0)
+	if (version == 12) {
+		FINAL(end12);
+		error = agx_microseq_append(seq, &end12, sizeof(end12), &ignored);
+	} else {
+		FINAL(end13); end13.unk_flag = flag;
+		error = agx_microseq_append(seq, &end13, sizeof(end13), &ignored);
+	}
+#undef FINAL
+	if (error != 0)
+		goto fail;
+	op = AGX_FW_OP_RETIRE_STAMP;
+	error = agx_microseq_append(seq, &op, sizeof(op), &ignored);
+	if (error != 0)
+		goto fail;
+	return 0;
+fail:
+	seq->size = original;
+	return error;
+}
Index: sys/dev/pci/drm/asahi/agx_context.c
