+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef _DEV_PCI_DRM_ASAHI_AGX_POWER_H_
+#define _DEV_PCI_DRM_ASAHI_AGX_POWER_H_
+
+#include <sys/types.h>
+#include "agx_float.h"
+
+/* Firmware tables contain at most 16 performance states and five zones. */
+#define AGX_POWER_MAX_PSTATES 16
+#define AGX_POWER_MAX_ZONES 5
+
+struct agx_power_pstate {
+	uint32_t freq_hz;
+	uint32_t volt_mv[4];
+	uint32_t pwr_mw;
+};
+
+struct agx_power_zone {
+	uint32_t target, target_offset, filter_tc;
+};
+
+struct agx_power_config {
+	struct agx_power_pstate perf_states[AGX_POWER_MAX_PSTATES];
+	struct agx_power_pstate cs_states[16], afr_states[8];
+	struct agx_power_zone power_zones[AGX_POWER_MAX_ZONES];
+	uint32_t num_perf_states, num_power_zones, num_voltages;
+	uint32_t num_cs_states, num_afr_states, csafr_min_sram_microvolt;
+	agx_f32 core_leak_coef[4], sram_leak_coef[4];
+	agx_f32 cs_leak_coef, afr_leak_coef;
+	uint32_t max_power_mw, max_freq_mhz, perf_base_pstate, perf_max_pstate;
+	uint32_t min_sram_microvolt;
+	uint32_t avg_power_filter_tc_ms;
+	agx_f32 avg_power_ki_only, avg_power_kp;
+	uint32_t avg_power_min_duty_cycle, avg_power_target_filter_tc;
+	agx_f32 fast_die0_integral_gain, fast_die0_proportional_gain;
+	uint32_t fast_die0_prop_tgt_delta, fast_die0_release_temp;
+	uint32_t fender_idle_off_delay_ms, fw_early_wake_timeout_ms;
+	uint32_t idle_off_delay_ms, idle_off_standby_timer;
+	uint32_t perf_boost_ce_step, perf_boost_min_util;
+	uint32_t perf_filter_drop_threshold, perf_filter_time_constant;
+	uint32_t perf_filter_time_constant2;
+	agx_f32 perf_integral_gain, perf_integral_gain2;
+	uint32_t perf_integral_min_clamp;
+	agx_f32 perf_proportional_gain, perf_proportional_gain2;
+	uint32_t perf_reset_iters, perf_tgt_utilization, power_sample_period;
+	uint32_t ppm_filter_time_constant_ms;
+	agx_f32 ppm_ki, ppm_kp;
+	uint32_t pwr_filter_time_constant;
+	agx_f32 pwr_integral_gain;
+	uint32_t pwr_integral_min_clamp, pwr_min_duty_cycle;
+	agx_f32 pwr_proportional_gain;
+	uint32_t pwr_sample_period_aic_clks;
+	int32_t se_engagement_criteria;
+	uint32_t se_filter_time_constant, se_filter_time_constant_1;
+	uint32_t se_inactive_threshold;
+	agx_f32 se_ki, se_ki_1, se_kp, se_kp_1;
+	uint32_t se_reset_criteria;
+};
+
+/* On error the output is cleared. No dynamic resources are retained. */
+int agx_power_load(int, struct agx_power_config *);
+void agx_power_fini(struct agx_power_config *);
+
+#endif
