+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* T8103 ASC and SGX registers used by the Asahi firmware protocol. */
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/systm.h>
+#include <machine/bus.h>
+#include <dev/ofw/openfirm.h>
+#include <dev/ofw/fdt.h>
+
+#include "agx_device.h"
+#include "agx_fw.h"
+#include "agx_uat.h"
+#include "agx_identity.h"
+
+#define AGX_ASC_CPU_CONTROL	0x44
+#define AGX_ASC_CPU_RUN		(1U << 4)
+#define AGX_SGX_FAULT_INFO	0x17030
+#define AGX_SGX_FAULT_INFO_G14X 0xd8c0
+#define AGX_SGX_FAULT_ADDR_G14X 0xd8c8
+#define AGX_SGX_CORE_MASK_0	0xd01500
+#define AGX_SGX_CORE_MASK_1	0xd01514
+#define AGX_SGX_ID_VERSION	0xd04000
+#define AGX_SGX_ID_UNK08	0xd04008
+#define AGX_SGX_ID_COUNTS_1	0xd04010
+#define AGX_SGX_ID_COUNTS_2	0xd04014
+#define AGX_SGX_ID_UNK18	0xd04018
+#define AGX_SGX_ID_CLUSTERS	0xd0401c
+
+int
+agx_hw_reserved_regions(int node, struct agx_fw_regions *regions)
+{
+	static const char *const names[] = { "handoff", "ttbs", "pagetables" };
+	struct agx_fw_region *dst[3];
+	struct fdt_reg reg;
+	uint32_t *phandles;
+	int len, index, error, i, j;
+	void *fdt_node;
+
+	if (node == 0 || regions == NULL)
+		return EINVAL;
+	len = OF_getproplen(node, "memory-region");
+	if (len <= 0 || len > 4096 || (len % sizeof(*phandles)) != 0)
+		return EINVAL;
+	phandles = malloc(len, M_TEMP, M_WAITOK);
+	if (OF_getpropintarray(node, "memory-region", phandles, len) != len) {
+		error = EINVAL;
+		goto out;
+	}
+	memset(regions, 0, sizeof(*regions));
+	dst[0] = &regions->handoff;
+	dst[1] = &regions->ttbs;
+	dst[2] = &regions->pagetables;
+	for (i = 0; i < 3; i++) {
+		index = OF_getindex(node, names[i], "memory-region-names");
+		if (index < 0 || index >= len / sizeof(*phandles)) {
+			error = EINVAL;
+			goto out;
+		}
+		fdt_node = fdt_find_phandle(phandles[index]);
+		error = fdt_get_reg(fdt_node, 0, &reg);
+		if (error != 0 || reg.size == 0 ||
+		    reg.addr > (paddr_t)-1 - reg.size) {
+			error = EINVAL;
+			goto out;
+		}
+		dst[i]->addr = reg.addr;
+		dst[i]->size = reg.size;
+	}
+	for (i = 0; i < 3; i++) {
+		for (j = i + 1; j < 3; j++) {
+			if (dst[i]->addr < dst[j]->addr + dst[j]->size &&
+			    dst[j]->addr < dst[i]->addr + dst[i]->size) {
+				error = EINVAL;
+				goto out;
+			}
+		}
+	}
+	if ((regions->pagetables.addr & 0x3fff) != 0 ||
+	    regions->pagetables.size < 0x4000) {
+		error = EINVAL;
+		goto out;
+	}
+	error = 0;
+out:
+	free(phandles, M_TEMP, len);
+	if (error)
+		memset(regions, 0, sizeof(*regions));
+	return error;
+}
+
+int
+agx_hw_read_id(const struct agx_resources *res, struct agx_hw_id *id)
+{
+	if (res == NULL || id == NULL || res->iot == NULL ||
+	    res->sgx_size < AGX_SGX_ID_CLUSTERS + 4)
+		return EINVAL;
+	id->version = bus_space_read_4(res->iot, res->sgx, AGX_SGX_ID_VERSION);
+	id->unk08 = bus_space_read_4(res->iot, res->sgx, AGX_SGX_ID_UNK08);
+	id->counts1 = bus_space_read_4(res->iot, res->sgx, AGX_SGX_ID_COUNTS_1);
+	id->counts2 = bus_space_read_4(res->iot, res->sgx, AGX_SGX_ID_COUNTS_2);
+	id->unk18 = bus_space_read_4(res->iot, res->sgx, AGX_SGX_ID_UNK18);
+	id->clusters = bus_space_read_4(res->iot, res->sgx, AGX_SGX_ID_CLUSTERS);
+	id->core_mask[0] = bus_space_read_4(res->iot, res->sgx, AGX_SGX_CORE_MASK_0);
+	id->core_mask[1] = bus_space_read_4(res->iot, res->sgx, AGX_SGX_CORE_MASK_1);
+	return 0;
+}
+
+int
+agx_hw_read_fault(const struct agx_resources *res, struct agx_hw_fault *fault)
+{
+	uint64_t value, address;
+	int g14x;
+
+	if (res == NULL || fault == NULL || res->iot == NULL)
+		return EINVAL;
+	g14x = res->node != 0 && OF_is_compatible(res->node, "apple,agx-t6021");
+	if (res->sgx_size < (g14x ? AGX_SGX_FAULT_ADDR_G14X + 8 :
+	    AGX_SGX_FAULT_INFO + 8))
+		return EINVAL;
+	value = bus_space_read_8(res->iot, res->sgx,
+	    g14x ? AGX_SGX_FAULT_INFO_G14X : AGX_SGX_FAULT_INFO);
+	if ((value & 1) == 0)
+		return ENOENT;
+	address = g14x ? bus_space_read_8(res->iot, res->sgx,
+	    AGX_SGX_FAULT_ADDR_G14X) : value >> 30;
+	fault->address = address << 6;
+	fault->sideband = (value >> 23) & 0x7f;
+	fault->vm_slot = (value >> 17) & 0x3f;
+	fault->unit = (value >> 9) & 0xff;
+	fault->level = (value >> 7) & 3;
+	fault->unknown = (value >> 5) & 3;
+	fault->read = (value >> 4) & 1;
+	fault->reason = (value >> 1) & 7;
+	return 0;
+}
+
+/* Power must be on; the ASC starts before UAT handoff initialization. */
+int
+agx_hw_start_cpu(const struct agx_resources *res)
+{
+	uint32_t control;
+
+	if (res == NULL || res->iot == NULL ||
+	    res->asc_size < AGX_ASC_CPU_CONTROL + 4)
+		return EINVAL;
+	control = bus_space_read_4(res->iot, res->asc, AGX_ASC_CPU_CONTROL);
+	bus_space_write_4(res->iot, res->asc, AGX_ASC_CPU_CONTROL,
+	    control | AGX_ASC_CPU_RUN);
+	bus_space_barrier(res->iot, res->asc, AGX_ASC_CPU_CONTROL, 4,
+	    BUS_SPACE_BARRIER_WRITE);
+	return 0;
+}
+
+struct agx_hw_io_desc {
+	uint64_t phys;
+	uint32_t size;
+	uint32_t stride;
+	uint8_t index, writable, count;
+};
+
+/* hw/t8103.rs and hw/t602x.rs; T6021 has one die. */
+static const struct agx_hw_io_desc agx_t8103_io[] = {
+	{ 0x204d00000ULL, 0x1c000, 0, 0, 1, 1 },
+	{ 0x20e100000ULL, 0x4000, 0, 1, 0, 1 },
+	{ 0x23b104000ULL, 0x4000, 0, 2, 1, 1 },
+	{ 0x204000000ULL, 0x20000, 0, 3, 1, 1 },
+	{ 0x23b2e8000ULL, 0x1000, 0, 7, 0, 1 },
+	{ 0x23bc00000ULL, 0x1000, 0, 8, 1, 1 },
+	{ 0x204d80000ULL, 0x5000, 0, 9, 1, 1 },
+	{ 0x204d61000ULL, 0x1000, 0, 10, 1, 1 },
+	{ 0x200000000ULL, 0xd6400, 0, 11, 1, 1 },
+	{ 0x23b738000ULL, 0x1000, 0, 13, 1, 1 },
+};
+static const struct agx_hw_io_desc agx_t6021_io[] = {
+	{ 0x404d00000ULL, 0x144000, 0, 0, 1, 1 },
+	{ 0x20e100000ULL, 0x4000, 0, 1, 0, 1 },
+	{ 0x28e106000ULL, 0x4000, 0, 2, 1, 1 },
+	{ 0x404000000ULL, 0x20000, 0, 3, 1, 1 },
+	{ 0x28e478000ULL, 0x4000, 0, 7, 0, 1 },
+	{ 0x404e08000ULL, 0x8000, 0, 9, 1, 1 },
+	{ 0x200000000ULL, 0xd8000, 0x1000000, 11, 1, 8 },
+	{ 0x28e118000ULL, 0x4000, 0, 12, 0, 1 },
+	{ 0x28e3d0000ULL, 0x4000, 0, 18, 1, 1 },
+	{ 0x28e3c0000ULL, 0x4000, 0, 19, 0, 1 },
+	{ 0x28e3d8000ULL, 0x4000, 0, 20, 1, 1 },
+	{ 0x404eac000ULL, 0x4000, 0, 21, 1, 1 },
+};
+
+int
+agx_hw_map_firmware_io(struct agx_fw_iomaps *maps, struct agx_uat_pt *pt,
+    struct agx_fw_io_mapping *out, size_t count, const struct agx_identity *id,
+    uint64_t *sram_va)
+{
+	const struct agx_hw_io_desc *desc, *table;
+	uint64_t va = 0xffffffaf00000000ULL, base, offset, size, first;
+	size_t ndesc;
+	unsigned int i, j;
+	int error;
+
+	if (maps == NULL || pt == NULL || out == NULL || id == NULL ||
+	    sram_va == NULL || maps->count != 0)
+		return EINVAL;
+	if (id->gpu_gen == 13 && id->gpu_variant == 'G' &&
+	    (count == AGX_FW_IO_MAPPING_COUNT_12_3 ||
+	    count == AGX_FW_IO_MAPPING_COUNT_13_5)) {
+		table = agx_t8103_io;
+		ndesc = nitems(agx_t8103_io);
+	} else if (id->gpu_gen == 14 && id->gpu_variant == 'C' &&
+	    count == AGX_FW_IO_MAPPING_COUNT_13_5) {
+		table = agx_t6021_io;
+		ndesc = nitems(agx_t6021_io);
+	} else
+		return EOPNOTSUPP;
+	*sram_va = 0;
+	maps->pt = pt;
+	memset(out, 0, count * sizeof(*out));
+	for (i = 0; i < ndesc; i++) {
+		desc = &table[i];
+		offset = desc->phys & 0x3fff;
+		base = desc->phys - offset;
+		size = (offset + desc->size + 0x3fff) & ~0x3fffULL;
+		first = va;
+		for (j = 0; j < desc->count; j++) {
+			error = agx_uat_pt_map_io(pt, va, base + (uint64_t)j *
+			    desc->stride, size, desc->writable);
+			if (error)
+				return error;
+			maps->map[maps->count].va = va;
+			maps->map[maps->count].size = size;
+			maps->count++;
+			va += size;
+		}
+		out[desc->index].phys_addr.value = desc->phys;
+		out[desc->index].virt_addr.value = first + offset;
+		out[desc->index].total_size = desc->size * desc->count;
+		out[desc->index].element_size = desc->size;
+		out[desc->index].readwrite.value = desc->writable;
+		va += 0x4000; /* Unmapped guard page. */
+	}
+	if (table == agx_t6021_io) {
+		error = agx_uat_pt_map_fw_shared_phys(pt, va, 0x404d60000ULL, 0x20000);
+		if (error)
+			return error;
+		maps->map[maps->count].va = va;
+		maps->map[maps->count].size = 0x20000;
+		maps->count++;
+		*sram_va = va;
+	}
+	return 0;
+}
+
+int
+agx_hw_unmap_firmware_io(struct agx_fw_iomaps *maps)
+{
+	unsigned int index;
+	int error;
+
+	if (maps == NULL || (maps->count != 0 && maps->pt == NULL))
+		return EINVAL;
+	while (maps->count != 0) {
+		index = maps->count - 1;
+		error = agx_uat_pt_unmap(maps->pt, maps->map[index].va,
+		    maps->map[index].size);
+		if (error)
+			return error;
+		maps->count--;
+	}
+	maps->pt = NULL;
+	return 0;
+}
