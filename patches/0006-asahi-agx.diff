+++ sys/dev/pci/drm/asahi/agx_submit.h	Tue Nov 17 15:55:57 2026
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef _AGX_SUBMIT_H_
+#define _AGX_SUBMIT_H_
+
+#include <sys/types.h>
+
+struct agx_heap;
+struct agx_file_queue;
+struct agx_queue_owner;
+struct agx_sched;
+struct agx_sync;
+struct agx_timestamp_file;
+
+/* Firmware heaps outlive retained queue jobs. Timestamp lookups are pinned
+ * during submission; the timestamp table itself need not outlive the file.
+ * Statistics addresses are runtime object bases. */
+struct agx_submit_config {
+	struct agx_heap *shared, *private, *gpu_ro, *gpu;
+	struct agx_timestamp_file *timestamps;
+	uint64_t stats_vtx, stats_frag, stats_comp, usc_exec_base;
+	uint32_t core_mask[3], queue_id;
+	unsigned int version, g14x, clusters;
+};
+
+/* The input command buffer is a private kernel copy, stable until return.
+ * The ioctl caller holds one kernel-lock level, dropped during validation.
+ * Commands are copied and validated before acceptance. Input and output syncs
+ * remain caller-owned; VM binding, snapshot and encoding occur asynchronously
+ * after input dependencies. Success publishes output fences. Shared-BO
+ * submissions pass their referenced, unlocked queue for nonblocking admission.
+ * Legacy submissions pass NULL with the queue submit lock held. */
+int agx_submit(struct agx_sched *, struct agx_queue_owner *,
+    const struct agx_submit_config *, const void *, size_t,
+    struct agx_sync *, size_t, size_t, uint64_t, struct agx_file_queue *);
+
+#endif
