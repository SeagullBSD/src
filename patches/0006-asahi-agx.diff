--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_float.c	Fri Nov  6 01:48:11 2026
@@ -0,0 +1,170 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/*
+ * Integer-only binary32 arithmetic for AGX firmware power configuration.
+ * Derived from the Asahi GPU driver's float.rs.  As in that implementation,
+ * subnormals are flushed to zero and operations are not fully IEEE 754.
+ */
+#include <sys/types.h>
+
+#include "agx_float.h"
+
+struct agx_f32_unpacked {
+	int sign;
+	int32_t exp;
+	int64_t frac;
+};
+
+static struct agx_f32_unpacked
+agx_f32_normalize(struct agx_f32_unpacked value)
+{
+	int leading;
+
+	if (value.frac == 0) {
+		value.exp = 0;
+		return value;
+	}
+
+	leading = __builtin_clzll((uint64_t)value.frac);
+	if (leading > 31) {
+		value.frac <<= leading - 31;
+		value.exp -= leading - 31;
+	} else if (leading < 31) {
+		value.frac >>= 31 - leading;
+		value.exp += 31 - leading;
+	}
+	if (value.exp < -126) {
+		value.frac = 0;
+		value.exp = 0;
+	}
+	return value;
+}
+
+static struct agx_f32_unpacked
+agx_f32_unpack(agx_f32 bits)
+{
+	struct agx_f32_unpacked value;
+
+	value.sign = (bits >> 31) != 0;
+	value.exp = (int32_t)((bits >> 23) & 0xff) - 127;
+	value.frac = (int64_t)((bits & 0x7fffffU) | 0x800000U) << 9;
+	return agx_f32_normalize(value);
+}
+
+static agx_f32
+agx_f32_pack(struct agx_f32_unpacked value)
+{
+	value = agx_f32_normalize(value);
+	if (value.frac != 0) {
+		value.frac += 0x100;
+		value = agx_f32_normalize(value);
+	}
+	if (value.exp > 127)
+		return (value.sign ? 0xff800000U : 0x7f800000U);
+	if (value.frac == 0)
+		return (value.sign ? 0x80000000U : 0);
+	return (value.sign ? 0x80000000U : 0) |
+	    ((uint32_t)(value.exp + 127) << 23) |
+	    ((uint32_t)(value.frac >> 9) & 0x7fffffU);
+}
+
+agx_f32
+agx_f32_from_u32(uint32_t value)
+{
+	struct agx_f32_unpacked number = { 0, 32, value };
+
+	return agx_f32_pack(number);
+}
+
+agx_f32
+agx_f32_from_i32(int32_t value)
+{
+	struct agx_f32_unpacked number = { value < 0, 32,
+	    value < 0 ? -(int64_t)value : (int64_t)value };
+
+	return agx_f32_pack(number);
+}
+
+agx_f32
+agx_f32_neg(agx_f32 value)
+{
+	return value ^ 0x80000000U;
+}
+
+static void
+agx_f32_align(struct agx_f32_unpacked *a, struct agx_f32_unpacked *b)
+{
+	struct agx_f32_unpacked *small, *large;
+	int32_t shift;
+
+	if (a->exp > b->exp) {
+		large = a;
+		small = b;
+	} else {
+		large = b;
+		small = a;
+	}
+	shift = large->exp - small->exp;
+	if (shift > 63)
+		small->frac = 0;
+	else
+		small->frac >>= shift;
+	small->exp = large->exp;
+}
+
+agx_f32
+agx_f32_add(agx_f32 lhs, agx_f32 rhs)
+{
+	struct agx_f32_unpacked a = agx_f32_unpack(lhs);
+	struct agx_f32_unpacked b = agx_f32_unpack(rhs);
+
+	agx_f32_align(&a, &b);
+	if (a.sign == b.sign)
+		a.frac += b.frac;
+	else
+		a.frac -= b.frac;
+	if (a.frac < 0) {
+		a.sign = !a.sign;
+		a.frac = -a.frac;
+	}
+	return agx_f32_pack(a);
+}
+
+agx_f32
+agx_f32_sub(agx_f32 lhs, agx_f32 rhs)
+{
+	return agx_f32_add(lhs, agx_f32_neg(rhs));
+}
+
+agx_f32
+agx_f32_mul(agx_f32 lhs, agx_f32 rhs)
+{
+	struct agx_f32_unpacked a = agx_f32_unpack(lhs);
+	struct agx_f32_unpacked b = agx_f32_unpack(rhs);
+	struct agx_f32_unpacked result;
+
+	result.sign = a.sign != b.sign;
+	result.exp = a.exp + b.exp;
+	result.frac = ((a.frac >> 8) * (b.frac >> 8)) >> 16;
+	return agx_f32_pack(result);
+}
+
+agx_f32
+agx_f32_div(agx_f32 lhs, agx_f32 rhs)
+{
+	struct agx_f32_unpacked a = agx_f32_unpack(lhs);
+	struct agx_f32_unpacked b = agx_f32_unpack(rhs);
+	struct agx_f32_unpacked result;
+
+	if (b.frac == 0 || a.exp > 127)
+		return (a.sign ? 0xff800000U : 0x7f800000U);
+	result.sign = a.sign != b.sign;
+	result.exp = a.exp - b.exp;
+	result.frac = (a.frac << 24) / (b.frac >> 8);
+	return agx_f32_pack(result);
+}
+
+int
+agx_f32_isfinite(agx_f32 value)
+{
+	return (value & 0x7f800000U) != 0x7f800000U;
+}
