@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef _AGX_CONTEXT_H_
+#define _AGX_CONTEXT_H_
+
+#include <sys/types.h>
+#include <machine/bus.h>
+
+struct agx_context_vm;
+struct agx_gpu_context;
+struct agx_uat_handoff;
+struct agx_vm;
+struct agx_fwctl;
+struct agx_fw_devctl;
+struct agx_fw_gpu_context_data;
+struct agx_heap;
+struct dma_resv;
+
+/*
+ * The handoff and control channel outlive the VM.  The two object heaps and
+ * reservation object are shared by all queues and private BOs for this VM.
+ * All puts, binds and unbinds are sleepable; callers must defer them from IRQ.
+ */
+int agx_context_vm_create(struct agx_uat_handoff *, bus_dma_tag_t, uint64_t,
+    uint64_t, struct agx_fwctl *, struct agx_fw_devctl *,
+    struct agx_context_vm **);
+int agx_context_vm_get(struct agx_context_vm *);
+void agx_context_vm_put(struct agx_context_vm *);
+/* Set before publishing the VM; callback runs once on final put, before
+ * teardown, and returns an errno without releasing retained state on error. */
+int agx_context_vm_set_release(struct agx_context_vm *, int (*)(void *), void *);
+struct agx_vm *agx_context_vm_raw(struct agx_context_vm *);
+struct dma_resv *agx_context_vm_resv(struct agx_context_vm *);
+struct agx_heap *agx_context_vm_shared_heap(struct agx_context_vm *);
+struct agx_heap *agx_context_vm_private_heap(struct agx_context_vm *);
+
+/*
+ * One GPU context belongs to one queue.  Its owner and every job/event/worker
+ * which may touch queue state hold a reference.  The release callback owns
+ * the dependent queue allocations, and runs only after DestroyContext has
+ * been acknowledged and all such references/bindings have gone away.  If
+ * invalidation or release fails, the complete remaining state is retained.
+ * The callback must retain anything it cannot release and return an errno.
+ * The firmware heap, device-control channel, and callback cookie must outlive
+ * the context, including a poisoned context after an error or GPU crash.
+ */
+typedef int (*agx_context_release_fn)(void *);
+int agx_gpu_context_create(struct agx_context_vm *, struct agx_heap *,
+    struct agx_fw_devctl *, agx_context_release_fn, void *,
+    struct agx_gpu_context **);
+int agx_gpu_context_get(struct agx_gpu_context *);
+void agx_gpu_context_put(struct agx_gpu_context *);
+/* Caller prevents new submissions and holds a reference.  EBUSY means jobs
+ * or pending binds remain; retry after they retire.  Success closes the
+ * context and acknowledges DestroyContext exactly once, while tail pins
+ * remain held.  Any firmware error permanently poisons and retains it. */
+int agx_gpu_context_invalidate(struct agx_gpu_context *);
+struct agx_context_vm *agx_gpu_context_vm(struct agx_gpu_context *);
+struct agx_fw_gpu_context_data *agx_gpu_context_cpu(struct agx_gpu_context *);
+uint64_t agx_gpu_context_gpu(struct agx_gpu_context *);
+
+/* Each successful bind owns a context reference until its matching unbind.
+ * A failed fence or crash notification is not retirement: retain the bind
+ * and all job references until firmware completion or proven GPU stop. */
+int agx_gpu_context_bind(struct agx_gpu_context *, uint32_t *, const int *,
+    const int *);
+int agx_gpu_context_unbind(struct agx_gpu_context *);
+/* Pin the active VM slot independently of execution; release each pin only
+ * when superseded by a later completed tail or after context invalidation. */
+int agx_gpu_context_tail_pin(struct agx_gpu_context *, uint32_t *);
+int agx_gpu_context_tail_unpin(struct agx_gpu_context *);
+
+#endif
