+
+struct sg_table;
+struct uvm_object;
+struct agx_dma_page;
+struct agx_resident_page;
+
+/*
+ * Owned DMA memory or a borrowed pinned scatterlist.  Imported memory has
+ * no CPU mapping here: its exporter controls CPU access and cache attributes.
+ * The caller must keep the attachment and pages pinned until all mappings,
+ * GPU work and the borrowed agx_mem have been destroyed.
+ */
+struct agx_mem {
+	bus_dma_tag_t dmat;
+	bus_dma_segment_t *segs;
+	int nsegs;
+	int batch_alloc;		/* segs came from one DMA allocation */
+	bus_size_t size;
+	unsigned int oas;		/* validated physical output width */
+	void *kva;
+	enum agx_mem_cache cache;
+	struct agx_dma_page *dma_pages;	/* native 16K-to-segment index */
+	paddr_t *pages;		/* 16K page bases for imported memory */
+	int lazy_kva;		/* pageable user BO mapping is on demand */
+	struct uvm_object *uao;	/* pageable native GEM backing, if any */
+	struct agx_resident_page *resident;
+	struct rwlock pin_lock;
+	unsigned int pin_count;
+	unsigned int retiring;	/* queued nonblocking pin releases */
+};
+
+int	agx_mem_alloc(bus_dma_tag_t, size_t, unsigned int, struct agx_mem **);
+int	agx_mem_alloc_mode(bus_dma_tag_t, size_t, enum agx_mem_cache,
+	    unsigned int, struct agx_mem **);
+int	agx_mem_native_tag(bus_dma_tag_t);
+/* GEM_CREATE ioctl process context; nonblock never waits for a sweep or retry. */
+int	agx_mem_alloc_gem(bus_dma_tag_t, size_t, enum agx_mem_cache,
+	    unsigned int, int, struct agx_mem **);
+int	agx_mem_import_sg(const struct sg_table *, size_t, unsigned int,
+	    struct agx_mem **);
+/* Pin transitions may sleep unless no_wait is set; ref requires a held pin. */
+int	agx_mem_pin(struct agx_mem *, int no_wait);
+void	agx_mem_pin_ref(struct agx_mem *);
+void	agx_mem_unpin(struct agx_mem *);
+/* Transfer one held pin to a queued worker, then retire it there. */
+void	agx_mem_retire_begin(struct agx_mem *);
+void	agx_mem_retire_end(struct agx_mem *);
+int	agx_mem_phys(const struct agx_mem *, uint64_t, paddr_t *);
+/* Caller holds the owning GEM reservation's cache lock. */
+int	agx_mem_vmap(struct agx_mem *);
+void	agx_mem_free(struct agx_mem *);
+/* BUS_DMASYNC_* transitions; imported backing must use exporter sync. */
+int	agx_mem_sync(struct agx_mem *, uint64_t, uint64_t, int);
+paddr_t	agx_mem_mmap(struct agx_mem *, off_t, int);
+
+/* UAT TLB invalidation uses CPU outer-shareable TLBI instructions. */
+void	agx_tlbi_all(void);
+void	agx_tlbi_asid(uint8_t);
+void	agx_tlbi_page(uint8_t, uint64_t);
+void	agx_tlbi_sync(void);
