+	e->gpu_se_filter_time_constant_ms = se_ms; e->gpu_se_filter_time_constant_1_ms = se1_ms; \
+	e->gpu_se_filter_time_constant_clks.value = se_clks; e->gpu_se_filter_time_constant_1_clks.value = se1_clks; \
+	e->unk_c4 = F65536; e->unk_114 = F65536; e->unk_124 = 40; e->max_pstate_scaled_2 = max; \
+} while (0)
+
+int
+agx_initdata_hw_a(void *dst, size_t len, unsigned major, unsigned minor,
+    const struct agx_power_config *p, const struct agx_identity *id)
+{
+	uint32_t base, max, release, delta, ppm4, avg4, target4, target_period;
+	uint32_t ppm_periods, avg_periods, zone4[5], zone_period[5];
+	uint32_t ppm_clks = 0, avg_clks = 0, target_clks = 0;
+	uint32_t se_ms = 0, se1_ms = 0, se_clks = 0, se1_clks = 0, coarse = 0;
+	uint32_t tmp, i;
+	agx_f32 period_s, pwr_a, ppm_a, perf_a, perf_a2, target_a, avg_a;
+	int v13, g14x, error;
+
+	if (dst == NULL || p == NULL || id == NULL || ((uintptr_t)dst & 3) != 0)
+		return EINVAL;
+	if (major == 12 && minor == 3)
+		v13 = 0;
+	else if (major == 13 && minor == 5)
+		v13 = 1;
+	else
+		return EINVAL;
+	g14x = id->gpu_gen == 14 && id->gpu_variant == 'C';
+	if (g14x && (!v13 || id->num_clusters == 0 || id->num_clusters > 4))
+		return EINVAL;
+	if (len < (g14x ? sizeof(struct agx_fw_hwdata_a_g14x_13_5) :
+	    v13 ? sizeof(struct agx_fw_hwdata_a_13_5) :
+	    sizeof(struct agx_fw_hwdata_a_12_3)))
+		return EINVAL;
+	if (!p->power_sample_period || !p->max_power_mw ||
+	    !p->pwr_filter_time_constant || !p->perf_filter_time_constant ||
+	    !p->perf_filter_time_constant2 || !p->avg_power_target_filter_tc ||
+	    (v13 && (!p->se_filter_time_constant || !p->se_filter_time_constant_1)) ||
+	    p->num_perf_states > AGX_POWER_MAX_PSTATES ||
+	    p->num_power_zones > AGX_POWER_MAX_ZONES ||
+	    p->perf_max_pstate < p->perf_base_pstate)
+		return EINVAL;
+	ppm_periods = p->ppm_filter_time_constant_ms / p->power_sample_period;
+	avg_periods = p->avg_power_filter_tc_ms / p->power_sample_period;
+	if (!ppm_periods || !avg_periods)
+		return EINVAL;
+#define PRODUCT(a, b, out) do { if (agx_hw_a_product((a), (b), &(out))) return EOVERFLOW; } while (0)
+	PRODUCT(p->perf_base_pstate, 100, base);
+	PRODUCT(p->perf_max_pstate, 100, max);
+	if (max > INT32_MAX || p->pwr_min_duty_cycle > INT32_MAX)
+		return EOVERFLOW;
+	PRODUCT(p->fast_die0_release_temp, 100, release);
+	PRODUCT(p->fast_die0_prop_tgt_delta, 100, delta);
+	PRODUCT(ppm_periods, 4, ppm4); PRODUCT(avg_periods, 4, avg4);
+	PRODUCT(p->avg_power_target_filter_tc, 4, target4);
+	PRODUCT(p->power_sample_period, p->avg_power_target_filter_tc, target_period);
+	for (i = 0; i < p->num_power_zones; i++) {
+		if (!p->power_zones[i].filter_tc ||
+		    p->power_zones[i].target_offset > p->power_zones[i].target)
+			return EINVAL;
+		PRODUCT(p->power_zones[i].filter_tc, 4, zone4[i]);
+		PRODUCT(p->power_zones[i].filter_tc, p->power_sample_period, zone_period[i]);
+	}
+	if (v13) {
+		PRODUCT(ppm_periods, p->power_sample_period, tmp); PRODUCT(tmp, 24000, ppm_clks);
+		PRODUCT(avg_periods, p->power_sample_period, tmp); PRODUCT(tmp, 24000, avg_clks);
+		PRODUCT(target_period, 24000, target_clks);
+		PRODUCT(p->se_filter_time_constant, p->power_sample_period, se_ms);
+		PRODUCT(p->se_filter_time_constant_1, p->power_sample_period, se1_ms);
+		PRODUCT(24000, p->power_sample_period, coarse);
+		PRODUCT(p->se_filter_time_constant, coarse, se_clks);
+		PRODUCT(p->se_filter_time_constant_1, coarse, se1_clks);
+	}
+#undef PRODUCT
+	period_s = agx_f32_div(F32U(p->power_sample_period), F32U(1000));
+	pwr_a = RECIP(p->pwr_filter_time_constant); ppm_a = RECIP(ppm_periods);
+	perf_a = RECIP(p->perf_filter_time_constant); perf_a2 = RECIP(p->perf_filter_time_constant2);
+	target_a = RECIP(p->avg_power_target_filter_tc); avg_a = RECIP(avg_periods);
+	if (!v13) {
+		struct agx_fw_hwdata_a_12_3 *a = dst;
+		memset(a, 0, sizeof(*a));
+		INITIALIZE_COMMON(a);
+		a->fast_die0_sensor_present.value = 1;
+		a->t81xx_data.unk_d8c = 0x80000000;
+		a->t81xx_data.unk_d90 = 4; a->t81xx_data.unk_d9c = 0x3f19999a;
+		a->t81xx_data.unk_da4 = 0x3ecccccd; a->t81xx_data.unk_dac = 0x3ec562e1;
+		a->t81xx_data.unk_db8 = F65536; a->t81xx_data.unk_dbc = 0x4158f5c3;
+		a->t81xx_data.max_pstate_scaled = max;
+	} else if (g14x) {
+		struct agx_fw_hwdata_a_g14x_13_5 *a = dst;
+		memset(a, 0, sizeof(*a));
+		INITIALIZE_V13(a);
+		a->fast_die0_sensor_mask.value = 0x40005000c000d00ULL;
+		a->fast_die0_sensor_mask_2.value = 0x40005000c000d00ULL;
+		a->fast_die0_sensor_mask_alt.value = 0x140015001d001d00ULL;
+		a->unk_87c = 500; a->unk_8cc = 11000; a->unk_e24 = 125;
+		error = agx_init_hw_shared(&a->hws1, &a->hws2, &a->hws3, p, 1);
+		if (error) return error;
+		for (i = 0; i < 16; i++) {
+			uint16_t t = a->hws2.g14.curve2.t1[i];
+			a->unk_hws2[i] = t == 0xffff ? 0 : t / 2;
+		}
+		for (i = 0; i < 4; i++) {
+			a->core_leak_coef[i] = p->core_leak_coef[i];
+			a->sram_leak_coef[i] = p->sram_leak_coef[i];
+		}
+		a->aux_leak_coef.cs_1[0] = a->aux_leak_coef.cs_2[0] = p->afr_leak_coef;
+		a->aux_leak_coef.afr_1[0] = a->aux_leak_coef.afr_2[0] = p->cs_leak_coef;
+		for (i = 0; i < id->num_clusters; i++) {
+			if (i == 0 || i == 2) {
+				a->unk_coef_a1[i][1] = a->unk_coef_a2[i][1] = 0x41033333;
+				a->unk_coef_b1[i][1] = a->unk_coef_b2[i][1] = 0x41100000;
+			}
+			a->unk_coef_a1[i][3] = a->unk_coef_a2[i][3] = 0x40dccccd;
+			a->unk_coef_b1[i][3] = a->unk_coef_b2[i][3] = 0x41000000;
+			if (i < 2) {
+				a->unk_coef_a1[i][4] = a->unk_coef_a2[i][4] = 0x40dccccd;
+				a->unk_coef_b1[i][4] = a->unk_coef_b2[i][4] = 0x41000000;
+			}
+		}
+	} else {
+		struct agx_fw_hwdata_a_13_5 *a = dst;
+		memset(a, 0, sizeof(*a));
+		INITIALIZE_V13(a);
+	}
+	return 0;
+}
