+		n->generation = (uint32_t)id;
+		n->unk_10 = 0x50;
+	}
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		pipe = &owner->pipes[i];
+		pipe->channel = agx_channel_bank_pipe(bank, priority, i);
+		if (pipe->channel == NULL) {
