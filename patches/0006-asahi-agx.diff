+struct agx_dma_page {
+	paddr_t pa;
+	int segment;
+};
+
+struct agx_resident_page {
+	struct vm_page *src;
+	struct vm_page *dst;
+};
+
+
+
+
+/* Limit staged page frees per free-page queue lock hold. */
+#define AGX_DMA_FREE_PAGES 256
+#define AGX_DMA_CHUNK_SIZE (AGX_DMA_FREE_PAGES * PAGE_SIZE)
+/* Retry for roughly one second under sustained allocation pressure. */
+#define AGX_DMA_RETRIES 16
+/* Maximum free ranges inspected per free-page queue lock hold. */
+#define AGX_PMR_SCAN_BATCH 64
+
+
+/* Only the standard provider supports aggregating independently allocated
+ * segments into one kernel mapping while retaining their free boundaries. */
+int
+agx_mem_native_tag(bus_dma_tag_t dmat)
+{
+	return dmat != NULL && dmat->_dmamem_alloc == _dmamem_alloc &&
+	    dmat->_dmamem_free == _dmamem_free &&
+	    dmat->_dmamem_map == _dmamem_map &&
+	    dmat->_dmamem_unmap == _dmamem_unmap &&
+	    dmat->_dmamem_mmap == _dmamem_mmap;
+}
+
+
+
+/* Keep the DMA provider's descriptors intact; UAT needs a 16K page index. */
+static int
+agx_mem_alloc_batch(struct agx_mem *mem, int count, bus_size_t boundary,
+    int flags)
+{
+	struct agx_dma_page *page;
+	uint64_t total = 0, offset;
+	int error, i, nseg, npages = 0;
+
+	/* Allow contiguous 16K pages to coalesce; validate each segment. */
+	error = bus_dmamem_alloc(mem->dmat, mem->size, AGX_PAGE_SIZE,
+	    boundary, mem->segs, count, &nseg, flags | BUS_DMA_ZERO);
+	if (error != 0) {
+		memset(mem->segs, 0, (size_t)count * sizeof(*mem->segs));
+		return error;
+	}
+	KASSERT(nseg > 0 && nseg <= count);
+	mem->nsegs = nseg;
+	mem->batch_alloc = 1;
+	for (i = 0; i < nseg; i++) {
+		bus_dma_segment_t *seg = &mem->segs[i];
+
+		if ((seg->ds_addr & AGX_PAGE_MASK) != 0 || seg->ds_len == 0 ||
+		    (seg->ds_len & AGX_PAGE_MASK) != 0 ||
+		    seg->ds_addr >= (1ULL << mem->oas) ||
+		    seg->ds_len > (1ULL << mem->oas) - seg->ds_addr ||
+		    seg->ds_len > mem->size - total) {
+			error = EINVAL;
+			goto fail;
+		}
+		total += seg->ds_len;
+	}
+	if (total != mem->size) {
+		error = EINVAL;
+		goto fail;
+	}
+	if (nseg == 1 || nseg == count)
+		return 0;
+	mem->dma_pages = mallocarray(count, sizeof(*mem->dma_pages), M_DEVBUF,
+	    M_NOWAIT | M_CANFAIL);
+	if (mem->dma_pages == NULL) {
+		error = ENOMEM;
+		goto fail;
+	}
+	for (i = 0; i < nseg; i++) {
+		for (offset = 0; offset < mem->segs[i].ds_len;
+		    offset += AGX_PAGE_SIZE) {
+			KASSERT(npages < count);
+			page = &mem->dma_pages[npages++];
+			page->pa = mem->segs[i].ds_addr + offset;
+			page->segment = i;
+		}
+	}
+	KASSERT(npages == count);
+	return 0;
+fail:
+	bus_dmamem_free(mem->dmat, mem->segs, mem->nsegs);
+	mem->nsegs = 0;
+	mem->batch_alloc = 0;
+	memset(mem->segs, 0, (size_t)count * sizeof(*mem->segs));
+	return error;
+}
+
+static void
+agx_mem_free_backing(struct agx_mem *mem)
+{
+	size_t count = mem->size >> AGX_PAGE_SHIFT;
+	int i;
+
+	if (mem->batch_alloc)
+		bus_dmamem_free(mem->dmat, mem->segs, mem->nsegs);
+	else
+		for (i = 0; i < mem->nsegs; i++)
+			bus_dmamem_free(mem->dmat, &mem->segs[i], 1);
+	if (mem->dma_pages != NULL)
+		free(mem->dma_pages, M_DEVBUF, count * sizeof(*mem->dma_pages));
+	free(mem->segs, M_DEVBUF, count * sizeof(*mem->segs));
+}
+
+int
+agx_mem_alloc(bus_dma_tag_t dmat, size_t size, unsigned int oas,
+    struct agx_mem **out)
+{
+	return agx_mem_alloc_mode(dmat, size, AGX_MEM_NOCACHE, oas, out);
+}
+
+static int
+agx_mem_alloc_mode_policy(bus_dma_tag_t dmat, size_t size,
+    enum agx_mem_cache cache, unsigned int oas, int gem,
+    struct agx_mem **out)
+{
+	struct agx_mem *mem;
+	int error, nseg, i, count, map_flags;
+	int alloc_flags = M_NOWAIT | M_CANFAIL;
+	int dma_flags = BUS_DMA_NOWAIT;
+
+	if (dmat == NULL || out == NULL || size == 0 ||
+	    size > SIZE_MAX - AGX_PAGE_MASK || !AGX_UAT_OAS_VALID(oas) ||
+	    (cache != AGX_MEM_NOCACHE && cache != AGX_MEM_WRITEBACK))
+		return EINVAL;
+	*out = NULL;
+	size = (size + AGX_PAGE_MASK) & ~AGX_PAGE_MASK;
+	if ((size >> AGX_PAGE_SHIFT) > INT_MAX ||
+	    (size >> AGX_PAGE_SHIFT) > MALLOC_MAX / sizeof(*mem->segs))
+		return EFBIG;
+	count = size >> AGX_PAGE_SHIFT;
+	mem = malloc(sizeof(*mem), M_DEVBUF, alloc_flags | M_ZERO);
+	if (mem == NULL)
+		return ENOMEM;
+	mem->dmat = dmat;
+	mem->size = size;
+	mem->oas = oas;
+	mem->cache = cache;
+	mem->segs = mallocarray(count, sizeof(*mem->segs), M_DEVBUF,
+	    alloc_flags | M_ZERO);
+	if (mem->segs == NULL) {
+		free(mem, M_DEVBUF, sizeof(*mem));
+		return ENOMEM;
+	}
+	if (count > 1) {
+		error = agx_mem_alloc_batch(mem, count, 0, dma_flags);
+		if (error == 0)
+			goto map;
+		if (error != ENOMEM && error != EINVAL && error != EOPNOTSUPP)
+			goto free_seg;
+		if (gem) {
+			error = agx_mem_alloc_batch(mem, count, AGX_PAGE_SIZE,
+			    dma_flags);
+			if (error == 0)
+				goto map;
+			if (error != ENOMEM && error != EINVAL &&
+			    error != EOPNOTSUPP)
+				goto free_seg;
+		}
+	}
+	for (i = 0; i < count; i++) {
+		error = bus_dmamem_alloc(dmat, AGX_PAGE_SIZE, AGX_PAGE_SIZE, 0,
+		    &mem->segs[i], 1, &nseg, dma_flags | BUS_DMA_ZERO);
+		if (error != 0)
+			goto free_seg;
+		mem->nsegs++;
+		if (nseg != 1 || (mem->segs[i].ds_addr & AGX_PAGE_MASK) != 0 ||
+		    mem->segs[i].ds_len != AGX_PAGE_SIZE ||
+		    mem->segs[i].ds_addr > (1ULL << oas) - AGX_PAGE_SIZE) {
+			error = EINVAL;
+			goto free_seg;
+		}
+	}
+map:
+	map_flags = BUS_DMA_NOWAIT |
+	    (cache == AGX_MEM_NOCACHE ? BUS_DMA_NOCACHE : 0);
+	error = bus_dmamem_map(dmat, mem->segs, mem->nsegs, size,
+	    (caddr_t *)&mem->kva, map_flags);
+	if (error != 0)
+		goto free_seg;
+	*out = mem;
+	return 0;
+
+free_seg:
+	agx_mem_free_backing(mem);
+	free(mem, M_DEVBUF, sizeof(*mem));
+	return error;
+}
+
+int
+agx_mem_alloc_mode(bus_dma_tag_t dmat, size_t size, enum agx_mem_cache cache,
+    unsigned int oas, struct agx_mem **out)
+{
+	return agx_mem_alloc_mode_policy(dmat, size, cache, oas, 0, out);
+}
+
+
+
+/* Native GEM objects defer backing, descriptors and mappings until pin. */
+int
+agx_mem_alloc_gem(bus_dma_tag_t dmat, size_t size, enum agx_mem_cache cache,
+    unsigned int oas, int nonblock, struct agx_mem **out)
+{
+	struct agx_mem *mem;
+	size_t count;
+	int flags = (nonblock ? M_NOWAIT : M_WAITOK) | M_CANFAIL | M_ZERO;
+	unsigned int retries = 0, backoff = 1;
+	int error;
+
+	if (dmat == NULL || out == NULL || size == 0 ||
+	    size > SIZE_MAX - AGX_PAGE_MASK || !AGX_UAT_OAS_VALID(oas) ||
+	    (cache != AGX_MEM_NOCACHE && cache != AGX_MEM_WRITEBACK))
+		return EINVAL;
+	*out = NULL;
+	if (!agx_mem_native_tag(dmat)) {
+		/* Keep the provider's allocation and mapping descriptors intact. */
+		if (size > 512UL * 1024 * 1024)
+			return ENOMEM;
+		if (nonblock)
+			return EOPNOTSUPP;
+		for (;;) {
+			error = agx_mem_alloc_mode_policy(dmat, size, cache, oas, 1,
+			    out);
+			if (error != ENOMEM || retries++ == AGX_DMA_RETRIES)
+				return error;
+			wakeup(&uvm.pagedaemon);
+			error = tsleep_nsec(&nowake, PWAIT | PCATCH, "agxgmem",
+			    MSEC_TO_NSEC(backoff));
+			if (error != 0 && error != EWOULDBLOCK)
+				return error;
+			backoff = MIN(backoff * 2, 100U);
+		}
+	}
+	size = (size + AGX_PAGE_MASK) & ~AGX_PAGE_MASK;
+	count = size >> AGX_PAGE_SHIFT;
+	if (size > (1ULL << 39) || (size >> PAGE_SHIFT) > INT_MAX ||
+	    (size >> PAGE_SHIFT) > MALLOC_MAX / sizeof(struct agx_resident_page) ||
+	    count > INT_MAX || count > MALLOC_MAX / sizeof(*mem->segs))
+		return EFBIG;
+	mem = malloc(sizeof(*mem), M_DEVBUF, flags);
+	if (mem == NULL)
+		return ENOMEM;
+	mem->uao = uao_create(size, nonblock ? UAO_FLAG_CANFAIL : 0);
+	if (mem->uao == NULL) {
+		free(mem, M_DEVBUF, sizeof(*mem));
+		return ENOMEM;
+	}
+	mem->dmat = dmat;
+	mem->size = size;
+	mem->oas = oas;
+	mem->cache = cache;
+	mem->lazy_kva = 1;
+	rw_init(&mem->pin_lock, "agxpin");
+	*out = mem;
+	return 0;
+}
+
+
+static int
+agx_mem_quartet_valid(struct agx_resident_page *p, paddr_t low, paddr_t high)
+{
+	paddr_t pa = VM_PAGE_TO_PHYS(p[0].src);
+	size_t j;
+
+	if ((pa & AGX_PAGE_MASK) != 0 || pa < low || pa > high ||
+	    high - pa < AGX_PAGE_SIZE - 1)
+		return 0;
+	for (j = 1; j < AGX_PAGE_SIZE / PAGE_SIZE; j++)
+		if (VM_PAGE_TO_PHYS(p[j].src) != pa + j * PAGE_SIZE)
+			return 0;
+	return 1;
+}
+
+/* A failed sweep can have staged the entire BO; never free it under one
+ * free-page queue lock hold.  The pages are still private to the sweep. */
+static void
+agx_mem_free_staged(struct pglist *pages)
+{
+	struct pglist batch;
+	struct vm_page *pg;
+	unsigned int i;
+
+	while (!TAILQ_EMPTY(pages)) {
+		TAILQ_INIT(&batch);
+		for (i = 0; i < AGX_DMA_FREE_PAGES &&
+		    (pg = TAILQ_FIRST(pages)) != NULL; i++) {
+			TAILQ_REMOVE(pages, pg, pageq);
+			TAILQ_INSERT_TAIL(&batch, pg, pageq);
+		}
+		uvm_pglistfree(&batch);
+	}
+}
+
+/*
+ * Unlike uvm_pmr_getpages(), do not collect and evict partial segments while
+ * searching.  In particular, a boundary-limited multi-segment request can
+ * repeatedly reinsert the segment it just removed.  Even a single-segment
+ * request can scan the entire size tree while holding the free-page lock.
+ *
+ * Walk the address trees in bounded batches, resuming by page number rather
+ * than retaining tree pointers across unlocks.  Only extract complete,
+ * aligned UAT pages from one free range.  The UVM reserve, page accounting,
+ * zeroing and ownership transitions mirror uvm_pmr_getpages().
+ */
+static int
+agx_mem_get_run(paddr_t low, paddr_t end, paddr_t *next, size_t *run,
+    int zero, struct pglist *pages)
+{
+	struct uvm_pmemrange *pmr, *iter;
+	struct vm_page *pg, *found, *node;
+	paddr_t cursor, stop, start, limit, base, finish;
+	psize_t npages, wanted = *run * (AGX_PAGE_SIZE / PAGE_SIZE);
+	unsigned int scanned;
+	int pass;
+
+	KASSERT(TAILQ_EMPTY(pages));
+	start = *next;
+	if (start < low || start >= end)
+		start = low;
+	for (pass = 0; pass < 2; pass++) {
+		cursor = pass == 0 ? start : low;
+		stop = pass == 0 ? end : start;
+		while (cursor < stop) {
+			uvm_lock_fpageq();
+			/* Find the first pmemrange whose end exceeds cursor. */
+			pmr = NULL;
+			iter = RBT_ROOT(uvm_pmemrange_addr,
+			    &uvm.pmr_control.addr);
+			while (iter != NULL) {
+				if (iter->high <= cursor)
+					iter = RBT_RIGHT(uvm_pmemrange_addr, iter);
+				else {
+					pmr = iter;
+					iter = RBT_LEFT(uvm_pmemrange_addr, iter);
+				}
+			}
+			if (pmr == NULL || pmr->low >= stop) {
+				uvm_unlock_fpageq();
+				break;
+			}
+			cursor = MAX(cursor, pmr->low);
+			limit = MIN(stop, pmr->high);
+			/* Find the first free range whose end exceeds cursor. */
+			found = NULL;
+			node = RBT_ROOT(uvm_pmr_addr, &pmr->addr);
+			while (node != NULL) {
+				base = atop(VM_PAGE_TO_PHYS(node));
+				if (base + node->fpgsz <= cursor)
+					node = RBT_RIGHT(uvm_pmr_addr, node);
+				else {
+					found = node;
+					node = RBT_LEFT(uvm_pmr_addr, node);
+				}
+			}
+			for (scanned = 0; found != NULL && scanned <
+			    AGX_PMR_SCAN_BATCH; scanned++) {
+				base = atop(VM_PAGE_TO_PHYS(found));
+				if (base >= limit)
+					break;
+				finish = MIN(base + found->fpgsz, limit);
+				cursor = MAX(cursor, base);
+				cursor = roundup(cursor, AGX_PAGE_SIZE / PAGE_SIZE);
+				if (cursor < finish) {
+					npages = MIN(wanted, finish - cursor);
+					npages -= npages % (AGX_PAGE_SIZE / PAGE_SIZE);
+					if (npages != 0)
+						goto found_run;
+				}
+				cursor = finish;
+				found = RBT_NEXT(uvm_pmr_addr, found);
+			}
+			if (found == NULL || (found != NULL &&
+			    atop(VM_PAGE_TO_PHYS(found)) >= limit))
+				cursor = limit;
+			uvm_unlock_fpageq();
+		}
+	}
+	wakeup(&uvm.pagedaemon);
+	return ENOMEM;
+
+found_run:
+	if (atomic_load_sint(&uvmexp.free) <= uvmexp.reserve_kernel + npages ||
+	    atomic_load_sint(&uvmexp.free) <= uvmexp.reserve_pagedaemon + npages) {
+		uvm_unlock_fpageq();
+		wakeup(&uvm.pagedaemon);
+		return ENOMEM;
+	}
+	uvm_pmr_extract_range(pmr, found, cursor, cursor + npages, pages);
+	atomic_sub_int(&uvmexp.free, npages);
+	TAILQ_FOREACH(pg, pages, pageq) {
+		if (pg->pg_flags & PG_ZERO)
+			atomic_dec_int(&uvmexp.zeropages);
+	}
+	if (atomic_load_sint(&uvmexp.zeropages) < UVM_PAGEZERO_TARGET)
+		wakeup(&uvmexp.zeropages);
+	if ((atomic_load_sint(&uvmexp.free) - BUFPAGES_DEFICIT) <
+	    uvmexp.freemin ||
+	    ((atomic_load_sint(&uvmexp.free) - BUFPAGES_DEFICIT) <
+	    atomic_load_sint(&uvmexp.freetarg) &&
+	    (atomic_load_sint(&uvmexp.inactive) + BUFPAGES_INACT) <
+	    atomic_load_sint(&uvmexp.inactarg)))
+		wakeup(&uvm.pagedaemon);
+	uvm_unlock_fpageq();
+	TAILQ_FOREACH(pg, pages, pageq) {
+		atomic_clearbits_int(&pg->pg_flags, PG_PMAPMASK);
+		if (zero) {
+			if (pg->pg_flags & PG_ZERO)
+				atomic_inc_int(&uvmexp.pga_zerohit);
+			else {
+				atomic_inc_int(&uvmexp.pga_zeromiss);
+				uvm_pagezero(pg);
+			}
+		}
+		atomic_clearbits_int(&pg->pg_flags, PG_ZERO | PQ_FREE);
+		KASSERT(pg->uobject == NULL && pg->uanon == NULL);
+		pg->pg_version++;
+	}
+	*next = cursor + npages;
+	*run = npages / (AGX_PAGE_SIZE / PAGE_SIZE);
+	return 0;
+}
+
+/* No pageable-memory wait occurs while the sweep owns any pages. */
+static int
+agx_mem_prepare(struct agx_mem *mem, int no_wait, int *need_pages)
+{
+	struct agx_resident_page *p;
+	bus_dma_segment_t *segs;
+	struct uvm_object *uobj = mem->uao;
+	struct vm_page *pg;
+	struct pglist allocated, quartet;
+	paddr_t pa, low = dma_constraint.ucr_low;
+	paddr_t high = MIN(dma_constraint.ucr_high, (1ULL << mem->oas) - 1);
+	paddr_t next = atop(roundup(low, AGX_PAGE_SIZE));
+	size_t count = mem->size >> PAGE_SHIFT, i, j, k, run, staged = 0;
+	caddr_t flushva;
+	int error, n, rv, pristine;
+
+	*need_pages = 0;
+	if (high < low || high - low < AGX_PAGE_SIZE - 1)
+		return ENOMEM;
+	p = mallocarray(count, sizeof(*p), M_DEVBUF,
+	    M_NOWAIT | M_CANFAIL | M_ZERO);
+	if (p == NULL)
+		return ENOMEM;
+	/* Keep descriptors private until the whole residency sweep commits. */
+	segs = mallocarray(mem->size >> AGX_PAGE_SHIFT, sizeof(*segs),
+	    M_DEVBUF, M_NOWAIT | M_CANFAIL | M_ZERO);
+	if (segs == NULL) {
+		free(p, M_DEVBUF, count * sizeof(*p));
+		return ENOMEM;
+	}
+	TAILQ_INIT(&allocated);
+	error = rw_enter(uobj->vmobjlock, RW_WRITE |
+	    (no_wait ? RW_NOSLEEP : 0));
+	if (error != 0) {
+		error = EAGAIN;
+		goto out;
+	}
+	/* An empty object can still have swap, including bad slots.  Prove
+	 * every slot absent before installing newly zeroed pages directly. */
+	pristine = uobj->uo_npages == 0;
+	if (pristine) {
+		for (i = 0; i < count; i++) {
+			if (uao_find_swslot(uobj, i) != 0) {
+				pristine = 0;
+				break;
+			}
+		}
+	}
+	if (pristine)
+		goto allocate;
+	/* PGO_LOCKED only returns already resident, unbusy pages and retains
+	 * the object lock.  Page in missing pages only after rolling back. */
+	for (i = 0; i < count; i++) {
+		pg = NULL;
+		n = 1;
+		rv = uobj->pgops->pgo_get(uobj, (voff_t)i << PAGE_SHIFT,
+		    &pg, &n, 0, PROT_READ | PROT_WRITE, MADV_SEQUENTIAL,
+		    PGO_LOCKED);
+		if (rv != VM_PAGER_OK || n != 1 || pg == NULL) {
+			*need_pages = 1;
+			error = EAGAIN;
+			goto rollback;
+		}
+		/* Releasing a swap slot can acquire sleeping locks. */
+		if (no_wait && uao_find_swslot(uobj, i) != 0) {
+			error = EAGAIN;
+			goto rollback;
+		}
+		KASSERT(!(pg->pg_flags & (PG_BUSY | PG_RELEASED)));
+		atomic_setbits_int(&pg->pg_flags, PG_BUSY);
+		UVM_PAGE_OWN(pg, "agx_mem_prepare");
+		uvm_pagewire(pg);
+		p[i].src = pg;
+		staged++;
+	}
+allocate:
+	for (i = 0; i < count;) {
+		if (!pristine && agx_mem_quartet_valid(&p[i], low, high)) {
+			i += AGX_PAGE_SIZE / PAGE_SIZE;
+			continue;
+		}
+		/* Collect up to one chunk of complete quartets at a time. */
+		for (run = 1; run < AGX_DMA_CHUNK_SIZE / AGX_PAGE_SIZE &&
+		    i + run * (AGX_PAGE_SIZE / PAGE_SIZE) < count; run++)
+			if (!pristine && agx_mem_quartet_valid(
+			    &p[i + run * (AGX_PAGE_SIZE / PAGE_SIZE)], low, high))
+				break;
+		TAILQ_INIT(&quartet);
+		error = agx_mem_get_run(atop(roundup(low, AGX_PAGE_SIZE)),
+		    atop(high + 1), &next, &run, pristine, &quartet);
+		if (error != 0)
+			goto rollback;
+		for (k = 0; k < run; k++) {
+			pg = TAILQ_FIRST(&quartet);
+			if (pg == NULL) {
+				error = EINVAL;
+				goto bad_quartet;
+			}
+			pa = VM_PAGE_TO_PHYS(pg);
+			if ((pa & AGX_PAGE_MASK) != 0 || pa < low || pa > high ||
+			    high - pa < AGX_PAGE_SIZE - 1) {
+				error = EINVAL;
+				goto bad_quartet;
+			}
+			for (j = 0; j < AGX_PAGE_SIZE / PAGE_SIZE; j++) {
+				pg = TAILQ_FIRST(&quartet);
+				if (pg == NULL || VM_PAGE_TO_PHYS(pg) !=
+				    pa + j * PAGE_SIZE) {
+					error = EINVAL;
+					goto bad_quartet;
+				}
+				TAILQ_REMOVE(&quartet, pg, pageq);
+				TAILQ_INSERT_TAIL(&allocated, pg, pageq);
+				p[i + k * (AGX_PAGE_SIZE / PAGE_SIZE) + j].dst = pg;
+			}
+		}
+		if (!TAILQ_EMPTY(&quartet)) {
+			error = EINVAL;
+			goto bad_quartet;
+		}
+		i += run * (AGX_PAGE_SIZE / PAGE_SIZE);
+		continue;
+bad_quartet:
+		uvm_pglistfree(&quartet);
+		goto rollback;
+	}
+	/* Prepare copies and a writeback alias before publishing any pages. */
+	for (i = 0; i < count; i++) {
+		if (p[i].dst != NULL && !pristine) {
+			pmap_page_protect(p[i].src, PROT_NONE);
+			uvm_pagecopy(p[i].src, p[i].dst);
+		}
+		if ((i % (AGX_PAGE_SIZE / PAGE_SIZE)) == 0) {
+			pg = p[i].dst != NULL ? p[i].dst : p[i].src;
+			segs[i / (AGX_PAGE_SIZE / PAGE_SIZE)].ds_addr =
+			    VM_PAGE_TO_PHYS(pg);
+			segs[i / (AGX_PAGE_SIZE / PAGE_SIZE)].ds_len = AGX_PAGE_SIZE;
+		}
+	}
+	if (mem->cache == AGX_MEM_NOCACHE) {
+		error = bus_dmamem_map(mem->dmat, segs,
+		    mem->size >> AGX_PAGE_SHIFT, mem->size, &flushva,
+		    BUS_DMA_NOWAIT);
+		if (error != 0)
+			goto rollback;
+		cpu_dcache_wbinv_range((vaddr_t)flushva, mem->size);
+		bus_dmamem_unmap(mem->dmat, flushva, mem->size);
+	}
+	for (i = 0; i < count; i++) {
+		pg = p[i].src;
+		if (p[i].dst != NULL) {
+			if (!pristine) {
+				uvm_page_unbusy(&pg, 1);
+				uvm_pagerealloc(pg, NULL, 0);
+				uvm_pagefree(pg);
+			}
+			pg = p[i].dst;
+			TAILQ_REMOVE(&allocated, pg, pageq);
+			uvm_pagealloc_pg(pg, uobj, (voff_t)i << PAGE_SHIFT, NULL);
+			atomic_setbits_int(&pg->pg_flags, PQ_AOBJ);
+			atomic_clearbits_int(&pg->pg_flags, PG_FAKE | PG_CLEAN);
+			uvm_pagewire(pg);
+		} else
+			atomic_clearbits_int(&pg->pg_flags, PG_CLEAN);
+		if (!pristine)
+			uao_dropswap(uobj, i);
+		uvm_page_unbusy(&pg, 1);
+		p[i].src = pg;
+	}
+	KASSERT(TAILQ_EMPTY(&allocated));
+	mem->segs = segs;
+	mem->nsegs = mem->size >> AGX_PAGE_SHIFT;
+	mem->resident = p;
+	rw_exit_write(uobj->vmobjlock);
+	error = 0;
+	goto out;
+rollback:
+	for (i = 0; i < staged; i++) {
+		uvm_pageunwire(p[i].src);
+		uvm_page_unbusy(&p[i].src, 1);
+	}
+	rw_exit_write(uobj->vmobjlock);
+	agx_mem_free_staged(&allocated);
+out:
+	if (error != 0) {
+		free(segs, M_DEVBUF,
+		    (mem->size >> AGX_PAGE_SHIFT) * sizeof(*segs));
+		free(p, M_DEVBUF, count * sizeof(*p));
+	}
+	return error;
+}
+
+/* Bring swap pages in with no prepared or wired pages held by this sweep. */
+static int
+agx_mem_prefault(struct agx_mem *mem)
+{
+	struct uvm_object *uobj = mem->uao;
+	struct vm_page *pg;
+	size_t i, count = mem->size >> PAGE_SHIFT;
+	int n, rv;
+
+	for (i = 0; i < count; i++) {
+		pg = NULL;
+		n = 1;
+		rw_enter_write(uobj->vmobjlock);
+		rv = uobj->pgops->pgo_get(uobj, (voff_t)i << PAGE_SHIFT,
+		    &pg, &n, 0, PROT_READ | PROT_WRITE, MADV_SEQUENTIAL,
+		    PGO_SYNCIO);
+		if (rv != VM_PAGER_OK)
+			return EIO;
+		rw_enter_write(uobj->vmobjlock);
+		KASSERT(n == 1 && pg != NULL && !(pg->pg_flags & PG_RELEASED));
+		uvm_pageactivate(pg);
+		uvm_page_unbusy(&pg, 1);
+		rw_exit_write(uobj->vmobjlock);
+	}
+	return 0;
+}
+
+int
+agx_mem_pin(struct agx_mem *mem, int no_wait)
+{
+	unsigned int attempt, count;
+	int error, need_pages;
+
+	if (mem == NULL)
+		return EINVAL;
+	if (mem->uao == NULL)
+		return 0;
+	error = rw_enter(&mem->pin_lock, RW_WRITE |
+	    (no_wait ? RW_NOSLEEP : 0));
+	if (error != 0)
+		return no_wait ? EBUSY : error;
+again:
+	count = __atomic_load_n(&mem->pin_count, __ATOMIC_ACQUIRE);
+	if (count != 0) {
+		/* A live pin keeps all backing and aliases resident even while
+		 * another reference is queued for retirement. */
+		for (;;) {
+			if (count == UINT_MAX) {
+				error = EOVERFLOW;
+				break;
+			}
+			if (__atomic_compare_exchange_n(&mem->pin_count, &count,
+			    count + 1, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+				error = 0;
+				break;
+			}
+			KASSERT(count != 0);
+		}
+		goto done;
+	}
+	if (__atomic_load_n(&mem->retiring, __ATOMIC_ACQUIRE) != 0) {
+		if (no_wait) {
+			error = EBUSY;
+			goto done;
+		}
+		rwsleep_nsec(&mem->retiring, &mem->pin_lock, PWAIT | PNORELOCK,
+		    "agxret", INFSLP);
+		rw_enter_write(&mem->pin_lock);
+		goto again;
+	}
+	for (attempt = 0;; attempt++) {
+		error = agx_mem_prepare(mem, no_wait, &need_pages);
+		if (error == 0 || no_wait || attempt == AGX_DMA_RETRIES)
+			break;
+		if (need_pages) {
+			error = agx_mem_prefault(mem);
+			if (error != 0)
+				break;
+		} else if (error == ENOMEM) {
+			wakeup(&uvm.pagedaemon);
+			error = tsleep_nsec(&nowake, PWAIT | PCATCH, "agxpin",
+			    MSEC_TO_NSEC(MIN(1U << MIN(attempt, 6U), 100U)));
+			if (error != 0 && error != EWOULDBLOCK)
+				break;
+		} else
+			break;
+	}
+	if (error == 0)
+		__atomic_store_n(&mem->pin_count, 1, __ATOMIC_RELEASE);
+done:
+	rw_exit_write(&mem->pin_lock);
+	/* libdrm retries EAGAIN indefinitely; a nonblocking pin must return. */
+	if (no_wait && error == EAGAIN)
+		error = EBUSY;
+	return error;
+}
+
+void
+agx_mem_pin_ref(struct agx_mem *mem)
+{
+	unsigned int old;
+
+	if (mem->uao == NULL)
+		return;
+	old = __atomic_load_n(&mem->pin_count, __ATOMIC_ACQUIRE);
+	for (;;) {
+		if (old == 0 || old == UINT_MAX)
+			panic("agx_mem_pin_ref: invalid pin count");
+		if (__atomic_compare_exchange_n(&mem->pin_count, &old, old + 1,
+		    0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+			break;
+	}
+}
+
+void
+agx_mem_unpin(struct agx_mem *mem)
+{
+	struct uvm_object *uobj;
+	struct vm_page *pg;
+	size_t i, count;
+
+	if (mem == NULL || mem->uao == NULL)
+		return;
+	rw_enter_write(&mem->pin_lock);
+	KASSERT(__atomic_load_n(&mem->pin_count, __ATOMIC_RELAXED) != 0);
+	if (__atomic_sub_fetch(&mem->pin_count, 1, __ATOMIC_ACQ_REL) != 0) {
+		rw_exit_write(&mem->pin_lock);
+		return;
+	}
+	/* All UAT and userspace aliases have retired.  Complete CI accesses
+	 * before removing the last kernel alias and releasing physical pages. */
+	agx_tlbi_sync();
+	if (mem->kva != NULL) {
+		bus_dmamem_unmap(mem->dmat, mem->kva, mem->size);
+		mem->kva = NULL;
+	}
+	agx_tlbi_sync();
+	uobj = mem->uao;
+	count = mem->size >> PAGE_SHIFT;
+	rw_enter_write(uobj->vmobjlock);
+	for (i = 0; i < count; i++) {
+		pg = mem->resident[i].src;
+		KASSERT(pg != NULL && pg->wire_count != 0);
+		uvm_pageunwire(pg);
+	}
+	rw_exit_write(uobj->vmobjlock);
+	free(mem->resident, M_DEVBUF, count * sizeof(*mem->resident));
+	mem->resident = NULL;
+	/* The last pin also owns the UAT/mmap descriptor array. */
+	free(mem->segs, M_DEVBUF,
+	    (mem->size >> AGX_PAGE_SHIFT) * sizeof(*mem->segs));
+	mem->segs = NULL;
+	mem->nsegs = 0;
+	rw_exit_write(&mem->pin_lock);
+}
+
+void
+agx_mem_retire_begin(struct agx_mem *mem)
+{
+	unsigned int old;
+
+	if (mem->uao == NULL)
+		return;
+	KASSERT(__atomic_load_n(&mem->pin_count, __ATOMIC_ACQUIRE) != 0);
+	old = __atomic_fetch_add(&mem->retiring, 1, __ATOMIC_ACQ_REL);
+	if (old == UINT_MAX)
+		panic("agx_mem_retire_begin: retirement overflow");
+}
+
+void
+agx_mem_retire_end(struct agx_mem *mem)
+{
+	if (mem->uao == NULL)
+		return;
+	agx_mem_unpin(mem);
+	rw_enter_write(&mem->pin_lock);
+	KASSERT(__atomic_load_n(&mem->retiring, __ATOMIC_ACQUIRE) != 0);
+	if (__atomic_sub_fetch(&mem->retiring, 1, __ATOMIC_ACQ_REL) == 0)
+		wakeup(&mem->retiring);
+	rw_exit_write(&mem->pin_lock);
+}
+
+/*
+ * SG entries describe physically contiguous runs, not DMA IOVAs.  Validate
+ * every CPU page so that each UAT page consists of four adjacent pinned
+ * CPU pages and starts at a 16K physical boundary.
+ */
+int
+agx_mem_import_sg(const struct sg_table *sgt, size_t size, unsigned int oas,
+    struct agx_mem **out)
+{
+	struct agx_mem *mem;
+	struct scatterlist *sg;
+	paddr_t pa, base = 0;
+	uint64_t pos = 0, n, j;
+	unsigned int i;
+
+	if (out == NULL || sgt == NULL || sgt->sgl == NULL ||
+	    sgt->orig_nents == 0 || size == 0 || !AGX_UAT_OAS_VALID(oas) ||
+	    (size & AGX_PAGE_MASK) != 0 || size > (1ULL << 39))
+		return EINVAL;
+	*out = NULL;
+	if ((size >> AGX_PAGE_SHIFT) > MALLOC_MAX / sizeof(*mem->pages))
+		return EFBIG;
+	mem = malloc(sizeof(*mem), M_DEVBUF, M_WAITOK | M_CANFAIL | M_ZERO);
+	if (mem == NULL)
+		return ENOMEM;
+	mem->size = size;
+	mem->oas = oas;
+	mem->pages = mallocarray(size >> AGX_PAGE_SHIFT, sizeof(*mem->pages),
+	    M_DEVBUF, M_WAITOK | M_CANFAIL | M_ZERO);
+	if (mem->pages == NULL) {
+		free(mem, M_DEVBUF, sizeof(*mem));
+		return ENOMEM;
+	}
+	sg = sgt->sgl;
+	for (i = 0; i < sgt->orig_nents && pos < size; i++) {
+		if (sg == NULL || sg_page(sg) == NULL ||
+		    (sg->offset & PAGE_MASK) != 0 || sg->offset >= PAGE_SIZE ||
+		    (sg->length & PAGE_MASK) != 0 || sg->length == 0)
+			goto invalid;
+		pa = VM_PAGE_TO_PHYS(sg_page(sg)) + sg->offset;
+		n = MIN((uint64_t)sg->length, size - pos);
+		if (pa >= (1ULL << oas) || n > (1ULL << oas) - pa)
+			goto invalid;
+		for (j = 0; j < n; j += PAGE_SIZE, pos += PAGE_SIZE) {
+			if ((pos & AGX_PAGE_MASK) == 0) {
+				base = pa + j;
+				if ((base & AGX_PAGE_MASK) != 0)
+					goto invalid;
+				mem->pages[pos >> AGX_PAGE_SHIFT] = base;
+			} else if (pa + j != base + (pos & AGX_PAGE_MASK))
+				goto invalid;
+		}
+		sg = sg_next(sg);
+	}
+	if (pos != size)
+		goto invalid;
+	*out = mem;
+	return 0;
+invalid:
+	free(mem->pages, M_DEVBUF,
+	    (size >> AGX_PAGE_SHIFT) * sizeof(*mem->pages));
+	free(mem, M_DEVBUF, sizeof(*mem));
+	return EINVAL;
+}
+
+int
+agx_mem_phys(const struct agx_mem *mem, uint64_t offset, paddr_t *out)
+{
+	if (mem == NULL || out == NULL || (offset & AGX_PAGE_MASK) != 0 ||
+	    offset >= mem->size)
+		return EINVAL;
+	if (mem->uao != NULL &&
+	    __atomic_load_n(&mem->pin_count, __ATOMIC_ACQUIRE) == 0)
+		return EINVAL;
+	if (mem->pages != NULL)
+		*out = mem->pages[offset >> AGX_PAGE_SHIFT];
+	else if (mem->dma_pages != NULL)
+		*out = mem->dma_pages[offset >> AGX_PAGE_SHIFT].pa;
+	else if (mem->nsegs == 1)
+		*out = mem->segs[0].ds_addr + offset;
+	else
+		*out = mem->segs[offset >> AGX_PAGE_SHIFT].ds_addr;
+	return 0;
+}
+
+/* Caller serializes mapping with the GEM reservation cache lock. */
+int
+agx_mem_vmap(struct agx_mem *mem)
+{
+	if (mem == NULL || mem->pages != NULL)
+		return EOPNOTSUPP;
+	if (mem->kva != NULL)
+		return 0;
+	if (mem->uao != NULL &&
+	    __atomic_load_n(&mem->pin_count, __ATOMIC_ACQUIRE) == 0)
+		return EINVAL;
+	KASSERT(agx_mem_native_tag(mem->dmat));
+	return bus_dmamem_map(mem->dmat, mem->segs, mem->nsegs,
+	    mem->size, (caddr_t *)&mem->kva, BUS_DMA_NOWAIT |
+	    (mem->cache == AGX_MEM_NOCACHE ? BUS_DMA_NOCACHE : 0));
+}
+
+void
+agx_mem_free(struct agx_mem *mem)
+{
+	if (mem == NULL)
+		return;
+	if (mem->uao != NULL) {
+		KASSERT(mem->pin_count == 0 && mem->retiring == 0 &&
+		    mem->kva == NULL && mem->resident == NULL &&
+		    mem->segs == NULL);
+		uao_detach(mem->uao);
+		free(mem, M_DEVBUF, sizeof(*mem));
+		return;
+	}
+	if (mem->pages != NULL) {
+		free(mem->pages, M_DEVBUF,
+		    (mem->size >> AGX_PAGE_SHIFT) * sizeof(*mem->pages));
+		free(mem, M_DEVBUF, sizeof(*mem));
+		return;
+	}
+	if (mem->kva != NULL)
+		bus_dmamem_unmap(mem->dmat, mem->kva, mem->size);
+	agx_mem_free_backing(mem);
+	free(mem, M_DEVBUF, sizeof(*mem));
+}
+
+int
+agx_mem_sync(struct agx_mem *mem, uint64_t offset, uint64_t size, int ops)
+{
+	vaddr_t va;
+	int pre = BUS_DMASYNC_PREREAD | BUS_DMASYNC_PREWRITE;
+	int post = BUS_DMASYNC_POSTREAD | BUS_DMASYNC_POSTWRITE;
+
+	if (mem == NULL || size == 0 || offset > mem->size ||
+	    size > mem->size - offset || ops == 0 ||
+	    (ops & ~(pre | post)) != 0 || ((ops & pre) && (ops & post)))
+		return EINVAL;
+	/* The exporter owns CPU mappings and synchronization of imported pages. */
+	if (mem->pages != NULL || mem->kva == NULL)
+		return EOPNOTSUPP;
+	if (mem->cache == AGX_MEM_NOCACHE) {
+		agx_tlbi_sync();
+		return 0;
+	}
+	va = (vaddr_t)mem->kva + offset;
+	if (ops & BUS_DMASYNC_PREREAD)
+		cpu_dcache_wbinv_range(va, size);
+	else if (ops & BUS_DMASYNC_PREWRITE)
+		cpu_dcache_wb_range(va, size);
+	else if (ops & BUS_DMASYNC_POSTREAD) {
+		/* The VM snapshot includes BOs not touched by this job.  Their
+		 * CPU-dirty lines must be cleaned, not silently discarded.  GPU-
+		 * written cache lines must not be CPU-dirtied until retirement. */
+		agx_tlbi_sync();
+		cpu_dcache_wbinv_range(va, size);
+	}
+	agx_tlbi_sync();
+	return 0;
+}
+
+paddr_t
+agx_mem_mmap(struct agx_mem *mem, off_t off, int prot)
+{
+	struct agx_dma_page *page;
+	bus_dma_segment_t *seg;
+	off_t seg_offset;
+	size_t index;
+	int flags;
+
+	if (mem == NULL || mem->pages != NULL || off < 0 ||
+	    (uint64_t)off >= mem->size || (off & PAGE_MASK) != 0)
+		return (paddr_t)-1;
+	if (mem->uao != NULL &&
+	    __atomic_load_n(&mem->pin_count, __ATOMIC_ACQUIRE) == 0)
+		return (paddr_t)-1;
+	flags = mem->cache == AGX_MEM_NOCACHE ? BUS_DMA_NOCACHE : 0;
+	if (mem->nsegs == 1)
+		return bus_dmamem_mmap(mem->dmat, mem->segs, 1, off, prot, flags);
+	/* Preserve the complete descriptor contract for nonstandard DMA tags. */
+	if (mem->dmat->_dmamem_mmap != _dmamem_mmap)
+		return bus_dmamem_mmap(mem->dmat, mem->segs, mem->nsegs,
+		    off, prot, flags);
+	index = (uint64_t)off >> AGX_PAGE_SHIFT;
+	seg_offset = off & AGX_PAGE_MASK;
+	if (mem->dma_pages != NULL) {
+		page = &mem->dma_pages[index];
+		seg = &mem->segs[page->segment];
+		seg_offset += page->pa - seg->ds_addr;
+	} else
+		seg = &mem->segs[index];
+	return bus_dmamem_mmap(mem->dmat, seg, 1, seg_offset, prot, flags);
+}
+
+void
+agx_tlbi_all(void)
+{
+	__asm volatile(".arch armv8.4-a\n\ttlbi vmalle1os" ::: "memory");
+}
+
+void
+agx_tlbi_asid(uint8_t asid)
+{
+	uint64_t operand = (uint64_t)asid << 48;
+	__asm volatile(".arch armv8.4-a\n\ttlbi aside1os, %0" ::
+	    "r" (operand) : "memory");
+}
+
+void
+agx_tlbi_page(uint8_t asid, uint64_t va)
+{
+	uint64_t operand = ((uint64_t)asid << 48) |
+	    ((va >> 12) & 0xffffffffffcULL);
+	__asm volatile(".arch armv8.4-a\n\ttlbi vae1os, %0" ::
+	    "r" (operand) : "memory");
+}
+
+void
+agx_tlbi_sync(void)
+{
+	__asm volatile("dsb sy" ::: "memory");
+}
