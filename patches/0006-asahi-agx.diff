--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_queue_job.c	Sun Nov 15 20:31:08 2026
@@ -0,0 +1,1296 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Reservation order is independent of the VM assembly/binding exclusion. */
+#include <sys/param.h>
+#include <sys/atomic.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/queue.h>
+#include <sys/rwlock.h>
+#include <sys/systm.h>
+#include <sys/task.h>
+#include <sys/timeout.h>
+
+#include "agx_channel_bank.h"
+#include "agx_context.h"
+#include "agx_fw.h"
+#include "agx_queue_event.h"
+#include "agx_queue_owner.h"
+
+#define AGX_QUEUE_MAX_EVENTS 127
+
+struct agx_queue_job_pipe {
+	struct agx_queue_event *epoch;
+	struct agx_queue_job_event event;
+	uint64_t *commands;
+	uint64_t generation;
+	uint32_t capacity, count, stages;
+};
+
+struct agx_queue_job {
+	TAILQ_ENTRY(agx_queue_job) link;
+	struct agx_queue_owner *owner;
+	struct agx_queue_job_pipe pipes[AGX_QUEUE_PIPES];
+	struct agx_queue_job *prior[AGX_QUEUE_PIPES];
+	struct agx_queue_event *prior_epoch[AGX_QUEUE_PIPES];
+	struct agx_queue_job_event prior_event[AGX_QUEUE_PIPES];
+	struct task destroy_task;
+	void (*release)(void *);
+	void *release_cookie;
+	void (*commit)(void *, unsigned int);
+	void *commit_cookie;
+	void (*complete)(void *, int);
+	void *complete_cookie;
+	unsigned int refs, mask, dependencies, published, retired, commits;
+	unsigned int accepted, submitted, completed, external, threshold, cancelled;
+	unsigned int committing;
+	unsigned int tail_pinned;
+	uint32_t tail_slot;
+	int error;
+};
+TAILQ_HEAD(agx_queue_job_list, agx_queue_job);
+
+struct agx_queue_pipe_state {
+	struct agx_queue_event *epoch;
+	struct agx_queue_event_info info;
+	struct agx_queue_job *tail, *last_completed;
+	struct agx_event_token token;
+	uint64_t cmd_seq, submit_seq, event_seq, generation;
+	uint64_t completed_event_seq;
+	uint32_t value, completed_value, submitted_value, users;
+	int have_token;
+};
+
+struct agx_queue_state {
+	struct rwlock lock;
+	struct agx_queue_job_list jobs;
+	struct agx_queue_job_list retained;
+	struct agx_queue_pipe_state pipes[AGX_QUEUE_PIPES];
+	struct agx_queue_owner *owner;
+	struct taskq *tasks;
+	struct task reap_task, destroy_task;
+	struct timeout retry;
+	unsigned int event_refs;
+	int closing, admission_closed, stopped, finalizing, finalize_error;
+};
+
+struct agx_queue_epoch_cookie {
+	struct agx_queue_state *state;
+	unsigned int pipe;
+};
+
+static void agx_queue_progress(void *);
+static void agx_queue_progress_held(struct agx_queue_owner *);
+static void agx_queue_job_unref(struct agx_queue_job *);
+static void agx_queue_cancel_locked(struct agx_queue_job *, int);
+
+static int
+agx_queue_error(const struct agx_event_error *error)
+{
+	if (error == NULL)
+		return EIO;
+	switch (error->kind) {
+	case AGX_EVENT_ERROR_FAULT: return EIO;
+	case AGX_EVENT_ERROR_TIMEOUT: return ETIMEDOUT;
+	case AGX_EVENT_ERROR_KILLED: return ECANCELED;
+	case AGX_EVENT_ERROR_NODEV: return ENODEV;
+	default: return EIO;
+	}
+}
+
+static void
+agx_queue_job_ref(struct agx_queue_job *job)
+{
+	unsigned int refs;
+
+	refs = atomic_inc_int_nv(&job->refs);
+	KASSERT(refs > 1);
+}
+
+/* The caller owns no state/assembly/channel lock and no VM binding here. */
+static void
+agx_queue_job_destroy(void *cookie)
+{
+	struct agx_queue_job *job = cookie;
+	struct agx_queue_owner *owner = job->owner;
+	unsigned int i;
+	int deferred = !owner->state->finalizing;
+	int error;
+
+	if (job->tail_pinned) {
+		error = agx_gpu_context_tail_unpin(owner->context);
+		if (error != 0) {
+			rw_enter_write(&owner->state->lock);
+			TAILQ_INSERT_TAIL(&owner->state->retained, job, link);
+			owner->state->finalize_error = error;
+			rw_exit_write(&owner->state->lock);
+			printf("agx: retaining queue work after tail unpin error %d\n",
+			    error);
+			return;
+		}
+		job->tail_pinned = 0;
+	}
+
+	KASSERT(!job->external && !job->accepted);
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		KASSERT(job->pipes[i].epoch == NULL);
+		KASSERT(job->prior[i] == NULL && job->prior_epoch[i] == NULL);
+		free(job->pipes[i].commands, M_DEVBUF,
+		    job->pipes[i].capacity * sizeof(uint64_t));
+	}
+	if (job->release != NULL)
+		job->release(job->release_cookie);
+	free(job, M_DEVBUF, sizeof(*job));
+	if (deferred)
+		agx_queue_owner_put(owner);
+}
+
+static void
+agx_queue_job_unref(struct agx_queue_job *job)
+{
+	if (job == NULL || atomic_dec_int_nv(&job->refs) != 0)
+		return;
+	if (job->owner->state->finalizing) {
+		agx_queue_job_destroy(job);
+		return;
+	}
+	/* A separate worker may wait for VM mutators. Never stall event delivery,
+	 * assembly, or the completion that releases the active VM binding. */
+	if (agx_queue_owner_get(job->owner) != 0)
+		panic("agx: queue job outlived its owner");
+	task_add(job->owner->state->tasks, &job->destroy_task);
+}
+
+static void
+agx_queue_tail_locked(struct agx_queue_pipe_state *pipe,
+    struct agx_queue_job *job)
+{
+	struct agx_queue_job *old = pipe->tail;
+
+	if (old == job)
+		return;
+	if (job != NULL)
+		agx_queue_job_ref(job);
+	pipe->tail = job;
+	agx_queue_job_unref(old);
+}
+
+static void
+agx_queue_idle_locked(struct agx_queue_state *state)
+{
+	struct agx_queue_pipe_state *pipe;
+	struct agx_queue_event *epoch;
+	unsigned int i;
+
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		pipe = &state->pipes[i];
+		if (pipe->epoch == NULL || pipe->users != 0 ||
+		    state->owner->pipes[i].ring.pending != 0)
+			continue;
+		epoch = pipe->epoch;
+		pipe->epoch = NULL;
+		agx_queue_tail_locked(pipe, NULL);
+		agx_queue_event_close(epoch, 0);
+		agx_queue_event_unref(epoch);
+	}
+}
+
+static void
+agx_queue_retire_locked(struct agx_queue_state *state, unsigned int index,
+    struct agx_event_token token, uint32_t current)
+{
+	struct agx_queue_pipe_state *pipe = &state->pipes[index];
+	struct agx_queue_job *job, *old;
+	struct agx_queue_job_pipe *jp;
+	unsigned int bit = 1U << index;
+
+	if (pipe->epoch == NULL || token.slot != pipe->info.token.slot ||
+	    token.generation != pipe->info.token.generation ||
+	    agx_event_value_delta(current, pipe->completed_value) < 0)
+		return;
+	pipe->completed_value = current;
+	TAILQ_FOREACH(job, &state->jobs, link) {
+		jp = &job->pipes[index];
+		if (!(job->published & bit) || (job->retired & bit) ||
+		    jp->epoch != pipe->epoch)
+			continue;
+		if (agx_event_value_delta(current,
+		    jp->event.start_value + (jp->stages << 8)) < 0)
+			break;
+		if (agx_wq_retire(&state->owner->pipes[index].ring, jp->count) != 0)
+			panic("agx: inconsistent queue retirement");
+		job->retired |= bit;
+		pipe->completed_event_seq = jp->event.event_seq + jp->stages;
+		if (state->owner->pipes[index].ring.pending == 0) {
+			state->owner->pipes[index].ring.needs_notify = 0;
+			state->owner->pipes[index].ring.needs_kick = 0;
+		}
+		old = pipe->last_completed;
+		agx_queue_job_ref(job);
+		pipe->last_completed = job;
+		agx_queue_job_unref(old);
+	}
+}
+
+static void
+agx_queue_epoch_signal(void *cookie, struct agx_event_token token,
+    uint32_t current)
+{
+	struct agx_queue_epoch_cookie *ec = cookie;
+	struct agx_queue_state *state = ec->state;
+
+	rw_enter_write(&state->lock);
+	agx_queue_retire_locked(state, ec->pipe, token, current);
+	rw_exit_write(&state->lock);
+	agx_queue_progress(state->owner);
+}
+
+/* True only if the captured error covers an unfinished job. */
+static int
+agx_queue_error_overlaps(uint32_t start, unsigned int stages,
+    uint32_t current, uint32_t wait)
+{
+	return agx_event_value_delta(start + (stages << 8), current) > 0 &&
+	    agx_event_value_delta(wait, start) > 0;
+}
+
+static void
+agx_queue_epoch_error(void *cookie, struct agx_event_token token,
+    uint32_t current, uint32_t wait, const struct agx_event_error *error)
+{
+	struct agx_queue_epoch_cookie *ec = cookie;
+	struct agx_queue_state *state = ec->state;
+	struct agx_queue_pipe_state *pipe = &state->pipes[ec->pipe];
+	struct agx_queue_job *job;
+	unsigned int bit = 1U << ec->pipe;
+
+	rw_enter_write(&state->lock);
+	if (pipe->epoch != NULL && token.slot == pipe->info.token.slot &&
+	    token.generation == pipe->info.token.generation &&
+	    agx_event_value_delta(wait, pipe->info.initial) > 0 &&
+	    agx_event_value_delta(wait, pipe->completed_value) > 0) {
+		TAILQ_FOREACH(job, &state->jobs, link) {
+			if ((job->published & bit) && !(job->retired & bit) &&
+			    agx_queue_error_overlaps(
+			    job->pipes[ec->pipe].event.start_value,
+			    job->pipes[ec->pipe].stages, current, wait) &&
+			    job->error == 0)
+				job->error = error != NULL &&
+				    error->kind == AGX_EVENT_ERROR_FAULT &&
+				    job->tail_slot != error->vm_slot ?
+				    ECANCELED : agx_queue_error(error);
+		}
+	}
+	/* A fault boundary must be attached before a stamp can retire the
+	 * affected job and allow its completion fence to be signalled. */
+	agx_queue_retire_locked(state, ec->pipe, token, current);
+	rw_exit_write(&state->lock);
+	/* An error boundary alone never retires work. */
+	agx_queue_progress(state->owner);
+}
+
+static int
+agx_queue_epoch_recover(void *cookie, struct agx_queue_event *event,
+    struct agx_event_token token, uint32_t current, uint32_t index,
+    uint32_t wait, const struct agx_event_error *error, uint64_t *queue_va)
+{
+	struct agx_queue_epoch_cookie *ec = cookie;
+	struct agx_queue_state *state = ec->state;
+	struct agx_queue_pipe_state *pipe;
+	int result;
+
+	if (index != ec->pipe || index >= AGX_QUEUE_PIPES)
+		return EIO;
+	rw_enter_write(&state->lock);
+	pipe = &state->pipes[index];
+	if (state->closing || state->stopped ||
+	    agx_fw_is_crashed(state->owner->runtime) || pipe->epoch != event ||
+	    state->owner->pipes[index].ring.pipe != index ||
+	    state->owner->pipes[index].ring.info_va == 0 ||
+	    token.slot != pipe->info.token.slot ||
+	    token.generation != pipe->info.token.generation ||
+	    agx_event_value_delta(wait, pipe->completed_value) <= 0 ||
+	    agx_event_value_delta(wait, pipe->submitted_value) > 0 ||
+	    agx_event_value_delta(current, pipe->submitted_value) > 0)
+		result = EIO;
+	else
+		result = agx_queue_event_recover_pin(event, token, current, index,
+		    wait, error, queue_va);
+	rw_exit_write(&state->lock);
+	return result;
+}
+
+static void
+agx_queue_epoch_stopped(void *cookie, struct agx_event_token token,
+    uint32_t current, const struct agx_event_error *error)
+{
+	struct agx_queue_epoch_cookie *ec = cookie;
+	struct agx_queue_state *state = ec->state;
+	struct agx_queue_job *job;
+	unsigned int i, bit;
+
+	rw_enter_write(&state->lock);
+	/* Mark outstanding work before consuming any possibly advanced stamp. */
+	/* This callback is the event manager's explicit, proven-stop contract. */
+	state->stopped = 1;
+	TAILQ_FOREACH(job, &state->jobs, link) {
+		if (job->published == job->mask && job->retired == job->mask)
+			continue;
+		if (job->error == 0)
+			job->error = error != NULL && job->tail_pinned &&
+			    error->kind == AGX_EVENT_ERROR_FAULT &&
+			    job->tail_slot != error->vm_slot ?
+			    ECANCELED : agx_queue_error(error);
+	}
+	agx_queue_retire_locked(state, ec->pipe, token, current);
+	TAILQ_FOREACH(job, &state->jobs, link) {
+		for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+			bit = 1U << i;
+			if ((job->published & bit) && !(job->retired & bit)) {
+				if (agx_wq_retire(&state->owner->pipes[i].ring,
+				    job->pipes[i].count) != 0)
+					panic("agx: inconsistent stopped queue retirement");
+				job->retired |= bit;
+			}
+		}
+	}
+	rw_exit_write(&state->lock);
+	agx_queue_progress(state->owner);
+}
+
+static void
+agx_queue_epoch_overflow(void *cookie)
+{
+	struct agx_queue_epoch_cookie *ec = cookie;
+	struct agx_queue_job *job;
+
+	rw_enter_write(&ec->state->lock);
+	TAILQ_FOREACH(job, &ec->state->jobs, link)
+		if (job->published != 0 && job->retired != job->mask &&
+		    job->error == 0)
+			job->error = EOVERFLOW;
+	rw_exit_write(&ec->state->lock);
+
+	agx_runtime_mark_failed(ec->state->owner->runtime, EOVERFLOW);
+	agx_queue_progress(ec->state->owner);
+}
+
+static void
+agx_queue_epoch_release(void *cookie)
+{
+	struct agx_queue_epoch_cookie *ec = cookie;
+
+	atomic_dec_int(&ec->state->event_refs);
+	free(ec, M_DEVBUF, sizeof(*ec));
+}
+
+static const struct agx_queue_event_ops agx_queue_epoch_ops = {
+	.signal = agx_queue_epoch_signal,
+	.mark_error = agx_queue_epoch_error,
+	.fail_all = agx_queue_epoch_stopped,
+	.recover = agx_queue_epoch_recover,
+	.overflow = agx_queue_epoch_overflow,
+	.release = agx_queue_epoch_release,
+};
+
+static int
+agx_queue_epoch_locked(struct agx_queue_state *state, unsigned int index,
+    struct agx_event_reservation *reservation)
+{
+	struct agx_queue_pipe_state *pipe = &state->pipes[index];
+	struct agx_queue_epoch_cookie *ec;
+	int error;
+
+	if (pipe->epoch != NULL)
+		return 0;
+	ec = malloc(sizeof(*ec), M_DEVBUF, M_WAITOK | M_ZERO);
+	ec->state = state;
+	ec->pipe = index;
+	atomic_inc_int(&state->event_refs);
+	error = agx_queue_event_create(reservation,
+	    pipe->have_token ? &pipe->token : NULL, &agx_queue_epoch_ops, ec,
+	    index, state->owner->pipes[index].ring.info_va, &pipe->epoch);
+	if (error != 0) {
+		atomic_dec_int(&state->event_refs);
+		free(ec, M_DEVBUF, sizeof(*ec));
+		return error;
+	}
+	agx_queue_event_info(pipe->epoch, &pipe->info);
+	pipe->token = pipe->info.token;
+	pipe->have_token = 1;
+	pipe->value = pipe->completed_value = pipe->submitted_value =
+	    pipe->info.initial;
+	pipe->generation++;
+	pipe->completed_event_seq = pipe->event_seq;
+	agx_queue_event_start(pipe->epoch);
+	return 0;
+}
+
+int
+agx_queue_job_prepare(struct agx_queue_owner *owner, const uint32_t capacity[3],
+    const uint32_t stages[3], void (*release)(void *), void *cookie,
+    const int *cancel, const int *stopped, struct agx_queue_job **out)
+{
+	struct agx_queue_state *state;
+	struct agx_queue_job *job;
+	struct agx_queue_pipe_state *pipe;
+	struct agx_queue_job_pipe *jp;
+	struct agx_event_reservation reservation;
+	unsigned int i, needed;
+	int error;
+
+	if (out == NULL)
+		return EINVAL;
+	*out = NULL;
+	if (owner == NULL || owner->state == NULL || capacity == NULL ||
+	    stages == NULL || cancel == NULL || stopped == NULL)
+		return EINVAL;
+	for (i = 0; i < AGX_QUEUE_PIPES; i++)
+		if ((capacity[i] == 0) != (stages[i] == 0) ||
+		    capacity[i] >= AGX_QUEUE_RING_SIZE ||
+		    stages[i] >= AGX_QUEUE_MAX_EVENTS)
+			return E2BIG;
+	error = agx_queue_owner_get(owner);
+	if (error != 0)
+		return error;
+	state = owner->state;
+	job = malloc(sizeof(*job), M_DEVBUF, M_WAITOK | M_ZERO);
+	job->owner = owner;
+	job->refs = job->external = 1;
+	task_set(&job->destroy_task, agx_queue_job_destroy, job);
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		jp = &job->pipes[i];
+		jp->capacity = jp->count = capacity[i];
+		jp->stages = stages[i];
+		if (capacity[i] != 0) {
+			jp->commands = mallocarray(capacity[i], sizeof(uint64_t),
+			    M_DEVBUF, M_WAITOK | M_ZERO);
+			job->mask |= 1U << i;
+		}
+	}
+	/* Reserve every missing epoch together. Never wait holding state->lock or
+	 * a partial set: retirement and the systqmp release must keep running. */
+retry:
+	rw_enter_write(&state->lock);
+	error = __atomic_load_n(cancel, __ATOMIC_ACQUIRE);
+	if (error == 0 && (state->closing || state->admission_closed ||
+	    state->stopped || __atomic_load_n(stopped, __ATOMIC_ACQUIRE) ||
+	    agx_fw_is_crashed(owner->runtime)))
+		error = ENODEV;
+	needed = 0;
+	for (i = 0; i < AGX_QUEUE_PIPES; i++)
+		if ((job->mask & (1U << i)) && state->pipes[i].epoch == NULL)
+			needed++;
+	if (error == 0 && job->mask == 0)
+		error = EINVAL;
+	if (error == 0)
+		error = agx_event_slots_reserve(owner->events, needed, &reservation);
+	if (error == EBUSY) {
+		rw_exit_write(&state->lock);
+		error = agx_event_slots_wait(owner->events, needed, cancel, stopped);
+		if (error == 0)
+			goto retry;
+		agx_queue_job_put(job);
+		return error;
+	}
+	if (error != 0) {
+		rw_exit_write(&state->lock);
+		agx_queue_job_put(job);
+		return error;
+	}
+	for (i = 0; error == 0 && i < AGX_QUEUE_PIPES; i++) {
+		pipe = &state->pipes[i];
+		/* Snapshot the accepted tail before creating this job's epoch. */
+		if (pipe->tail != NULL) {
+			job->prior[i] = pipe->tail;
+			agx_queue_job_ref(pipe->tail);
+			job->prior_epoch[i] = pipe->epoch;
+			KASSERT(pipe->epoch != NULL);
+			agx_queue_event_ref(pipe->epoch);
+			job->prior_event[i] = pipe->tail->pipes[i].event;
+			job->prior_event[i].start_value +=
+			    pipe->tail->pipes[i].stages << 8;
+			job->prior_event[i].cmd_seq += pipe->tail->pipes[i].count;
+			job->prior_event[i].event_seq += pipe->tail->pipes[i].stages;
+		}
+		if (!(job->mask & (1U << i)))
+			continue;
+		error = agx_queue_epoch_locked(state, i, &reservation);
+		if (error != 0)
+			break;
+		jp = &job->pipes[i];
+		jp->epoch = pipe->epoch;
+		agx_queue_event_ref(jp->epoch);
+		pipe->users++;
+		jp->generation = pipe->generation;
+		jp->event.stamp_va = pipe->info.gpu_stamp;
+		jp->event.fw_stamp_va = pipe->info.gpu_fw_stamp;
+		jp->event.queue_va = owner->pipes[i].ring.info_va;
+		jp->event.slot = pipe->info.token.slot;
+		jp->event.start_value = pipe->value;
+		jp->event.cmd_seq = pipe->cmd_seq;
+		jp->event.event_seq = pipe->event_seq;
+	}
+	agx_event_slots_unreserve(&reservation);
+	rw_exit_write(&state->lock);
+	if (error != 0) {
+		agx_queue_job_put(job);
+		return error;
+	}
+	/* Ownership of the caller's resources transfers only on success. */
+	job->release = release;
+	job->release_cookie = cookie;
+	*out = job;
+	return 0;
+}
+
+int
+agx_queue_job_pipe(struct agx_queue_job *job, unsigned int index,
+    struct agx_queue_job_event *event, uint64_t **commands)
+{
+	if (job == NULL || index >= AGX_QUEUE_PIPES || event == NULL ||
+	    commands == NULL || !(job->mask & (1U << index)) || job->accepted)
+		return EINVAL;
+	*event = job->pipes[index].event;
+	*commands = job->pipes[index].commands;
+	return 0;
+}
+
+int
+agx_queue_job_set_count(struct agx_queue_job *job, unsigned int index,
+    uint32_t count)
+{
+	if (job == NULL || index >= AGX_QUEUE_PIPES || job->accepted ||
+	    count > job->pipes[index].capacity ||
+	    ((count == 0) != (job->pipes[index].stages == 0)))
+		return EINVAL;
+	job->pipes[index].count = count;
+	return 0;
+}
+
+int
+agx_queue_job_predecessor(struct agx_queue_job *job, unsigned int index,
+    struct agx_queue_job_event *event, int *valid)
+{
+	struct agx_queue_state *state;
+
+	if (job == NULL || index >= AGX_QUEUE_PIPES || event == NULL || valid == NULL)
+		return EINVAL;
+	state = job->owner->state;
+	rw_enter_write(&state->lock);
+	*valid = job->prior[index] != NULL;
+	*event = job->prior_event[index];
+	if (*valid)
+		event->error = job->prior[index]->error;
+	rw_exit_write(&state->lock);
+	return 0;
+}
+
+int
+agx_queue_job_depend_pipe(struct agx_queue_job *job, unsigned int index)
+{
+	struct agx_queue_state *state;
+	int error;
+
+	if (job == NULL || index >= AGX_QUEUE_PIPES)
+		return EINVAL;
+	state = job->owner->state;
+	rw_enter_write(&state->lock);
+	error = job->accepted ? EINVAL : 0;
+	if (error == 0 && job->prior[index] != NULL) {
+		job->dependencies |= 1U << index;
+		error = job->prior[index]->error;
+	}
+	rw_exit_write(&state->lock);
+	return error;
+}
+
+int
+agx_queue_job_set_commit(struct agx_queue_job *job,
+    void (*commit)(void *, unsigned int), void *cookie)
+{
+	if (job == NULL || job->accepted || job->commit != NULL)
+		return EINVAL;
+	job->commit = commit;
+	job->commit_cookie = cookie;
+	return 0;
+}
+
+int
+agx_queue_job_accept(struct agx_queue_job *job)
+{
+	struct agx_queue_state *state;
+	struct agx_queue_pipe_state *pipe;
+	struct agx_queue_job_pipe *jp;
+	unsigned int i, j;
+	int error = 0;
+
+	if (job == NULL)
+		return EINVAL;
+	state = job->owner->state;
+	/* Caller order: assembly -> scheduler -> state. Runtime never assembly. */
+	rw_enter_write(&state->lock);
+	if (job->accepted || state->closing || state->admission_closed ||
+	    state->stopped || agx_fw_is_crashed(job->owner->runtime))
+		error = ENODEV;
+	for (i = 0; error == 0 && i < AGX_QUEUE_PIPES; i++) {
+		if ((job->dependencies & (1U << i)) && job->prior[i]->error != 0) {
+			error = job->prior[i]->error;
+			break;
+		}
+		if (!(job->mask & (1U << i)))
+			continue;
+		pipe = &state->pipes[i];
+		jp = &job->pipes[i];
+		if (jp->epoch != pipe->epoch || jp->generation != pipe->generation ||
+		    jp->event.start_value != pipe->value ||
+		    jp->event.cmd_seq != pipe->cmd_seq ||
+		    jp->event.event_seq != pipe->event_seq)
+			error = ECANCELED;
+		else if (pipe->cmd_seq > UINT64_MAX - jp->count ||
+		    pipe->event_seq > UINT64_MAX - jp->stages)
+			error = EOVERFLOW;
+		else if (pipe->event_seq - pipe->completed_event_seq >
+		    0x7fffffU - jp->stages)
+			error = EBUSY;
+		for (j = 0; error == 0 && j < jp->count; j++)
+			if (jp->commands[j] == 0)
+				error = EINVAL;
+	}
+	if (error == 0) {
+		agx_queue_job_ref(job);
+		TAILQ_INSERT_TAIL(&state->jobs, job, link);
+		job->accepted = 1;
+		for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+			if (!(job->mask & (1U << i)))
+				continue;
+			pipe = &state->pipes[i];
+			jp = &job->pipes[i];
+			pipe->value += jp->stages << 8;
+			pipe->cmd_seq += jp->count;
+			pipe->event_seq += jp->stages;
+			agx_queue_tail_locked(pipe, job);
+		}
+	}
+	rw_exit_write(&state->lock);
+	return error;
+}
+
+/* Invalidate the transitive reservation/dependency suffix before any fence can
+ * signal. Unrelated pipes retain their accepted sequence. Generation rejects
+ * prepared-but-not-accepted snapshots even if a rolled-back value is reused. */
+static void
+agx_queue_cancel_locked(struct agx_queue_job *first, int error)
+{
+	struct agx_queue_state *state = first->owner->state;
+	struct agx_queue_job *job, *tail[AGX_QUEUE_PIPES] = { NULL, NULL, NULL };
+	struct agx_queue_pipe_state *pipe;
+	unsigned int affected = 0, rolled = 0, i, bit;
+	int started = 0, cancel;
+
+	if (first->cancelled)
+		return;
+	if (first->published != 0) {
+		if (first->error == 0)
+			first->error = error;
+		return;
+	}
+	if (first->error == 0)
+		first->error = error;
+	TAILQ_FOREACH(job, &state->jobs, link) {
+		if (job == first)
+			started = 1;
+		cancel = started && (job == first || (job->mask & affected) != 0);
+		for (i = 0; started && i < AGX_QUEUE_PIPES; i++)
+			if ((job->dependencies & (1U << i)) &&
+			    job->prior[i]->cancelled)
+				cancel = 1;
+		if (cancel) {
+			/* Publication cannot pass an earlier unpublished reservation. */
+			KASSERT(job->published == 0);
+			if (job->error == 0)
+				job->error = error;
+			job->cancelled = 1;
+			affected |= job->mask;
+			for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+				bit = 1U << i;
+				if (!(job->mask & bit) || (rolled & bit))
+					continue;
+				pipe = &state->pipes[i];
+				pipe->value = job->pipes[i].event.start_value;
+				pipe->cmd_seq = job->pipes[i].event.cmd_seq;
+				pipe->event_seq = job->pipes[i].event.event_seq;
+				pipe->generation++;
+				rolled |= bit;
+			}
+		}
+		for (i = 0; i < AGX_QUEUE_PIPES; i++)
+			if ((job->mask & (1U << i)) && !job->cancelled)
+				tail[i] = job;
+	}
+	for (i = 0; i < AGX_QUEUE_PIPES; i++)
+		if (affected & (1U << i))
+			agx_queue_tail_locked(&state->pipes[i], tail[i]);
+}
+
+/* State -> ordered channel locks -> IPL_HIGH admission. Nothing beneath the
+ * gate allocates, sleeps, invokes callbacks, signals fences or rings doorbells. */
+static int
+agx_queue_publish_locked(struct agx_queue_job *job)
+{
+	static const unsigned int order[] = {
+		AGX_FW_PIPE_FRAGMENT, AGX_FW_PIPE_VERTEX, AGX_FW_PIPE_COMPUTE
+	};
+	struct agx_queue_owner *owner = job->owner;
+	struct agx_queue_state *state = owner->state;
+	struct agx_queue_pipe_state *pipe;
+	struct agx_queue_job_pipe *jp;
+	uint32_t counts[3] = { 0, 0, 0 }, slots[3] = { 0, 0, 0 };
+	uint32_t notifications = 0, tvb = 0;
+	uint64_t threshold_before;
+	unsigned int mask = job->mask & ~job->retired, pending, i, index, bit;
+	unsigned int priority = owner->pipes[0].ring.priority;
+	int error, committed, notify_error = 0;
+
+	/* A partially published job must finish; an unpublished one cannot
+	 * cross queue close, including through a later progress retry. */
+	if (state->admission_closed && job->published == 0)
+		return ECANCELED;
+	if (state->stopped)
+		return ENODEV;
+	if (agx_fw_is_crashed(owner->runtime))
+		return ENXIO;
+	/* A cross-pipe firmware barrier must not target a reservation that can
+	 * still be cancelled without producing its stamp. */
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		bit = 1U << i;
+		if (!(job->dependencies & bit))
+			continue;
+		KASSERT(job->prior[i] != NULL);
+		if (job->prior[i]->error != 0)
+			return job->prior[i]->error;
+		if (!(job->prior[i]->published & bit))
+			return EBUSY;
+	}
+	pending = job->mask & ~job->published;
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		jp = &job->pipes[i];
+		if (!(job->mask & (1U << i)))
+			continue;
+		notifications += jp->stages;
+		if (!(pending & (1U << i)))
+			continue;
+		pipe = &state->pipes[i];
+		if (pipe->submit_seq != jp->event.cmd_seq)
+			return EBUSY;
+		/* Firmware supports strictly fewer than 127 outstanding events. */
+		if (agx_event_value_delta(jp->event.start_value +
+		    (jp->stages << 8), pipe->completed_value) >=
+		    AGX_QUEUE_MAX_EVENTS)
+			return EBUSY;
+		counts[i] = jp->count;
+		slots[i] = jp->event.slot;
+	}
+	if (mask == 0)
+		return 0;
+	error = agx_channel_bank_acquire(owner->bank, priority, mask);
+	if (error != 0)
+		return error;
+	/* Repair notification state before attempting another wptr publication. */
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		if (!(mask & (1U << i)))
+			continue;
+		if (owner->pipes[i].ring.needs_notify ||
+		    owner->pipes[i].ring.needs_kick) {
+			error = agx_channel_bank_notify_locked(owner->bank,
+			    &owner->pipes[i].ring);
+			if (error != 0)
+				goto release;
+		}
+	}
+	error = agx_queue_owner_preflight(owner, counts, slots);
+	if (error != 0)
+		goto release;
+	error = agx_runtime_admit_enter(owner->runtime);
+	if (error != 0)
+		goto release;
+	threshold_before = __atomic_load_n(owner->threshold, __ATOMIC_RELAXED);
+	if (!job->threshold) {
+		error = agx_event_threshold_increase(owner->threshold, notifications);
+		if (error != 0)
+			goto leave;
+		job->threshold = 1;
+	}
+	for (i = 0; i < nitems(order); i++) {
+		index = order[i];
+		bit = 1U << index;
+		if (!(pending & bit))
+			continue;
+		jp = &job->pipes[index];
+		if (index == AGX_FW_PIPE_VERTEX) {
+			for (tvb = 0; tvb < jp->stages; tvb++) {
+				error = agx_tvb_increment(&owner->tvb);
+				if (error != 0)
+					break;
+			}
+			if (error != 0) {
+				while (tvb-- != 0)
+					agx_tvb_increment_rollback(&owner->tvb);
+				break;
+			}
+		}
+		error = agx_channel_bank_publish_locked(owner->bank,
+		    &owner->pipes[index].ring, jp->commands, jp->count,
+		    jp->event.slot, &committed);
+		if (committed) {
+			job->published |= bit;
+			state->pipes[index].submit_seq += jp->count;
+			state->pipes[index].submitted_value =
+			    jp->event.start_value + (jp->stages << 8);
+		} else if (index == AGX_FW_PIPE_VERTEX) {
+			while (tvb-- != 0)
+				agx_tvb_increment_rollback(&owner->tvb);
+		}
+		if (error != 0)
+			break;
+	}
+	if (job->published == 0 && job->threshold) {
+		__atomic_store_n(owner->threshold, threshold_before, __ATOMIC_RELAXED);
+		job->threshold = 0;
+	}
+leave:
+	agx_runtime_admit_leave(owner->runtime);
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		bit = 1U << i;
+		if (!(job->published & bit))
+			continue;
+		if (!(mask & bit))
+			continue;
+		notify_error = agx_channel_bank_notify_locked(owner->bank,
+		    &owner->pipes[i].ring);
+		if (error == 0)
+			error = notify_error;
+	}
+release:
+	agx_channel_bank_release(owner->bank, priority, mask);
+	return error;
+}
+
+static int
+agx_queue_retryable(int error)
+{
+	return error == EBUSY || error == EAGAIN || error == ENOMEM;
+}
+
+static int
+agx_queue_needs_publish(struct agx_queue_job *job)
+{
+	unsigned int i;
+
+	if (job->published != job->mask)
+		return 1;
+	for (i = 0; i < AGX_QUEUE_PIPES; i++)
+		if ((job->published & ~job->retired & (1U << i)) &&
+		    (job->owner->pipes[i].ring.needs_notify ||
+		    job->owner->pipes[i].ring.needs_kick))
+			return 1;
+	return 0;
+}
+
+/* Commit hooks can take TVB locks. Run them after notification, without queue
+ * locks, and keep completion fenced until every published hook has returned. */
+static void
+agx_queue_commit_callbacks(struct agx_queue_job *job)
+{
+	struct agx_queue_state *state = job->owner->state;
+	unsigned int mask, i;
+
+	rw_enter_write(&state->lock);
+	mask = job->published & ~(job->commits | job->committing);
+	job->committing |= mask;
+	rw_exit_write(&state->lock);
+	for (i = 0; i < AGX_QUEUE_PIPES; i++)
+		if ((mask & (1U << i)) && job->commit != NULL)
+			job->commit(job->commit_cookie, i);
+	rw_enter_write(&state->lock);
+	job->commits |= mask;
+	job->committing &= ~mask;
+	rw_exit_write(&state->lock);
+}
+
+/* The GPU may retire dependent work on another pipe first.  Its host
+ * completion must not overtake a predecessor's captured error. */
+static int
+agx_queue_predecessors_done(struct agx_queue_job *job, int stopped)
+{
+	struct agx_queue_job *prior;
+	unsigned int i;
+
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		if (!(job->dependencies & (1U << i)))
+			continue;
+		prior = job->prior[i];
+		KASSERT(prior != NULL);
+		if (!prior->completed && !stopped)
+			return 0;
+		if (job->error == 0 && (prior->error != 0 || !prior->completed))
+			job->error = prior->error != 0 ? prior->error : ECANCELED;
+	}
+	return 1;
+}
+
+static void
+agx_queue_progress_held(struct agx_queue_owner *owner)
+{
+	struct agx_queue_state *state = owner->state;
+	struct agx_queue_job *job, *done, *commit_job;
+	void (*complete)(void *, int);
+	void *complete_cookie;
+	int error, fail, again;
+
+	for (;;) {
+		done = commit_job = NULL;
+		fail = again = 0;
+		rw_enter_write(&state->lock);
+		if (state->closing) {
+			rw_exit_write(&state->lock);
+			break;
+		}
+		/* Only bridge-delivered captured boundaries retire work. Polling a
+		 * newer stamp here could overtake an already captured fault boundary. */
+		TAILQ_FOREACH(job, &state->jobs, link) {
+			if (!job->submitted || job->completed)
+				continue;
+			if (!state->stopped && agx_queue_needs_publish(job)) {
+				if (job->error != 0 && job->published == 0)
+					agx_queue_cancel_locked(job, job->error);
+				else {
+					error = agx_queue_publish_locked(job);
+					if (error != 0 && !agx_queue_retryable(error)) {
+						if (job->published == 0)
+							agx_queue_cancel_locked(job, error);
+						else {
+							if (job->error == 0)
+								job->error = error;
+							fail = error;
+						}
+					}
+				}
+			}
+			if (job->published & ~(job->commits | job->committing)) {
+				agx_queue_job_ref(job);
+				commit_job = job;
+				break;
+			}
+			if (job->committing != 0) {
+				again = 1;
+				continue;
+			}
+			if (state->stopped || (job->error != 0 && job->published == 0) ||
+			    (job->published == job->mask && job->retired == job->mask)) {
+				if (job->published != 0 &&
+				    !agx_queue_predecessors_done(job, state->stopped))
+					continue;
+				job->completed = 1;
+				agx_queue_job_ref(job);
+				done = job;
+				break;
+			}
+			if (!agx_fw_is_crashed(owner->runtime) &&
+			    agx_queue_needs_publish(job))
+				again = 1;
+		}
+		if (again)
+			timeout_add_msec(&state->retry, 1);
+		agx_queue_idle_locked(state);
+		if (done != NULL) {
+			complete = done->complete;
+			complete_cookie = done->complete_cookie;
+			error = done->error;
+		}
+		rw_exit_write(&state->lock);
+		if (fail != 0)
+			agx_runtime_mark_failed(owner->runtime, fail);
+		if (commit_job != NULL) {
+			agx_queue_commit_callbacks(commit_job);
+			agx_queue_job_unref(commit_job);
+			continue;
+		}
+		if (done == NULL)
+			break;
+		complete(complete_cookie, error);
+		agx_queue_job_unref(done);
+	}
+}
+
+static void
+agx_queue_progress(void *cookie)
+{
+	struct agx_queue_owner *owner = cookie;
+
+	if (agx_queue_owner_get(owner) != 0)
+		return;
+	agx_queue_progress_held(owner);
+	agx_queue_owner_put(owner);
+}
+
+int
+agx_queue_job_submit(struct agx_queue_job *job,
+    void (*complete)(void *, int), void *cookie)
+{
+	struct agx_queue_owner *owner;
+	struct agx_queue_state *state;
+	int error, fail;
+	unsigned int i;
+
+	if (job == NULL || complete == NULL)
+		return EINVAL;
+	owner = job->owner;
+	error = agx_queue_owner_get(owner);
+	if (error != 0)
+		return error;
+	state = owner->state;
+	/* Execution still owns the VM bind. A tail pin preserves its root/slot
+	 * without holding vm->active and blocking the next VM mutation. */
+	if (!job->tail_pinned) {
+		error = agx_gpu_context_tail_pin(owner->context, &job->tail_slot);
+		if (error != 0)
+			goto out;
+		job->tail_pinned = 1;
+	}
+	rw_enter_write(&state->lock);
+	if (!job->accepted || job->submitted) {
+		error = EINVAL;
+		goto unlock;
+	}
+	error = job->error;
+	for (i = 0; error == 0 && i < AGX_QUEUE_PIPES; i++)
+		if ((job->dependencies & (1U << i)) && job->prior[i]->error != 0)
+			error = job->prior[i]->error;
+	if (error == 0)
+		error = agx_queue_publish_locked(job);
+	if (error != 0 && job->published == 0 && !agx_queue_retryable(error)) {
+		agx_queue_cancel_locked(job, error);
+		goto unlock;
+	}
+	job->complete = complete;
+	job->complete_cookie = cookie;
+	job->submitted = 1;
+	fail = error != 0 && job->published != 0 &&
+	    !agx_queue_retryable(error);
+	if (fail && job->error == 0)
+		job->error = error;
+	rw_exit_write(&state->lock);
+	if (fail)
+		agx_runtime_mark_failed(owner->runtime, error);
+	/* Process publication hooks immediately.  In particular, a TVB
+	 * initializer must release init_pending before the next preparation can
+	 * proceed.  Progress arms the retry timer only if work still needs it. */
+	agx_queue_progress_held(owner);
+	error = 0;
+	goto out;
+unlock:
+	rw_exit_write(&state->lock);
+out:
+	agx_queue_owner_put(owner);
+	return error;
+}
+
+void
+agx_queue_job_abort(struct agx_queue_job *job, int error)
+{
+	struct agx_queue_state *state;
+	int irreversible;
+
+	if (job == NULL)
+		return;
+	state = job->owner->state;
+	if (error <= 0)
+		error = error < 0 ? -error : EIO;
+	rw_enter_write(&state->lock);
+	irreversible = job->published != 0;
+	agx_queue_cancel_locked(job, error);
+	rw_exit_write(&state->lock);
+	if (irreversible)
+		agx_runtime_mark_failed(job->owner->runtime, error);
+}
+
+void
+agx_queue_job_timeout(struct agx_queue_job *job)
+{
+	if (job == NULL)
+		return;
+	agx_queue_job_abort(job, ETIMEDOUT);
+	/* Freeze admission, not completion or DMA ownership. */
+	agx_runtime_mark_failed(job->owner->runtime, ETIMEDOUT);
+}
+
+int
+agx_queue_job_timeout_pending(struct agx_queue_job *job)
+{
+	struct agx_queue_state *state;
+	int published;
+
+	KASSERT(job != NULL);
+	state = job->owner->state;
+	rw_enter_write(&state->lock);
+	if (job->completed) {
+		rw_exit_write(&state->lock);
+		return 0;
+	}
+	published = job->published != 0;
+	agx_queue_cancel_locked(job, ETIMEDOUT);
+	rw_exit_write(&state->lock);
+	if (published)
+		agx_runtime_mark_failed(job->owner->runtime, ETIMEDOUT);
+	return 1;
+}
+
+void
+agx_queue_job_put(struct agx_queue_job *job)
+{
+	struct agx_queue_owner *owner;
+	struct agx_queue_state *state;
+	unsigned int i;
+
+	if (job == NULL)
+		return;
+	owner = job->owner;
+	state = owner->state;
+	rw_enter_write(&state->lock);
+	KASSERT(job->external);
+	KASSERT(job->published == 0 || job->completed);
+	if (job->accepted) {
+		if (!job->submitted && job->error == 0)
+			agx_queue_cancel_locked(job, ECANCELED);
+		TAILQ_REMOVE(&state->jobs, job, link);
+		job->accepted = 0;
+		agx_queue_job_unref(job);
+	}
+	job->external = 0;
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		if (job->pipes[i].epoch != NULL) {
+			KASSERT(state->pipes[i].users != 0);
+			state->pipes[i].users--;
+			agx_queue_event_unref(job->pipes[i].epoch);
+			job->pipes[i].epoch = NULL;
+		}
+		agx_queue_job_unref(job->prior[i]);
+		job->prior[i] = NULL;
+		if (job->prior_epoch[i] != NULL) {
+			agx_queue_event_unref(job->prior_epoch[i]);
+			job->prior_epoch[i] = NULL;
+		}
+	}
+	agx_queue_idle_locked(state);
+	agx_queue_job_unref(job);
+	rw_exit_write(&state->lock);
+	agx_queue_owner_put(owner);
+}
+
+static void
+agx_queue_state_destroy(void *cookie)
+{
+	struct agx_queue_state *state = cookie;
+
+	/* The reaper was queued after context invalidation/unmapping returned.
+	 * Its worker now only returns; this wait cannot obstruct GPU progress. */
+	taskq_destroy(state->tasks);
+	free(state, M_DEVBUF, sizeof(*state));
+}
+
+static void
+agx_queue_state_reap(void *cookie)
+{
+	struct agx_queue_state *state = cookie;
+
+	task_add(systqmp, &state->destroy_task);
+}
+
+int
+agx_queue_jobs_init(struct agx_queue_owner *owner)
+{
+	struct agx_queue_state *state;
+
+	state = malloc(sizeof(*state), M_DEVBUF, M_WAITOK | M_ZERO);
+	rw_init(&state->lock, "agxqstate");
+	TAILQ_INIT(&state->jobs);
+	TAILQ_INIT(&state->retained);
+	state->owner = owner;
+	timeout_set_proc(&state->retry, agx_queue_progress, owner);
+	task_set(&state->reap_task, agx_queue_state_reap, state);
+	task_set(&state->destroy_task, agx_queue_state_destroy, state);
+	state->tasks = taskq_create("agxqfree", 1, IPL_NONE, TASKQ_MPSAFE);
+	if (state->tasks == NULL) {
+		free(state, M_DEVBUF, sizeof(*state));
+		return ENOMEM;
+	}
+	owner->state = state;
+	return 0;
+}
+
+struct taskq *
+agx_queue_jobs_taskq(struct agx_queue_owner *owner)
+{
+	return owner->state->tasks;
+}
+
+void
+agx_queue_jobs_stop_admission(struct agx_queue_owner *owner)
+{
+	struct agx_queue_state *state = owner->state;
+
+	if (state == NULL)
+		return;
+	rw_enter_write(&state->lock);
+	state->admission_closed = 1;
+	rw_exit_write(&state->lock);
+}
+
+int
+agx_queue_jobs_close(struct agx_queue_owner *owner)
+{
+	struct agx_queue_state *state = owner->state;
+
+	if (state == NULL)
+		return 0;
+	timeout_del_barrier(&state->retry);
+	rw_enter_write(&state->lock);
+	state->closing = 1;
+	KASSERT(TAILQ_EMPTY(&state->jobs));
+	agx_queue_idle_locked(state);
+	rw_exit_write(&state->lock);
+	/* Epoch delivery/release uses systqmp: never wait for it here. */
+	return __atomic_load_n(&state->event_refs, __ATOMIC_ACQUIRE) != 0 ?
+	    EBUSY : 0;
+}
+
+int
+agx_queue_jobs_fini(struct agx_queue_owner *owner)
+{
+	struct agx_queue_state *state = owner->state;
+	unsigned int i;
+
+	if (state == NULL)
+		return 0;
+	if (state->finalizing)
+		return state->finalize_error;
+	KASSERT(TAILQ_EMPTY(&state->jobs));
+	KASSERT(__atomic_load_n(&state->event_refs, __ATOMIC_ACQUIRE) == 0);
+	state->finalizing = 1;
+	/* Firmware context invalidation has succeeded. Only now can the final
+	 * completed work objects, still potentially firmware-cached, be freed. */
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		KASSERT(state->pipes[i].epoch == NULL);
+		agx_queue_tail_locked(&state->pipes[i], NULL);
+		agx_queue_job_unref(state->pipes[i].last_completed);
+		state->pipes[i].last_completed = NULL;
+	}
+	return state->finalize_error;
+}
+
+void
+agx_queue_jobs_reap(struct agx_queue_owner *owner)
+{
+	if (owner->state != NULL)
+		task_add(owner->state->tasks, &owner->state->reap_task);
+}
