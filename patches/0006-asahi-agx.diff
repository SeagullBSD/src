+/* SPDX-License-Identifier: MIT */
+/* Allocation and composition of vertex and fragment jobs. */
+#include <sys/types.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <drm/asahi_drm.h>
+#include "agx_render_high.h"
+
+static int
+agx_render_job_object(struct agx_heap *heap, size_t size, struct agx_object **out)
+{
+	int error = agx_object_alloc(heap, size, 16, out);
+	if (error != 0) return error;
+	if ((*out)->cpu == NULL) {
+		agx_object_free(*out);
+		*out = NULL;
+		return EINVAL;
+	}
+	memset((*out)->cpu, 0, size);
+	return 0;
+}
+
+void
+agx_render_job_free(struct agx_render_job *j)
+{
+	if (j->aux_fb) agx_object_free(j->aux_fb);
+	if (j->barrier) agx_object_free(j->barrier);
+	if (j->init_buffer) agx_object_free(j->init_buffer);
+	if (j->timestamps) agx_object_free(j->timestamps);
+	if (j->fragment_seq) agx_object_free(j->fragment_seq);
+	if (j->vertex_seq) agx_object_free(j->vertex_seq);
+	if (j->fragment) agx_object_free(j->fragment);
+	if (j->vertex) agx_object_free(j->vertex);
+	agx_scene_free(&j->scene);
+	memset(j, 0, sizeof(*j));
+}
+
+int
+agx_render_job_alloc(struct agx_heap *shared, struct agx_heap *user,
+    struct agx_heap *vm_private, struct agx_heap *fw_private,
+    struct agx_heap *gpu_ro, struct agx_heap *gpu,
+    unsigned int version, int g14x, const struct drm_asahi_cmd_render *cmd,
+    uint32_t clusters, uint64_t stats, struct agx_render_job *out)
+{
+	struct agx_render_job j;
+	size_t vs, fs, vseq, fseq;
+	int error;
+	if (shared == NULL || user == NULL || vm_private == NULL ||
+	    fw_private == NULL || gpu_ro == NULL || gpu == NULL || cmd == NULL ||
+	    out == NULL || clusters == 0 || clusters > 4 ||
+	    (!g14x && clusters != 1) || (g14x && version != 13) ||
+	    (version != 12 && version != 13)) return EINVAL;
+	memset(&j, 0, sizeof(j));
+	j.version = version;
+	j.g14x = g14x;
+	error = agx_render_tiling(cmd,
+	    (cmd->flags & DRM_ASAHI_RENDER_NO_VERTEX_CLUSTERING) ? 1 : clusters,
+	    &j.tile);
+	if (error != 0) return error;
+	if (g14x)
+		j.tile.meta1_blocks = j.tile.meta1_layer_stride;
+	error = agx_scene_alloc(shared, user, vm_private, gpu, &j.tile, version,
+	    g14x, clusters, stats, &j.scene);
+	if (error != 0) goto fail;
+	vs = g14x ? sizeof(struct agx_fw_vertex_g14x_13_5) :
+	    version == 12 ? sizeof(struct agx_fw_vertex_12_3) :
+	    sizeof(struct agx_fw_vertex_13_5);
+	fs = g14x ? sizeof(struct agx_fw_fragment_g14x_13_5) :
+	    version == 12 ? sizeof(struct agx_fw_fragment_12_3) :
+	    sizeof(struct agx_fw_fragment_13_5);
+	vseq = (g14x ? sizeof(struct agx_fw_start_vertex_g14x_13_5) :
+	    sizeof(struct agx_fw_start_vertex_13_5)) +
+	    2 * sizeof(struct agx_fw_microseq_timestamp_13_5) +
+	    sizeof(struct agx_fw_finalize_vertex_13_5) + 2 * sizeof(uint32_t);
+	fseq = (g14x ? sizeof(struct agx_fw_start_fragment_g14x_13_5) :
+	    sizeof(struct agx_fw_start_fragment_13_5)) +
+	    2 * sizeof(struct agx_fw_microseq_timestamp_13_5) +
+	    sizeof(struct agx_fw_finalize_fragment_13_5) + 2 * sizeof(uint32_t);
+#define OBJ(heap, size, member) do { \
+	error = agx_render_job_object((heap), (size), &j.member); \
+	if (error != 0) goto fail; \
+} while (0)
+	OBJ(gpu_ro, vs, vertex);
+	OBJ(gpu_ro, fs, fragment);
+	OBJ(fw_private, vseq, vertex_seq);
+	OBJ(user, 0x8000, aux_fb);
+	OBJ(fw_private, fseq, fragment_seq);
+	OBJ(shared, sizeof(struct agx_fw_render_timestamps), timestamps);
+	OBJ(fw_private, sizeof(struct agx_fw_init_buffer), init_buffer);
+	OBJ(fw_private, sizeof(struct agx_fw_barrier), barrier);
+#undef OBJ
+	*out = j;
+	return 0;
+fail:
+	agx_render_job_free(&j);
+	return error;
+}
+
+static int
+agx_render_args_match(const struct agx_render_microseq_args *m,
+    const struct agx_vertex_work_args *w)
+{
+	return m->vm_slot == w->vm_slot && m->buffer_slot == w->buffer_slot &&
+	    m->fw_stamp_va == w->fw_stamp_va && m->stamp_value == w->stamp_value &&
+	    m->event_seq == w->event_seq && m->counter == w->counter;
+}
+
+int
+agx_render_job_encode(struct agx_render_job *j,
+    const struct drm_asahi_cmd_render *cmd,
+    const struct agx_render_microseq_args *vm,
+    const struct agx_render_microseq_args *fm,
+    const struct agx_vertex_work_args *vw,
+    const struct agx_fragment_work_args *fw)
+{
+	struct agx_render_microseq_args vma, fma;
+	struct agx_vertex_work_args vwa;
+	struct agx_fragment_work_args fwa;
+	struct agx_microseq seq;
+	int error;
+	if (j == NULL || cmd == NULL || vm == NULL || fm == NULL || vw == NULL ||
+	    fw == NULL || j->encoded || j->vertex == NULL || j->fragment == NULL ||
+	    j->vertex_seq == NULL || j->fragment_seq == NULL || j->timestamps == NULL ||
+	    j->scene.scene == NULL || !agx_render_args_match(vm, vw) ||
+	    !agx_render_args_match(fm, &fw->common) ||
+	    vw->vm_slot != fw->common.vm_slot || vw->buffer_slot != fw->common.buffer_slot ||
+	    vw->buffer_va != fw->common.buffer_va ||
+	    vw->kernel_buffer_va != fw->common.kernel_buffer_va ||
+	    vw->fragment_stamp_slot != fw->common.stamp_slot ||
+	    vw->fragment_stamp_value != fw->common.stamp_value)
+		return EINVAL;
+	vma = *vm; fma = *fm; vwa = *vw; fwa = *fw;
+	vma.work_va = j->vertex->gpu; fma.work_va = j->fragment->gpu;
+	vma.g14x = fma.g14x = j->g14x;
+	vwa.work_va = j->vertex->gpu;
+	fwa.common.work_va = j->fragment->gpu;
+	vma.scene_va = fma.scene_va = j->scene.scene->gpu;
+	vma.buffer_va = fma.buffer_va = vwa.buffer_va;
+	vma.timestamps = vwa.user_start_va != 0 || vwa.user_end_va != 0;
+	fma.timestamps = fwa.common.user_start_va != 0 || fwa.common.user_end_va != 0;
+	seq.bytes = j->vertex_seq->cpu; seq.capacity = j->vertex_seq->size; seq.size = 0;
+	error = agx_render_microseq(&seq, j->version, 0, &vma);
+	fwa.aux_fb_va = j->aux_fb->gpu;
+	if (error != 0) return error;
+	vwa.microseq_va = j->vertex_seq->gpu; vwa.microseq_size = seq.size;
+	seq.bytes = j->fragment_seq->cpu; seq.capacity = j->fragment_seq->size; seq.size = 0;
+	error = agx_render_microseq(&seq, j->version, 1, &fma);
+	if (error != 0) return error;
+	fwa.common.microseq_va = j->fragment_seq->gpu; fwa.common.microseq_size = seq.size;
+	vwa.timestamps_start_va = j->timestamps->gpu +
+	    offsetof(struct agx_fw_render_timestamps, vtx.start);
+	vwa.timestamps_end_va = j->timestamps->gpu +
+	    offsetof(struct agx_fw_render_timestamps, vtx.end);
+	fwa.common.timestamps_start_va = j->timestamps->gpu +
+	    offsetof(struct agx_fw_render_timestamps, frag.start);
+	fwa.common.timestamps_end_va = j->timestamps->gpu +
+	    offsetof(struct agx_fw_render_timestamps, frag.end);
+	error = agx_vertex_work(j->vertex->cpu, j->vertex->size, j->version, cmd,
+	    &j->tile, &j->scene, &vwa);
+	if (error != 0) return error;
+	error = agx_fragment_work(j->fragment->cpu, j->fragment->size, j->version,
+	    cmd, &j->tile, &j->scene, &fwa);
+	if (error != 0) return error;
+	j->encoded = 1;
+	return 0;
+}
