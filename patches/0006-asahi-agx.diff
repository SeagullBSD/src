+#ifndef _AGX_MEM_H_
+#define _AGX_MEM_H_
+
+#include <sys/types.h>
+#include <sys/rwlock.h>
+#include <machine/bus.h>
+
+#define AGX_PAGE_SHIFT	14
+#define AGX_PAGE_SIZE	(1UL << AGX_PAGE_SHIFT)
+#define AGX_PAGE_MASK	(AGX_PAGE_SIZE - 1)
+
+/* UAT physical widths; the 39-bit GPU virtual space is independent. */
+#define AGX_UAT_OAS_VALID(n)	((n) == 40 || (n) == 42)
+
+enum agx_mem_cache {
+	AGX_MEM_NOCACHE,
+	AGX_MEM_WRITEBACK
