Index: sys/dev/pci/drm/asahi/agx_submit.c
===================================================================
--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_submit.c	Wed Nov 18 20:52:59 2026
@@ -0,0 +1,679 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Stable command stream to firmware workqueue submission. */
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/systm.h>
+
+#include <drm/asahi_drm.h>
+#include <drm/drm_gem.h>
+
+#include "agx_context.h"
+#include "agx_fw.h"
+#include "agx_object.h"
+#include "agx_queue.h"
+#include "agx_queue_owner.h"
+#include "agx_render_high.h"
+#include "agx_sched.h"
+#include "agx_submit.h"
+#include "agx_timestamp.h"
+#include "agx_tvb.h"
+#include "agx_uat.h"
+
+struct agx_submit_command {
+	struct drm_asahi_cmd_header header;
+	union {
+		struct drm_asahi_cmd_render render;
+		struct drm_asahi_cmd_compute compute;
+	} cmd;
+	struct agx_fw_attachments attachments[2];
+	struct agx_timestamp *timestamps[4];
+	uint64_t timestamp_va[4];
+	struct agx_object *barriers[2];
+	struct agx_render_job render;
+	struct agx_compute_job compute;
+	uint32_t index;
+};
+
+struct agx_submit_resources {
+	struct agx_queue_owner *owner;
+	struct agx_submit_config config;
+	struct agx_cmd_counts counts;
+	uint32_t capacity[3], stages[3];
+	struct agx_submit_command *commands;
+	struct drm_gem_object **timestamp_gems;
+	size_t count, ntimestamps;
+	uint32_t vm_slot, tvb_slot, tvb_init_blocks;
+	int tvb_acquired, tvb_rebind, tvb_committed;
+	int owner_held;
+};
+
+static void
+agx_submit_release(void *cookie)
+{
+	struct agx_submit_resources *r = cookie;
+	struct agx_submit_command *c;
+	size_t i, j;
+
+	if (r == NULL)
+		return;
+	if (r->tvb_acquired && r->tvb_rebind && !r->tvb_committed &&
+	    agx_tvb_binding_abort(&r->owner->tvb, r->vm_slot, r->tvb_slot,
+	    r->tvb_init_blocks) != 0)
+		panic("agx: unpublished TVB binding changed");
+	for (i = 0; i < r->count; i++) {
+		c = &r->commands[i];
+		agx_render_job_free(&c->render);
+		agx_compute_job_free(&c->compute);
+		for (j = 0; j < nitems(c->barriers); j++)
+			agx_object_free(c->barriers[j]);
+		for (j = 0; j < nitems(c->timestamps); j++)
+			agx_timestamp_put(c->timestamps[j]);
+	}
+	if (r->tvb_acquired)
+		agx_tvb_release(&r->owner->tvb);
+	free(r->timestamp_gems, M_DEVBUF,
+	    r->count * 4 * sizeof(*r->timestamp_gems));
+	free(r->commands, M_DEVBUF, r->count * sizeof(*r->commands));
+	if (r->owner_held)
+		agx_queue_owner_put(r->owner);
+	free(r, M_DEVBUF, sizeof(*r));
+}
+
+static int
+agx_submit_timestamp(struct agx_submit_resources *r,
+    const struct agx_submit_config *config, struct agx_submit_command *c,
+    unsigned int i, const struct drm_asahi_timestamp *ts)
+{
+	struct drm_gem_object *gem;
+	int error;
+
+	error = agx_timestamp_lookup(config->timestamps, ts->handle, ts->offset,
+	    &c->timestamps[i], &c->timestamp_va[i]);
+	if (error != 0)
+		return error;
+	if (c->timestamps[i] != NULL) {
+		gem = agx_timestamp_gem(c->timestamps[i]);
+		if (gem == NULL)
+			return EINVAL;
+		r->timestamp_gems[r->ntimestamps++] = gem;
+	}
+	return 0;
+}
+
+/* Validation establishes all bounds before this decoding pass. */
+static int
+agx_submit_parse(struct agx_submit_resources *r,
+    const struct agx_submit_config *config, const void *buffer, size_t size,
+    uint32_t cmd_counts[3], uint32_t event_counts[3])
+{
+	struct agx_fw_attachments attachments[3];
+	struct agx_submit_command *c;
+	struct drm_asahi_cmd_header h;
+	const uint8_t *p = buffer;
+	size_t n = 0, len;
+	uint32_t render = 0, compute = 0, pipe;
+	int error;
+	KERNEL_ASSERT_UNLOCKED();
+
+	memset(attachments, 0, sizeof(attachments));
+	while (size != 0) {
+		memcpy(&h, p, sizeof(h));
+		p += sizeof(h);
+		size -= sizeof(h);
+		if (h.cmd_type >= DRM_ASAHI_SET_VERTEX_ATTACHMENTS &&
+		    h.cmd_type <= DRM_ASAHI_SET_COMPUTE_ATTACHMENTS) {
+			pipe = h.cmd_type - DRM_ASAHI_SET_VERTEX_ATTACHMENTS;
+			error = agx_build_attachments(p, h.size, &attachments[pipe]);
+			if (error != 0)
+				return error;
+			goto next;
+		}
+		c = &r->commands[n++];
+		c->header = h;
+		if (h.cmd_type == DRM_ASAHI_CMD_RENDER) {
+			len = MIN(sizeof(c->cmd.render), (size_t)h.size);
+			memcpy(&c->cmd.render, p, len);
+			c->attachments[0] = attachments[0];
+			c->attachments[1] = attachments[1];
+			c->index = ++render;
+			pipe = AGX_FW_PIPE_VERTEX;
+			event_counts[AGX_FW_PIPE_VERTEX]++;
+			event_counts[AGX_FW_PIPE_FRAGMENT]++;
+			/* One init-buffer may be omitted once the slot is bound. */
+			cmd_counts[AGX_FW_PIPE_VERTEX] += 2;
+			cmd_counts[AGX_FW_PIPE_FRAGMENT] += 2;
+			error = agx_submit_timestamp(r, config, c, 0, &c->cmd.render.ts_vtx.start);
+			if (error == 0) error = agx_submit_timestamp(r, config, c, 1, &c->cmd.render.ts_vtx.end);
+			if (error == 0) error = agx_submit_timestamp(r, config, c, 2, &c->cmd.render.ts_frag.start);
+			if (error == 0) error = agx_submit_timestamp(r, config, c, 3, &c->cmd.render.ts_frag.end);
+		} else {
+			len = MIN(sizeof(c->cmd.compute), (size_t)h.size);
+			memcpy(&c->cmd.compute, p, len);
+			c->attachments[0] = attachments[2];
+			c->index = ++compute;
+			pipe = AGX_FW_PIPE_COMPUTE;
+			event_counts[pipe]++;
+			cmd_counts[pipe]++;
+			error = agx_submit_timestamp(r, config, c, 0, &c->cmd.compute.ts.start);
+			if (error == 0) error = agx_submit_timestamp(r, config, c, 1, &c->cmd.compute.ts.end);
+		}
+		if (error != 0)
+			return error;
+		if (h.vdm_barrier != DRM_ASAHI_BARRIER_NONE)
+			cmd_counts[pipe]++;
+		if (h.cdm_barrier != DRM_ASAHI_BARRIER_NONE)
+			cmd_counts[pipe]++;
+next:
+		p += h.size;
+		size -= h.size;
+	}
+	return 0;
+}
+
+static int
+agx_submit_alloc(struct agx_submit_resources *r,
+    const struct agx_submit_config *config)
+{
+	struct agx_context_vm *vm = agx_gpu_context_vm(r->owner->context);
+	struct agx_submit_command *c;
+	struct agx_tvb *tvb = &r->owner->tvb;
+	size_t i, j;
+	int error, auto_grown;
+	/* r->commands is private; shared heaps and TVB use their own locks. */
+	KERNEL_ASSERT_UNLOCKED();
+
+	for (i = 0; i < r->count; i++) {
+		c = &r->commands[i];
+		for (j = 0; j < 2; j++) {
+			uint16_t index = j == 0 ? c->header.vdm_barrier :
+			    c->header.cdm_barrier;
+			if (index == DRM_ASAHI_BARRIER_NONE)
+				continue;
+			error = agx_object_alloc(config->private,
+			    sizeof(struct agx_fw_barrier), 16, &c->barriers[j]);
+			if (error != 0)
+				return error;
+			if (c->barriers[j]->cpu == NULL)
+				return EINVAL;
+		}
+		if (c->header.cmd_type == DRM_ASAHI_CMD_RENDER) {
+			error = agx_render_job_alloc(config->shared,
+			    agx_context_vm_shared_heap(vm),
+			    agx_context_vm_private_heap(vm), config->private,
+			    config->gpu_ro, config->gpu, config->version, config->g14x,
+			    &c->cmd.render, config->clusters,
+			    tvb->stats->gpu,
+			    &c->render);
+			if (error != 0)
+				return error;
+			error = agx_tvb_auto_grow(tvb, &auto_grown);
+			if (error != 0)
+				return error;
+			error = agx_tvb_ensure_blocks(tvb, c->render.tile.min_tvb_blocks);
+			if (error != 0)
+				return error;
+		} else {
+			error = agx_compute_job_alloc(config->gpu_ro, config->private,
+			    agx_context_vm_shared_heap(vm), config->shared,
+			    config->version, config->g14x, &c->compute);
+			if (error != 0)
+				return error;
+		}
+	}
+	return 0;
+}
+
+static void
+agx_submit_commit(void *cookie, unsigned int pipe)
+{
+	struct agx_submit_resources *r = cookie;
+
+	if (pipe != AGX_FW_PIPE_VERTEX || !r->tvb_acquired)
+		return;
+	if (r->tvb_rebind) {
+		if (agx_tvb_binding_commit(&r->owner->tvb, r->vm_slot,
+		    r->tvb_slot, r->tvb_init_blocks) != 0)
+			panic("agx: published TVB binding changed");
+		r->tvb_committed = 1;
+	}
+}
+
+static uint32_t
+agx_submit_stamp(const struct agx_queue_job_event *ev, uint32_t index)
+{
+	return ev->start_value + (index << 8);
+}
+
+static void
+agx_submit_barriers(struct agx_submit_command *c,
+    const struct agx_queue_job_event ev[3],
+    const struct agx_queue_job_event prior[3], const int prior_valid[3],
+    uint32_t pipe, uint32_t stage, uint64_t *commands, uint32_t *used)
+{
+	const struct agx_queue_job_event *target;
+	uint16_t index[2] = { c->header.vdm_barrier, c->header.cdm_barrier };
+	unsigned int j, target_pipe;
+
+	for (j = 0; j < 2; j++) {
+		if (index[j] == DRM_ASAHI_BARRIER_NONE)
+			continue;
+		target_pipe = j == 0 ? AGX_FW_PIPE_FRAGMENT : AGX_FW_PIPE_COMPUTE;
+		if (index[j] == 0) {
+			if (!prior_valid[target_pipe])
+				continue;
+			target = &prior[target_pipe];
+		} else {
+			target = &ev[target_pipe];
+		}
+		agx_workqueue_barrier(c->barriers[j]->cpu, target->fw_stamp_va,
+		    agx_submit_stamp(target, index[j]), target->slot,
+		    agx_submit_stamp(&ev[pipe], stage));
+		commands[(*used)++] = c->barriers[j]->gpu;
+	}
+}
+
+static uint64_t
+agx_submit_notifier_buf(const struct agx_queue_owner *owner,
+    unsigned int version)
+{
+	if (version != 13)
+		return 0;
+	return owner->notifier_va + offsetof(struct agx_fw_notifier_13_5, state) +
+	    offsetof(struct agx_fw_notifier_state_13_5, unk_buf);
+}
+
+static int
+agx_submit_compute(struct agx_submit_resources *r,
+    const struct agx_submit_config *config, struct agx_submit_command *c,
+    const struct agx_queue_job_event *ev, uint64_t counter)
+{
+	struct agx_compute_microseq_args m;
+	struct agx_compute_work_args w;
+
+	memset(&m, 0, sizeof(m));
+	memset(&w, 0, sizeof(w));
+	w.notifier_va = r->owner->notifier_va;
+	w.stamp_va = ev->stamp_va;
+	w.fw_stamp_va = ev->fw_stamp_va;
+	w.user_start_va = c->timestamp_va[0];
+	w.user_end_va = c->timestamp_va[1];
+	w.vm_slot = r->vm_slot;
+	w.stamp_slot = ev->slot;
+	w.stamp_value = agx_submit_stamp(ev, c->index);
+	/* Flush the final compute stamp of this submission. */
+	w.flush_stamps = c->index == r->stages[AGX_FW_PIPE_COMPUTE];
+	w.event_seq = ev->event_seq + c->index - 1;
+	w.queue_id = (uint32_t)r->owner->id;
+	w.counter = counter;
+	m.stats_va = config->stats_comp;
+	m.queue_va = ev->queue_va;
+	m.fw_stamp_va = w.fw_stamp_va;
+	m.notifier_buf_va = agx_submit_notifier_buf(r->owner, config->version);
+	m.vm_slot = w.vm_slot;
+	m.event_generation = w.queue_id;
+	m.event_seq = w.event_seq;
+	m.stamp_value = w.stamp_value;
+	m.counter = counter;
+	m.attachments = c->attachments[0];
+	return agx_compute_job_encode(&c->compute, &c->cmd.compute,
+	    config->usc_exec_base, &m, &w);
+}
+
+static int
+agx_submit_render(struct agx_submit_resources *r,
+    const struct agx_submit_config *config, struct agx_submit_command *c,
+    const struct agx_queue_job_event *v, const struct agx_queue_job_event *f,
+    uint64_t counter)
+{
+	struct agx_render_microseq_args vm, fm;
+	struct agx_vertex_work_args vw;
+	struct agx_fragment_work_args fw;
+
+	memset(&vm, 0, sizeof(vm));
+	memset(&fm, 0, sizeof(fm));
+	memset(&vw, 0, sizeof(vw));
+	memset(&fw, 0, sizeof(fw));
+	vw.notifier_va = r->owner->notifier_va;
+	vw.buffer_va = r->owner->tvb.info->gpu;
+	vw.kernel_buffer_va = r->owner->tvb.kernel_buffer->gpu;
+	vw.stamp_va = v->stamp_va;
+	vw.fw_stamp_va = v->fw_stamp_va;
+	vw.user_start_va = c->timestamp_va[0];
+	vw.user_end_va = c->timestamp_va[1];
+	vw.usc_exec_base = config->usc_exec_base;
+	vw.vm_slot = r->vm_slot;
+	vw.buffer_slot = r->tvb_slot;
+	vw.stamp_slot = v->slot;
+	vw.stamp_value = agx_submit_stamp(v, c->index);
+	/* Vertex and fragment use the same render ordinal and final flush. */
+	vw.flush_stamps = c->index == r->stages[AGX_FW_PIPE_VERTEX];
+	vw.fragment_stamp_slot = f->slot;
+	vw.fragment_stamp_value = agx_submit_stamp(f, c->index);
+	vw.event_seq = v->event_seq + c->index - 1;
+	vw.queue_id = (uint32_t)r->owner->id;
+	vw.counter = counter + 1;
+	vw.core_mask[0] = config->core_mask[0];
+	vw.core_mask[1] = config->core_mask[1];
+	fw.common = vw;
+	fw.common.stamp_va = f->stamp_va;
+	fw.common.fw_stamp_va = f->fw_stamp_va;
+	fw.common.stamp_slot = f->slot;
+	fw.common.stamp_value = agx_submit_stamp(f, c->index);
+	fw.common.event_seq = f->event_seq + c->index - 1;
+	fw.common.user_start_va = c->timestamp_va[2];
+	fw.common.user_end_va = c->timestamp_va[3];
+	fw.common.counter = counter;
+	vm.stats_va = config->stats_vtx +
+	    offsetof(struct agx_fw_global_stats_vtx, stats);
+	vm.queue_va = v->queue_va;
+	vm.fw_stamp_va = v->fw_stamp_va;
+	vm.notifier_buf_va = agx_submit_notifier_buf(r->owner, config->version);
+	vm.vm_slot = r->vm_slot;
+	vm.buffer_slot = r->tvb_slot;
+	vm.event_generation = vw.queue_id;
+	vm.event_seq = vw.event_seq;
+	vm.stamp_value = vw.stamp_value;
+	vm.counter = vw.counter;
+	vm.attachments = c->attachments[0];
+	fm = vm;
+	fm.stats_va = config->stats_frag + (config->g14x ?
+	    offsetof(struct agx_fw_global_stats_frag_g14x, stats) :
+	    offsetof(struct agx_fw_global_stats_frag, stats));
+	fm.queue_va = f->queue_va;
+	fm.fw_stamp_va = f->fw_stamp_va;
+	fm.event_seq = fw.common.event_seq;
+	fm.stamp_value = fw.common.stamp_value;
+	fm.counter = counter;
+	fm.attachments = c->attachments[1];
+	return agx_render_job_encode(&c->render, &c->cmd.render, &vm, &fm,
+	    &vw, &fw);
+}
+
+/* The preparation task holds the kernel lock once.  All destinations below
+ * belong exclusively to this unpublished job; the owner assembly lock,
+ * job references, VM binding and firmware operation remain held throughout.
+ * Keep allocation, reservation and publication under their existing locks. */
+static int
+agx_submit_encode(struct agx_submit_resources *r,
+    const struct agx_queue_job_event ev[3],
+    const struct agx_queue_job_event prior[3], const int prior_valid[3],
+    uint64_t *commands[3], uint32_t used[3], uint64_t next_counter,
+    int need_init)
+{
+	struct agx_queue_owner *owner = r->owner;
+	const struct agx_submit_config *config = &r->config;
+	struct agx_submit_command *c;
+	uint64_t counter;
+	uint32_t pipe;
+	size_t i;
+	int error = 0;
+
+	KERNEL_ASSERT_LOCKED();
+	KERNEL_UNLOCK();
+	for (i = 0; i < r->count; i++) {
+		c = &r->commands[i];
+		pipe = c->header.cmd_type == DRM_ASAHI_CMD_RENDER ?
+		    AGX_FW_PIPE_VERTEX : AGX_FW_PIPE_COMPUTE;
+		agx_submit_barriers(c, ev, prior, prior_valid, pipe, c->index,
+		    commands[pipe], &used[pipe]);
+		counter = next_counter;
+		if (pipe == AGX_FW_PIPE_COMPUTE) {
+			next_counter++;
+			error = agx_submit_compute(r, config, c, &ev[pipe], counter);
+			if (error != 0)
+				break;
+			commands[pipe][used[pipe]++] = c->compute.work->gpu;
+			continue;
+		}
+		next_counter += 2;
+		if (need_init) {
+			error = agx_tvb_init_work(c->render.init_buffer->cpu,
+			    r->vm_slot, r->tvb_slot, r->tvb_init_blocks,
+			    owner->tvb.info->gpu, agx_submit_stamp(&ev[pipe], c->index));
+			if (error != 0)
+				break;
+			commands[pipe][used[pipe]++] = c->render.init_buffer->gpu;
+			need_init = 0;
+		}
+		error = agx_submit_render(r, config, c, &ev[AGX_FW_PIPE_VERTEX],
+		    &ev[AGX_FW_PIPE_FRAGMENT], counter);
+		if (error != 0)
+			break;
+		agx_render_barrier(c->render.barrier->cpu,
+		    ev[AGX_FW_PIPE_VERTEX].fw_stamp_va,
+		    agx_submit_stamp(&ev[AGX_FW_PIPE_VERTEX], c->index),
+		    ev[AGX_FW_PIPE_VERTEX].slot,
+		    agx_submit_stamp(&ev[AGX_FW_PIPE_FRAGMENT], c->index));
+		commands[AGX_FW_PIPE_VERTEX][used[AGX_FW_PIPE_VERTEX]++] =
+		    c->render.vertex->gpu;
+		commands[AGX_FW_PIPE_FRAGMENT][used[AGX_FW_PIPE_FRAGMENT]++] =
+		    c->render.barrier->gpu;
+		commands[AGX_FW_PIPE_FRAGMENT][used[AGX_FW_PIPE_FRAGMENT]++] =
+		    c->render.fragment->gpu;
+	}
+	KERNEL_LOCK();
+	return error;
+}
+
+/* A pending initializer owns the current block-count snapshot.  Wait before
+ * taking predecessor references or growing it, so an aborted initializer can
+ * release its resources and unblock this preparation. */
+static int
+agx_submit_wait_tvb(struct agx_queue_owner *owner, const int *cancel,
+    const int *stopped)
+{
+	struct agx_tvb *tvb = &owner->tvb;
+	int error = 0;
+
+	rw_enter_write(&tvb->lock);
+	while (tvb->init_pending) {
+		error = __atomic_load_n(cancel, __ATOMIC_ACQUIRE);
+		if (error != 0)
+			break;
+		if (__atomic_load_n(stopped, __ATOMIC_ACQUIRE) ||
+		    agx_fw_is_crashed(owner->runtime)) {
+			error = ENODEV;
+			break;
+		}
+		rwsleep_nsec(tvb, &tvb->lock, PWAIT, "agxtvb", MSEC_TO_NSEC(100));
+	}
+	rw_exit_write(&tvb->lock);
+	return error;
+}
+
+static int
+agx_submit_prepare(void *cookie, struct agx_queue_job **out,
+    struct agx_vm_snapshot *snapshot, struct drm_gem_object *const **extra,
+    size_t *nextra, int *bound, const int *cancel, const int *stopped)
+{
+	struct agx_submit_resources *r = cookie;
+	struct agx_queue_owner *owner = r->owner;
+	const struct agx_submit_config *config = &r->config;
+	struct agx_submit_command *c;
+	struct agx_queue_job *job = NULL;
+	struct agx_queue_job_event ev[3], prior[3];
+	struct agx_cmd_counts counts = r->counts;
+	uint64_t *commands[3] = { NULL, NULL, NULL }, next_counter;
+	uint32_t *capacity = r->capacity, *stages = r->stages;
+	uint32_t used[3] = { 0, 0, 0 }, pipe;
+	int prior_valid[3] = { 0, 0, 0 };
+	int error, rebind, need_init;
+	size_t i;
+
+	memset(ev, 0, sizeof(ev));
+	memset(prior, 0, sizeof(prior));
+	agx_queue_owner_assemble_enter(owner);
+	if (counts.render != 0) {
+		error = agx_submit_wait_tvb(owner, cancel, stopped);
+		if (error != 0)
+			goto fail;
+	}
+	/* Every allocation that can map the VM precedes the bind/snapshot gate. */
+	/* These unpublished job buffers use their AGX heap and TVB locks. */
+	KERNEL_ASSERT_LOCKED();
+	KERNEL_UNLOCK();
+	error = agx_submit_alloc(r, config);
+	KERNEL_LOCK();
+	if (error != 0)
+		goto fail;
+	error = agx_queue_job_prepare(owner, capacity, stages, agx_submit_release,
+	    r, cancel, stopped, &job);
+	if (error != 0)
+		goto fail;
+	/* The queue job now owns an owner reference and the resource cookie. */
+	r->owner_held = 0;
+	agx_queue_owner_put(owner);
+	for (pipe = 0; pipe < AGX_QUEUE_PIPES; pipe++) {
+		error = agx_queue_job_predecessor(job, pipe, &prior[pipe],
+		    &prior_valid[pipe]);
+		if (error != 0)
+			goto fail;
+	}
+	error = agx_queue_job_set_commit(job, agx_submit_commit, r);
+	if (error != 0)
+		goto fail;
+	for (i = 0; i < r->count; i++) {
+		c = &r->commands[i];
+		if (c->header.vdm_barrier == 0 && prior_valid[AGX_FW_PIPE_FRAGMENT]) {
+			if (prior[AGX_FW_PIPE_FRAGMENT].error != 0) {
+				error = prior[AGX_FW_PIPE_FRAGMENT].error;
+				goto fail;
+			}
+			error = agx_queue_job_depend_pipe(job, AGX_FW_PIPE_FRAGMENT);
+			if (error != 0)
+				goto fail;
+		}
+		if (c->header.cdm_barrier == 0 && prior_valid[AGX_FW_PIPE_COMPUTE]) {
+			if (prior[AGX_FW_PIPE_COMPUTE].error != 0) {
+				error = prior[AGX_FW_PIPE_COMPUTE].error;
+				goto fail;
+			}
+			error = agx_queue_job_depend_pipe(job, AGX_FW_PIPE_COMPUTE);
+			if (error != 0)
+				goto fail;
+		}
+	}
+	for (pipe = 0; pipe < AGX_QUEUE_PIPES; pipe++) {
+		if (stages[pipe] == 0)
+			continue;
+		error = agx_queue_job_pipe(job, pipe, &ev[pipe], &commands[pipe]);
+		if (error != 0)
+			goto fail;
+	}
+	error = agx_queue_owner_counters(owner, 2 * counts.render + counts.compute,
+	    &next_counter);
+	if (error != 0)
+		goto fail;
+	error = agx_gpu_context_bind(owner->context, &r->vm_slot, cancel, stopped);
+	if (error != 0)
+		goto fail;
+	*bound = 1;
+	error = agx_vm_snapshot(agx_context_vm_raw(agx_gpu_context_vm(owner->context)),
+	    snapshot);
+	if (error != 0)
+		goto fail;
+	
+	need_init = 0;
+	if (counts.render != 0) {
+		if (prior_valid[AGX_FW_PIPE_VERTEX]) {
+			error = agx_queue_job_depend_pipe(job, AGX_FW_PIPE_VERTEX);
+			if (error != 0)
+				goto fail;
+		}
+		error = agx_tvb_acquire(&owner->tvb, r->vm_slot,
+		    prior_valid[AGX_FW_PIPE_VERTEX], &r->tvb_slot, &rebind,
+		    &r->tvb_init_blocks);
+		if (error != 0)
+			goto fail;
+		r->tvb_acquired = 1;
+		r->tvb_rebind = rebind;
+		need_init = rebind;
+	}
+	error = agx_submit_encode(r, ev, prior, prior_valid, commands, used,
+	    next_counter, need_init);
+	if (error != 0)
+		goto fail;
+	for (pipe = 0; pipe < AGX_QUEUE_PIPES; pipe++) {
+		if (used[pipe] > capacity[pipe]) {
+			error = EOVERFLOW;
+			goto fail;
+		}
+		error = agx_queue_job_set_count(job, pipe, used[pipe]);
+		if (error != 0)
+			goto fail;
+	}
+	error = agx_queue_job_accept(job);
+fail:
+	*out = job;
+	*extra = r->timestamp_gems;
+	*nextra = r->ntimestamps;
+	agx_queue_owner_assemble_leave(owner);
+	return error;
+}
+
+/* The ioctl supplies a private command copy.  Validation only reads it and
+ * computes stack-local state, so it does not need the ioctl's kernel lock. */
+static int
+agx_submit_validate(const void *buffer, size_t size, struct agx_cmd_counts *counts)
+{
+	int error;
+
+	KERNEL_ASSERT_LOCKED();
+	KERNEL_UNLOCK();
+	error = agx_validate_cmdbuf(buffer, size, counts);
+	KERNEL_LOCK();
+	return error;
+}
+
+int
+agx_submit(struct agx_sched *sched, struct agx_queue_owner *owner,
+    const struct agx_submit_config *config, const void *buffer, size_t size,
+    struct agx_sync *syncs, size_t ninputs, size_t noutputs, uint64_t id,
+    struct agx_file_queue *queue)
+{
+	struct agx_submit_resources *r;
+	struct agx_cmd_counts counts;
+	int error;
+
+	if (sched == NULL || owner == NULL || config == NULL || buffer == NULL ||
+	    config->shared == NULL || config->private == NULL || config->gpu_ro == NULL ||
+	    config->gpu == NULL || config->clusters == 0 ||
+	    config->timestamps == NULL || owner->context == NULL ||
+	    config->stats_vtx == 0 || config->stats_frag == 0 ||
+	    config->stats_comp == 0 ||
+	    (config->core_mask[0] | config->core_mask[1] | config->core_mask[2]) == 0 ||
+	    (config->version != 12 && config->version != 13) ||
+	    (config->g14x && config->version != 13) ||
+	    (uint32_t)owner->id != config->queue_id)
+		return EINVAL;
+	error = agx_submit_validate(buffer, size, &counts);
+	if (error != 0)
+		return error;
+	error = agx_queue_owner_get(owner);
+	if (error != 0)
+		return error;
+	r = malloc(sizeof(*r), M_DEVBUF, M_WAITOK | M_ZERO);
+	r->owner = owner;
+	r->owner_held = 1;
+	r->config = *config;
+	r->config.timestamps = NULL;
+	r->counts = counts;
+	r->count = counts.render + counts.compute;
+	r->commands = mallocarray(r->count, sizeof(*r->commands),
+	    M_DEVBUF, M_WAITOK | M_ZERO);
+	r->timestamp_gems = mallocarray(r->count * 4,
+	    sizeof(*r->timestamp_gems), M_DEVBUF, M_WAITOK | M_ZERO);
+	/* Parse the private command copy; timestamp references use their own locks. */
+	KERNEL_ASSERT_LOCKED();
+	KERNEL_UNLOCK();
+	error = agx_submit_parse(r, config, buffer, size, r->capacity, r->stages);
+	KERNEL_LOCK();
+	if (error == 0)
+		error = agx_sched_submit(sched, owner->context, r,
+		    agx_submit_prepare, agx_submit_release, syncs, ninputs, noutputs,
+		    id, queue);
+	if (error != 0)
+		agx_submit_release(r);
+	return error;
+}
