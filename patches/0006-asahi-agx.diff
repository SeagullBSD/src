+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Derived from alloc.rs, object.rs and slotalloc.rs in the Asahi driver. */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/errno.h>
+#include <sys/rwlock.h>
+#include <drm/drm_mm.h>
+
+#include "agx_object.h"
+
+#define AGX_HEAP_PAGE_SIZE 16384U
+
+struct agx_heap_block {
+	TAILQ_ENTRY(agx_heap_block) link;
+	struct drm_mm_node va;
+	struct drm_mm objects;
+	void *cpu, *handle;
+	size_t size;
+	int usable;
+};
+
+static int
+agx_powerof2(size_t n)
+{
+	return n != 0 && (n & (n - 1)) == 0;
+}
+
+int
+agx_heap_init(struct agx_heap *heap, uint64_t start, uint64_t size,
+    size_t min_align, size_t block_size, int cpu_mapped,
+    const struct agx_heap_ops *ops, void *cookie)
+{
+	if (heap == NULL || ops == NULL || ops->map == NULL ||
+	    ops->unmap == NULL || !agx_powerof2(min_align) ||
+	    size == 0 || start > UINT64_MAX - size ||
+	    (start & (AGX_HEAP_PAGE_SIZE - 1)) != 0 ||
+	    (size & (AGX_HEAP_PAGE_SIZE - 1)) != 0 || block_size == 0)
+		return EINVAL;
+	if (ops == &agx_heap_uat_ops && cookie == NULL)
+		return EINVAL;
+	memset(heap, 0, sizeof(*heap));
+	rw_init(&heap->lock, "agxheap");
+	drm_mm_init(&heap->va, start, size);
+	TAILQ_INIT(&heap->blocks);
+	TAILQ_INIT(&heap->garbage);
+	heap->min_align = min_align;
+	heap->block_size = block_size;
+	heap->cpu_mapped = cpu_mapped;
+	heap->ops = ops;
+	heap->cookie = cookie;
+	if (ops == &agx_heap_uat_ops) {
+		((struct agx_heap_uat *)cookie)->heap = heap;
+		((struct agx_heap_uat *)cookie)->reset_teardown = 0;
+	}
+	return 0;
+}
+
+int
+agx_heap_enable_quarantine(struct agx_heap *heap, int (*flush)(void *),
+    void *cookie)
+{
+	if (heap == NULL || flush == NULL)
+		return EINVAL;
+	rw_enter_write(&heap->lock);
+	if (heap->live != 0 || !TAILQ_EMPTY(&heap->blocks)) {
+		rw_exit_write(&heap->lock);
+		return EBUSY;
+	}
+	heap->flush_cache = flush;
+	heap->flush_cookie = cookie;
+	rw_exit_write(&heap->lock);
+	return 0;
+}
+
+static int
+agx_heap_collect_locked(struct agx_heap *heap)
+{
+	struct agx_object *obj;
+	int error;
+
+	if (heap->cache_fault)
+		return EIO;
+	if (TAILQ_EMPTY(&heap->garbage))
+		return 0;
+	error = heap->flush_cache(heap->flush_cookie);
+	if (error != 0) {
+		heap->cache_fault = 1;
+		return error;
+	}
+	while ((obj = TAILQ_FIRST(&heap->garbage)) != NULL) {
+		TAILQ_REMOVE(&heap->garbage, obj, garbage_link);
+		drm_mm_remove_node(&obj->node);
+		free(obj, M_DEVBUF, sizeof(*obj));
+	}
+	heap->garbage_count = heap->garbage_bytes = 0;
+	return 0;
+}
+
+int
+agx_heap_collect(struct agx_heap *heap)
+{
+	int error;
+
+	if (heap == NULL)
+		return EINVAL;
+	rw_enter_write(&heap->lock);
+	error = agx_heap_collect_locked(heap);
+	rw_exit_write(&heap->lock);
+	return error;
+}
+
+/* Quiesce GPU/FW users first; cached teardown still needs running firmware. */
+int
+agx_heap_destroy(struct agx_heap *heap)
+{
+	struct agx_heap_block *block;
+	int error;
+
+	rw_enter_write(&heap->lock);
+	if (heap->live != 0) {
+		rw_exit_write(&heap->lock);
+		return EBUSY;
+	}
+	error = agx_heap_collect_locked(heap);
+	if (error != 0) {
+		rw_exit_write(&heap->lock);
+		return error;
+	}
+	while ((block = TAILQ_FIRST(&heap->blocks)) != NULL) {
+		error = heap->ops->unmap(heap->cookie, block->va.start,
+		    block->size, block->handle);
+		if (error != 0) {
+			if (heap->flush_cache != NULL)
+				heap->cache_fault = 1;
+			rw_exit_write(&heap->lock);
+			return error;
+		}
+		TAILQ_REMOVE(&heap->blocks, block, link);
+		drm_mm_takedown(&block->objects);
+		drm_mm_remove_node(&block->va);
+		free(block, M_DEVBUF, sizeof(*block));
+	}
+	drm_mm_takedown(&heap->va);
+	rw_exit_write(&heap->lock);
+	return 0;
+}
+
+int
+agx_object_alloc(struct agx_heap *heap, size_t size, size_t align,
+    struct agx_object **out)
+{
+	struct agx_heap_block *block;
+	struct agx_object *obj;
+	size_t block_size, block_align;
+	int error;
+
+	if (heap == NULL || out == NULL || size == 0 ||
+	    (align != 0 && !agx_powerof2(align)))
+		return EINVAL;
+	*out = NULL;
+	align = MAX(align, heap->min_align);
+	obj = malloc(sizeof(*obj), M_DEVBUF, M_NOWAIT | M_ZERO);
+	if (obj == NULL)
+		return ENOMEM;
+	rw_enter_write(&heap->lock);
+	if (heap->cache_fault) {
+		error = EIO;
+		goto fail;
+	}
+	if (heap->garbage_bytes > 16 * 1024 * 1024 ||
+	    heap->garbage_count > 2048) {
+		error = agx_heap_collect_locked(heap);
+		if (error != 0)
+			goto fail;
+	}
+	TAILQ_FOREACH(block, &heap->blocks, link) {
+		if (!block->usable)
+			continue;
+		error = drm_mm_insert_node_generic(&block->objects, &obj->node,
+		    size, align, 0, DRM_MM_INSERT_BEST);
+		if (error == 0)
+			goto found;
+	}
+	block_size = MAX(size, heap->block_size);
+	if (block_size > SIZE_MAX - (AGX_HEAP_PAGE_SIZE - 1)) {
+		error = EOVERFLOW;
+		goto fail;
+	}
+	block_size = (block_size + AGX_HEAP_PAGE_SIZE - 1) &
+	    ~(size_t)(AGX_HEAP_PAGE_SIZE - 1);
+	block_align = MAX(align, (size_t)AGX_HEAP_PAGE_SIZE);
+	block = malloc(sizeof(*block), M_DEVBUF, M_NOWAIT | M_ZERO);
+	if (block == NULL) {
+		error = ENOMEM;
+		goto fail;
+	}
+	error = drm_mm_insert_node_generic(&heap->va, &block->va,
+	    block_size, block_align, 0, DRM_MM_INSERT_LOW);
+	if (error != 0) {
+		error = -error;
+		free(block, M_DEVBUF, sizeof(*block));
+		goto fail;
+	}
+	block->size = block_size;
+	error = heap->ops->map(heap->cookie, block->va.start, block_size,
+	    &block->cpu, &block->handle);
+	if (error != 0) {
+		drm_mm_remove_node(&block->va);
+		free(block, M_DEVBUF, sizeof(*block));
+		goto fail;
+	}
+	drm_mm_init(&block->objects, block->va.start, block_size);
+	TAILQ_INSERT_TAIL(&heap->blocks, block, link);
+	if (heap->cpu_mapped && block->cpu == NULL) {
+		error = EINVAL;
+		goto fail;
+	}
+	error = drm_mm_insert_node_generic(&block->objects, &obj->node,
+	    size, align, 0, DRM_MM_INSERT_BEST);
+	if (error != 0) {
+		error = -error;
+		goto fail;
+	}
+	block->usable = 1;
+found:
+	obj->heap = heap;
+	obj->block = block;
+	obj->gpu = obj->node.start;
+	obj->size = size;
+	if (heap->cpu_mapped)
+		obj->cpu = (char *)block->cpu + (obj->gpu - block->va.start);
+	heap->live++;
+	rw_exit_write(&heap->lock);
+	*out = obj;
+	return 0;
+fail:
+	rw_exit_write(&heap->lock);
+	free(obj, M_DEVBUF, sizeof(*obj));
+	return error;
+}
+
+void
+agx_object_free(struct agx_object *obj)
+{
+	struct agx_heap *heap;
+
+	if (obj == NULL)
+		return;
+	heap = obj->heap;
+	rw_enter_write(&heap->lock);
+	KASSERT(heap->live != 0);
+	heap->live--;
+	if (heap->flush_cache != NULL) {
+		TAILQ_INSERT_TAIL(&heap->garbage, obj, garbage_link);
+		if (heap->garbage_bytes > SIZE_MAX - obj->size)
+			heap->garbage_bytes = SIZE_MAX;
+		else
+			heap->garbage_bytes += obj->size;
+		heap->garbage_count++;
+		rw_exit_write(&heap->lock);
+		return;
+	}
+	drm_mm_remove_node(&obj->node);
+	rw_exit_write(&heap->lock);
+	free(obj, M_DEVBUF, sizeof(*obj));
+}
+
+int
+agx_slots_init(struct agx_slots *slots, uint32_t count, void **items,
+    void *cookie, void (*release)(void *, uint32_t, void *))
+{
+	uint32_t i;
+
+	if (slots == NULL || items == NULL || count == 0 ||
+	    (size_t)count > SIZE_MAX / sizeof(*slots->entries))
+		return EINVAL;
+	memset(slots, 0, sizeof(*slots));
+	rw_init(&slots->lock, "agxslots");
+	slots->entries = mallocarray(count, sizeof(*slots->entries),
+	    M_DEVBUF, M_WAITOK | M_ZERO);
+	slots->count = slots->limit = count;
+	slots->cookie = cookie;
+	slots->release = release;
+	for (i = 0; i < count; i++) {
+		slots->entries[i].item = items[i];
+		slots->entries[i].available = items[i] != NULL;
+	}
+	return 0;
+}
+
+int
+agx_slots_destroy(struct agx_slots *slots)
+{
+	rw_enter_write(&slots->lock);
+	if (slots->active != 0 || slots->waiters != 0) {
+		rw_exit_write(&slots->lock);
+		return EBUSY;
+	}
+	free(slots->entries, M_DEVBUF,
+	    (size_t)slots->count * sizeof(*slots->entries));
+	slots->entries = NULL;
+	rw_exit_write(&slots->lock);
+	return 0;
+}
+
+int
+agx_slots_limit(struct agx_slots *slots, uint32_t limit)
+{
+	if (limit == 0 || limit > slots->count)
+		return EINVAL;
+	rw_enter_write(&slots->lock);
+	slots->limit = limit;
+	wakeup(slots);
+	rw_exit_write(&slots->lock);
+	return 0;
+}
+
+int
+agx_slot_get(struct agx_slots *slots, const struct agx_slot_token *token,
+    struct agx_slot_guard *guard)
+{
+	struct agx_slot_entry *entry;
+	uint64_t oldest;
+	uint32_t i, chosen;
+	int error, changed;
+
+	if (slots == NULL || guard == NULL)
+		return EINVAL;
+	rw_enter_write(&slots->lock);
+	for (;;) {
+		chosen = slots->count;
+		changed = 1;
+		if (token != NULL && token->slot < slots->limit) {
+			entry = &slots->entries[token->slot];
+			if (entry->available && entry->get_time == token->time) {
+				chosen = token->slot;
+				changed = 0;
+			}
+		}
+		if (chosen == slots->count) {
+			oldest = UINT64_MAX;
+			for (i = 0; i < slots->limit; i++) {
+				entry = &slots->entries[i];
+				if (entry->available && entry->drop_time < oldest) {
+					oldest = entry->drop_time;
+					chosen = i;
+				}
+			}
+		}
+		if (chosen != slots->count)
+			break;
+		slots->waiters++;
+		error = rwsleep(slots, &slots->lock, PWAIT | PCATCH,
+		    "agxslot", 0);
+		slots->waiters--;
+		if (error != 0) {
+			rw_exit_write(&slots->lock);
+			return error;
+		}
+	}
+	if (changed && slots->gets == UINT64_MAX) {
+		rw_exit_write(&slots->lock);
+		return EOVERFLOW;
+	}
+	entry = &slots->entries[chosen];
+	entry->available = 0;
+	if (changed)
+		entry->get_time = ++slots->gets;
+	guard->slots = slots;
+	guard->token.time = entry->get_time;
+	guard->token.slot = chosen;
+	guard->item = entry->item;
+	guard->changed = changed;
+	slots->active++;
+	rw_exit_write(&slots->lock);
+	return 0;
+}
+
+void
+agx_slot_put(struct agx_slot_guard *guard)
+{
+	struct agx_slots *slots = guard->slots;
+	struct agx_slot_entry *entry;
+
+	KASSERT(slots != NULL);
+	rw_enter_write(&slots->lock);
+	entry = &slots->entries[guard->token.slot];
+	KASSERT(!entry->available && slots->active != 0);
+	if (slots->release != NULL)
+		slots->release(slots->cookie, guard->token.slot, guard->item);
+	entry->item = guard->item;
+	entry->get_time = guard->token.time;
+	/* Saturation preserves safety even after counter exhaustion. */
+	if (slots->drops != UINT64_MAX - 1)
+		slots->drops++;
+	entry->drop_time = slots->drops;
+	entry->available = 1;
+	slots->active--;
+	guard->slots = NULL;
+	wakeup(slots);
+	rw_exit_write(&slots->lock);
+}
+
+static int
+agx_heap_uat_cached(enum agx_uat_fw_prot prot)
+{
+	return prot == AGX_UAT_FW_PRIV_RW ||
+	    prot == AGX_UAT_FW_GPU_PRIV_RW ||
+	    prot == AGX_UAT_FW_RW_GPU_RO_PRIV;
+}
+
+static int
+agx_heap_uat_map(void *cookie, uint64_t va, size_t size, void **cpu,
+    void **handle)
+{
+	struct agx_heap_uat *uat = cookie;
+	struct agx_mem *mem;
+	int error;
+
+	if (uat == NULL || uat->pt == NULL || uat->dmat == NULL)
+		return EINVAL;
+	if (agx_heap_uat_cached(uat->prot) && (uat->handoff == NULL ||
+	    uat->flush == NULL || uat->heap == NULL ||
+	    uat->heap->flush_cache == NULL))
+		return EINVAL;
+	error = agx_mem_alloc_mode(uat->dmat, size, AGX_MEM_NOCACHE,
+	    agx_uat_pt_oas(uat->pt), &mem);
+	if (error != 0)
+		return error;
+	error = agx_uat_pt_map_kernel(uat->pt, va, mem, 0, size, uat->prot);
+	if (error != 0) {
+		agx_mem_free(mem);
+		return error;
+	}
+	*cpu = mem->kva;
+	*handle = mem;
+	return 0;
+}
+
+static int
+agx_heap_uat_unmap(void *cookie, uint64_t va, size_t size, void *handle)
+{
+	struct agx_heap_uat *uat = cookie;
+	int error;
+
+	if (agx_heap_uat_cached(uat->prot) && uat->reset_teardown)
+		error = agx_uat_pt_unmap_after_reset(uat->pt, uat->handoff,
+		    va, size);
+	else if (agx_heap_uat_cached(uat->prot))
+		error = agx_uat_pt_unmap_cached(uat->pt, uat->handoff, va,
+		    size, uat->flush, uat->flush_cookie);
+	else
+		error = agx_uat_pt_unmap(uat->pt, va, size);
+	if (error != 0)
+		return error;
+	agx_mem_free(handle);
+	return 0;
+}
+
+const struct agx_heap_ops agx_heap_uat_ops = {
+	agx_heap_uat_map,
+	agx_heap_uat_unmap,
+};
+
+struct agx_heap_vm_block {
+	struct agx_mem *mem;
+	int mapped;
+};
+
+static int
+agx_heap_vm_map(void *cookie, uint64_t va, size_t size, void **cpu,
+    void **handle)
+{
+	struct agx_heap_vm *ctx = cookie;
+	struct agx_heap_vm_block *block;
+	int error, put_error;
+
+	block = malloc(sizeof(*block), M_DEVBUF, M_NOWAIT | M_ZERO);
+	if (block == NULL)
+		return ENOMEM;
+	error = agx_vm_get(ctx->vm);
+	if (error != 0)
+		goto fail_block;
+	error = agx_mem_alloc_mode(ctx->dmat, size, AGX_MEM_NOCACHE,
+	    agx_vm_oas(ctx->vm), &block->mem);
+	if (error != 0)
+		goto fail_ref;
+	error = agx_vm_map_internal(ctx->vm, va, block->mem, size, ctx->kind);
+	if (error != 0)
+		goto fail_mem;
+	block->mapped = 1;
+	*cpu = block->mem->kva;
+	*handle = block;
+	return 0;
+fail_mem:
+	agx_mem_free(block->mem);
+fail_ref:
+	/* The context holds a separate reference, so this cannot be the last. */
+	put_error = agx_vm_put(ctx->vm);
+	KASSERT(put_error == 0);
+	(void)put_error;
+fail_block:
+	free(block, M_DEVBUF, sizeof(*block));
+	return error;
+}
+
+static int
+agx_heap_vm_unmap(void *cookie, uint64_t va, size_t size, void *handle)
+{
+	struct agx_heap_vm *ctx = cookie;
+	struct agx_heap_vm_block *block = handle;
+	int error;
+
+	if (block->mapped) {
+		error = agx_vm_unmap_internal(ctx->vm, va, size, ctx->kind,
+		    ctx->reset_teardown ? NULL : ctx->flush,
+		    ctx->flush_cookie);
+		if (error != 0)
+			return error;
+		block->mapped = 0;
+	}
+	error = agx_vm_put(ctx->vm);
+	if (error != 0)
+		return error;
+	agx_mem_free(block->mem);
+	free(block, M_DEVBUF, sizeof(*block));
+	return 0;
+}
+
+static const struct agx_heap_ops agx_heap_vm_ops = {
+	agx_heap_vm_map,
+	agx_heap_vm_unmap,
+};
+
+int
+agx_heap_vm_init(struct agx_heap *heap, struct agx_heap_vm *ctx,
+    struct agx_vm *vm, bus_dma_tag_t dmat, enum agx_vm_internal_kind kind,
+    size_t min_align, size_t block_size, agx_uat_flush_fn flush,
+    void *flush_cookie)
+{
+	uint64_t start, end;
+	int error, put_error;
+
+	if (heap == NULL || ctx == NULL || vm == NULL || dmat == NULL ||
+	    (kind == AGX_VM_GPU_FW_PRIVATE && flush == NULL))
+		return EINVAL;
+	error = agx_vm_internal_range(vm, kind, &start, &end);
+	if (error != 0)
+		return error;
+	error = agx_vm_get(vm);
+	if (error != 0)
+		return error;
+	ctx->dmat = dmat;
+	ctx->vm = vm;
+	ctx->kind = kind;
+	ctx->flush = flush;
+	ctx->flush_cookie = flush_cookie;
+	ctx->reset_teardown = 0;
+	error = agx_heap_init(heap, start, end - start, min_align, block_size,
+	    1, &agx_heap_vm_ops, ctx);
+	if (error != 0) {
+		put_error = agx_vm_put(vm);
+		KASSERT(put_error == 0);
+		(void)put_error;
+		ctx->vm = NULL;
+	}
+	return error;
+}
+
+int
+agx_heap_vm_fini(struct agx_heap_vm *ctx)
+{
+	int error;
+
+	if (ctx == NULL || ctx->vm == NULL)
+		return EINVAL;
+	error = agx_vm_put(ctx->vm);
+	if (error == 0)
+		ctx->vm = NULL;
+	return error;
+}
+
+int
+agx_heap_destroy_after_reset(struct agx_heap *heap)
+{
+	struct agx_heap_uat *uat;
+	struct agx_heap_vm *vm;
+	struct agx_heap_block *block;
+	struct agx_object *obj;
+	int error;
+
+	if (heap == NULL)
+		return EINVAL;
+	rw_enter_write(&heap->lock);
+	if (heap->live != 0) {
+		error = EBUSY;
+		goto out;
+	}
+	if (heap->ops == &agx_heap_uat_ops) {
+		uat = heap->cookie;
+		if (uat == NULL || uat->handoff == NULL ||
+		    !agx_uat_handoff_is_stopped(uat->handoff)) {
+			error = EBUSY;
+			goto out;
+		}
+		uat->reset_teardown = 1;
+	} else if (heap->ops == &agx_heap_vm_ops) {
+		vm = heap->cookie;
+		if (vm == NULL || vm->vm == NULL ||
+		    !agx_vm_reset_proven(vm->vm)) {
+			error = EBUSY;
+			goto out;
+		}
+		vm->reset_teardown = 1;
+	} else {
+		error = EINVAL;
+		goto out;
+	}
+	/* No future allocation may use this heap, even if unmapping fails. */
+	heap->cache_fault = 1;
+	while ((obj = TAILQ_FIRST(&heap->garbage)) != NULL) {
+		TAILQ_REMOVE(&heap->garbage, obj, garbage_link);
+		drm_mm_remove_node(&obj->node);
+		free(obj, M_DEVBUF, sizeof(*obj));
+	}
+	heap->garbage_count = heap->garbage_bytes = 0;
+	while ((block = TAILQ_FIRST(&heap->blocks)) != NULL) {
+		error = heap->ops->unmap(heap->cookie, block->va.start,
+		    block->size, block->handle);
+		if (error != 0)
+			goto out;
+		TAILQ_REMOVE(&heap->blocks, block, link);
+		drm_mm_takedown(&block->objects);
+		drm_mm_remove_node(&block->va);
+		free(block, M_DEVBUF, sizeof(*block));
+	}
+	drm_mm_takedown(&heap->va);
+	error = 0;
+out:
+	rw_exit_write(&heap->lock);
+	return error;
+}
