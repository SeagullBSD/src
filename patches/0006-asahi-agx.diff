--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_fw.c	Fri Nov 20 04:18:08 2026
@@ -0,0 +1,1391 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Firmware control channel and ASC cache invalidation. */
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/stdint.h>
+#include <sys/systm.h>
+#include <sys/time.h>
+#include <machine/bus.h>
+#include <machine/intr.h>
+#include <arm64/dev/rtkit.h>
+#include <drm/asahi_drm.h>
+#include <dev/ofw/openfirm.h>
+
+#include "agx_device.h"
+#include "agx_fw.h"
+#include "agx_object.h"
+#include "agx_channel_bank.h"
+#include "agx_event_slots.h"
+#include "agx_init_runtime.h"
+#include "agx_timestamp.h"
+#include "agx_tvb.h"
+#include "agx_uat.h"
+
+#define AGX_UAT_PAGE_SIZE 0x4000ULL
+#define AGX_FW_ENDPOINT_DOORBELL 0x21
+#define AGX_FWCTL_DOORBELL (0x84ULL << 48)
+
+struct agx_fw_uat {
+	struct agx_uat_handoff *handoff;
+	struct agx_uat_pt *kernel, *lower;
+	struct agx_mem *dummy;
+	uint64_t ttbs;
+	int started, stopped;
+};
+
+int
+agx_fw_uat_create(const struct agx_resources *res, struct agx_fw_uat **out)
+{
+	struct agx_fw_regions regions;
+	struct agx_fw_uat *uat;
+	int error;
+
+	if (res == NULL || out == NULL || res->iot == NULL || res->dmat == NULL)
+		return EINVAL;
+	*out = NULL;
+	error = agx_hw_reserved_regions(res->node, &regions);
+	if (error)
+		return error;
+	uat = malloc(sizeof(*uat), M_DEVBUF, M_WAITOK | M_ZERO);
+	error = agx_uat_handoff_create(res->iot, regions.handoff.addr,
+	    regions.handoff.size, regions.ttbs.addr, regions.ttbs.size,
+	    res->uat_oas, OF_is_compatible(res->node, "apple,agx-t6021"),
+	    &uat->handoff);
+	if (error)
+		goto fail;
+	error = agx_uat_pt_create_kernel(res->dmat, res->iot,
+	    regions.pagetables.addr, res->uat_oas, &uat->kernel);
+	if (error)
+		goto fail;
+	error = agx_uat_pt_create(res->dmat, res->uat_oas, &uat->lower);
+	if (error)
+		goto fail;
+	error = agx_mem_alloc(res->dmat, AGX_PAGE_SIZE, res->uat_oas, &uat->dummy);
+	if (error)
+		goto fail;
+	error = agx_uat_pt_map_dummy(uat->lower, uat->dummy);
+	if (error)
+		goto fail;
+	uat->ttbs = regions.ttbs.addr;
+	*out = uat;
+	return 0;
+fail:
+	agx_uat_pt_destroy(uat->lower);
+	agx_mem_free(uat->dummy);
+	agx_uat_pt_destroy(uat->kernel);
+	if (uat->handoff != NULL)
+		(void)agx_uat_handoff_destroy(uat->handoff);
+	free(uat, M_DEVBUF, sizeof(*uat));
+	return error;
+}
+
+int
+agx_fw_uat_start(struct agx_fw_uat *uat)
+{
+	int error;
+
+	if (uat == NULL || uat->started || uat->stopped)
+		return EINVAL;
+	error = agx_uat_handoff_start(uat->handoff,
+	    agx_uat_pt_root(uat->lower), agx_uat_pt_root(uat->kernel));
+	if (error == 0)
+		uat->started = 1;
+	return error;
+}
+
+int
+agx_fw_uat_destroy_stopped(struct agx_fw_uat *uat)
+{
+	int error;
+
+	if (uat == NULL)
+		return EINVAL;
+	if (uat->started && !uat->stopped) {
+		error = agx_uat_handoff_stop(uat->handoff);
+		if (error)
+			return error;
+		uat->stopped = 1;
+	}
+	error = agx_uat_handoff_destroy(uat->handoff);
+	if (error)
+		return error;
+	agx_uat_pt_destroy(uat->lower);
+	agx_mem_free(uat->dummy);
+	agx_uat_pt_destroy(uat->kernel);
+	free(uat, M_DEVBUF, sizeof(*uat));
+	return 0;
+}
+
+struct agx_uat_handoff *
+agx_fw_uat_handoff(struct agx_fw_uat *uat)
+{
+	return uat != NULL ? uat->handoff : NULL;
+}
+
+struct agx_uat_pt *
+agx_fw_uat_kernel(struct agx_fw_uat *uat)
+{
+	return uat != NULL ? uat->kernel : NULL;
+}
+
+struct agx_uat_pt *
+agx_fw_uat_lower(struct agx_fw_uat *uat)
+{
+	return uat != NULL ? uat->lower : NULL;
+}
+
+uint64_t
+agx_fw_uat_ttbs(struct agx_fw_uat *uat)
+{
+	return uat != NULL ? uat->ttbs : 0;
+}
+
+struct agx_fw_heaps {
+	struct agx_heap heap[AGX_FW_HEAP_COUNT];
+	struct agx_heap_uat uat[AGX_FW_HEAP_COUNT];
+	unsigned int initialized;
+};
+
+struct agx_fw_heap_spec {
+	uint64_t start, end;
+	size_t block_size, alignment;
+	enum agx_uat_fw_prot prot;
+};
+
+static const struct agx_fw_heap_spec agx_fw_heap_specs[AGX_FW_HEAP_COUNT] = {
+	{ 0xffffffa000000000ULL, 0xffffffa600000000ULL, 0x100000, 0x80, AGX_UAT_FW_PRIV_RW },
+	{ 0xffffffa600000000ULL, 0xffffffa800000000ULL, 0x100000, 0x80, AGX_UAT_FW_RW_GPU_RO_PRIV },
+	{ 0xffffffa800000000ULL, 0xffffffaa00000000ULL, 0x100000, 0x80, AGX_UAT_FW_SHARED_RW },
+	{ 0xffffffaa00000000ULL, 0xffffffac00000000ULL, 0x10000, 0x80, AGX_UAT_FW_SHARED_RO },
+	{ 0xffffffac00000000ULL, 0xffffffae00000000ULL, 0x10000, 0x80, AGX_UAT_FW_GPU_SHARED_RW },
+	{ 0xffffffae00000000ULL, 0xffffffae10000000ULL, 0x10000, 0x4000, AGX_UAT_FW_SHARED_RW },
+};
+
+int
+agx_fw_heaps_create(bus_dma_tag_t dmat, struct agx_uat_pt *pt,
+    struct agx_uat_handoff *handoff, struct agx_fwctl *fwctl,
+    struct agx_fw_devctl *devctl, struct agx_fw_heaps **out)
+{
+	struct agx_fw_heaps *heaps;
+	const struct agx_fw_heap_spec *spec;
+	unsigned int i;
+	int error;
+
+	if (dmat == NULL || pt == NULL || handoff == NULL || fwctl == NULL ||
+	    devctl == NULL || out == NULL)
+		return EINVAL;
+	*out = NULL;
+	heaps = malloc(sizeof(*heaps), M_DEVBUF, M_WAITOK | M_ZERO);
+	for (i = 0; i < AGX_FW_HEAP_COUNT; i++) {
+		spec = &agx_fw_heap_specs[i];
+		heaps->uat[i].dmat = dmat;
+		heaps->uat[i].pt = pt;
+		heaps->uat[i].prot = spec->prot;
+		heaps->uat[i].handoff = handoff;
+		heaps->uat[i].flush = agx_fwctl_flush;
+		heaps->uat[i].flush_cookie = fwctl;
+		error = agx_heap_init(&heaps->heap[i], spec->start,
+		    spec->end - spec->start, spec->alignment, spec->block_size,
+		    1, &agx_heap_uat_ops, &heaps->uat[i]);
+		if (error) {
+			while (heaps->initialized != 0) {
+				heaps->initialized--;
+				(void)agx_heap_destroy(&heaps->heap[heaps->initialized]);
+			}
+			free(heaps, M_DEVBUF, sizeof(*heaps));
+			return error;
+		}
+		heaps->initialized++;
+		if (i == AGX_FW_HEAP_PRIVATE || i == AGX_FW_HEAP_GPU_RO) {
+			error = agx_heap_enable_quarantine(&heaps->heap[i],
+			    agx_fw_flush_cache, devctl);
+			if (error) {
+				while (heaps->initialized != 0) {
+					heaps->initialized--;
+					(void)agx_heap_destroy(&heaps->heap[heaps->initialized]);
+				}
+				free(heaps, M_DEVBUF, sizeof(*heaps));
+				return error;
+			}
+		}
+	}
+	*out = heaps;
+	return 0;
+}
+
+struct agx_heap *
+agx_fw_heap(struct agx_fw_heaps *heaps, enum agx_fw_heap_kind kind)
+{
+	if (heaps == NULL || (unsigned int)kind >= heaps->initialized)
+		return NULL;
+	return &heaps->heap[kind];
+}
+
+int
+agx_fw_heaps_destroy(struct agx_fw_heaps *heaps)
+{
+	int error;
+
+	if (heaps == NULL)
+		return EINVAL;
+	while (heaps->initialized != 0) {
+		error = agx_heap_destroy(&heaps->heap[heaps->initialized - 1]);
+		if (error)
+			return error;
+		heaps->initialized--;
+	}
+	free(heaps, M_DEVBUF, sizeof(*heaps));
+	return 0;
+}
+
+static void
+agx_fw_init_level(struct agx_fw_uat_level_info *level, unsigned int shift,
+    unsigned int entries, unsigned int oas)
+{
+	level->unk_3 = 8;
+	level->unk_1 = 14;
+	level->unk_2 = 14;
+	level->index_shift = shift;
+	level->num_entries = entries;
+	level->unk_4 = 0x4000;
+	level->unk_8.value = 1;
+	level->unk_10.value = ((1ULL << oas) - 1) & ~0x3fffULL;
+	level->index_mask.value = ((uint64_t)entries - 1) << shift;
+}
+
+#define AGX_INITDATA_ROOT(p, a) do { \
+	(p)->unk_buf = (a)->unk_buf; \
+	(p)->runtime_pointers = (a)->runtime_pointers; \
+	(p)->globals = (a)->globals; \
+	(p)->fw_status = (a)->fw_status; \
+	(p)->uat_page_size = 0x4000; \
+	(p)->uat_page_bits = 14; \
+	(p)->uat_num_levels = 3; \
+	agx_fw_init_level(&(p)->uat_level_info[0], 36, 8, (a)->uat_oas); \
+	agx_fw_init_level(&(p)->uat_level_info[1], 25, 2048, (a)->uat_oas); \
+	agx_fw_init_level(&(p)->uat_level_info[2], 14, 2048, (a)->uat_oas); \
+	(p)->host_mapped_fw_allocations = 1; \
+} while (0)
+
+/* Encodes only the root; all referenced objects must already be populated. */
+int
+agx_fw_encode_initdata(void *storage, size_t size, unsigned int major,
+    unsigned int minor, const struct agx_initdata_addrs *addr)
+{
+	if (storage == NULL || ((uintptr_t)storage & 3) != 0 || addr == NULL ||
+	    addr->unk_buf == 0 || addr->runtime_pointers == 0 ||
+	    addr->globals == 0 || addr->fw_status == 0 ||
+	    !AGX_UAT_OAS_VALID(addr->uat_oas))
+		return EINVAL;
+	if (major == 12 && minor == 3) {
+		struct agx_fw_init_data_12_3 *p = storage;
+		if (size < sizeof(*p))
+			return EINVAL;
+		memset(p, 0, sizeof(*p));
+		AGX_INITDATA_ROOT(p, addr);
+	} else if (major == 13 && minor == 5) {
+		struct agx_fw_init_data_13_5 *p = storage;
+		if (size < sizeof(*p))
+			return EINVAL;
+		memset(p, 0, sizeof(*p));
+		p->ver_info[0] = 0x6ba0;
+		p->ver_info[1] = 0x1f28;
+		p->ver_info[2] = 0x601;
+		p->ver_info[3] = 0xb0;
+		AGX_INITDATA_ROOT(p, addr);
+	} else
+		return EOPNOTSUPP;
+	return 0;
+}
+#undef AGX_INITDATA_ROOT
+
+static int
+agx_fw_ring_valid(const struct agx_fw_channel_ring *ring)
+{
+	return ring->state != 0 && ring->ring != 0;
+}
+
+int
+agx_fw_encode_runtime(struct agx_fw_runtime_pointers *out,
+    const struct agx_runtime_init *in)
+{
+	unsigned int i;
+
+	if (out == NULL || in == NULL ||
+	    !agx_fw_ring_valid(&in->device_control) ||
+	    !agx_fw_ring_valid(&in->event) || !agx_fw_ring_valid(&in->fw_log) ||
+	    !agx_fw_ring_valid(&in->ktrace) || !agx_fw_ring_valid(&in->stats) ||
+	    !in->stats_vtx || !in->stats_frag || !in->stats_comp ||
+	    !in->hwdata_a || !in->hwdata_b || !in->fwlog_buf ||
+	    !in->unkptr_190 || !in->unkptr_198 || !in->unkptr_1b8 ||
+	    !in->unkptr_1c0 || !in->unkptr_1c8)
+		return EINVAL;
+	for (i = 0; i < 4; i++) {
+		if (!agx_fw_ring_valid(&in->pipes[i].vtx) ||
+		    !agx_fw_ring_valid(&in->pipes[i].frag) ||
+		    !agx_fw_ring_valid(&in->pipes[i].comp))
+			return EINVAL;
+	}
+	memset(out, 0, sizeof(*out));
+	memcpy(out->pipes, in->pipes, sizeof(out->pipes));
+	out->device_control = in->device_control;
+	out->event = in->event;
+	out->fw_log = in->fw_log;
+	out->ktrace = in->ktrace;
+	out->stats = in->stats;
+	out->stats_vtx = in->stats_vtx;
+	out->stats_frag = in->stats_frag;
+	out->stats_comp = in->stats_comp;
+	out->hwdata_a = in->hwdata_a;
+	out->hwdata_b = in->hwdata_b;
+	out->hwdata_b_2 = in->hwdata_b;
+	out->fwlog_buf = in->fwlog_buf;
+	out->unkptr_190 = in->unkptr_190;
+	out->unkptr_198 = in->unkptr_198;
+	out->unkptr_1b8 = in->unkptr_1b8;
+	out->unkptr_1c0 = in->unkptr_1c0;
+	out->unkptr_1c8 = in->unkptr_1c8;
+	out->buffer_mgr_ctl_gpu_addr.value = 0x2000000000ULL;
+	out->buffer_mgr_ctl_fw_addr.value = 0xffffffaeffff0000ULL;
+	out->gpu_scratch.unk_6b38 = 0xff;
+	return 0;
+}
+
+int
+agx_fw_encode_status(struct agx_fw_status *out,
+    const struct agx_fw_channel_ring *fwctl)
+{
+	if (out == NULL || fwctl == NULL || !agx_fw_ring_valid(fwctl))
+		return EINVAL;
+	memset(out, 0, sizeof(*out));
+	out->fwctl_channel = *fwctl;
+	return 0;
+}
+
+/* The mailbox FIFO can be full; unlike pipe kicks these callers may sleep. */
+static int
+agx_fw_send_wait(struct rtkit_state *rtkit, uint32_t endpoint, uint64_t msg,
+    const int *failed)
+{
+	uint64_t deadline = nsecuptime() + SEC_TO_NSEC(1);
+	int error;
+
+	for (;;) {
+		if (failed != NULL && __atomic_load_n(failed, __ATOMIC_ACQUIRE))
+			return ENXIO;
+		error = rtkit_send_endpoint(rtkit, endpoint, msg);
+		if (error != EBUSY)
+			return error;
+		if (nsecuptime() >= deadline)
+			return ETIMEDOUT;
+		if (cold)
+			delay(100);
+		else
+			(void)tsleep_nsec(rtkit, PWAIT, "agxmbox", MSEC_TO_NSEC(1));
+	}
+}
+
+static int
+agx_fw_start_endpoint_wait(struct rtkit_state *rtkit, uint32_t endpoint,
+    void (*callback)(void *, uint64_t), void *cookie, const int *failed)
+{
+	uint64_t deadline = nsecuptime() + SEC_TO_NSEC(1);
+	int error;
+
+	for (;;) {
+		if (failed != NULL && __atomic_load_n(failed, __ATOMIC_ACQUIRE))
+			return ENXIO;
+		error = rtkit_start_endpoint(rtkit, endpoint, callback, cookie);
+		if (error != EBUSY)
+			return error;
+		if (nsecuptime() >= deadline)
+			return ETIMEDOUT;
+		if (cold)
+			delay(100);
+		else
+			(void)tsleep_nsec(rtkit, PWAIT, "agxmbox", MSEC_TO_NSEC(1));
+	}
+}
+
+int
+agx_fw_boot(struct rtkit_state *rtkit, struct agx_channel *device_control,
+    uint64_t initdata, unsigned int major, unsigned int minor,
+    void (*rx)(void *, uint64_t), void *cookie, const int *failed)
+{
+	struct agx_fw_device_control_msg msg;
+	int error;
+
+	if (rtkit == NULL || device_control == NULL || rx == NULL ||
+	    !device_control->tx || device_control->count < 2 ||
+	    device_control->message_size != sizeof(msg) ||
+	    (initdata | 0xfffffffffffULL) != UINT64_MAX ||
+	    (initdata & 0x80000000000ULL) == 0 || (initdata & 3) != 0)
+		return EINVAL;
+	memset(&msg, 0, sizeof(msg));
+	if (major == 12 && minor == 3)
+		msg.tag = 0x19;
+	else if (major == 13 && minor == 5)
+		msg.tag = 0x1a;
+	else
+		return EOPNOTSUPP;
+	if (failed != NULL && __atomic_load_n(failed, __ATOMIC_ACQUIRE))
+		return ENXIO;
+	error = agx_channel_put(device_control, &msg, NULL);
+	if (error)
+		return error;
+	__asm volatile("dsb sy" ::: "memory");
+	error = rtkit_boot(rtkit);
+	if (error)
+		return error;
+	error = agx_fw_start_endpoint_wait(rtkit, 0x20, rx, cookie, failed);
+	if (error)
+		return error;
+	error = agx_fw_start_endpoint_wait(rtkit, AGX_FW_ENDPOINT_DOORBELL,
+	    NULL, NULL, failed);
+	if (error)
+		return error;
+	error = agx_fw_send_wait(rtkit, 0x20,
+	    (0x81ULL << 48) | (initdata & 0xfffffffffffULL), failed);
+	if (error)
+		return error;
+	error = agx_fw_send_wait(rtkit, AGX_FW_ENDPOINT_DOORBELL,
+	    (0x83ULL << 48) | 0x11, failed);
+	if (error)
+		return error;
+	return agx_fw_send_wait(rtkit, AGX_FW_ENDPOINT_DOORBELL,
+	    (0x83ULL << 48) | 0x10, failed);
+}
+
+int
+agx_fw_start_op(struct agx_runtime *runtime)
+{
+	uint32_t *pending;
+	int error;
+
+	if (runtime == NULL || agx_fw_is_crashed(runtime) ||
+	    runtime->rtkit == NULL ||
+	    (pending = agx_init_runtime_pending(runtime->graph)) == NULL)
+		return ENXIO;
+	/* Firmware globals are mapped Normal Non-cacheable on the CPU.  ARM
+	 * does not guarantee atomic read-modify-write on that mapping.  Keep
+	 * the authoritative count in cacheable memory under a CPU mutex and
+	 * publish it to the firmware-owned mapping with a plain atomic store. */
+	mtx_enter(&runtime->op_mtx);
+	if (runtime->op_count == UINT32_MAX) {
+		mtx_leave(&runtime->op_mtx);
+		return EOVERFLOW;
+	}
+	runtime->op_count++;
+	__atomic_store_n(pending, runtime->op_count, __ATOMIC_RELEASE);
+	mtx_leave(&runtime->op_mtx);
+	/* Publish the count before the firmware wake doorbell. */
+	__asm volatile("dsb sy" ::: "memory");
+	error = agx_fw_send_wait(runtime->rtkit, AGX_FW_ENDPOINT_DOORBELL,
+	    (0x83ULL << 48) | 0x10, &runtime->crashed);
+	if (error != 0)
+		agx_fw_end_op(runtime);
+	return error;
+}
+
+void
+agx_fw_end_op(struct agx_runtime *runtime)
+{
+	uint32_t *pending = agx_init_runtime_pending(runtime->graph);
+
+	KASSERT(pending != NULL);
+	mtx_enter(&runtime->op_mtx);
+	KASSERT(runtime->op_count != 0);
+	runtime->op_count--;
+	__atomic_store_n(pending, runtime->op_count, __ATOMIC_RELEASE);
+	mtx_leave(&runtime->op_mtx);
+}
+
+int
+agx_fw_kick_pipe(struct rtkit_state *rtkit, unsigned int pipe,
+    unsigned int priority)
+{
+	if (rtkit == NULL || pipe > AGX_FW_PIPE_COMPUTE || priority >= 4)
+		return EINVAL;
+	__asm volatile("dsb sy" ::: "memory");
+	return rtkit_send_endpoint(rtkit, AGX_FW_ENDPOINT_DOORBELL,
+	    (0x83ULL << 48) | pipe | ((uint64_t)priority << 2));
+}
+
+int
+agx_fwctl_init(struct agx_fwctl *ctl, struct agx_channel *channel,
+    struct rtkit_state *rtkit)
+{
+	if (ctl == NULL || channel == NULL || rtkit == NULL ||
+	    !channel->tx || channel->count < 2 ||
+	    channel->message_size != sizeof(struct agx_fw_ctl_msg))
+		return EINVAL;
+	rw_init(&ctl->lock, "agxfwctl");
+	ctl->channel = channel;
+	ctl->rtkit = rtkit;
+	__atomic_store_n(&ctl->failed, 0, __ATOMIC_RELEASE);
+	return 0;
+}
+
+/* May be called from the RTKit mailbox callback. */
+void
+agx_fwctl_crashed(struct agx_fwctl *ctl)
+{
+	__atomic_store_n(&ctl->failed, 1, __ATOMIC_RELEASE);
+}
+
+int
+agx_fw_devctl_init(struct agx_fw_devctl *dc, struct agx_channel *channel,
+    struct rtkit_state *rtkit, unsigned int major, unsigned int minor)
+{
+	if (dc == NULL || channel == NULL || rtkit == NULL || !channel->tx ||
+	    channel->count < 2 ||
+	    channel->message_size != sizeof(struct agx_fw_device_control_msg))
+		return EINVAL;
+	if (!((major == 12 && minor == 3) || (major == 13 && minor == 5)))
+		return EOPNOTSUPP;
+	rw_init(&dc->lock, "agxdevctl");
+	dc->channel = channel;
+	dc->rtkit = rtkit;
+	dc->major = major;
+	dc->minor = minor;
+	__atomic_store_n(&dc->failed, 0, __ATOMIC_RELEASE);
+	return 0;
+}
+
+/* Fast firmware replies avoid a sleep; slow replies must not monopolize the
+ * caller's CPU (and possibly the kernel lock) for multiple milliseconds. */
+static int
+agx_fw_wait_consumed(struct agx_channel *channel, uint32_t token,
+    const int *failed, const volatile void *wchan, const char *wmesg)
+{
+	uint64_t start, now, deadline;
+	int error, consumed;
+
+	start = nsecuptime();
+	deadline = start + SEC_TO_NSEC(1);
+	for (;;) {
+		if (__atomic_load_n(failed, __ATOMIC_ACQUIRE))
+			return ENXIO;
+		error = agx_channel_consumed(channel, token, &consumed);
+		if (error != 0)
+			return error;
+		if (consumed)
+			return 0;
+		now = nsecuptime();
+		if (now >= deadline)
+			return ETIMEDOUT;
+		if (cold)
+			delay(100);
+		else if (now - start < 100000ULL)
+			delay(10);
+		else
+			(void)tsleep_nsec(wchan, PWAIT, wmesg, MSEC_TO_NSEC(1));
+	}
+}
+
+enum agx_devctl_send_mode {
+	AGX_DEVCTL_SYNC,
+	AGX_DEVCTL_ASYNC
+};
+/* Serialize ring publication until space is available or the deadline expires.
+ * The RX queue is MPSAFE; normal callers retain their existing lock state. */
+static int
+agx_fw_devctl_wait_space(struct agx_fw_devctl *dc,
+    const struct agx_fw_device_control_msg *msg, uint32_t *token)
+{
+	uint64_t deadline = nsecuptime() + SEC_TO_NSEC(1);
+	int error;
+
+	for (;;) {
+		if (__atomic_load_n(&dc->failed, __ATOMIC_ACQUIRE)) {
+			error = ENXIO;
+			break;
+		}
+		error = agx_channel_put(dc->channel, msg, token);
+		if (error != EAGAIN)
+			break;
+		if (nsecuptime() >= deadline) {
+			error = ETIMEDOUT;
+			break;
+		}
+		if (cold)
+			delay(100);
+		else
+			(void)tsleep_nsec(dc, PWAIT, "agxspace", MSEC_TO_NSEC(1));
+	}
+	return error;
+}
+static int
+agx_fw_devctl_send_internal(struct agx_fw_devctl *dc,
+    const struct agx_fw_device_control_msg *msg, enum agx_devctl_send_mode mode)
+{
+	uint32_t token;
+	int error;
+
+	if (dc == NULL || msg == NULL)
+		return EINVAL;
+	rw_enter_write(&dc->lock);
+	if (__atomic_load_n(&dc->failed, __ATOMIC_ACQUIRE)) {
+		error = ENXIO;
+		goto out;
+	}
+	error = agx_channel_put(dc->channel, msg, &token);
+	if (error == EAGAIN)
+		error = agx_fw_devctl_wait_space(dc, msg, &token);
+	if (error)
+		goto out;
+	__asm volatile("dsb sy" ::: "memory");
+	error = agx_fw_send_wait(dc->rtkit, AGX_FW_ENDPOINT_DOORBELL,
+	    (0x83ULL << 48) | 0x11, &dc->failed);
+	if (error)
+		goto failed;
+	/* Like Asahi's GrowTVBAck, publication and the doorbell suffice here.
+	 * A later synchronous sender holds dc->lock from put through consumption,
+	 * so its read-pointer token cannot be passed by a subsequent put. */
+	if (mode == AGX_DEVCTL_ASYNC)
+		goto out;
+	/* The RX worker is MPSAFE; quiesce drains rx_lock before teardown, while
+	 * dc->lock serializes the posted token. */
+	error = agx_fw_wait_consumed(dc->channel, token, &dc->failed, dc,
+	    "agxdevctl");
+	if (error)
+		goto failed;
+	goto out;
+failed:
+	__atomic_store_n(&dc->failed, 1, __ATOMIC_RELEASE);
+out:
+	rw_exit_write(&dc->lock);
+	return error;
+}
+
+
+int
+agx_fw_devctl_send(struct agx_fw_devctl *dc,
+    const struct agx_fw_device_control_msg *msg)
+{
+	return agx_fw_devctl_send_internal(dc, msg, AGX_DEVCTL_SYNC);
+}
+
+int
+agx_fw_destroy_context(struct agx_fw_devctl *dc,
+    const struct agx_fw_gpu_context_data *ctx, uint64_t gpu_va)
+{
+	struct agx_fw_device_control_msg msg;
+
+	if (dc == NULL || ctx == NULL || gpu_va == 0)
+		return EINVAL;
+	memset(&msg, 0, sizeof(msg));
+	if (dc->major == 12 && dc->minor == 3) {
+		msg.tag = 0x17;
+		msg.payload.destroy_context_12_3.ctx_23 = ctx->unk_23;
+		msg.payload.destroy_context_12_3.ctx_0 = ctx->unk_0;
+		msg.payload.destroy_context_12_3.ctx_1 = ctx->unk_1;
+		msg.payload.destroy_context_12_3.ctx_4 = ctx->unk_4;
+		msg.payload.destroy_context_12_3.gpu_context = gpu_va;
+	} else if (dc->major == 13 && dc->minor == 5) {
+		msg.tag = 0x18;
+		msg.payload.destroy_context_13_5.ctx_23 = ctx->unk_23;
+		msg.payload.destroy_context_13_5.ctx_0 = ctx->unk_0;
+		msg.payload.destroy_context_13_5.ctx_1 = ctx->unk_1;
+		msg.payload.destroy_context_13_5.ctx_4 = ctx->unk_4;
+		msg.payload.destroy_context_13_5.gpu_context = gpu_va;
+	} else
+		return EOPNOTSUPP;
+	return agx_fw_devctl_send(dc, &msg);
+}
+
+int
+agx_fw_flush_cache(void *cookie)
+{
+	struct agx_fw_devctl *dc = cookie;
+	struct agx_fw_device_control_msg msg;
+
+	if (dc == NULL)
+		return EINVAL;
+	memset(&msg, 0, sizeof(msg));
+	if (dc->major == 12 && dc->minor == 3) {
+		msg.tag = 0x17;
+		msg.payload.destroy_context_12_3.ctx_0 = 0xff;
+		msg.payload.destroy_context_12_3.ctx_1 = 0xff;
+	} else if (dc->major == 13 && dc->minor == 5) {
+		msg.tag = 0x18;
+		msg.payload.destroy_context_13_5.ctx_0 = 0xff;
+		msg.payload.destroy_context_13_5.ctx_1 = 0xff;
+	} else
+		return EOPNOTSUPP;
+	return agx_fw_devctl_send(dc, &msg);
+}
+
+int
+agx_runtime_init(struct agx_runtime *runtime, struct agx_fwctl *ctl,
+    struct agx_fw_devctl *devctl, struct agx_uat_handoff *handoff,
+    struct agx_heap *rtkit_heap, void (*fail_jobs)(void *), void *cookie)
+{
+	if (runtime == NULL || ctl == NULL || devctl == NULL || handoff == NULL ||
+	    rtkit_heap == NULL || !rtkit_heap->cpu_mapped || fail_jobs == NULL)
+		return EINVAL;
+	mtx_init(&runtime->admission, IPL_HIGH);
+	mtx_init(&runtime->op_mtx, IPL_HIGH);
+	runtime->op_count = 0;
+	rw_init(&runtime->submit_order, "agxorder");
+	mtx_init(&runtime->parallel_lock, IPL_TTY);
+	runtime->parallel_head = NULL;
+	runtime->parallel_tail = NULL;
+	runtime->parallel_foreign = 0;
+	runtime->ctl = ctl;
+	runtime->devctl = devctl;
+	runtime->handoff = handoff;
+	runtime->rtkit_heap = rtkit_heap;
+	runtime->fail_jobs = fail_jobs;
+	runtime->cookie = cookie;
+	runtime->failure_error = 0;
+	__atomic_store_n(&runtime->failure_complete, 0, __ATOMIC_RELAXED);
+	__atomic_store_n(&runtime->crashed, 0, __ATOMIC_RELEASE);
+	return 0;
+}
+
+int
+agx_fw_is_crashed(const struct agx_runtime *runtime)
+{
+	return runtime == NULL ||
+	    __atomic_load_n(&runtime->crashed, __ATOMIC_ACQUIRE) != 0;
+}
+
+int
+agx_runtime_admit_enter(struct agx_runtime *runtime)
+{
+	if (runtime == NULL)
+		return ENXIO;
+	mtx_enter(&runtime->admission);
+	if (__atomic_load_n(&runtime->crashed, __ATOMIC_ACQUIRE)) {
+		mtx_leave(&runtime->admission);
+		return ENXIO;
+	}
+	return 0;
+}
+
+void
+agx_runtime_admit_leave(struct agx_runtime *runtime)
+{
+	mtx_leave(&runtime->admission);
+}
+
+void
+agx_runtime_mark_failed(struct agx_runtime *runtime, int error)
+{
+	if (runtime == NULL)
+		return;
+	mtx_enter(&runtime->admission);
+	if (__atomic_load_n(&runtime->crashed, __ATOMIC_RELAXED)) {
+		mtx_leave(&runtime->admission);
+		return;
+	}
+	runtime->failure_error = error > 0 ? error : EIO;
+	__atomic_store_n(&runtime->crashed, 1, __ATOMIC_RELEASE);
+	mtx_leave(&runtime->admission);
+	agx_fwctl_crashed(runtime->ctl);
+	__atomic_store_n(&runtime->devctl->failed, 1, __ATOMIC_RELEASE);
+	agx_uat_handoff_poison(runtime->handoff);
+	runtime->fail_jobs(runtime->cookie);
+	__atomic_store_n(&runtime->failure_complete, 1, __ATOMIC_RELEASE);
+	wakeup(&runtime->failure_complete);
+}
+
+/* This failure path and its fail_jobs callback are IRQ-safe. */
+static void
+agx_fw_rtkit_crash_notify(void *cookie)
+{
+	agx_runtime_mark_failed(cookie, ENXIO);
+}
+
+/* An RX transport fault makes firmware communication unusable, not stopped. */
+static void
+agx_fw_rtkit_fault(void *cookie, int error)
+{
+	agx_runtime_mark_failed(cookie, error);
+}
+
+void
+agx_fw_rtkit_crashed(void *cookie, const void *snapshot, bus_size_t size)
+{
+	struct agx_runtime *runtime = cookie;
+
+	/* RTKit owns and logs the bounded snapshot before releasing it. */
+	(void)snapshot;
+	(void)size;
+	agx_runtime_mark_failed(runtime, ENXIO);
+}
+
+int
+agx_fw_rtkit_alloc(void *cookie, bus_size_t size, caddr_t *kva,
+    bus_addr_t *dva, void **handle)
+{
+	struct agx_runtime *runtime = cookie;
+	struct agx_object *object;
+	size_t rounded;
+	int error;
+
+	if (runtime == NULL || runtime->rtkit_heap == NULL || kva == NULL ||
+	    dva == NULL || handle == NULL || size == 0 ||
+	    size > SIZE_MAX - (AGX_UAT_PAGE_SIZE - 1))
+		return EINVAL;
+	rounded = (size + AGX_UAT_PAGE_SIZE - 1) & ~(AGX_UAT_PAGE_SIZE - 1);
+	error = agx_object_alloc(runtime->rtkit_heap, rounded,
+	    AGX_UAT_PAGE_SIZE, &object);
+	if (error)
+		return error;
+	if (object->cpu == NULL || object->gpu < 0xffffffae00000000ULL ||
+	    object->gpu >= 0xffffffae10000000ULL ||
+	    rounded > 0xffffffae10000000ULL - object->gpu) {
+		agx_object_free(object);
+		return EINVAL;
+	}
+	memset(object->cpu, 0, rounded);
+	*kva = object->cpu;
+	*dva = object->gpu;
+	*handle = object;
+	return 0;
+}
+
+void
+agx_fw_rtkit_free(void *cookie, void *handle)
+{
+	struct agx_runtime *runtime = cookie;
+	struct agx_object *object = handle;
+
+	KASSERT(runtime != NULL && object != NULL &&
+	    object->heap == runtime->rtkit_heap);
+	agx_object_free(object);
+}
+
+int
+agx_fwctl_flush(void *cookie, uint64_t va, uint64_t size, uint32_t slot)
+{
+	struct agx_fwctl *ctl = cookie;
+	struct agx_fw_ctl_msg msg;
+	uint32_t token;
+	int error;
+
+	if (ctl == NULL || size == 0 ||
+	    ((va | size) & (AGX_UAT_PAGE_SIZE - 1)) != 0 ||
+	    size / AGX_UAT_PAGE_SIZE > 0xffff || va > UINT64_MAX - size ||
+	    slot > 64)
+		return EINVAL;
+	rw_enter_write(&ctl->lock);
+	if (__atomic_load_n(&ctl->failed, __ATOMIC_ACQUIRE)) {
+		error = ENXIO;
+		goto out;
+	}
+	memset(&msg, 0, sizeof(msg));
+	msg.addr.value = va;
+	msg.slot = slot;
+	msg.page_count = size / AGX_UAT_PAGE_SIZE;
+	msg.unk_12 = 2;
+	error = agx_channel_put(ctl->channel, &msg, &token);
+	if (error)
+		goto out;
+	/* Publish both the entry and write pointer before ringing RTKit. */
+	__asm volatile("dsb sy" ::: "memory");
+	error = agx_fw_send_wait(ctl->rtkit, AGX_FW_ENDPOINT_DOORBELL,
+	    AGX_FWCTL_DOORBELL, &ctl->failed);
+	if (error)
+		goto failed;
+	error = agx_fw_wait_consumed(ctl->channel, token, &ctl->failed, ctl,
+	    "agxfwctl");
+	if (error)
+		goto failed;
+	goto out;
+failed:
+	/* A posted command may still be in flight; never reuse this ring. */
+	__atomic_store_n(&ctl->failed, 1, __ATOMIC_RELEASE);
+out:
+	rw_exit_write(&ctl->lock);
+	return error;
+}
+
+static void
+agx_runtime_contain(void *cookie)
+{
+	struct agx_runtime *runtime = cookie;
+
+	if (runtime->bank != NULL)
+		agx_channel_bank_stop(runtime->bank);
+}
+
+static void
+agx_runtime_freeze_jobs(void *cookie)
+{
+	struct agx_runtime *runtime = cookie;
+
+	if (runtime->events != NULL)
+		agx_event_slots_freeze(runtime->events);
+	task_add(runtime->tasks, &runtime->contain_task);
+}
+
+static void
+agx_runtime_bank_error(void *cookie, int error)
+{
+	struct agx_runtime *runtime = cookie;
+
+	printf("agx: firmware doorbell failed (%d)\n", error);
+	agx_runtime_mark_failed(runtime, error);
+}
+
+/* G13/G14 firmware reports in-flight event stamps before requesting a resume. */
+static struct agx_fw_pending_stamp *
+agx_runtime_pending_stamps(const struct agx_init_runtime_view *view,
+    unsigned int *slot_shift)
+{
+	if (view->globals == NULL || slot_shift == NULL)
+		return NULL;
+	if (view->major == 12 && view->minor == 3 &&
+	    view->globals_size == sizeof(struct agx_fw_globals_12_3)) {
+		*slot_shift = 3;
+		return ((struct agx_fw_globals_12_3 *)view->globals)->pending_stamps;
+	}
+	if (view->major == 13 && view->minor == 5) {
+		*slot_shift = 4;
+		if (view->globals_size == sizeof(struct agx_fw_globals_g14x_13_5))
+			return ((struct agx_fw_globals_g14x_13_5 *)view->globals)->pending_stamps;
+		if (view->globals_size == sizeof(struct agx_fw_globals_13_5))
+			return ((struct agx_fw_globals_13_5 *)view->globals)->pending_stamps;
+	}
+	return NULL;
+}
+
+static int
+agx_runtime_mark_pending_events(struct agx_runtime *runtime,
+	const struct agx_init_runtime_view *view,
+	const struct agx_event_error *error, int culprit_slot)
+{
+	struct agx_fw_pending_stamp *pending;
+	struct agx_event_error killed;
+	uint32_t info, slot, wait;
+	unsigned int shift, i;
+
+	pending = agx_runtime_pending_stamps(view, &shift);
+	if (pending == NULL)
+		return EOPNOTSUPP;
+	memset(&killed, 0, sizeof(killed));
+	killed.kind = AGX_EVENT_ERROR_KILLED;
+	for (i = 0; i < 0x100; i++) {
+		info = __atomic_load_n(&pending[i].info, __ATOMIC_ACQUIRE);
+		if ((info & 1) == 0)
+			continue;
+		slot = (info >> shift) & 0x7f;
+		wait = __atomic_load_n(&pending[i].wait_value, __ATOMIC_ACQUIRE);
+		agx_event_slots_mark_error(runtime->events, slot, wait,
+		    culprit_slot >= 0 && slot != (uint32_t)culprit_slot ?
+		    &killed : error);
+		__atomic_store_n(&pending[i].wait_value, 0, __ATOMIC_RELAXED);
+		__atomic_store_n(&pending[i].info, 0, __ATOMIC_RELEASE);
+	}
+	return 0;
+}
+
+static int
+agx_runtime_recover_event(struct agx_runtime *runtime,
+	const struct agx_event_error *error, int culprit_slot)
+{
+	struct agx_init_runtime_view view;
+	uint64_t start;
+	int result;
+
+	result = agx_init_runtime_view(runtime->graph, &view);
+	if (result != 0 || view.status == NULL)
+		return result != 0 ? result : EINVAL;
+
+	/* Firmware may still update pending stamps until it confirms a halt. */
+	start = nsecuptime();
+	while (__atomic_load_n(&view.status->flags.halted, __ATOMIC_ACQUIRE) == 0) {
+		if (agx_fw_is_crashed(runtime))
+			return ENXIO;
+		if (nsecuptime() - start >= 100000000ULL)
+			return ETIMEDOUT;
+		(void)tsleep_nsec(&view.status->flags.halted, PWAIT, "agxfwhalt",
+		    1000000ULL);
+	}
+	if (agx_fw_is_crashed(runtime))
+		return ENXIO;
+	result = agx_runtime_mark_pending_events(runtime, &view, error,
+	    culprit_slot);
+	if (result != 0)
+		return result;
+	if (agx_fw_is_crashed(runtime))
+		return ENXIO;
+	__atomic_store_n(&view.status->flags.halted, 0, __ATOMIC_SEQ_CST);
+	__atomic_store_n(&view.status->flags.resume, 1, __ATOMIC_SEQ_CST);
+	return 0;
+}
+
+static void
+agx_runtime_event(void *cookie, const struct agx_fw_event_msg *raw)
+{
+	struct agx_runtime *runtime = cookie;
+	struct agx_init_runtime_view view;
+	struct agx_fw_device_control_msg ack;
+	struct agx_event event;
+	struct agx_event_error channel_error;
+	struct agx_event_recovery recovery;
+	struct agx_event_error event_error;
+	int culprit_slot;
+	struct agx_hw_fault fault;
+	struct agx_uat_fault_snapshot snapshot;
+	int snapshot_error;
+	int error;
+
+	if (agx_fw_is_crashed(runtime))
+		return;
+	error = agx_event_decode(raw, &event);
+	if (error == EOPNOTSUPP) {
+		printf("agx: unknown firmware event %u\n", raw->tag);
+		return;
+	}
+	if (error != 0)
+		goto failed;
+	switch (event.tag) {
+	case AGX_FW_EVENT_FLAG:
+		agx_event_slots_signal(runtime->events, event.u.flag.firing);
+		return;
+	case AGX_FW_EVENT_GROW_TVB:
+		error = agx_tvb_grow_slot(runtime->tvb, event.u.grow.vm_slot,
+		    event.u.grow.buffer_slot);
+		if (error != 0)
+			goto failed;
+		error = agx_init_runtime_view(runtime->graph, &view);
+		if (error != 0)
+			goto failed;
+		memset(&ack, 0, sizeof(ack));
+		ack.tag = view.major == 12 ? 0x0d : 0x0e;
+		ack.payload.grow_tvb_ack.unk_4 = 1;
+		ack.payload.grow_tvb_ack.buffer_slot = event.u.grow.buffer_slot;
+		ack.payload.grow_tvb_ack.vm_slot = event.u.grow.vm_slot;
+		ack.payload.grow_tvb_ack.counter = event.u.grow.counter;
+		ack.payload.grow_tvb_ack.halt_count.value =
+		    __atomic_load_n(&view.status->flags.halt_count, __ATOMIC_ACQUIRE);
+		error = agx_fw_devctl_send_internal(runtime->devctl, &ack,
+		    AGX_DEVCTL_ASYNC);
+		if (error != 0)
+			goto failed;
+		return;
+	case AGX_FW_EVENT_FAULT:
+	case AGX_FW_EVENT_TIMEOUT:
+		memset(&event_error, 0, sizeof(event_error));
+		culprit_slot = -1;
+		if (event.tag == AGX_FW_EVENT_TIMEOUT) {
+			printf("agx: timeout event slot %d counter %u unknown %u\n",
+			    event.u.timeout.slot, event.u.timeout.counter,
+			    event.u.timeout.unknown);
+			event_error.kind = AGX_EVENT_ERROR_TIMEOUT;
+			event_error.code = event.u.timeout.counter;
+			if (event.u.timeout.slot >= 0 &&
+			    event.u.timeout.slot < AGX_EVENT_SLOTS)
+				culprit_slot = event.u.timeout.slot;
+		}
+		if (agx_hw_read_fault(&runtime->sc->resources, &fault) == 0) {
+			printf("agx: MMU snapshot event %u addr 0x%llx slot %u unit %u level %u reason %u read %u sideband %u\n",
+			    event.tag, (unsigned long long)fault.address, fault.vm_slot,
+			    fault.unit, fault.level, fault.reason, fault.read,
+			    fault.sideband);
+			snapshot_error = agx_uat_fault_snapshot(runtime->handoff,
+			    fault.vm_slot, fault.address, &snapshot);
+			if (snapshot_error != 0)
+				printf("agx: current slot snapshot unavailable (%d)\n",
+				    snapshot_error);
+			else {
+				printf("agx: current slot users %u age %llu active %u tails %u mutators %u closing %d scanned %u truncated %d\n",
+				    snapshot.slot_users, (unsigned long long)snapshot.slot_age,
+				    snapshot.active, snapshot.tails, snapshot.mutators,
+				    snapshot.closing, snapshot.mappings, snapshot.truncated);
+				printf("agx: current VM kernel [0x%llx,0x%llx) prev %d [0x%llx,0x%llx) next %d [0x%llx,0x%llx)\n",
+				    (unsigned long long)snapshot.kernel_start,
+				    (unsigned long long)snapshot.kernel_end,
+				    snapshot.prev_valid, (unsigned long long)snapshot.prev_start,
+				    (unsigned long long)snapshot.prev_end, snapshot.next_valid,
+				    (unsigned long long)snapshot.next_start,
+				    (unsigned long long)snapshot.next_end);
+			}
+			event_error.kind = AGX_EVENT_ERROR_FAULT;
+			event_error.code = fault.reason;
+			event_error.vm_slot = fault.vm_slot;
+			event_error.address = fault.address;
+		} else if (event.tag == AGX_FW_EVENT_FAULT)
+			event_error.kind = AGX_EVENT_ERROR_UNKNOWN;
+		error = agx_runtime_recover_event(runtime, &event_error, culprit_slot);
+		if (error != 0)
+			goto failed;
+		printf("agx: resumed firmware after event %u\n", event.tag);
+		return;
+
+	case AGX_FW_EVENT_CHANNEL_ERROR:
+		memset(&channel_error, 0, sizeof(channel_error));
+		channel_error.kind = AGX_EVENT_ERROR_CHANNEL;
+		channel_error.code = event.u.channel_error.error;
+		error = agx_event_recovery_begin(runtime->events,
+		    event.u.channel_error.slot, event.u.channel_error.pipe,
+		    event.u.channel_error.value, &channel_error, &recovery);
+		if (error != 0)
+			goto failed;
+		memset(&ack, 0, sizeof(ack));
+		ack.tag = runtime->devctl->major == 12 ? 0x0e : 0x0f;
+		ack.payload.recover_channel.pipe_type = event.u.channel_error.pipe;
+		ack.payload.recover_channel.work_queue = recovery.queue_va;
+		ack.payload.recover_channel.event_value = event.u.channel_error.value;
+		error = agx_fw_devctl_send_internal(runtime->devctl, &ack,
+		    AGX_DEVCTL_SYNC);
+		if (error == 0 && agx_fw_is_crashed(runtime))
+			error = ENXIO;
+		if (error != 0) {
+			/* A competing failure may not yet have frozen the manager. */
+			agx_event_slots_freeze(runtime->events);
+			agx_runtime_mark_failed(runtime, error);
+		}
+		agx_event_recovery_end(&recovery);
+		if (error != 0)
+			goto failed;
+		return;
+	default:
+		return;
+	}
+failed:
+	printf("agx: firmware event %u failed (%d)\n", raw->tag, error);
+	agx_runtime_mark_failed(runtime, error);
+}
+
+static void
+agx_runtime_poll(void *cookie)
+{
+	struct agx_runtime *runtime = cookie;
+	const struct agx_channel_bank_ops ops = { .event = agx_runtime_event };
+	int error;
+
+	rw_enter_write(&runtime->rx_lock);
+	if (!agx_fw_is_crashed(runtime)) {
+		error = agx_channel_bank_poll(runtime->bank, &ops, runtime);
+		if (error == EAGAIN && !agx_fw_is_crashed(runtime))
+			task_add(runtime->tasks, &runtime->rx_task);
+		else if (error != 0 && error != EAGAIN) {
+			printf("agx: firmware channel poll failed (%d)\n", error);
+			agx_runtime_mark_failed(runtime, error);
+		}
+	}
+	rw_exit_write(&runtime->rx_lock);
+}
+
+static void
+agx_runtime_rx(void *cookie, uint64_t msg)
+{
+	struct agx_runtime *runtime = cookie;
+
+	if (msg != (0x42ULL << 48)) {
+		/* Match Asahi: an unknown mailbox message is not a GPU crash. */
+		printf("agx: unexpected firmware message %llx\n", msg);
+		return;
+	}
+	task_add(runtime->tasks, &runtime->rx_task);
+}
+
+int
+agx_runtime_create(struct agx_softc *sc, struct agx_runtime **out)
+{
+	struct agx_runtime *runtime;
+	struct agx_heap *shared, *private;
+	int error;
+
+	if (sc == NULL || out == NULL)
+		return EINVAL;
+	runtime = malloc(sizeof(*runtime), M_DEVBUF, M_WAITOK | M_ZERO);
+	*out = runtime;
+	runtime->sc = sc;
+	rw_init(&runtime->rx_lock, "agxrx");
+	task_set(&runtime->rx_task, agx_runtime_poll, runtime);
+	task_set(&runtime->contain_task, agx_runtime_contain, runtime);
+	runtime->tasks = taskq_create("agxrt", 1, IPL_HIGH, TASKQ_MPSAFE);
+	if (runtime->tasks == NULL) {
+		free(runtime, M_DEVBUF, sizeof(*runtime));
+		*out = NULL;
+		return ENOMEM;
+	}
+	error = agx_fw_uat_create(&sc->resources, &runtime->uat);
+	if (error) goto fail;
+	runtime->handoff = agx_fw_uat_handoff(runtime->uat);
+	error = agx_fw_heaps_create(sc->resources.dmat,
+	    agx_fw_uat_kernel(runtime->uat), runtime->handoff,
+	    &runtime->ctl_storage, &runtime->devctl_storage, &runtime->heaps);
+	if (error) goto fail;
+	shared = agx_fw_heap(runtime->heaps, AGX_FW_HEAP_SHARED);
+	private = agx_fw_heap(runtime->heaps, AGX_FW_HEAP_PRIVATE);
+	runtime->events = malloc(sizeof(*runtime->events), M_DEVBUF, M_WAITOK | M_ZERO);
+	error = agx_event_slots_init(runtime->events, shared, private);
+	if (error) goto fail;
+	runtime->tvb = malloc(sizeof(*runtime->tvb), M_DEVBUF, M_WAITOK | M_ZERO);
+	agx_tvb_manager_init(runtime->tvb);
+	error = agx_timestamp_pool_create(agx_fw_uat_kernel(runtime->uat),
+	    &runtime->timestamps);
+	if (error) goto fail;
+	error = agx_runtime_init(runtime, &runtime->ctl_storage,
+	    &runtime->devctl_storage, runtime->handoff,
+	    agx_fw_heap(runtime->heaps, AGX_FW_HEAP_RTKIT),
+	    agx_runtime_freeze_jobs, runtime);
+	if (error) goto fail;
+	runtime->rk = malloc(sizeof(*runtime->rk), M_DEVBUF, M_WAITOK | M_ZERO);
+	runtime->rk->rk_cookie = runtime;
+	runtime->rk->rk_dmat = sc->resources.dmat;
+	runtime->rk->rk_alloc = agx_fw_rtkit_alloc;
+	runtime->rk->rk_free = agx_fw_rtkit_free;
+	runtime->rk->rk_crash_notify = agx_fw_rtkit_crash_notify;
+	runtime->rk->rk_crashed = agx_fw_rtkit_crashed;
+	runtime->rk->rk_fault = agx_fw_rtkit_fault;
+	runtime->rtkit = rtkit_init(sc->resources.node, NULL, 0, runtime->rk);
+	if (runtime->rtkit == NULL) { error = ENXIO; goto fail; }
+	/* Install the mailbox receiver before the ASC can send HELLO. */
+	error = agx_runtime_admit_enter(runtime);
+	if (error) goto fail;
+	error = agx_hw_start_cpu(&sc->resources);
+	agx_runtime_admit_leave(runtime);
+	if (error) goto fail;
+	if (agx_fw_is_crashed(runtime)) { error = ENXIO; goto fail; }
+	error = agx_fw_uat_start(runtime->uat);
+	if (error) goto fail;
+	if (agx_fw_is_crashed(runtime)) { error = ENXIO; goto fail; }
+	error = agx_channel_bank_create(runtime->heaps, sc->resources.fw_major,
+	    sc->resources.fw_minor, runtime->rtkit, &runtime->bank);
+	if (error) goto fail;
+	agx_channel_bank_set_error_handler(runtime->bank, agx_runtime_bank_error,
+	    runtime);
+	error = agx_fwctl_init(runtime->ctl, agx_channel_bank_fwctl(runtime->bank),
+	    runtime->rtkit);
+	if (error) goto fail;
+	runtime->ctl_ready = 1;
+	error = agx_fw_devctl_init(runtime->devctl,
+	    agx_channel_bank_devctl(runtime->bank), runtime->rtkit,
+	    sc->resources.fw_major, sc->resources.fw_minor);
+	if (error) goto fail;
+	runtime->devctl_ready = 1;
+	if (agx_fw_is_crashed(runtime)) {
+		agx_fwctl_crashed(runtime->ctl);
+		__atomic_store_n(&runtime->devctl->failed, 1, __ATOMIC_RELEASE);
+		error = ENXIO;
+		goto fail;
+	}
+	error = agx_init_runtime_create(sc->resources.dmat, runtime->heaps,
+	    agx_fw_uat_kernel(runtime->uat), agx_fw_uat_lower(runtime->uat),
+	    &sc->power, &sc->identity, sc->resources.fw_major,
+	    sc->resources.fw_minor, agx_fw_uat_ttbs(runtime->uat), 0xb,
+	    runtime->bank, &runtime->graph);
+	if (error) goto fail;
+	error = agx_fw_boot(runtime->rtkit,
+	    agx_channel_bank_devctl(runtime->bank),
+	    agx_init_runtime_root(runtime->graph), sc->resources.fw_major,
+	    sc->resources.fw_minor, agx_runtime_rx, runtime, &runtime->crashed);
+	if (error) goto fail;
+	if (agx_fw_is_crashed(runtime)) { error = ENXIO; goto fail; }
+	sc->runtime = runtime;
+	sc->uat = runtime->handoff;
+	sc->fwctl = runtime->ctl;
+	sc->devctl = runtime->devctl;
+	sc->features = DRM_ASAHI_FEATURE_SOFT_FAULTS;
+	return 0;
+fail:
+	if (runtime->fail_jobs != NULL)
+		agx_runtime_mark_failed(runtime, error);
+	else {
+		__atomic_store_n(&runtime->crashed, 1, __ATOMIC_RELEASE);
+		if (runtime->handoff != NULL)
+			agx_uat_handoff_poison(runtime->handoff);
+	}
+	return error;
+}
+
+int
+agx_runtime_quiesce_callbacks(struct agx_runtime *runtime)
+{
+	int error;
+
+	if (runtime == NULL || runtime->fail_jobs == NULL)
+		return EINVAL;
+	if (runtime->callbacks_detached == 2)
+		return 0;
+	/* This marks the device unusable but does not establish DMA quiescence. */
+	agx_runtime_mark_failed(runtime, ENXIO);
+	/* The winning failure caller may still be freezing and queuing work. */
+	while (!__atomic_load_n(&runtime->failure_complete, __ATOMIC_ACQUIRE)) {
+		sleep_setup(&runtime->failure_complete, PWAIT, "agxfail");
+		sleep_finish(INFSLP, !__atomic_load_n(&runtime->failure_complete,
+		    __ATOMIC_ACQUIRE));
+	}
+	taskq_del_barrier(runtime->tasks, &runtime->contain_task);
+	if (runtime->bank != NULL)
+		agx_channel_bank_stop(runtime->bank);
+	/* Wait out callers which may already be sending control commands. */
+	if (runtime->ctl_ready) {
+		rw_enter_write(&runtime->ctl->lock);
+		rw_exit_write(&runtime->ctl->lock);
+	}
+	if (runtime->devctl_ready) {
+		rw_enter_write(&runtime->devctl->lock);
+		rw_exit_write(&runtime->devctl->lock);
+	}
+	if (runtime->rtkit != NULL && runtime->callbacks_detached == 0) {
+		error = rtkit_detach_callbacks(runtime->rtkit);
+		if (error)
+			return error;
+	}
+	runtime->callbacks_detached = 1;
+	/* Wait for an in-flight poll to finish any self-requeue before deletion. */
+	rw_enter_write(&runtime->rx_lock);
+	rw_exit_write(&runtime->rx_lock);
+	taskq_del_barrier(runtime->tasks, &runtime->rx_task);
+	if (runtime->events != NULL) {
+		error = agx_event_slots_barrier(runtime->events);
+		if (error)
+			return error;
+	}
+	taskq_destroy(runtime->tasks);
+	runtime->tasks = NULL;
+	runtime->callbacks_detached = 2;
+	return 0;
+}
+
+struct agx_timestamp_pool *
+agx_runtime_timestamp_pool(struct agx_runtime *runtime)
+{
+	return runtime != NULL ? runtime->timestamps : NULL;
+}
+
+struct agx_channel_bank *
+agx_runtime_channels(struct agx_runtime *runtime)
+{
+	return runtime != NULL ? runtime->bank : NULL;
+}
+
+struct agx_fw_heaps *
+agx_runtime_heaps(struct agx_runtime *runtime)
+{
+	return runtime != NULL ? runtime->heaps : NULL;
+}
+
+struct agx_event_slots *
