+
+/* The heaps, page tables and channel bank must outlive the graph.  On error,
+ * *out may hold a partially constructed graph if cleanup failed: retain it
+ * and retry destroy.  Stop firmware and retire all GPU work before destroy. */
+int agx_init_runtime_create(bus_dma_tag_t, struct agx_fw_heaps *,
+    struct agx_uat_pt *, struct agx_uat_pt *, const struct agx_power_config *,
+    const struct agx_identity *, unsigned int, unsigned int, uint64_t,
+    uint32_t, struct agx_channel_bank *, struct agx_init_runtime **);
+uint64_t agx_init_runtime_root(const struct agx_init_runtime *);
+/* Firmware globals remain allocated until all operation guards are released. */
+uint32_t *agx_init_runtime_pending(struct agx_init_runtime *);
+int agx_init_runtime_destroy(struct agx_init_runtime *);
