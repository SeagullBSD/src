+	(g)->unk_89c4 = AGX_T8103_DA_UNK_87C; \
+	(g)->fast_die0_prop_tgt_delta = 100 * (p)->fast_die0_prop_tgt_delta; \
+	(g)->fast_die0_kp = (p)->fast_die0_proportional_gain; \
+	(g)->fast_die0_ki_dt = agx_f32_mul((p)->fast_die0_integral_gain, (period_s)); \
+	(g)->unk_89e0 = 1; (g)->max_power_2 = (p)->max_power_mw; \
+	(g)->ppm_kp = (p)->ppm_kp; (g)->ppm_ki_dt = agx_f32_mul((p)->ppm_ki, (period_s)); \
+	memcpy((g)->hws1.table, agx_shared1, sizeof(agx_shared1)); \
+	(g)->hws1.unk_a4 = AGX_T8103_SHARED1_A4; \
+	memcpy((g)->hws2.table, agx_shared2, sizeof(agx_shared2)); \
+	memset((g)->hws2.unk_28, 0xff, sizeof((g)->hws2.unk_28)); \
+	(g)->hws2.unk_508 = AGX_T8103_SHARED2_UNK_508; \
+	(g)->unk_900c = 1; (g)->fault_control = (fault); (g)->do_init = 1; \
+	(g)->progress_check_interval_3d = 40; (g)->progress_check_interval_ta = 10; \
+	(g)->progress_check_interval_cl = 250; \
+	(g)->idle_off_delay_ms = (p)->idle_off_delay_ms; \
+	(g)->fender_idle_off_delay_ms = (p)->fender_idle_off_delay_ms; \
+	(g)->fw_early_wake_timeout_ms = (p)->fw_early_wake_timeout_ms; \
+	(g)->cl_context_switch_timeout_ms = 40; \
+	for (i = 0; i < (p)->num_power_zones; i++) { \
+		(g)->power_zones[i].target = (p)->power_zones[i].target; \
+		(g)->power_zones[i].target_off = (p)->power_zones[i].target - (p)->power_zones[i].target_offset; \
+		(g)->power_zones[i].filter_tc = (p)->power_zones[i].filter_tc; \
+	} \
+} while (0)
+
+int
+agx_initdata_globals(void *dst, size_t len, unsigned int major,
+    unsigned int minor, const struct agx_power_config *p,
+    const struct agx_identity *id, uint32_t fault_control)
+{
+	size_t size;
+	unsigned int i;
+	int g14x, error;
+	agx_f32 period_s;
+
+	if (dst == NULL || p == NULL || id == NULL || ((uintptr_t)dst & 3) != 0)
+		return EINVAL;
+	g14x = id->gpu_gen == 14 && id->gpu_variant == 'C';
+	if (g14x && (major != 13 || minor != 5))
+		return EINVAL;
+	if (major == 12 && minor == 3)
+		size = sizeof(struct agx_fw_globals_12_3);
+	else if (major == 13 && minor == 5)
+		size = g14x ? sizeof(struct agx_fw_globals_g14x_13_5) :
+		    sizeof(struct agx_fw_globals_13_5);
+	else
+		return EINVAL;
+	if (len < size || p->power_sample_period == 0 ||
+	    p->num_power_zones > AGX_POWER_MAX_ZONES ||
+	    p->perf_max_pstate > UINT32_MAX / 100 ||
+	    p->fast_die0_release_temp > UINT32_MAX / 100 ||
+	    p->fast_die0_prop_tgt_delta > UINT32_MAX / 100)
+		return EINVAL;
+	for (i = 0; i < p->num_power_zones; i++)
+		if (p->power_zones[i].target_offset > p->power_zones[i].target)
+			return EINVAL;
+	period_s = agx_f32_div(agx_f32_from_u32(p->power_sample_period),
+	    agx_f32_from_u32(1000));
+	if (!agx_f32_isfinite(p->avg_power_ki_only) ||
+	    !agx_f32_isfinite(p->avg_power_kp) ||
+	    !agx_f32_isfinite(p->fast_die0_integral_gain) ||
+	    !agx_f32_isfinite(p->fast_die0_proportional_gain) ||
+	    !agx_f32_isfinite(p->ppm_ki) || !agx_f32_isfinite(p->ppm_kp) ||
+	    !agx_f32_isfinite(agx_f32_mul(p->avg_power_ki_only, period_s)) ||
+	    !agx_f32_isfinite(agx_f32_mul(p->fast_die0_integral_gain, period_s)) ||
+	    !agx_f32_isfinite(agx_f32_mul(p->ppm_ki, period_s)))
+		return ERANGE;
+	memset(dst, 0, size);
+	if (major == 12) {
+		struct agx_fw_globals_12_3 *g = dst;
+		AGX_GLOBALS_INIT(g, p, period_s, fault_control);
+	} else if (g14x) {
+		static const uint32_t coeffs[8] = { 0x3f800000, 0x3f4ccccd,
+		    0x3e4ccccd, 0x3f666666, 0x3dcccccd, 0x3e800000,
+		    0x3f333333, 0x3f666666 };
+		static const uint8_t table[] = { 0, 2, 2, 1, 1, 90, 75, 1, 1,
+		    1, 2, 90, 75, 1, 1, 1, 2, 90, 75, 1, 1, 1, 1, 90, 75, 1, 1 };
+		struct agx_fw_globals_g14x_13_5 *g = dst;
+		AGX_GLOBALS_INIT(g, p, period_s, fault_control);
+		g->unk_24_0 = 3000; g->unk_2c_0 = 1; g->sub.unk_54 = 4000;
+		g->unk_89bc = 11000; g->unk_89c4 = 500; g->unk_89f4_8 = 1;
+		g->idle_off_standby_timer = p->idle_off_standby_timer;
+		memcpy(g->unk_hws2_4, coeffs, sizeof(coeffs)); g->unk_hws2_24 = 6;
+		error = agx_init_hw_shared(&g->hws1, &g->hws2, &g->hws3, p, 1);
+		if (error) return error;
+		g->unk_9010_0 = 1; g->unk_903c = 1;
+		g->unk_1102c_0 = 1; g->unk_1102c_4 = 1;
+		g->unk_1102c_8 = 100; g->unk_1102c_c = 1;
+		g->cl_kill_timeout_ms = 50;
+		memcpy(g->unk_118ec, table, sizeof(table)); g->unk_118e8 = 1;
+	} else {
+		struct agx_fw_globals_13_5 *g = dst;
+		AGX_GLOBALS_INIT(g, p, period_s, fault_control);
+		g->unk_24_0 = 3000;
+		g->unk_89f4_8 = 1;
+		g->idle_off_standby_timer = p->idle_off_standby_timer;
+		g->unk_9010_0 = 1;
+		g->unk_903c = 1;
+		g->unk_1102c_0 = 1;
+		g->unk_1102c_4 = 1;
+		g->unk_1102c_8 = 100;
+		g->unk_1102c_c = 1;
+		g->cl_kill_timeout_ms = 50;
+	}
+	return 0;
+}
+#undef AGX_GLOBALS_INIT
