+			goto fail;
+		}
+		error = agx_queue_owner_alloc(shared, sizeof(struct agx_fw_ring_state),
+		    &pipe->state);
+		if (error != 0)
+			goto fail;
+		error = agx_queue_owner_alloc(shared,
+		    AGX_QUEUE_RING_SIZE * sizeof(uint64_t), &pipe->entries);
+		if (error != 0)
+			goto fail;
+		error = agx_queue_owner_alloc(private, AGX_QUEUE_GPU_BUFFER_SIZE,
+		    &pipe->gpu_buffer);
+		if (error != 0)
+			goto fail;
+		error = agx_queue_owner_alloc(private, info_size, &pipe->info);
+		if (error != 0)
+			goto fail;
+	}
+	error = agx_tvb_init(&owner->tvb, tvb_manager, version, g14x, shared,
+	    private, agx_context_vm_private_heap(vm), agx_context_vm_shared_heap(vm));
