@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Decode firmware event ring entries without trusting firmware indices. */
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+
+#include "agx_fw.h"
+
+int
+agx_event_decode(const struct agx_fw_event_msg *message,
+    struct agx_event *event)
+{
+	if (message == NULL || event == NULL)
+		return EINVAL;
+	memset(event, 0, sizeof(*event));
+	event->tag = message->tag;
+	switch (message->tag) {
+	case AGX_FW_EVENT_FAULT:
+		return 0;
+	case AGX_FW_EVENT_FLAG:
+		memcpy(event->u.flag.firing, message->payload.flag.firing,
+		    sizeof(event->u.flag.firing));
+		return 0;
+	case AGX_FW_EVENT_TIMEOUT:
+		event->u.timeout.counter = message->payload.timeout.counter;
+		event->u.timeout.unknown = message->payload.timeout.unk_8;
+		/* The slot is diagnostic, not an index; -1 may mean unknown. */
+		event->u.timeout.slot = message->payload.timeout.event_slot;
+		return 0;
+	case AGX_FW_EVENT_GROW_TVB:
+		event->u.grow.vm_slot = message->payload.grow_tvb.vm_slot;
+		event->u.grow.buffer_slot = message->payload.grow_tvb.buffer_slot;
+		event->u.grow.counter = message->payload.grow_tvb.counter;
+		return 0;
+	case AGX_FW_EVENT_CHANNEL_ERROR:
+		event->u.channel_error.error = message->payload.channel_error.error_type;
+		event->u.channel_error.pipe = message->payload.channel_error.pipe_type;
+		event->u.channel_error.slot = message->payload.channel_error.event_slot;
+		event->u.channel_error.value = message->payload.channel_error.event_value;
+		if (event->u.channel_error.slot >= AGX_EVENT_SLOTS)
+			return EIO;
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
Index: sys/dev/pci/drm/asahi/agx_event_slots.c
