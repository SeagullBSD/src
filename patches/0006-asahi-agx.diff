--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_event_slots.c	Tue Nov 10 16:38:03 2026
@@ -0,0 +1,506 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Based on the Asahi event manager and slot allocator. */
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <machine/intr.h>
+
+#include "agx_event_slots.h"
+#include "agx_object.h"
+
+struct agx_event_call {
+	const struct agx_event_owner_ops *ops;
+	void *owner;
+	struct agx_event_token token;
+	uint32_t current;
+};
+
+int
+agx_event_threshold_increase(uint64_t *threshold, uint32_t notifications)
+{
+	uint64_t value;
+
+	if (threshold == NULL || ((uintptr_t)threshold & 7) != 0)
+		return EINVAL;
+	/* A serialized load/store avoids the non-LSE atomic RMW sequence. */
+	value = __atomic_load_n(threshold, __ATOMIC_RELAXED);
+	if (value > UINT64_MAX - notifications)
+		return EOVERFLOW;
+	__atomic_store_n(threshold, value + notifications, __ATOMIC_RELAXED);
+	return 0;
+}
+
+int
+agx_event_slots_init(struct agx_event_slots *manager, struct agx_heap *shared,
+    struct agx_heap *private)
+{
+	uint32_t *stamps;
+	unsigned int i;
+	int error;
+
+	if (manager == NULL || shared == NULL || private == NULL)
+		return EINVAL;
+	memset(manager, 0, sizeof(*manager));
+	mtx_init(&manager->lock, IPL_TTY);
+	error = agx_object_alloc(shared, AGX_EVENT_SLOTS * sizeof(uint32_t),
+	    sizeof(uint32_t), &manager->stamps);
+	if (error != 0)
+		return error;
+	error = agx_object_alloc(private, AGX_EVENT_SLOTS * sizeof(uint32_t),
+	    sizeof(uint32_t), &manager->fw_stamps);
+	if (error != 0)
+		goto fail_stamps;
+	if (manager->stamps->cpu == NULL || manager->fw_stamps->cpu == NULL) {
+		error = EINVAL;
+		goto fail_fw;
+	}
+	/* Heap blocks can be reused; initialise both arrays explicitly. */
+	stamps = manager->stamps->cpu;
+	for (i = 0; i < AGX_EVENT_SLOTS; i++)
+		__atomic_store_n(&stamps[i], i << 24, __ATOMIC_RELAXED);
+	memset(manager->fw_stamps->cpu, 0, AGX_EVENT_SLOTS * sizeof(uint32_t));
+	return 0;
+
+fail_fw:
+	agx_object_free(manager->fw_stamps);
+	manager->fw_stamps = NULL;
+fail_stamps:
+	agx_object_free(manager->stamps);
+	manager->stamps = NULL;
+	return error;
+}
+
+int
+agx_event_slots_fini(struct agx_event_slots *manager)
+{
+	if (manager == NULL || manager->stamps == NULL ||
+	    manager->fw_stamps == NULL)
+		return EINVAL;
+	mtx_enter(&manager->lock);
+	if (manager->active != 0 || manager->callbacks != 0 ||
+	    manager->reserved != 0 || manager->waiters != 0) {
+		mtx_leave(&manager->lock);
+		return EBUSY;
+	}
+	manager->closed = 1;
+	mtx_leave(&manager->lock);
+	agx_object_free(manager->fw_stamps);
+	agx_object_free(manager->stamps);
+	manager->fw_stamps = manager->stamps = NULL;
+	return 0;
+}
+
+int
+agx_event_slots_reserve(struct agx_event_slots *manager, unsigned int count,
+    struct agx_event_reservation *reservation)
+{
+	int error = 0;
+
+	if (manager == NULL || manager->stamps == NULL || reservation == NULL ||
+	    count > AGX_EVENT_SLOTS)
+		return EINVAL;
+	reservation->manager = NULL;
+	reservation->remaining = 0;
+	mtx_enter(&manager->lock);
+	if (manager->closed)
+		error = ENODEV;
+	else if (count > AGX_EVENT_SLOTS - manager->active - manager->reserved)
+		error = EBUSY;
+	else {
+		manager->reserved += count;
+		reservation->manager = manager;
+		reservation->remaining = count;
+	}
+	mtx_leave(&manager->lock);
+	return error;
+}
+
+void
+agx_event_slots_unreserve(struct agx_event_reservation *reservation)
+{
+	struct agx_event_slots *manager = reservation->manager;
+
+	if (manager == NULL)
+		return;
+	mtx_enter(&manager->lock);
+	KASSERT(manager->reserved >= reservation->remaining);
+	manager->reserved -= reservation->remaining;
+	if (reservation->remaining != 0)
+		wakeup(&manager->reserved);
+	reservation->remaining = 0;
+	reservation->manager = NULL;
+	mtx_leave(&manager->lock);
+}
+
+int
+agx_event_slots_wait(struct agx_event_slots *manager, unsigned int count,
+    const int *cancel, const int *stopped)
+{
+	int error = 0;
+
+	if (manager == NULL || manager->stamps == NULL || count == 0 ||
+	    count > AGX_EVENT_SLOTS || cancel == NULL || stopped == NULL)
+		return EINVAL;
+	mtx_enter(&manager->lock);
+	if (manager->waiters == UINT_MAX) {
+		mtx_leave(&manager->lock);
+		return EOVERFLOW;
+	}
+	manager->waiters++;
+	for (;;) {
+		error = __atomic_load_n(cancel, __ATOMIC_ACQUIRE);
+		if (error != 0)
+			break;
+		if (manager->closed || __atomic_load_n(stopped, __ATOMIC_ACQUIRE)) {
+			error = ENODEV;
+			break;
+		}
+		if (count <= AGX_EVENT_SLOTS - manager->active - manager->reserved)
+			break;
+		/* Scheduler timeout/stop flags are independent of the manager lock. */
+		(void)msleep_nsec(&manager->reserved, &manager->lock, PWAIT,
+		    "agxevslot", MSEC_TO_NSEC(100));
+	}
+	manager->waiters--;
+	mtx_leave(&manager->lock);
+	return error;
+}
+
+int
+agx_event_slot_get_reserved(struct agx_event_reservation *reservation,
+    const struct agx_event_token *previous, const struct agx_event_owner_ops *ops,
+    void *owner, struct agx_event_guard *guard)
+{
+	struct agx_event_slots *manager;
+	struct agx_event_slot_entry *entry;
+	uint64_t oldest;
+	uint32_t i, chosen;
+	int changed;
+
+	if (reservation == NULL || (manager = reservation->manager) == NULL ||
+	    manager->stamps == NULL || ops == NULL ||
+	    ops->ref == NULL || ops->unref == NULL || ops->signal == NULL ||
+	    ops->mark_error == NULL || ops->fail_all == NULL || owner == NULL ||
+	    guard == NULL)
+		return EINVAL;
+	mtx_enter(&manager->lock);
+	if (manager->closed) {
+		mtx_leave(&manager->lock);
+		return ENODEV;
+	}
+	if (reservation->remaining == 0) {
+		mtx_leave(&manager->lock);
+		return EINVAL;
+	}
+	chosen = AGX_EVENT_SLOTS;
+	changed = 1;
+	if (previous != NULL && previous->slot < AGX_EVENT_SLOTS) {
+		entry = &manager->slots[previous->slot];
+		if (entry->ops == NULL && previous->generation != 0 &&
+		    entry->generation == previous->generation) {
+			chosen = previous->slot;
+			changed = 0;
+		}
+	}
+	if (chosen == AGX_EVENT_SLOTS) {
+		oldest = UINT64_MAX;
+		for (i = 0; i < AGX_EVENT_SLOTS; i++) {
+			entry = &manager->slots[i];
+			if (entry->ops == NULL &&
+			    (chosen == AGX_EVENT_SLOTS || entry->drop_time < oldest)) {
+				chosen = i;
+				oldest = entry->drop_time;
+			}
+		}
+	}
+	if (chosen == AGX_EVENT_SLOTS) {
+		mtx_leave(&manager->lock);
+		return EBUSY;
+	}
+	if (manager->generation == UINT64_MAX) {
+		mtx_leave(&manager->lock);
+		return EOVERFLOW;
+	}
+	reservation->remaining--;
+	manager->reserved--;
+	entry = &manager->slots[chosen];
+	ops->ref(owner);
+	entry->owner = owner;
+	entry->ops = ops;
+	entry->generation = ++manager->generation;
+	manager->active++;
+	guard->manager = manager;
+	guard->token.slot = chosen;
+	guard->token.generation = entry->generation;
+	guard->gpu_stamp = manager->stamps->gpu + chosen * sizeof(uint32_t);
+	guard->gpu_fw_stamp = manager->fw_stamps->gpu + chosen * sizeof(uint32_t);
+	guard->changed = changed;
+	mtx_leave(&manager->lock);
+	return 0;
+}
+
+
+static int
+agx_event_slot_release(struct agx_event_guard *guard, int quarantine)
+{
+	struct agx_event_slots *manager;
+	struct agx_event_slot_entry *entry;
+	const struct agx_event_owner_ops *ops = NULL;
+	void *owner = NULL;
+
+	if (guard == NULL || (manager = guard->manager) == NULL ||
+	    guard->token.slot >= AGX_EVENT_SLOTS)
+		return EINVAL;
+	mtx_enter(&manager->lock);
+	entry = &manager->slots[guard->token.slot];
+	if (entry->ops == NULL || entry->quarantined ||
+	    entry->generation != guard->token.generation) {
+		mtx_leave(&manager->lock);
+		return EINVAL;
+	}
+	if (quarantine || manager->closed) {
+		entry->quarantined = 1;
+	} else {
+		ops = entry->ops;
+		owner = entry->owner;
+		entry->ops = NULL;
+		entry->owner = NULL;
+		if (manager->drops != UINT64_MAX)
+			manager->drops++;
+		entry->drop_time = manager->drops;
+		manager->active--;
+		wakeup(&manager->reserved);
+	}
+	guard->manager = NULL;
+	mtx_leave(&manager->lock);
+	if (ops != NULL)
+		ops->unref(owner);
+	return 0;
+}
+
+int
+agx_event_slot_put(struct agx_event_guard *guard)
+{
+	return agx_event_slot_release(guard, 0);
+}
+
+int
+agx_event_slot_quarantine(struct agx_event_guard *guard)
+{
+	return agx_event_slot_release(guard, 1);
+}
+
+int
+agx_event_slots_reap_stopped(struct agx_event_slots *manager)
+{
+	struct agx_event_slot_entry *entry;
+	const struct agx_event_owner_ops *ops;
+	void *owner;
+	uint32_t slot;
+
+	if (manager == NULL || manager->stamps == NULL)
+		return EINVAL;
+	/* The caller has stopped firmware and quiesced all dispatchers. */
+	mtx_enter(&manager->lock);
+	if (!manager->failed || manager->callbacks != 0) {
+		mtx_leave(&manager->lock);
+		return EBUSY;
+	}
+	for (slot = 0; slot < AGX_EVENT_SLOTS; slot++) {
+		entry = &manager->slots[slot];
+		if (!entry->quarantined)
+			continue;
+		ops = entry->ops;
+		owner = entry->owner;
+		KASSERT(ops != NULL && manager->active != 0);
+		entry->ops = NULL;
+		entry->owner = NULL;
+		entry->quarantined = 0;
+		manager->active--;
+		mtx_leave(&manager->lock);
+		ops->unref(owner);
+		mtx_enter(&manager->lock);
+	}
+	mtx_leave(&manager->lock);
+	return 0;
+}
+
+uint32_t
+agx_event_slot_current(const struct agx_event_guard *guard)
+{
+	uint32_t *stamps;
+
+	KASSERT(guard != NULL && guard->manager != NULL &&
+	    guard->token.slot < AGX_EVENT_SLOTS);
+	stamps = guard->manager->stamps->cpu;
+	return __atomic_load_n(&stamps[guard->token.slot], __ATOMIC_ACQUIRE);
+}
+
+/* Capture the owner and stamp before the slot can be recycled. */
+static int
+agx_event_call_get(struct agx_event_slots *manager, uint32_t slot,
+    struct agx_event_call *call, int stopped_failure)
+{
+	struct agx_event_slot_entry *entry;
+	uint32_t *stamps;
+
+	mtx_enter(&manager->lock);
+	entry = &manager->slots[slot];
+	if (entry->ops == NULL || (manager->closed && !stopped_failure)) {
+		mtx_leave(&manager->lock);
+		return 0;
+	}
+	call->ops = entry->ops;
+	call->owner = entry->owner;
+	call->token.slot = slot;
+	call->token.generation = entry->generation;
+	stamps = manager->stamps->cpu;
+	call->current = __atomic_load_n(&stamps[slot], __ATOMIC_ACQUIRE);
+	call->ops->ref(call->owner);
+	manager->callbacks++;
+	mtx_leave(&manager->lock);
+	return 1;
+}
+
+static void
+agx_event_call_put(struct agx_event_slots *manager, struct agx_event_call *call)
+{
+	call->ops->unref(call->owner);
+	mtx_enter(&manager->lock);
+	KASSERT(manager->callbacks != 0);
+	manager->callbacks--;
+	if (manager->callbacks == 0)
+		wakeup(manager);
+	mtx_leave(&manager->lock);
+}
+
+void
+agx_event_slots_signal(struct agx_event_slots *manager, const uint32_t firing[4])
+{
+	struct agx_event_call call;
+	uint32_t word, bit, slot;
+
+	if (manager == NULL || firing == NULL)
+		return;
+	for (word = 0; word < 4; word++) {
+		for (bit = 0; bit < 32; bit++) {
+			if ((firing[word] & (1U << bit)) == 0)
+				continue;
+			slot = word * 32 + bit;
+			if (agx_event_call_get(manager, slot, &call, 0)) {
+				call.ops->signal(call.owner, call.token, call.current);
+				agx_event_call_put(manager, &call);
+			}
+		}
+	}
+}
+
+void
+agx_event_slots_mark_error(struct agx_event_slots *manager, uint32_t slot,
+    uint32_t wait_value, const struct agx_event_error *error)
+{
+	struct agx_event_call call;
+
+	if (manager == NULL || error == NULL || slot >= AGX_EVENT_SLOTS)
+		return;
+	if (agx_event_call_get(manager, slot, &call, 0)) {
+		call.ops->mark_error(call.owner, call.token, call.current,
+		    wait_value, error);
+		agx_event_call_put(manager, &call);
+	}
+}
+int
+agx_event_recovery_begin(struct agx_event_slots *manager, uint32_t slot,
+    uint32_t pipe, uint32_t wait, const struct agx_event_error *error,
+    struct agx_event_recovery *recovery)
+{
+	struct agx_event_call call;
+	int result;
+
+	if (manager == NULL || error == NULL || recovery == NULL ||
+	    slot >= AGX_EVENT_SLOTS)
+		return EINVAL;
+	memset(recovery, 0, sizeof(*recovery));
+	if (!agx_event_call_get(manager, slot, &call, 0))
+		return ENOENT;
+	if (call.ops->recover == NULL || call.ops->recover_put == NULL)
+		result = EOPNOTSUPP;
+	else
+		result = call.ops->recover(call.owner, call.token, call.current,
+		    pipe, wait, error, &recovery->queue_va);
+	if (result != 0) {
+		agx_event_call_put(manager, &call);
+		return result;
+	}
+	recovery->ops = call.ops;
+	recovery->owner = call.owner;
+	recovery->manager = manager;
+	return 0;
+}
+
+void
+agx_event_recovery_end(struct agx_event_recovery *recovery)
+{
+	struct agx_event_call call;
+
+	KASSERT(recovery != NULL && recovery->manager != NULL);
+	call.ops = recovery->ops;
+	call.owner = recovery->owner;
+	call.ops->recover_put(call.owner);
+	agx_event_call_put(recovery->manager, &call);
+	recovery->manager = NULL;
+}
+
+
+void
+agx_event_slots_freeze(struct agx_event_slots *manager)
+{
+	if (manager == NULL)
+		return;
+	mtx_enter(&manager->lock);
+	manager->closed = 1;
+	wakeup(&manager->reserved);
+	mtx_leave(&manager->lock);
+}
+
+int
+agx_event_slots_barrier(struct agx_event_slots *manager)
+{
+	if (manager == NULL)
+		return EINVAL;
+	mtx_enter(&manager->lock);
+	if (!manager->closed) {
+		mtx_leave(&manager->lock);
+		return EBUSY;
+	}
+	while (manager->callbacks != 0)
+		msleep(manager, &manager->lock, 0, "agxevbar", 0);
+	mtx_leave(&manager->lock);
+	return 0;
+}
+
+void
+agx_event_slots_fail_all(struct agx_event_slots *manager,
+    const struct agx_event_error *error)
+{
+	struct agx_event_call call;
+	uint32_t slot;
+
+	if (manager == NULL || error == NULL)
+		return;
+	mtx_enter(&manager->lock);
+	if (manager->failed) {
+		mtx_leave(&manager->lock);
+		return;
+	}
+	manager->closed = 1;
+	manager->failed = 1;
+	wakeup(&manager->reserved);
+	mtx_leave(&manager->lock);
+	for (slot = 0; slot < AGX_EVENT_SLOTS; slot++) {
+		if (agx_event_call_get(manager, slot, &call, 1)) {
+			call.ops->fail_all(call.owner, call.token, call.current, error);
+			agx_event_call_put(manager, &call);
+		}
+	}
+}
Index: sys/dev/pci/drm/asahi/agx_event_slots.h
===================================================================
--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_event_slots.h	Tue Nov 10 17:45:38 2026
@@ -0,0 +1,169 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* T8103 firmware event stamps and their queue owners. */
+#ifndef _AGX_EVENT_SLOTS_H_
+#define _AGX_EVENT_SLOTS_H_
+
+#include <sys/types.h>
+#include <sys/mutex.h>
+
+#include "agx_fw.h"
+
+struct agx_heap;
+struct agx_object;
+
+/* Stamp arithmetic is valid while the outstanding distance is less than
+ * 2^23 increments.  The low eight bits are reserved by the firmware. */
+static inline uint32_t
+agx_event_value_next(uint32_t value)
+{
+	return value + 0x100;
+}
+
+static inline int32_t
+agx_event_value_delta(uint32_t a, uint32_t b)
+{
+	return (int32_t)(a - b) >> 8;
+}
+
+enum agx_event_error_kind {
+	AGX_EVENT_ERROR_UNKNOWN,
+	AGX_EVENT_ERROR_FAULT,
+	AGX_EVENT_ERROR_TIMEOUT,
+	AGX_EVENT_ERROR_CHANNEL,
+	AGX_EVENT_ERROR_KILLED,
+	AGX_EVENT_ERROR_NODEV
+};
+
+struct agx_event_error {
+	enum agx_event_error_kind kind;
+	uint32_t code, vm_slot;
+	uint64_t address;
+};
+/* Caller serializes each queue's aligned, coherent threshold.  Invoke exactly
+ * once per scheduled job, before publishing/kicking it, never on enqueue. */
+int agx_event_threshold_increase(uint64_t *, uint32_t);
+
+
+/* Generation identifies one allocation, including sticky reacquisitions. */
+struct agx_event_token { uint64_t generation; uint32_t slot; };
+
+/*
+ * ref/unref must be nonblocking and safe at IPL_TTY; ref is called with the
+ * manager mutex held.  Each registration and each callback owns a reference.
+ * Other callbacks run without that mutex and may run concurrently at interrupt
+ * level.  They must serialize with the queue and reject a token that matches
+ * neither an active guard nor its quarantined ownership.  They receive a
+ * snapshot of the shared stamp;
+ * concurrent callbacks may arrive out of stamp order, so queue retirement
+ * must never move its completed value backwards.  A deferred callback must
+ * copy its arguments and hold its own owner reference until it finishes.
+ * mark_error marks outstanding work through wait_value before retiring the
+ * captured stamp; ignore wait values at/before this allocation's initial
+ * stamp so stale errors cannot affect a new owner.
+ * fail_all retires remaining work only after GPU access has been stopped.
+ * The operations table must outlive the registration and all its callbacks.
+ */
+struct agx_event_owner_ops {
+	void (*ref)(void *);
+	void (*unref)(void *);
+	void (*signal)(void *, struct agx_event_token, uint32_t);
+	void (*mark_error)(void *, struct agx_event_token, uint32_t, uint32_t,
+	    const struct agx_event_error *);
+	void (*fail_all)(void *, struct agx_event_token, uint32_t,
+	    const struct agx_event_error *);
+	/* Process context: validate and pin the exact epoch, then enqueue its
+	 * error before firmware recovery. recover_put drops that pin. */
+	int (*recover)(void *, struct agx_event_token, uint32_t, uint32_t,
+	    uint32_t, const struct agx_event_error *, uint64_t *);
+	void (*recover_put)(void *);
+};
+
+struct agx_event_slot_entry {
+	const struct agx_event_owner_ops *ops;
+	void *owner;
+	uint64_t generation, drop_time;
+	int quarantined;
+};
+
+struct agx_event_slots {
+	struct mutex lock;
+	struct agx_object *stamps, *fw_stamps;
+	struct agx_event_slot_entry slots[AGX_EVENT_SLOTS];
+	uint64_t generation, drops;
+	unsigned int active, callbacks, reserved, waiters;
+	int closed, failed;
+};
+
+/* Private to one preparation; all remaining reservations must be returned. */
+struct agx_event_reservation {
+	struct agx_event_slots *manager;
+	unsigned int remaining;
+};
+
+struct agx_event_guard {
+	struct agx_event_slots *manager;
+	struct agx_event_token token;
+	uint64_t gpu_stamp, gpu_fw_stamp;
+	int changed;
+};
+
+struct agx_event_recovery {
+	const struct agx_event_owner_ops *ops;
+	void *owner;
+	struct agx_event_slots *manager;
+	uint64_t queue_va;
+};
+
+/* Both heaps must provide coherent CPU access; private stamp storage is
+ * nevertheless mapped GPU-private.  The heaps must outlive the manager. */
+int agx_event_slots_init(struct agx_event_slots *, struct agx_heap *,
+    struct agx_heap *);
+/* Stop firmware and externally quiesce callers before fini. EBUSY retains
+ * storage while guards, reservations, waiters or callbacks remain. */
+int agx_event_slots_fini(struct agx_event_slots *);
+/* Nonblocking all-or-none reservation; EBUSY means retry after wait, ENODEV
+ * means frozen. No slot or owner is acquired until get_reserved succeeds. */
+int agx_event_slots_reserve(struct agx_event_slots *, unsigned int,
+    struct agx_event_reservation *);
+void agx_event_slots_unreserve(struct agx_event_reservation *);
+/* Process context, without queue state locks or systqmp; cancel and stopped
+ * remain alive until return. The caller retries reservation after waking. */
+int agx_event_slots_wait(struct agx_event_slots *, unsigned int,
+    const int *, const int *);
+int agx_event_slot_get_reserved(struct agx_event_reservation *,
+    const struct agx_event_token *, const struct agx_event_owner_ops *,
+    void *, struct agx_event_guard *);
+/* Normal put requires no pending jobs or unretired firmware work.  The stamp
+ * remains monotonic across owners, and the new owner starts at current().
+ * A put after freeze quarantines the owner instead of recycling the slot. */
+int agx_event_slot_put(struct agx_event_guard *);
+/* Preserve the slot and owner for work whose GPU lifetime is unproven.  The
+ * owner must accept callbacks for this token until the stopped reap. */
+int agx_event_slot_quarantine(struct agx_event_guard *);
+/* After a proven global GPU/firmware stop, event/pending-stamp drain, and
+ * external callback quiescence, drop quarantined owners.  Requires fail_all
+ * to have closed the manager; never turns a slot into a live allocation. */
+int agx_event_slots_reap_stopped(struct agx_event_slots *);
+/* Caller serializes guard access and retains the guard while reading. */
+uint32_t agx_event_slot_current(const struct agx_event_guard *);
+void agx_event_slots_signal(struct agx_event_slots *, const uint32_t [4]);
+void agx_event_slots_mark_error(struct agx_event_slots *, uint32_t, uint32_t,
+    const struct agx_event_error *);
+/* Process context: pin the original slot generation and queue through end.
+ * Success enqueues the error; callers must serialize later firmware events. */
+int agx_event_recovery_begin(struct agx_event_slots *, uint32_t, uint32_t,
+    uint32_t, const struct agx_event_error *, struct agx_event_recovery *);
+void agx_event_recovery_end(struct agx_event_recovery *);
+/* Stop new allocations and normal event dispatch on crash without completing
+ * or releasing work.  Callbacks captured before freeze may still run; callers
+ * must quiesce them.  GPU/firmware may still access registered resources. */
+void agx_event_slots_freeze(struct agx_event_slots *);
+/* Process context only, after freeze: wait for captured callbacks and their
+ * owner refs.  Serialize against fail_all and drain owner task queues
+ * separately; this is not a GPU/firmware stop or DMA quiescence barrier. */
+int agx_event_slots_barrier(struct agx_event_slots *);
+/* Permanently closes allocation; caller must first stop firmware/GPU access. */
+void agx_event_slots_fail_all(struct agx_event_slots *,
+    const struct agx_event_error *);
+
+#endif
