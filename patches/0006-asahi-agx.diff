===================================================================
--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_workqueue.c	Sun Nov 15 22:17:58 2026
@@ -0,0 +1,248 @@
+/* SPDX-License-Identifier: MIT */
+/* Firmware workqueue barrier encoding for T8103. */
+#include <sys/types.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+
+#include "agx_queue.h"
+#include "agx_fw.h"
+
+void
+agx_workqueue_barrier(struct agx_fw_barrier *barrier, uint64_t stamp_va,
+    uint32_t wait_value, uint32_t wait_slot, uint32_t self_value)
+{
+	memset(barrier, 0, sizeof(*barrier));
+	barrier->tag = AGX_FW_CMD_BARRIER;
+	barrier->wait_stamp = stamp_va;
+	barrier->wait_value = wait_value;
+	barrier->wait_slot = wait_slot;
+	barrier->stamp_self = self_value;
+	barrier->uuid = 0xffffbbbb;
+	barrier->internal_barrier_type = 1;
+}
+
+void
+agx_render_barrier(struct agx_fw_barrier *barrier, uint64_t stamp_va,
+    uint32_t wait_value, uint32_t wait_slot, uint32_t self_value)
+{
+	agx_workqueue_barrier(barrier, stamp_va, wait_value, wait_slot, self_value);
+	barrier->uuid = 0;
+	barrier->internal_barrier_type = 0;
+}
+
+int
+agx_microseq_append(struct agx_microseq *seq, const void *operation,
+    size_t length, int32_t *offset)
+{
+	if (seq->size > seq->capacity || seq->size > INT32_MAX ||
+	    length > seq->capacity - seq->size ||
+	    length > INT32_MAX - seq->size)
+		return E2BIG;
+	*offset = seq->size;
+	memcpy(seq->bytes + seq->size, operation, length);
+	seq->size += length;
+	return 0;
+}
+
+int
+agx_microseq_branch(const struct agx_microseq *seq, int32_t target,
+    int32_t *offset)
+{
+	if (target < 0 || seq->size > INT32_MAX || (size_t)target > seq->size)
+		return EINVAL;
+	*offset = target - (int32_t)seq->size;
+	return 0;
+}
+
+void
+agx_wq_context_init(struct agx_fw_gpu_context_data *context)
+{
+	memset(context, 0, sizeof(*context));
+	context->unk_0 = 0xff;
+	context->unk_1 = 0xff;
+	context->unk_5 = 1;
+	context->unk_1e = 0xff;
+	context->unk_23 = 2;
+}
+
+int
+agx_wq_encode_info(void *dst, size_t size, unsigned int version,
+    const struct agx_wq_info_args *a)
+{
+	static const uint64_t masks[4] = {
+		0xffffffffffff0000ULL, 0xffffffff00000000ULL,
+		0xffff000000000000ULL, 0
+	};
+	struct agx_fw_priority priority;
+	size_t needed;
+
+	/* G14X 13.5 omits the two fields added to the G13 13.5 layout. */
+	if ((version == 12 && !a->g14x) || (version == 13 && a->g14x))
+		needed = sizeof(struct agx_fw_queue_info_12_3);
+	else if (version == 13)
+		needed = sizeof(struct agx_fw_queue_info_13_5);
+	else
+		return EINVAL;
+	if (size < needed || a->priority > 3 || a->pipe > AGX_FW_PIPE_COMPUTE ||
+	    a->state_va == 0 || a->ring_va == 0 || a->notifier_list_va == 0 ||
+	    a->gpu_buf_va == 0 || a->gpu_context_va == 0)
+		return EINVAL;
+	memset(&priority, 0, sizeof(priority));
+	priority.a = priority.b = a->priority;
+	priority.mask.value = masks[a->priority];
+	priority.c = a->priority == 0 ? 1 : 0;
+	priority.e = a->priority == 0 ? 1 : (a->priority == 1 ? 0 : a->priority);
+	/* Aurora enables compute preemption by default on T6021 (G14X). */
+	if (a->pipe == AGX_FW_PIPE_COMPUTE && !a->g14x) {
+		priority.a = 0;
+		priority.e = 1;
+	}
+	memset(dst, 0, needed);
+#define INFO(w) do { \
+	(w)->state = a->state_va; (w)->ring = a->ring_va; \
+	(w)->notifier_list = a->notifier_list_va; (w)->gpu_buf = a->gpu_buf_va; \
+	(w)->event_id = -1; (w)->priority = priority; (w)->unk_4c = -1; \
+	(w)->uuid = a->queue_id; (w)->unk_54 = -1; \
+	(w)->gpu_context = a->gpu_context_va; \
+} while (0)
+	if (version == 12 || a->g14x) {
+		struct agx_fw_queue_info_12_3 *info = dst;
+		INFO(info);
+	} else {
+		struct agx_fw_queue_info_13_5 *info = dst;
+		INFO(info);
+	}
+#undef INFO
+	return 0;
+}
+
+int
+agx_wq_init(struct agx_wq_ring *wq, struct agx_fw_ring_state *state,
+    uint64_t *ring, uint32_t size, uint64_t info_va, uint32_t pipe,
+    uint32_t priority)
+{
+	if (wq == NULL || state == NULL || ring == NULL || size < 2 ||
+	    size > UINT32_MAX / 2 || info_va == 0 ||
+	    pipe > AGX_FW_PIPE_COMPUTE || priority > 3)
+		return EINVAL;
+	memset(wq, 0, sizeof(*wq));
+	memset(state, 0, sizeof(*state));
+	memset(ring, 0, (size_t)size * sizeof(*ring));
+	state->rb_size = size;
+	wq->state = state;
+	wq->ring = ring;
+	wq->info_va = info_va;
+	wq->size = size;
+	wq->pipe = pipe;
+	wq->priority = priority;
+	wq->is_new = 1;
+	return 0;
+}
+
+int
+agx_wq_notify(struct agx_wq_ring *wq, struct agx_channel *channel,
+    struct rtkit_state *rtkit)
+{
+	struct agx_fw_run_workqueue_msg msg;
+	int error;
+
+	if (wq->needs_notify) {
+		if (channel == NULL || channel->message_size != sizeof(msg))
+			return EINVAL;
+		memset(&msg, 0, sizeof(msg));
+		msg.pipe_type = wq->pipe;
+		msg.work_queue = wq->info_va;
+		msg.wptr = wq->wptr;
+		msg.event_slot = wq->event_slot;
+		msg.is_new = wq->is_new;
+		error = agx_channel_put(channel, &msg, NULL);
+		if (error != 0)
+			return error;
+		wq->is_new = 0;
+		wq->needs_notify = 0;
+		wq->needs_kick = 1;
+	}
+	if (wq->needs_kick) {
+		error = agx_fw_kick_pipe(rtkit, wq->pipe, wq->priority);
+		if (error != 0)
+			return error;
+		wq->needs_kick = 0;
+	}
+	return 0;
+}
+
+int
+agx_wq_publish(struct agx_wq_ring *wq, const uint64_t *commands,
+    uint32_t count, uint32_t event_slot, int *committed)
+{
+	uint32_t i, wptr, done;
+
+	if (committed == NULL)
+		return EINVAL;
+	*committed = 0;
+	if (wq == NULL || commands == NULL || wq->size < 2 || count == 0 ||
+	    event_slot >= AGX_EVENT_SLOTS)
+		return EINVAL;
+	if (wq->needs_notify || wq->needs_kick ||
+	    (wq->pending != 0 && event_slot != wq->event_slot) ||
+	    count > wq->size - 1 - wq->pending)
+		return EBUSY;
+	for (i = 0; i < count; i++)
+		if (commands[i] == 0)
+			return EINVAL;
+	done = __atomic_load_n(&wq->state->gpu_doneptr, __ATOMIC_ACQUIRE);
+	if (done >= wq->size)
+		return EIO;
+	wptr = wq->wptr;
+	for (i = 0; i < count; i++) {
+		wptr = (wptr + 1) % wq->size;
+		if (wptr == done)
+			return EBUSY;
+	}
+	wptr = wq->wptr;
+	for (i = 0; i < count; i++) {
+		wq->ring[wptr] = commands[i];
+		wptr = (wptr + 1) % wq->size;
+	}
+	wq->wptr = wptr;
+	wq->pending += count;
+	wq->event_slot = event_slot;
+	wq->needs_notify = 1;
+	/* Committed objects remain live even if notification or kick fails. */
+	__asm volatile("dsb sy" ::: "memory");
+	__atomic_store_n(&wq->state->cpu_wptr, wptr, __ATOMIC_RELEASE);
+	*committed = 1;
+	return 0;
+}
+
+int
+agx_wq_submit(struct agx_wq_ring *wq, struct agx_channel *channel,
+    struct rtkit_state *rtkit, const uint64_t *commands, uint32_t count,
+    uint32_t event_slot, int *committed)
+{
+	int error;
+
+	if (committed == NULL)
+		return EINVAL;
+	*committed = 0;
+	if (channel == NULL || rtkit == NULL)
+		return EINVAL;
+	error = agx_wq_publish(wq, commands, count, event_slot, committed);
+	if (error != 0)
+		return error;
+	return agx_wq_notify(wq, channel, rtkit);
+}
+
+int
+agx_wq_retire(struct agx_wq_ring *wq, uint32_t count)
+{
+	if (count == 0 || count > wq->pending)
+		return EINVAL;
+	wq->freeptr = (wq->freeptr + count) % wq->size;
+	wq->pending -= count;
+	/* Debug field records the final completed entry, not the next slot. */
+	__atomic_store_n(&wq->state->cpu_freeptr,
+	    (wq->freeptr + wq->size - 1) % wq->size, __ATOMIC_RELEASE);
+	return 0;
+}
+
Index: sys/dev/pci/drm/asahi/aplagx.c
===================================================================
--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/aplagx.c	Mon Nov 16 16:36:30 2026
@@ -0,0 +1,227 @@
+/* SPDX-License-Identifier: MIT */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/atomic.h>
+#include <sys/device.h>
+
+#include <machine/bus.h>
+#include <machine/fdt.h>
+
+#include <dev/ofw/openfirm.h>
+#include <dev/ofw/fdt.h>
+#include <dev/ofw/ofw_clock.h>
+#include <dev/ofw/ofw_power.h>
+
+#include <drm/drm_drv.h>
+#include <drm/drm_ioctl.h>
+#include <uapi/drm/asahi_drm.h>
+
+#include "agx_device.h"
+#include "agx_fw.h"
+#include "agx_uat.h"
+
+#define AGX_ASC_SIZE	0x4000
+#define AGX_SGX_SIZE	0x1000000
+
+static const struct drm_ioctl_desc agx_ioctls[] = {
+	DRM_IOCTL_DEF_DRV(ASAHI_GET_PARAMS, agx_get_params_ioctl, DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GET_TIME, agx_get_time_ioctl, DRM_AUTH | DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_VM_CREATE, agx_vm_create_ioctl, DRM_AUTH | DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_VM_DESTROY, agx_vm_destroy_ioctl, DRM_AUTH | DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_VM_BIND, agx_vm_bind_ioctl, DRM_AUTH | DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GEM_CREATE, agx_gem_create_ioctl, DRM_AUTH | DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GEM_MMAP_OFFSET, agx_gem_mmap_offset_ioctl, DRM_AUTH | DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_GEM_BIND_OBJECT, agx_gem_bind_object_ioctl, DRM_AUTH | DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_QUEUE_CREATE, agx_queue_create_ioctl, DRM_AUTH | DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_QUEUE_DESTROY, agx_queue_destroy_ioctl, DRM_AUTH | DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(ASAHI_SUBMIT, agx_submit_ioctl, DRM_AUTH | DRM_RENDER_ALLOW),
+};
+
+static struct drm_driver agx_drm_driver = {
+	.driver_features = DRIVER_GEM | DRIVER_RENDER | DRIVER_SYNCOBJ |
+	    DRIVER_SYNCOBJ_TIMELINE | DRIVER_GEM_GPUVA,
+	.open = agx_file_open,
+	.postclose = agx_file_postclose,
+	.reject_private_mmap = true,
+	.gem_fault = agx_gem_fault,
+	.gem_prime_import_sg_table = agx_bo_import_sg_table,
+	.ioctls = agx_ioctls,
+	.num_ioctls = nitems(agx_ioctls),
+	.name = "asahi",
+	.desc = "Apple AGX Graphics",
+	.major = 0,
+	.minor = 2,
+	.patchlevel = 0,
+};
+
+int aplagx_match(struct device *, void *, void *);
+void aplagx_attach(struct device *, struct device *, void *);
+int aplagx_activate(struct device *, int);
+void aplagx_attachhook(struct device *);
+
+const struct cfattach aplagx_ca = {
+	sizeof(struct agx_softc), aplagx_match, aplagx_attach, NULL,
+	aplagx_activate
+};
+
+struct cfdriver aplagx_cd = {
+	NULL, "aplagx", DV_DULL
+};
+
+int
+aplagx_match(struct device *parent, void *match, void *aux)
+{
+	struct fdt_attach_args *faa = aux;
+
+	return OF_is_compatible(faa->fa_node, "apple,agx-t8103") ||
+	    OF_is_compatible(faa->fa_node, "apple,agx-t6021");
+}
+
+void
+aplagx_attach(struct device *parent, struct device *self, void *aux)
+{
+	struct agx_softc *sc = (struct agx_softc *)self;
+	struct fdt_attach_args *faa = aux;
+	int error;
+
+	error = agx_resources_map(faa, &sc->resources);
+	if (error != 0) {
+		printf(": unsupported firmware or resources (%d)\n", error);
+		return;
+	}
+	error = agx_power_load(faa->fa_node, &sc->power);
+	if (error != 0) {
+		printf(": invalid power data (%d)\n", error);
+		agx_resources_unmap(&sc->resources);
+		return;
+	}
+	power_domain_enable(faa->fa_node);
+	clock_enable_all(faa->fa_node);
+	reset_deassert_all(faa->fa_node);
+	error = agx_identity_read(&sc->resources, &sc->identity);
+	if (error != 0) {
+		printf(": invalid GPU identity (%d)\n", error);
+		reset_assert_all(faa->fa_node);
+		clock_disable_all(faa->fa_node);
+		power_domain_disable(faa->fa_node);
+		agx_power_fini(&sc->power);
+		agx_resources_unmap(&sc->resources);
+		return;
+	}
+	printf("\n");
+	sc->dev.faa = faa;
+	platform_device_register(&sc->dev);
+	/* platform_device_register copies the resources and FDT identity. */
+	sc->dev.faa = NULL;
+	config_mountroot(self, aplagx_attachhook);
+}
+
+void
+aplagx_attachhook(struct device *self)
+{
+	struct agx_softc *sc = (struct agx_softc *)self;
+	struct agx_runtime *runtime = NULL;
+	int error;
+
+	drm_attach_platform(&agx_drm_driver, sc->resources.iot,
+	    sc->resources.dmat, self, &sc->drm);
+	if (sc->drm.dev == NULL || sc->drm.dev_private != sc) {
+		printf("%s: DRM child not attached\n", self->dv_xname);
+		return;
+	}
+	error = agx_runtime_create(sc, &runtime);
+	if (error != 0) {
+		/* ASC may be running: retain power, mappings and firmware backing. */
+		sc->runtime = runtime;
+		printf("%s: GPU firmware startup failed (%d)\n", self->dv_xname,
+		    error);
+		return;
+	}
+	error = drm_dev_register(&sc->drm, 0);
+	if (error != 0) {
+		printf("%s: DRM registration failed (%d)\n", self->dv_xname,
+		    -error);
+		return;
+	}
+	membar_producer();
+	atomic_store_int(&sc->ready, 1);
+}
+
+int
+aplagx_activate(struct device *self, int act)
+{
+	struct agx_softc *sc = (struct agx_softc *)self;
+
+	/* Firmware and UAT state cannot yet be stopped and restored safely. */
+	if (act == DVACT_QUIESCE && sc->runtime != NULL) {
+		printf("%s: refusing suspend with active GPU firmware\n",
+		    self->dv_xname);
+		return EBUSY;
+	}
+	return config_activate_children(self, act);
+}
+
+/*
+ * Acquire the register mappings only. Firmware, power and DRM registration
+ * belong to the device lifecycle and must be established before publishing
+ * the device. Firmware compatibility is selected per GPU generation.
+ */
+int
+agx_resources_map(const struct fdt_attach_args *faa, struct agx_resources *res)
+{
+	uint32_t compat[3];
+	int asc, sgx, error, g14x;
+
+	if (faa == NULL || res == NULL)
+		return EINVAL;
+	memset(res, 0, sizeof(*res));
+	g14x = OF_is_compatible(faa->fa_node, "apple,agx-t6021");
+	if (!g14x && !OF_is_compatible(faa->fa_node, "apple,agx-t8103"))
+		return ENODEV;
+	if (OF_getproplen(faa->fa_node, "apple,firmware-compat") !=
+	    sizeof(compat) || OF_getpropintarray(faa->fa_node,
+	    "apple,firmware-compat", compat, sizeof(compat)) != sizeof(compat))
+		return EINVAL;
+	if (compat[2] != 0 ||
+	    !((compat[0] == 13 && compat[1] == 5) ||
+	    (!g14x && compat[0] == 12 && compat[1] == 3)))
+		return ENODEV;
+	asc = OF_getindex(faa->fa_node, "asc", "reg-names");
+	sgx = OF_getindex(faa->fa_node, "sgx", "reg-names");
+	if (asc < 0 || sgx < 0 || asc >= faa->fa_nreg || sgx >= faa->fa_nreg ||
+	    asc == sgx || faa->fa_reg[asc].size < AGX_ASC_SIZE ||
+	    faa->fa_reg[sgx].size < AGX_SGX_SIZE)
+		return EINVAL;
+
+	res->node = faa->fa_node;
+	res->iot = faa->fa_iot;
+	res->dmat = faa->fa_dmat;
+	res->uat_oas = agx_uat_oas_for_chip(g14x ? 0x6021 : 0x8103);
+	res->fw_major = compat[0];
+	res->fw_minor = compat[1];
+	res->asc_size = AGX_ASC_SIZE;
+	res->sgx_size = AGX_SGX_SIZE;
+	error = bus_space_map(res->iot, faa->fa_reg[asc].addr,
+	    res->asc_size, 0, &res->asc);
+	if (error)
+		goto fail;
+	error = bus_space_map(res->iot, faa->fa_reg[sgx].addr,
+	    res->sgx_size, 0, &res->sgx);
+	if (error) {
+		bus_space_unmap(res->iot, res->asc, res->asc_size);
+		goto fail;
+	}
+	return 0;
+fail:
+	memset(res, 0, sizeof(*res));
+	return error;
+}
+
+void
+agx_resources_unmap(struct agx_resources *res)
+{
+	bus_space_unmap(res->iot, res->sgx, res->sgx_size);
+	bus_space_unmap(res->iot, res->asc, res->asc_size);
+	memset(res, 0, sizeof(*res));
+}
