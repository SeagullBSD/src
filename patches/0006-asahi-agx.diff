+/* No scheduler-owned callback may use the shell after dropping its count. */
+static void
+agx_sched_drop(struct agx_sched *sched, int stop_done)
+{
+	rw_enter_write(&sched->lock);
+	if (stop_done)
+		sched->stop_done = 1;
+	if (atomic_dec_int_nv(&sched->outstanding) == 0 && sched->orphaned)
+		task_add(systqmp, &sched->reap_task);
+	rw_exit_write(&sched->lock);
+}
+
+static int
+agx_sched_bo_compare(const void *a, const void *b)
+{
+	uintptr_t x = (uintptr_t)*(struct agx_bo *const *)a;
+	uintptr_t y = (uintptr_t)*(struct agx_bo *const *)b;
+
+	return (x > y) - (x < y);
+}
+
+/* Summaries are made while the snapshot and extra BOs are pinned. An
+ * unprovable range, a non-native allocator, or a large fragmented working
+ * set falls back to the original device-wide foreign gate. */
+static int
+agx_sched_access_summarize(struct agx_sched_job *job)
+{
+	struct agx_access_range *range;
+	struct agx_bo *bo;
+	struct agx_mem *mem;
+	paddr_t pa;
+	uint64_t offset, step, pages;
+	size_t i, budget = AGX_ACCESS_MAX_PAGES;
+
+	if (job->nbo > AGX_ACCESS_MAX_BOS)
+		goto unknown;
+	if (job->nbo == 0)
+		return 0;
+	job->ranges = mallocarray(job->nbo, sizeof(*job->ranges), M_DEVBUF,
+	    M_NOWAIT | M_CANFAIL);
+	if (job->ranges == NULL)
+		goto unknown;
+	for (i = 0; i < job->nbo; i++) {
+		bo = job->bos[i];
+		mem = bo->mem;
+		range = &job->ranges[i];
+		if (bo->gem.resv == NULL || mem->size == 0 ||
+		    (mem->size & AGX_PAGE_MASK) != 0 ||
+		    (bo->import_sgt == NULL && !agx_mem_native_tag(mem->dmat)) ||
+		    (bo->import_sgt != NULL &&
+		    (bo->gem.dev->dmat == NULL ||
+		    !(bo->gem.dev->dmat->_flags & BUS_DMA_COHERENT) ||
+		    bo->gem.dev->dmat->_dmamap_sync != _dmamap_sync ||
+		    bo->import_sgt->dmamap == NULL ||
+		    bo->import_sgt->dmamap->_dm_nused != 0 ||
+		    bo->import_sgt->dmamap->dm_mapsize != mem->size)))
+			goto unknown;
+		range->resv = bo->gem.resv;
+		pages = mem->size >> AGX_PAGE_SHIFT;
+		/* A single native segment is physically contiguous. */
+		step = AGX_PAGE_SIZE;
+		if (mem->pages == NULL && mem->dma_pages == NULL &&
+		    mem->nsegs == 1 && pages > 1) {
+			step = mem->size - AGX_PAGE_SIZE;
+			pages = 2;
+		}
+		if (pages > budget)
+			goto unknown;
+		budget -= pages;
+		range->first = (paddr_t)-1;
+		range->last = 0;
+		for (offset = 0; offset < mem->size; offset += step) {
+			if (agx_mem_phys(mem, offset, &pa) != 0 ||
+			    (pa & AGX_PAGE_MASK) != 0)
+				goto unknown;
+			if (pa < range->first)
+				range->first = pa;
+			if (pa > range->last)
+				range->last = pa;
+		}
+	}
+	return 0;
+unknown:
+	return 1;
+}
+
+static int
+agx_sched_access_conflicts(const struct agx_sched_job *a,
+    const struct agx_sched_job *b)
+{
+	size_t i, j;
+
+	if (!a->has_foreign && !b->has_foreign)
+		return 0;
+	if (a->access_unknown || b->access_unknown)
+		return 1;
+	for (i = 0; i < a->nbo; i++) {
+		for (j = 0; j < b->nbo; j++) {
+			if (a->ranges[i].resv == b->ranges[j].resv ||
+			    (a->ranges[i].first <= b->ranges[j].last &&
+			    b->ranges[j].first <= a->ranges[i].last))
+				return 1;
+		}
+	}
+	return 0;
+}
+
+/* Caller holds parallel_lock. Both waiting and active jobs are linked. */
+static void
+agx_sched_access_remove(struct agx_runtime *runtime, struct agx_sched_job *job)
+{
+	struct agx_sched_job *cur, *prev = NULL;
+
+	for (cur = runtime->parallel_head; cur != job; cur = cur->access_next) {
+		KASSERT(cur != NULL);
+		prev = cur;
+	}
+	if (prev == NULL)
+		runtime->parallel_head = job->access_next;
+	else
+		prev->access_next = job->access_next;
+	if (runtime->parallel_tail == job)
+		runtime->parallel_tail = prev;
+	if (job->has_foreign) {
+		KASSERT(runtime->parallel_foreign != 0);
+		runtime->parallel_foreign--;
+	}
+	job->access_next = NULL;
+	wakeup(&runtime->parallel_lock);
+}
+
+static int
+agx_sched_access_enter(struct agx_sched_job *job)
+{
+	struct agx_runtime *runtime = job->sched->runtime;
+	struct agx_sched_job *cur;
+	int error = 0, summarize, unknown;
+
+	mtx_enter(&runtime->parallel_lock);
+	summarize = job->has_foreign || runtime->parallel_foreign != 0;
+	if (job->has_foreign) {
+		if (runtime->parallel_foreign == UINT_MAX) {
+			mtx_leave(&runtime->parallel_lock);
+			return EOVERFLOW;
+		}
+		runtime->parallel_foreign++;
+	}
+	/* Unsummarized native jobs may overlap one another. A later foreign
+	 * job must conservatively wait for them before accessing any BO. */
+	job->access_unknown = 1;
+	if (runtime->parallel_tail == NULL)
+		runtime->parallel_head = job;
+	else
+		runtime->parallel_tail->access_next = job;
+	runtime->parallel_tail = job;
+	if (summarize) {
+		/* Publish the unknown state first: successors cannot pass this
+		 * job until the completed summary is installed under the lock. */
+		mtx_leave(&runtime->parallel_lock);
+		unknown = agx_sched_access_summarize(job);
+		mtx_enter(&runtime->parallel_lock);
+		job->access_unknown = unknown;
+		wakeup(&runtime->parallel_lock);
+	}
+	for (;;) {
+		error = __atomic_load_n(&job->error, __ATOMIC_ACQUIRE);
+		if (error != 0)
+			break;
+		if (__atomic_load_n(&job->sched->stopped, __ATOMIC_ACQUIRE) ||
+		    agx_fw_is_crashed(runtime)) {
+			error = ENODEV;
+			break;
+		}
+		if (runtime->parallel_foreign == 0) {
+			job->access_mode = 1;
+			break;
+		}
+		/* Conflicting predecessors include waiters, preventing starvation;
+		 * disjoint successors may proceed without bypassing a conflict. */
+		for (cur = runtime->parallel_head; cur != job;
+		    cur = cur->access_next) {
+			KASSERT(cur != NULL);
+			if (agx_sched_access_conflicts(cur, job))
+				break;
+		}
+		if (cur == job) {
+			job->access_mode = 1;
+			break;
+		}
+		(void)msleep_nsec(&runtime->parallel_lock, &runtime->parallel_lock,
+		    PWAIT, "agxaccess", MSEC_TO_NSEC(100));
+	}
+	if (error != 0)
+		agx_sched_access_remove(runtime, job);
+	mtx_leave(&runtime->parallel_lock);
+	return error;
+}
+
+static void
+agx_sched_access_leave(struct agx_sched_job *job)
+{
+	struct agx_runtime *runtime = job->sched->runtime;
+
+	if (job->access_mode == 0)
+		return;
+	mtx_enter(&runtime->parallel_lock);
+	agx_sched_access_remove(runtime, job);
+	job->access_mode = 0;
+	mtx_leave(&runtime->parallel_lock);
+}
+
+static const char *
+agx_sched_fence_driver(struct dma_fence *fence)
+{
+	return "asahi";
+}
+
+static const char *
+agx_sched_fence_timeline(struct dma_fence *fence)
+{
+	return "asahi hardware";
+}
+
+static const struct dma_fence_ops agx_sched_fence_ops = {
+	.get_driver_name = agx_sched_fence_driver,
+	.get_timeline_name = agx_sched_fence_timeline,
+};
+
+static struct dma_fence *
+agx_sched_fence_create(void)
+{
+	struct agx_sched_fence *fence;
+
+	fence = malloc(sizeof(*fence), M_DRM, M_WAITOK | M_CANFAIL | M_ZERO);
+	if (fence == NULL)
+		return NULL;
+	mtx_init(&fence->lock, IPL_TTY);
+	dma_fence_init64(&fence->base, &agx_sched_fence_ops, &fence->lock,
+	    dma_fence_context_alloc(1), 1);
+	return &fence->base;
+}
+
+/* The proxy does not retain a scheduler pointer after source completion. */
+static void
+agx_completion_signal(struct dma_fence *source, struct dma_fence_cb *cb)
+{
+	struct agx_completion_fence *fence = container_of(cb,
+	    struct agx_completion_fence, callback);
+
+	if (source->error != 0)
+		dma_fence_set_error(&fence->base, source->error);
+	dma_fence_signal(&fence->base);
+	fence->source = NULL;
+	dma_fence_put(source);
+	dma_fence_put(&fence->base);
+}
+
+static struct agx_completion_fence *
+agx_completion_create(void)
+{
+	struct agx_completion_fence *fence;
+
+	fence = malloc(sizeof(*fence), M_DRM, M_WAITOK | M_CANFAIL | M_ZERO);
+	if (fence == NULL)
+		return NULL;
+	mtx_init(&fence->lock, IPL_TTY);
+	dma_fence_init64(&fence->base, &agx_sched_fence_ops, &fence->lock,
+	    dma_fence_context_alloc(1), 1);
+	return fence;
+}
+
+/* User UAT mappings use the GPU shared/coherent attributes. Native system
+ * memory therefore needs ordering, not CPU cache invalidation. Imported BOs
+ * additionally need their exporter's foreign-DMA ownership transitions.
+ * Hold one shared cache-transition mutex, never the reservation ww lock, and
+ * do not hold it across dependency waits, callbacks or fence signaling. */
+static int
+agx_sched_bo_sync(struct agx_bo *bo, int ops)
+{
+	struct sg_table *sgt = bo->import_sgt;
+	int error;
+
+	if (sgt == NULL) {
+		agx_tlbi_sync();
+		return 0;
+	}
+	if (sgt->dmamap == NULL || sgt->dmamap->_dm_nused != 0 ||
+	    sgt->dmamap->dm_mapsize < bo->gem.size ||
+	    bo->gem.import_attach == NULL)
+		return EINVAL;
+	dma_resv_cache_lock(bo->gem.resv);
+	if (ops & BUS_DMASYNC_POSTREAD) {
+		/* A normal POSTREAD discards dirty lines of unrelated VM BOs. */
+		error = dma_buf_cache_postread_preserve(
+		    bo->gem.import_attach->dmabuf, 0, bo->gem.size);
+		if (error < 0)
+			error = -error;
+	} else {
+		bus_dmamap_sync(bo->gem.dev->dmat, sgt->dmamap, 0,
+		    sgt->dmamap->dm_mapsize, ops);
+		error = 0;
+	}
+	dma_resv_cache_unlock(bo->gem.resv);
+	return error;
+}
+
+/* Adjacent native BOs need the same system-wide ordering barrier. Do not
+ * move barriers across imported transitions, and advance progress only
+ * after the corresponding transition succeeds. */
+static int
+agx_sched_sync_bos(struct agx_sched_job *job, size_t *progress, size_t limit,
+    int ops)
+{
+	struct agx_bo *bo;
+	int error, native_run = 0;
+
+	while (*progress < limit) {
+		bo = job->bos[*progress];
+		if (bo->import_sgt != NULL || !native_run) {
+			error = agx_sched_bo_sync(bo, ops);
+			if (error != 0)
+				return error;
+		}
+		native_run = bo->import_sgt == NULL;
+		(*progress)++;
+	}
+	return 0;
+}
+
+/* Queue retirement may arrive at interrupt level. */
+static void
+agx_sched_complete(void *cookie, int error)
+{
+	struct agx_sched_job *job = cookie;
+	unsigned int state;
+	int expected = 0;
+
+	if (error != 0)
+		__atomic_compare_exchange_n(&job->error, &expected,
+		    error > 0 ? error : -error, 0, __ATOMIC_ACQ_REL,
+		    __ATOMIC_ACQUIRE);
+	state = __atomic_fetch_or(&job->finish_state, AGX_SCHED_FINISH_QUEUED,
+	    __ATOMIC_ACQ_REL);
+	if (!(state & AGX_SCHED_FINISH_QUEUED) &&
+	    (!(state & AGX_SCHED_TIMEOUT_CLAIMED) ||
+	    (state & AGX_SCHED_TIMEOUT_DONE)))
+		schedule_work(&job->finish_work.work);
+}
+
+static void
+agx_sched_finish(struct work_struct *work)
+{
+	struct agx_sched_job *job = container_of(to_delayed_work(work),
+	    struct agx_sched_job, finish_work);
+	struct agx_sched *sched = job->sched;
+	struct dma_fence *fence;
+	int error, e, expected;
+
+	e = agx_sched_sync_bos(job, &job->posted, job->synced,
+	    BUS_DMASYNC_POSTREAD | BUS_DMASYNC_POSTWRITE);
+	if (e != 0) {
+		/* Keep the binding, backing and fence until cache ownership
+		 * can actually be transferred. Retry in process context. */
+		expected = 0;
+		__atomic_compare_exchange_n(&job->error, &expected, e, 0,
+		    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+		if (!job->cache_failed) {
+			job->cache_failed = 1;
+			agx_queue_job_timeout(job->queue_job);
+		}
+		schedule_delayed_work(&job->finish_work,
+		    MAX(1, msecs_to_jiffies(100)));
+		return;
+	}
+	/* A skipped reserved stamp must not become a barrier target of later
+	 * jobs. Close that hole before the error fence can wake the scheduler. */
+	if (__atomic_load_n(&job->submitted, __ATOMIC_ACQUIRE) == 0) {
+		error = __atomic_load_n(&job->error, __ATOMIC_ACQUIRE);
+		if (error != 0)
+			agx_queue_job_abort(job->queue_job, error);
+	}
+	/* Failed unpublished reservations are cancelled before admitting work. */
+	agx_sched_access_leave(job);
+	if (job->bound) {
+		e = agx_gpu_context_unbind(job->context);
+		if (e != 0) {
+			expected = 0;
+			__atomic_compare_exchange_n(&job->error, &expected, e, 0,
+			    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+			/* Unbind poisons the context permanently. Retain the job and
+			 * its backing rather than signaling or repeatedly retrying. */
+			return;
+		}
+		job->bound = 0;
+	}
+	if (job->op_active) {
+		agx_fw_end_op(sched->runtime);
+		job->op_active = 0;
+	}
+	error = __atomic_load_n(&job->error, __ATOMIC_ACQUIRE);
+	fence = dma_fence_get(job->fence);
+	if (error != 0)
+		dma_fence_set_error(fence, -error);
+	/* free_job may run before the fence callback returns. Keep scheduler
+	 * teardown excluded until dma_fence_signal has finished all callbacks. */
+	atomic_inc_int(&sched->outstanding);
+	/* taskq copies the task before invocation; the scheduler may free job
+	 * during signaling, so keep a separate fence reference and do not touch
+	 * job or work after this point. */
+	dma_fence_signal(fence);
+	dma_fence_put(fence);
+	membar_producer();
+	agx_sched_drop(sched, 0);
+}
+
+static int
+agx_sched_collect_bos(struct agx_sched_job *job,
+    struct agx_vm_snapshot *snapshot, struct drm_gem_object *const *extra,
+    size_t nextra)
+{
+	size_t i, j, capacity;
+	struct agx_bo *bo;
+	int sorted = 1;
+
+	if (snapshot->count > SIZE_MAX - nextra ||
+	    snapshot->count + nextra > SIZE_MAX - nextra ||
+	    snapshot->count + nextra + nextra > MALLOC_MAX / sizeof(*job->bos))
+		return EOVERFLOW;
+	capacity = snapshot->count + nextra;
+	job->bo_capacity = capacity + nextra;
+	if (job->bo_capacity != 0) {
+		job->bos = mallocarray(job->bo_capacity, sizeof(*job->bos), M_DEVBUF,
+		    M_WAITOK | M_CANFAIL);
+		if (job->bos == NULL)
+			return ENOMEM;
+	}
+	for (i = 0; i < snapshot->count; i++) {
+		bo = agx_bo_from_gem(snapshot->entries[i].gem);
+		if (bo == NULL || bo->mem == NULL || bo->mem != snapshot->entries[i].mem)
+			return EINVAL;
+		job->bos[i] = bo;
+	}
+	for (i = 0; i < nextra; i++) {
+		bo = agx_bo_from_gem(extra[i]);
+		if (bo == NULL || bo->mem == NULL)
+			return EINVAL;
+		job->bos[snapshot->count + i] = bo;
+	}
+	/* The immutable snapshot retains its own references and pins. Extra
+	 * timestamp BOs are retained separately, including duplicates. */
+	for (i = 0; i < nextra; i++) {
+		bo = job->bos[snapshot->count + i];
+		agx_mem_pin_ref(bo->mem);
+		drm_gem_object_get(&bo->gem);
+		job->bos[capacity + i] = bo;
+	}
+	job->nextra = nextra;
+	for (i = 1; i < capacity; i++) {
+		if ((uintptr_t)job->bos[i - 1] > (uintptr_t)job->bos[i]) {
+			sorted = 0;
+			break;
+		}
+	}
+	/* The VM snapshot is BO-ordered. A single timestamp BO is common;
+	 * insert it rather than sorting the entire VM again. Validate the
+	 * prefix first because other snapshot producers need not be ordered. */
+	if (!sorted && nextra == 1) {
+		sorted = 1;
+		for (i = 1; i < snapshot->count; i++) {
+			if ((uintptr_t)job->bos[i - 1] > (uintptr_t)job->bos[i]) {
+				sorted = 0;
+				break;
+			}
+		}
+		if (sorted) {
+			bo = job->bos[snapshot->count];
+			j = snapshot->count;
+			while (j != 0 && (uintptr_t)job->bos[j - 1] >
+			    (uintptr_t)bo) {
+				job->bos[j] = job->bos[j - 1];
+				j--;
+			}
+			job->bos[j] = bo;
+		}
+	}
+	if (!sorted)
+		sort(job->bos, capacity, sizeof(*job->bos), agx_sched_bo_compare, NULL);
+	for (i = 0; i < capacity; i++) {
+		if (job->nbo != 0 && job->bos[i] == job->bos[job->nbo - 1])
+			continue;
+		job->bos[job->nbo++] = job->bos[i];
+		if (!job->has_foreign && job->bos[i]->import_sgt != NULL)
+			job->has_foreign = 1;
+	}
+	job->snapshot = *snapshot;
+	memset(snapshot, 0, sizeof(*snapshot));
+	return 0;
+}
+
+static void
+agx_sched_execute(void *cookie)
+{
+	struct agx_sched_job *job = cookie;
+	struct agx_queue_job *queue_job = NULL;
+	struct agx_vm_snapshot snapshot;
+	struct drm_gem_object *const *extra = NULL;
+	size_t nextra = 0;
+	int status, error;
+	size_t i;
+	if (__atomic_load_n(&job->finish_state, __ATOMIC_SEQ_CST) &
+	    AGX_SCHED_TIMEOUT_CLAIMED) {
+		agx_sched_complete(job, ETIMEDOUT);
+		return;
+	}
+
+	if (__atomic_load_n(&job->sched->stopped, __ATOMIC_ACQUIRE)) {
+		agx_sched_complete(job, ECANCELED);
+		return;
+	}
+	/* Check the original fences too: drm_sched may coalesce dependencies. */
+	for (i = 0; i < job->ninputs; i++) {
+		status = dma_fence_get_status(job->inputs[i]);
+		if (status <= 0) {
+			agx_sched_complete(job, status < 0 ? -status : EIO);
+			return;
+		}
+	}
+	if (!job->op_active) {
+		error = agx_fw_start_op(job->sched->runtime);
+		if (error != 0) {
+			agx_sched_complete(job, error);
+			return;
+		}
+		job->op_active = 1;
+	}
+	memset(&snapshot, 0, sizeof(snapshot));
+	error = job->prepare(job->cookie, &queue_job, &snapshot, &extra,
+	    &nextra, &job->bound, &job->error, &job->sched->stopped);
+	__atomic_store_n(&job->queue_job, queue_job, __ATOMIC_SEQ_CST);
+	if (queue_job != NULL)
+		job->cookie = NULL;
+	/* Pair with the timeout's claim-before-pointer-load.  At least one
+	 * side must observe the other before firmware publication. */
+	if (error == 0 && (__atomic_load_n(&job->finish_state, __ATOMIC_SEQ_CST) &
+	    AGX_SCHED_TIMEOUT_CLAIMED))
+		error = ETIMEDOUT;
+	if (error == 0)
+		error = agx_sched_collect_bos(job, &snapshot, extra, nextra);
+	agx_vm_snapshot_fini(&snapshot);
+	if (error == 0)
+		error = __atomic_load_n(&job->error, __ATOMIC_ACQUIRE);
+	if (error != 0) {
+		agx_queue_job_abort(queue_job, error);
+		agx_sched_complete(job, error);
+		return;
+	}
+	error = agx_sched_access_enter(job);
+	if (error == 0 && (__atomic_load_n(&job->sched->stopped, __ATOMIC_ACQUIRE) ||
+	    agx_fw_is_crashed(job->sched->runtime)))
+		error = ENODEV;
+	if (error == 0)
+		error = __atomic_load_n(&job->error, __ATOMIC_ACQUIRE);
+	if (error != 0) {
+		agx_queue_job_abort(queue_job, error);
+		agx_sched_complete(job, error);
+		return;
+	}
+	error = agx_sched_sync_bos(job, &job->synced, job->nbo,
+	    BUS_DMASYNC_PREWRITE | BUS_DMASYNC_PREREAD);
+	if (error != 0) {
+		agx_queue_job_abort(queue_job, error);
+		agx_sched_complete(job, error);
+		return;
+	}
+	/* This is the first point at which firmware may see this job. */
+	__atomic_store_n(&job->submitted, 1, __ATOMIC_RELEASE);
+	error = agx_queue_job_submit(job->queue_job, agx_sched_complete, job);
+	if (error != 0) {
+		__atomic_store_n(&job->submitted, 0, __ATOMIC_RELEASE);
+		agx_queue_job_abort(queue_job, error);
+		agx_sched_complete(job, error);
+	}
+	return;
+}
+
+static struct dma_fence *
+agx_sched_run(struct drm_sched_job *base)
+{
+	struct agx_sched_job *job = container_of(base, struct agx_sched_job, base);
+	struct dma_fence *fence = dma_fence_get(job->fence);
+
+	task_add(job->sched->prepare_tasks, &job->prepare_task);
+	return fence;
+}
+
+static enum drm_gpu_sched_stat
+agx_sched_timeout(struct drm_sched_job *base)
+{
+	struct agx_sched_job *job = container_of(base, struct agx_sched_job, base);
+	struct agx_queue_job *queue_job;
+	unsigned int state, desired;
+	int expected = 0;
+
+	state = __atomic_load_n(&job->finish_state, __ATOMIC_SEQ_CST);
+	for (;;) {
+		if (state & (AGX_SCHED_FINISH_QUEUED | AGX_SCHED_TIMEOUT_CLAIMED))
+			return DRM_GPU_SCHED_STAT_NO_HANG;
+		desired = state | AGX_SCHED_TIMEOUT_CLAIMED;
+		if (__atomic_compare_exchange_n(&job->finish_state, &state, desired,
+		    0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
+			break;
+	}
+	queue_job = __atomic_load_n(&job->queue_job, __ATOMIC_SEQ_CST);
+	if (queue_job == NULL || agx_queue_job_timeout_pending(queue_job))
+		__atomic_compare_exchange_n(&job->error, &expected, ETIMEDOUT, 0,
+		    __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+	/* A completion racing the timeout waits until containment is decided. */
+	state = __atomic_fetch_or(&job->finish_state, AGX_SCHED_TIMEOUT_DONE,
+	    __ATOMIC_ACQ_REL);
+	if (state & AGX_SCHED_FINISH_QUEUED)
+		schedule_work(&job->finish_work.work);
+	/* NO_HANG reinserts the job; ENODEV would lose it from pending_list.
+	 * Never signal while firmware might still access its backing. */
+	return DRM_GPU_SCHED_STAT_NO_HANG;
+}
+
+static void
+agx_sched_free_job(struct drm_sched_job *base)
+{
+	struct agx_sched_job *job = container_of(base, struct agx_sched_job, base);
+	struct agx_sched *sched = job->sched;
+	size_t i;
+
+	drm_sched_job_cleanup(base);
+	agx_queue_job_put(job->queue_job);
+	if (job->cookie != NULL)
+		job->release(job->cookie);
+	for (i = 0; i < job->nextra; i++) {
+		struct agx_bo *bo = job->bos[job->bo_capacity - job->nextra + i];
+
+		agx_mem_unpin(bo->mem);
+		drm_gem_object_put(&bo->gem);
+	}
+	agx_vm_snapshot_fini(&job->snapshot);
+	for (i = 0; i < job->nshared; i++)
+		drm_gem_object_put(job->shared_gems[i]);
+	free(job->shared_gems, M_DEVBUF, job->nshared * sizeof(*job->shared_gems));
+	for (i = 0; i < job->ninputs; i++)
+		dma_fence_put(job->inputs[i]);
+	free(job->ranges, M_DEVBUF, job->nbo * sizeof(*job->ranges));
+	free(job->bos, M_DEVBUF, job->bo_capacity * sizeof(*job->bos));
+	free(job->inputs, M_DEVBUF, job->ninputs * sizeof(*job->inputs));
+	dma_fence_put(job->fence);
+	free(job, M_DEVBUF, sizeof(*job));
+	agx_sched_drop(sched, 0);
+}
+
+/* The scheduler has detached the job and excludes run_job here. */
+static void
+agx_sched_cancel_queued(struct drm_sched_job *base)
+{
+	struct agx_sched_job *job = container_of(base, struct agx_sched_job, base);
+	size_t i;
+
+	if (job->op_active) {
+		agx_fw_end_op(job->sched->runtime);
+		job->op_active = 0;
+	}
+	job->context = NULL;
+
+	if (job->queue_job != NULL) {
+		agx_queue_job_abort(job->queue_job, ECANCELED);
+		agx_queue_job_put(job->queue_job);
+		job->queue_job = NULL;
+	}
+	if (job->cookie != NULL) {
+		job->release(job->cookie);
+		job->cookie = NULL;
+	}
+	for (i = 0; i < job->ninputs; i++)
+		dma_fence_put(job->inputs[i]);
+	free(job->inputs, M_DEVBUF, job->ninputs * sizeof(*job->inputs));
+	job->inputs = NULL;
+	job->ninputs = 0;
+	dma_fence_put(job->fence);
+	job->fence = NULL;
+}
+
+static const struct drm_sched_backend_ops agx_sched_ops = {
+	.run_job = agx_sched_run,
+	.timedout_job = agx_sched_timeout,
+	.cancel_queued = agx_sched_cancel_queued,
+	.free_job = agx_sched_free_job,
+};
+
+static void
+agx_sched_stop_task(void *cookie)
+{
+	struct agx_sched *sched = cookie;
+
+	drm_sched_entity_stop_queued(&sched->entity);
+	agx_sched_drop(sched, 1);
+}
+
+int
+agx_sched_create(struct device *dev, long timeout, struct agx_sched **out)
+{
+	struct drm_sched_init_args args;
+	struct agx_sched *sched;
+	int error;
+
+	if (dev == NULL || out == NULL || timeout <= 0)
+		return EINVAL;
+	*out = NULL;
+	sched = malloc(sizeof(*sched), M_DEVBUF, M_WAITOK | M_ZERO);
+	sched->runtime = container_of(to_platform_device(dev),
+	    struct agx_softc, dev)->runtime;
+	if (sched->runtime == NULL) {
+		free(sched, M_DEVBUF, sizeof(*sched));
+		return ENXIO;
+	}
+	rw_init(&sched->lock, "agxsch");
+	sched->prepare_tasks = taskq_create("agxprep", 1, IPL_TTY, 0);
+	if (sched->prepare_tasks == NULL) {
+		free(sched, M_DEVBUF, sizeof(*sched));
+		return ENOMEM;
+	}
+	sched->stop_tasks = taskq_create("agxstop", 1, IPL_TTY, 0);
+	if (sched->stop_tasks == NULL) {
+		taskq_destroy(sched->prepare_tasks);
+		free(sched, M_DEVBUF, sizeof(*sched));
+		return ENOMEM;
+	}
+	task_set(&sched->stop_task, agx_sched_stop_task, sched);
+	task_set(&sched->reap_task, agx_sched_reap, sched);
+	memset(&args, 0, sizeof(args));
+	args.ops = &agx_sched_ops;
+	args.num_rqs = DRM_SCHED_PRIORITY_COUNT;
+	/* Firmware rings and completion fences support independent jobs. */
+	args.credit_limit = 8;
+	args.independent_finished_fences = true;
+	args.timeout = timeout;
+	args.name = "asahi";
+	args.dev = dev;
+	error = drm_sched_init(&sched->sched, &args);
+	if (error != 0) {
+		taskq_destroy(sched->stop_tasks);
+		taskq_destroy(sched->prepare_tasks);
+		free(sched, M_DEVBUF, sizeof(*sched));
+		return -error;
+	}
+	sched->sched_list[0] = &sched->sched;
+	error = drm_sched_entity_init(&sched->entity, DRM_SCHED_PRIORITY_NORMAL,
+	    sched->sched_list, 1, NULL);
+	if (error != 0) {
+		taskq_destroy(sched->stop_tasks);
+		taskq_destroy(sched->prepare_tasks);
+		drm_sched_fini(&sched->sched);
+		free(sched, M_DEVBUF, sizeof(*sched));
+		return -error;
+	}
+	*out = sched;
+	return 0;
+}
+
+int
+agx_sched_destroy(struct agx_sched *sched)
+{
+	if (sched == NULL)
+		return EINVAL;
+	rw_enter_write(&sched->lock);
+	if (__atomic_load_n(&sched->outstanding, __ATOMIC_ACQUIRE) != 0) {
+		rw_exit_write(&sched->lock);
+		return EBUSY;
+	}
+	/* Drain timeout and submission workers before destroying their entity. */
+	drm_sched_quiesce(&sched->sched);
+	drm_sched_entity_destroy(&sched->entity);
+	drm_sched_fini(&sched->sched);
+	if (sched->prepare_tasks != NULL)
+		taskq_destroy(sched->prepare_tasks);
+	if (sched->stop_tasks != NULL)
+		taskq_destroy(sched->stop_tasks);
+	rw_exit_write(&sched->lock);
+	free(sched, M_DEVBUF, sizeof(*sched));
+	return 0;
+}
+
+/* Called after the owner has no running job references. Detached scheduler
+ * jobs may still wait for fences, but no longer hold AGX objects. */
+int
+agx_sched_orphan(struct agx_sched *sched)
+{
+	struct taskq *prepare_tasks, *stop_tasks;
+
+	if (sched == NULL)
+		return EINVAL;
+	rw_enter_write(&sched->lock);
+	if (sched->stopped && !sched->stop_done) {
+		rw_exit_write(&sched->lock);
+		return EBUSY;
+	}
+	if (__atomic_load_n(&sched->outstanding, __ATOMIC_ACQUIRE) == 0) {
+		rw_exit_write(&sched->lock);
+		return agx_sched_destroy(sched);
+	}
+	if (!sched->stopped) {
+		rw_exit_write(&sched->lock);
+		return EBUSY;
+	}
+	/* Pin the shell until these two queues have fully drained. */
+	atomic_inc_int(&sched->outstanding);
+	prepare_tasks = sched->prepare_tasks;
+	stop_tasks = sched->stop_tasks;
+	sched->prepare_tasks = NULL;
+	sched->stop_tasks = NULL;
+	sched->orphaned = 1;
+	rw_exit_write(&sched->lock);
+	taskq_destroy(prepare_tasks);
+	taskq_destroy(stop_tasks);
+	agx_sched_drop(sched, 0);
+	return 0;
+}
+
+void
+agx_sched_stop_queued(struct agx_sched *sched)
+{
+	if (sched == NULL)
+		return;
+	rw_enter_write(&sched->lock);
+	if (!sched->stopped) {
+		__atomic_store_n(&sched->stopped, 1, __ATOMIC_RELEASE);
+		atomic_inc_int(&sched->outstanding);
+		task_add(sched->stop_tasks, &sched->stop_task);
+	}
+	rw_exit_write(&sched->lock);
+}
+
+int
+agx_sched_submit(struct agx_sched *sched, struct agx_gpu_context *context,
+    void *cookie, int (*prepare)(void *, struct agx_queue_job **,
+    struct agx_vm_snapshot *, struct drm_gem_object *const **, size_t *, int *,
+    const int *, const int *),
+    void (*release)(void *), struct agx_sync *syncs, size_t ninputs,
+    size_t noutputs, uint64_t client_id, struct agx_file_queue *queue)
+{
+	struct agx_sched_job *job;
+	struct agx_completion_fence *completion = NULL;
+	struct drm_syncobj_publish *pub = NULL;
+	struct dma_resv_batch *batch = NULL;
+	struct dma_resv **resvs = NULL;
+	size_t i, nshared = 0, nexplicit = 0, ndeps, nrecords = 0;
+	int error, base_initialized = 0, armed = 0, callback_owned = 0;
+	int callback_attached = 0, queue_locked = 0;
+
+	if (sched == NULL || context == NULL || cookie == NULL || prepare == NULL ||
+	    release == NULL || ((ninputs != 0 || noutputs != 0) && syncs == NULL) ||
+	    ninputs > SIZE_MAX - noutputs || ninputs > UINT_MAX ||
+	    ninputs > MALLOC_MAX / sizeof(*resvs) ||
+	    noutputs > MALLOC_MAX / sizeof(*pub))
+		return EINVAL;
+	for (i = 0; i < ninputs; i++) {
+		if (syncs[i].is_output ||
+		    ((syncs[i].gem == NULL) == (syncs[i].dependency == NULL)))
+			return EINVAL;
+		if (syncs[i].gem != NULL) {
+			if (syncs[i].gem->resv == NULL)
+				return EINVAL;
+			nshared++;
+		} else
+			nexplicit++;
+	}
+	if ((nshared != 0) != (queue != NULL))
+		return EINVAL;
+	for (i = ninputs; i < ninputs + noutputs; i++)
+		if (!syncs[i].is_output || syncs[i].object == NULL ||
+		    syncs[i].gem != NULL)
+			return EINVAL;
+	if (agx_fw_is_crashed(sched->runtime))
+		return ENXIO;
+	job = malloc(sizeof(*job), M_DEVBUF, M_WAITOK | M_CANFAIL | M_ZERO);
+	if (job == NULL)
+		return ENOMEM;
+	job->sched = sched;
+	job->context = context;
+	job->cookie = cookie;
+	job->prepare = prepare;
+	job->release = release;
+	if (nshared != 0) {
+		job->shared_gems = mallocarray(nshared, sizeof(*job->shared_gems),
+		    M_DEVBUF, M_WAITOK | M_CANFAIL);
+		resvs = mallocarray(nshared, sizeof(*resvs), M_DEVBUF,
+		    M_WAITOK | M_CANFAIL);
+		if (job->shared_gems == NULL || resvs == NULL) {
+			error = -ENOMEM;
+			goto fail_unlocked;
+		}
+		for (i = 0; i < ninputs; i++) {
+			if (syncs[i].gem == NULL)
+				continue;
+			drm_gem_object_get(syncs[i].gem);
+			job->shared_gems[job->nshared] = syncs[i].gem;
+			resvs[job->nshared++] = syncs[i].gem->resv;
+		}
+	}
+	if (noutputs != 0) {
+		pub = mallocarray(noutputs, sizeof(*pub), M_DEVBUF,
+		    M_WAITOK | M_CANFAIL | M_ZERO);
+		if (pub == NULL) {
+			error = -ENOMEM;
+			goto fail_unlocked;
+		}
+	}
+	if (ninputs != 0) {
+		error = agx_fw_start_op(sched->runtime);
+		if (error != 0) {
+			error = -error;
+			goto fail_unlocked;
+		}
+		job->op_active = 1;
+	}
+	task_set(&job->prepare_task, agx_sched_execute, job);
+	INIT_DELAYED_WORK(&job->finish_work, agx_sched_finish);
+	job->fence = agx_sched_fence_create();
+	if (job->fence == NULL) {
+		error = -ENOMEM;
+		goto fail_unlocked;
+	}
+	if (noutputs != 0 || nshared != 0) {
+		completion = agx_completion_create();
+		if (completion == NULL) {
+			error = -ENOMEM;
+			goto fail_unlocked;
+		}
+	}
+
+	if (nshared != 0) {
+		batch = dma_resv_batch_prepare(resvs, nshared);
+		if (IS_ERR(batch)) {
+			error = PTR_ERR(batch);
+			batch = NULL;
+			goto fail_unlocked;
+		}
+	}
+	ndeps = batch != NULL ? dma_resv_batch_num_fences(batch) : 0;
+	if (ndeps > SIZE_MAX - nexplicit ||
+	    ndeps + nexplicit > MALLOC_MAX / sizeof(*job->inputs)) {
+		error = -EOVERFLOW;
+		goto fail_unlocked;
+	}
+	job->ninputs = nexplicit + ndeps;
+	if (job->ninputs != 0) {
+		job->inputs = mallocarray(job->ninputs, sizeof(*job->inputs), M_DEVBUF,
+		    M_WAITOK | M_CANFAIL);
+		if (job->inputs == NULL) {
+			job->ninputs = 0;
+			error = -ENOMEM;
+			goto fail_unlocked;
+		}
+	}
+	ndeps = 0;
+	for (i = 0; i < ninputs; i++)
+		if (syncs[i].dependency != NULL)
+			job->inputs[ndeps++] = dma_fence_get(syncs[i].dependency);
+	for (i = 0; batch != NULL && i < dma_resv_batch_num_fences(batch); i++)
+		job->inputs[ndeps++] = dma_fence_get(dma_resv_batch_fence(batch, i));
+
+	if (queue != NULL) {
+		/* The queue/owner reference pins the single-scheduler entity even
+		 * if stop races preparation. No job is visible until push. */
+		error = drm_sched_job_init(&job->base, &sched->entity, 1, NULL,
+		    client_id);
+		if (error != 0)
+			goto fail_unlocked;
+		base_initialized = 1;
+		for (i = 0; i < job->ninputs; i++) {
+			error = drm_sched_job_add_dependency(&job->base,
+			    dma_fence_get(job->inputs[i]));
+			if (error != 0)
+				goto fail_unlocked;
+		}
+		if (signal_pending(current)) {
+			error = -EINTR;
+			goto fail_unlocked;
+		}
+		error = agx_file_queue_try_admit(queue);
+		if (error != 0) {
+			error = -error;
+			goto fail_unlocked;
+		}
+		queue_locked = 1;
+		if (rw_enter(&sched->lock, RW_WRITE | RW_NOSLEEP) != 0) {
+			error = -EAGAIN;
+			agx_file_queue_unlock(queue);
+			queue_locked = 0;
+			goto fail_unlocked;
+		}
+	} else {
+		/* Preserve the existing serialization for legacy submissions. */
+		rw_enter_write(&sched->lock);
+	}
+	if (sched->stopped || (queue != NULL && agx_fw_is_crashed(sched->runtime))) {
+		error = -ENODEV;
+		goto fail_locked;
+	}
+	if (queue == NULL) {
+		error = drm_sched_job_init(&job->base, &sched->entity, 1, NULL,
+		    client_id);
+		if (error != 0)
+			goto fail_locked;
+		base_initialized = 1;
+		for (i = 0; i < job->ninputs; i++) {
+			error = drm_sched_job_add_dependency(&job->base,
+			    dma_fence_get(job->inputs[i]));
+			if (error != 0)
+				goto fail_locked;
+		}
+	} else {
+		/* Connect the unpublished proxy before the irreversible commit. */
+		drm_sched_job_arm(&job->base);
+		armed = 1;
+		set_bit(DRM_SCHED_FENCE_DONT_PIPELINE,
+		    &job->base.s_fence->finished.flags);
+		completion->source = dma_fence_get(&job->base.s_fence->finished);
+		dma_fence_get(&completion->base);
+		callback_owned = 1;
+		error = dma_fence_add_callback(completion->source,
+		    &completion->callback, agx_completion_signal);
+		if (error != 0)
+			goto fail_locked;
+		callback_attached = 1;
+		error = dma_resv_batch_trylock(batch);
+		if (error != 0)
+			goto fail_locked;
+		if (rw_enter(&sched->runtime->submit_order,
+		    RW_WRITE | RW_NOSLEEP) != 0) {
+			dma_resv_batch_unlock(batch);
+			error = -EAGAIN;
+			goto fail_locked;
+		}
+		error = dma_resv_batch_commit_locked(batch, &completion->base);
+		dma_resv_batch_unlock(batch);
+		if (error != 0) {
+			rw_exit_write(&sched->runtime->submit_order);
+			goto fail_locked;
+		}
+	}
+	if (queue == NULL && noutputs != 0)
+		rw_enter_write(&sched->runtime->submit_order);
+	/* No callback, fence put or allocation under the ordering gate. */
+	for (i = 0; i < noutputs; i++) {
+		struct agx_sync *sync = &syncs[ninputs + i];
+
+		drm_syncobj_publish_prepare(&pub[i], sync->object, sync->chain,
+		    &completion->base, sync->point);
+		sync->chain = NULL;
+		sync->is_output = 0;
+		nrecords++;
+	}
+	if (batch != NULL || noutputs != 0)
+		rw_exit_write(&sched->runtime->submit_order);
+
+	/* Shared submissions armed their completion before committing. Legacy
+	 * submissions retain their existing arm/publish sequence. */
+	if (queue == NULL) {
+		drm_sched_job_arm(&job->base);
+		set_bit(DRM_SCHED_FENCE_DONT_PIPELINE,
+		    &job->base.s_fence->finished.flags);
+		if (completion != NULL) {
+			completion->source = dma_fence_get(&job->base.s_fence->finished);
+			dma_fence_get(&completion->base);
+			error = dma_fence_add_callback(completion->source,
+			    &completion->callback, agx_completion_signal);
+			KASSERT(error == 0);
+		}
+	}
+	atomic_inc_int(&sched->outstanding);
+	drm_sched_entity_push_job(&job->base);
+	rw_exit_write(&sched->lock);
+	if (queue_locked)
+		agx_file_queue_unlock(queue);
+	for (i = 0; i < nrecords; i++)
+		drm_syncobj_publish_finish(&pub[i]);
+	dma_resv_batch_destroy(batch);
+	if (completion != NULL)
+		dma_fence_put(&completion->base);
+	free(pub, M_DEVBUF, noutputs * sizeof(*pub));
+	free(resvs, M_DEVBUF, nshared * sizeof(*resvs));
+	return 0;
+
+fail_locked:
+	rw_exit_write(&sched->lock);
+	if (queue_locked)
+		agx_file_queue_unlock(queue);
+fail_unlocked:
+	if (callback_owned) {
+		/* This fence was never published or queued and cannot signal. */
+		if (callback_attached &&
+		    !dma_fence_remove_callback(completion->source,
+		    &completion->callback))
+			panic("agx: unpublished completion callback lost");
+		dma_fence_put(completion->source);
+		completion->source = NULL;
+		dma_fence_put(&completion->base);
+	}
+	if (base_initialized) {
+		if (armed) {
+			if (drm_sched_job_abort_armed(&job->base) != 0)
+				panic("agx: cannot abort unpublished armed job");
+		} else
+			drm_sched_job_cleanup(&job->base);
+	}
+	dma_resv_batch_destroy(batch);
+	if (job->op_active)
+		agx_fw_end_op(sched->runtime);
+	if (completion != NULL)
+		dma_fence_put(&completion->base);
+	dma_fence_put(job->fence);
+	for (i = 0; i < job->ninputs; i++)
+		dma_fence_put(job->inputs[i]);
+	free(job->inputs, M_DEVBUF, job->ninputs * sizeof(*job->inputs));
+	for (i = 0; i < job->nshared; i++)
+		drm_gem_object_put(job->shared_gems[i]);
+	free(job->shared_gems, M_DEVBUF, nshared * sizeof(*job->shared_gems));
+	free(resvs, M_DEVBUF, nshared * sizeof(*resvs));
+	free(pub, M_DEVBUF, noutputs * sizeof(*pub));
+	free(job, M_DEVBUF, sizeof(*job));
+	return -error;
+}
