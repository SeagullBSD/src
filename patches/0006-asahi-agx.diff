+/* All functions return positive OpenBSD errno values; timeout is in ticks.
+ * The device is the AGX softc's platform device; its runtime outlives jobs. */
+int agx_sched_create(struct device *, long, struct agx_sched **);
+/* Caller prevents concurrent new submissions. EBUSY retains the scheduler
+ * while queued or in-flight jobs still own it. */
+int agx_sched_destroy(struct agx_sched *);
+/* Owner has no job references; detached jobs may retain only the scheduler. */
+int agx_sched_orphan(struct agx_sched *);
