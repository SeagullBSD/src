--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_tvb.c	Tue Nov 10 18:57:28 2026
@@ -0,0 +1,375 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Tiled vertex buffer management, derived from Asahi buffer.rs. */
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/systm.h>
+#include "agx_fw_abi.h"
+#include "agx_tvb.h"
+
+#define TVB_MAX_BLOCKS (862322688U / AGX_TVB_BLOCK_SIZE)
+#define TVB_MAX_NOMEMLESS ((862322688U / 3) / AGX_TVB_BLOCK_SIZE)
+#define TVB_NO_SLOT UINT32_MAX
+
+void
+agx_tvb_manager_init(struct agx_tvb_manager *m)
+{
+	memset(m, 0, sizeof(*m));
+	rw_init(&m->lock, "agxtvbm");
+}
+
+static int
+agx_tvb_object(struct agx_heap *heap, size_t size, size_t align,
+    struct agx_object **out)
+{
+	int error = agx_object_alloc(heap, size, align, out);
+	if (error != 0)
+		return error;
+	if ((*out)->cpu == NULL) {
+		agx_object_free(*out);
+		*out = NULL;
+		return EINVAL;
+	}
+	memset((*out)->cpu, 0, size);
+	return 0;
+}
+
+static void
+agx_tvb_free_objects(struct agx_tvb *b)
+{
+	uint32_t i;
+	for (i = 0; i < b->count; i++)
+		agx_object_free(b->blocks[i]);
+	if (b->blocks != NULL)
+		free(b->blocks, M_DEVBUF, b->max_blocks * sizeof(*b->blocks));
+	if (b->stats) agx_object_free(b->stats);
+	if (b->kernel_buffer) agx_object_free(b->kernel_buffer);
+	if (b->counter) agx_object_free(b->counter);
+	if (b->control) agx_object_free(b->control);
+	if (b->block_list) agx_object_free(b->block_list);
+	if (b->page_list) agx_object_free(b->page_list);
+	if (b->info) agx_object_free(b->info);
+}
+
+int
+agx_tvb_init(struct agx_tvb *b, struct agx_tvb_manager *m, unsigned int ver,
+    int g14x, struct agx_heap *shared, struct agx_heap *fw_private,
+    struct agx_heap *vm_private, struct agx_heap *user)
+{
+	int error;
+	if (b == NULL || m == NULL || shared == NULL || fw_private == NULL ||
+	    vm_private == NULL || user == NULL || (ver != 12 && ver != 13) ||
+	    (g14x && ver != 13))
+		return EINVAL;
+	memset(b, 0, sizeof(*b));
+	rw_init(&b->lock, "agxtvb");
+	b->manager = m; b->blocks_heap = user; b->version = ver; b->g14x = g14x;
+	b->slot = TVB_NO_SLOT;
+	b->max_blocks = TVB_MAX_BLOCKS;
+	b->max_blocks_nomemless = TVB_MAX_NOMEMLESS;
+	b->blocks = mallocarray(b->max_blocks, sizeof(*b->blocks), M_DEVBUF,
+	    M_NOWAIT | M_ZERO);
+	if (b->blocks == NULL) {
+		error = ENOMEM;
+		goto fail;
+	}
+#define ALLOC(h, n, member) do { \
+	error = agx_tvb_object((h), (n), 1, &b->member); \
+	if (error != 0) goto fail; \
+} while (0)
+	/* G14X 13.5 retains the unk_1c word present in the 12.3 layout. */
+	ALLOC(fw_private, (ver == 12 || g14x) ?
+	    sizeof(struct agx_fw_buffer_info_12_3) :
+	    sizeof(struct agx_fw_buffer_info_13_5), info);
+	ALLOC(vm_private, b->max_blocks * 4 * sizeof(uint32_t), page_list);
+	ALLOC(vm_private, b->max_blocks * 2 * sizeof(uint32_t), block_list);
+	ALLOC(shared, sizeof(struct agx_fw_buffer_block_control), control);
+	ALLOC(shared, sizeof(struct agx_fw_buffer_counter), counter);
+	ALLOC(shared, 0x40, kernel_buffer);
+	ALLOC(shared, sizeof(struct agx_fw_buffer_stats), stats);
+#undef ALLOC
+#define INIT(p) do { \
+	(p)->cur_id = -1; (p)->page_list = b->page_list->gpu; \
+	(p)->page_list_size = b->max_blocks * 4 * sizeof(uint32_t); \
+	(p)->max_blocks = b->max_blocks; (p)->block_list = b->block_list->gpu; \
+	(p)->block_ctl = b->control->gpu; (p)->block_size = AGX_TVB_BLOCK_SIZE; \
+	(p)->counter = b->counter->gpu; (p)->unk_80 = 1; \
+	(p)->max_pages = b->max_blocks * 4; \
+	(p)->max_pages_nomemless = b->max_blocks_nomemless * 4; \
+} while (0)
+	if (ver == 12 || g14x) {
+		struct agx_fw_buffer_info_12_3 *p = b->info->cpu;
+		INIT(p);
+	} else {
+		struct agx_fw_buffer_info_13_5 *p = b->info->cpu;
+		INIT(p);
+	}
+#undef INIT
+	((struct agx_fw_buffer_stats *)b->stats->cpu)->reset = 1;
+	return 0;
+fail:
+	agx_tvb_free_objects(b);
+	memset(b, 0, sizeof(*b));
+	return error;
+}
+
+int
+agx_tvb_fini(struct agx_tvb *b)
+{
+	struct agx_tvb_manager *m = b->manager;
+	if (m == NULL) return EINVAL;
+	rw_enter_write(&m->lock);
+	rw_enter_write(&b->lock);
+	if (b->active != 0) {
+		rw_exit_write(&b->lock);
+		rw_exit_write(&m->lock);
+		return EBUSY;
+	}
+	if (b->slot != TVB_NO_SLOT && m->owners[b->slot] == b)
+		m->owners[b->slot] = NULL;
+	b->manager = NULL;
+	rw_exit_write(&b->lock);
+	rw_exit_write(&m->lock);
+	agx_tvb_free_objects(b);
+	return 0;
+}
+
+static int
+agx_tvb_ensure_locked(struct agx_tvb *b, uint32_t wanted)
+{
+	struct agx_object **newblocks;
+	struct agx_fw_buffer_block_control *ctl = b->control->cpu;
+	uint32_t *pages = b->page_list->cpu, *blocks = b->block_list->cpu;
+	uint32_t n, i, j, page, count = b->count;
+	int error = 0;
+	if (wanted <= count) return 0;
+	if (wanted > b->max_blocks) return ENOMEM;
+	n = wanted - count;
+	newblocks = mallocarray(n, sizeof(*newblocks), M_DEVBUF,
+	    M_NOWAIT | M_ZERO);
+	if (newblocks == NULL)
+		return ENOMEM;
+	for (i = 0; i < n; i++) {
+		error = agx_object_alloc(b->blocks_heap, AGX_TVB_BLOCK_SIZE,
+		    AGX_TVB_PAGE_SIZE, &newblocks[i]);
+		if (error != 0) break;
+		if ((newblocks[i]->gpu & (AGX_TVB_PAGE_SIZE - 1)) != 0 ||
+		    (newblocks[i]->gpu >> 15) > UINT32_MAX - 3) {
+			agx_object_free(newblocks[i]);
+			newblocks[i] = NULL;
+			error = EOVERFLOW;
+			break;
+		}
+	}
+	if (error != 0) {
+		while (i != 0) agx_object_free(newblocks[--i]);
+		free(newblocks, M_DEVBUF, n * sizeof(*newblocks));
+		return error;
+	}
+	for (i = 0; i < n; i++) {
+		page = newblocks[i]->gpu >> 15;
+		b->blocks[count + i] = newblocks[i];
+		blocks[2 * (count + i)] = page;
+		for (j = 0; j < 4; j++) pages[4 * (count + i) + j] = page + j;
+	}
+	free(newblocks, M_DEVBUF, n * sizeof(*newblocks));
+	b->count = wanted;
+	__atomic_store_n(&ctl->total, wanted, __ATOMIC_SEQ_CST);
+	__atomic_store_n(&ctl->wptr, wanted, __ATOMIC_SEQ_CST);
+	if (b->active == 0) {
+#define UPDATE(p) do { \
+	__atomic_store_n(&(p)->page_count, wanted * 4, __ATOMIC_RELAXED); \
+	__atomic_store_n(&(p)->block_count, wanted, __ATOMIC_RELAXED); \
+	__atomic_store_n(&(p)->last_page, wanted * 4 - 1, __ATOMIC_RELAXED); \
+} while (0)
+		if (b->version == 12 || b->g14x) {
+			struct agx_fw_buffer_info_12_3 *p = b->info->cpu; UPDATE(p);
+		} else {
+			struct agx_fw_buffer_info_13_5 *p = b->info->cpu; UPDATE(p);
+		}
+#undef UPDATE
+	}
+	return 0;
+}
+
+int
+agx_tvb_ensure_blocks(struct agx_tvb *b, uint32_t count)
+{
+	int error;
+	rw_enter_write(&b->lock);
+	error = agx_tvb_ensure_locked(b, count);
+	rw_exit_write(&b->lock);
+	return error;
+}
+
+int
+agx_tvb_auto_grow(struct agx_tvb *b, int *grew)
+{
+	struct agx_fw_buffer_stats *s = b->stats->cpu;
+	uint64_t used, need, want;
+	int error = 0;
+	rw_enter_write(&b->lock);
+	used = __atomic_load_n(&s->max_pages, __ATOMIC_RELAXED);
+	__atomic_store_n(&s->reset, 1, __ATOMIC_RELEASE);
+	need = MIN((used * 2 + 3) / 4, b->max_blocks_nomemless);
+	want = MIN((used * 3 + 3) / 4, b->max_blocks_nomemless);
+	*grew = 0;
+	if (need > b->count) {
+		error = agx_tvb_ensure_locked(b, want);
+		if (error == 0) *grew = 1;
+	}
+	rw_exit_write(&b->lock);
+	return error;
+}
+
+int
+agx_tvb_acquire(struct agx_tvb *b, uint32_t vm_slot, int ordered,
+    uint32_t *slot, int *rebind, uint32_t *init_blocks)
+{
+	struct agx_tvb_manager *m = b->manager;
+	uint32_t i, best = TVB_NO_SLOT;
+	uint64_t oldest = UINT64_MAX;
+	if (m == NULL || slot == NULL || rebind == NULL || init_blocks == NULL)
+		return EINVAL;
+	rw_enter_write(&m->lock);
+	rw_enter_write(&b->lock);
+	if (b->active == UINT32_MAX || b->count == 0 ||
+	    (b->active != 0 && b->vm_slot != vm_slot)) {
+		rw_exit_write(&b->lock); rw_exit_write(&m->lock); return EBUSY;
+	}
+	if (b->init_pending) {
+		if (!ordered || b->active == 0 || b->vm_slot != vm_slot ||
+		    b->slot >= AGX_TVB_SLOTS || m->owners[b->slot] != b ||
+		    b->pending_blocks < b->count) {
+			rw_exit_write(&b->lock);
+			rw_exit_write(&m->lock);
+			return EBUSY;
+		}
+		*slot = b->slot;
+		*rebind = 0;
+		*init_blocks = b->pending_blocks;
+		b->active++;
+		rw_exit_write(&b->lock);
+		rw_exit_write(&m->lock);
+		return 0;
+	}
+	if (b->active == 0) {
+		if (b->slot != TVB_NO_SLOT && m->owners[b->slot] == b)
+			best = b->slot;
+		else for (i = 0; i < AGX_TVB_SLOTS; i++) {
+			if (m->owners[i] == NULL) { best = i; break; }
+			if (m->owners[i]->active == 0 && m->age[i] <= oldest) {
+				oldest = m->age[i]; best = i;
+			}
+		}
+		if (best == TVB_NO_SLOT) {
+			rw_exit_write(&b->lock); rw_exit_write(&m->lock); return EBUSY;
+		}
+		if (m->owners[best] != b || b->vm_slot != vm_slot) {
+			b->binding_valid = 0;
+			b->initialized_blocks = 0;
+		}
+		if (m->owners[best] != NULL && m->owners[best] != b)
+			m->owners[best]->slot = TVB_NO_SLOT;
+		m->owners[best] = b; b->slot = best; b->vm_slot = vm_slot;
+	}
+	*slot = b->slot;
+	*rebind = !b->binding_valid || b->initialized_blocks < b->count;
+	*init_blocks = b->count;
+	if (*rebind) {
+		b->init_pending = 1;
+		b->pending_blocks = b->count;
+	}
+	b->active++;
+	rw_exit_write(&b->lock); rw_exit_write(&m->lock);
+	return 0;
+}
+
+static int
+agx_tvb_binding_finish(struct agx_tvb *b, uint32_t vm_slot, uint32_t slot,
+    uint32_t blocks, int commit)
+{
+	struct agx_tvb_manager *m = b->manager;
+	int error = 0;
+	if (m == NULL || slot >= AGX_TVB_SLOTS) return EINVAL;
+	rw_enter_write(&m->lock); rw_enter_write(&b->lock);
+	if (b->active == 0 || b->slot != slot || b->vm_slot != vm_slot ||
+	    m->owners[slot] != b || !b->init_pending ||
+	    blocks != b->pending_blocks)
+		error = EINVAL;
+	else {
+		if (commit) {
+			b->binding_valid = 1;
+			b->initialized_blocks = blocks;
+		}
+		b->init_pending = 0;
+		b->pending_blocks = 0;
+		wakeup(b);
+	}
+	rw_exit_write(&b->lock); rw_exit_write(&m->lock);
+	return error;
+}
+
+int
+agx_tvb_binding_commit(struct agx_tvb *b, uint32_t vm_slot, uint32_t slot,
+    uint32_t blocks)
+{
+	return agx_tvb_binding_finish(b, vm_slot, slot, blocks, 1);
+}
+
+int
+agx_tvb_binding_abort(struct agx_tvb *b, uint32_t vm_slot, uint32_t slot,
+    uint32_t blocks)
+{
+	return agx_tvb_binding_finish(b, vm_slot, slot, blocks, 0);
+}
+
+void
+agx_tvb_release(struct agx_tvb *b)
+{
+	struct agx_tvb_manager *m = b->manager;
+	rw_enter_write(&m->lock); rw_enter_write(&b->lock);
+	KASSERT(b->active != 0);
+	if (--b->active == 0) {
+		KASSERT(!b->init_pending);
+		m->age[b->slot] = ++m->clock;
+	}
+	rw_exit_write(&b->lock); rw_exit_write(&m->lock);
+}
+
+int
+agx_tvb_increment(struct agx_tvb *b)
+{
+	struct agx_fw_buffer_counter *c = b->counter->cpu;
+	uint32_t value = __atomic_load_n(&c->count, __ATOMIC_RELAXED);
+	if (value == UINT32_MAX) return EOVERFLOW;
+	__atomic_store_n(&c->count, value + 1, __ATOMIC_RELEASE);
+	return 0;
+}
+
+void
+agx_tvb_increment_rollback(struct agx_tvb *b)
+{
+	struct agx_fw_buffer_counter *c = b->counter->cpu;
+	uint32_t value = __atomic_load_n(&c->count, __ATOMIC_RELAXED);
+	KASSERT(value != 0);
+	__atomic_store_n(&c->count, value - 1, __ATOMIC_RELEASE);
+}
+
+int
+agx_tvb_grow_slot(struct agx_tvb_manager *m, uint32_t vm_slot, uint32_t slot)
+{
+	struct agx_tvb *b;
+	int error;
+	if (m == NULL || slot >= AGX_TVB_SLOTS) return EINVAL;
+	rw_enter_write(&m->lock);
+	b = m->owners[slot];
+	if (b == NULL || b->active == 0 || b->vm_slot != vm_slot) {
+		rw_exit_write(&m->lock); return ENOENT;
+	}
+	rw_enter_write(&b->lock);
+	error = b->count > b->max_blocks - 10 ? ENOMEM :
+	    agx_tvb_ensure_locked(b, b->count + 10);
+	rw_exit_write(&b->lock); rw_exit_write(&m->lock);
+	return error;
+}
Index: sys/dev/pci/drm/asahi/agx_tvb.h
===================================================================
--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_tvb.h	Tue Nov 10 18:54:15 2026
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef _AGX_TVB_H_
+#define _AGX_TVB_H_
+
+#include <sys/types.h>
+#include <sys/rwlock.h>
+#include "agx_object.h"
+
+#define AGX_TVB_SLOTS 127
+#define AGX_TVB_PAGE_SIZE 0x8000U
+#define AGX_TVB_BLOCK_SIZE 0x20000U
+
+struct agx_tvb;
+struct agx_tvb_manager {
+	struct rwlock lock;
+	struct agx_tvb *owners[AGX_TVB_SLOTS];
+	uint64_t age[AGX_TVB_SLOTS], clock;
+};
+struct agx_tvb {
+	struct rwlock lock;
+	struct agx_tvb_manager *manager;
+	struct agx_heap *blocks_heap;
+	struct agx_object *info, *page_list, *block_list, *control, *counter;
+	struct agx_object *kernel_buffer, *stats;
+	struct agx_object **blocks;
+	uint32_t count, max_blocks, max_blocks_nomemless;
+	uint32_t active, slot, vm_slot, version, g14x;
+	uint32_t initialized_blocks, pending_blocks;
+	int binding_valid, init_pending;
+};
+
+void agx_tvb_manager_init(struct agx_tvb_manager *);
+int agx_tvb_init(struct agx_tvb *, struct agx_tvb_manager *, unsigned int,
+    int, struct agx_heap *, struct agx_heap *, struct agx_heap *, struct agx_heap *);
+int agx_tvb_fini(struct agx_tvb *);
+int agx_tvb_ensure_blocks(struct agx_tvb *, uint32_t);
+int agx_tvb_auto_grow(struct agx_tvb *, int *);
+/* ordered retains the exact accepted vertex predecessor and propagates its
+ * cancellation. Only such a caller may reuse an unpublished initializer. */
+int agx_tvb_acquire(struct agx_tvb *, uint32_t, int, uint32_t *, int *, uint32_t *);
+/* Complete or abort the initializer using the block-count snapshot from acquire. */
+int agx_tvb_binding_commit(struct agx_tvb *, uint32_t, uint32_t, uint32_t);
+int agx_tvb_binding_abort(struct agx_tvb *, uint32_t, uint32_t, uint32_t);
+void agx_tvb_release(struct agx_tvb *);
+/* Queue-serialized and non-sleeping; increment before publishing vertex wptr. */
+int agx_tvb_increment(struct agx_tvb *);
+/* Only before publication, under the same queue serialization. */
+void agx_tvb_increment_rollback(struct agx_tvb *);
+/* May sleep; caller must defer firmware grow events to process context. */
+int agx_tvb_grow_slot(struct agx_tvb_manager *, uint32_t, uint32_t);
+#endif
Index: sys/dev/pci/drm/asahi/agx_uat.c
