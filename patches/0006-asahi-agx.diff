+/* SPDX-License-Identifier: MIT */
+/* T8103 HwDataB initialization, derived from Asahi Linux initdata.rs. */
+#include <sys/types.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+
+#include "agx_fw_hwdata_b.h"
+#include "agx_identity.h"
+#include "agx_init_hw_b.h"
+#include "agx_power.h"
+
+/* Common fields have identical names but version-dependent offsets. */
+#define AGX_INIT_B_COMMON(b) do { \
+	(b)->unk_8.value = 0x1400000000ULL; \
+	(b)->unk_18.value = 0xffc00000ULL; \
+	(b)->unk_30.value = 0x7fffff8000ULL; \
+	(b)->timestamp_area_base.value = 0xffffffae10000000ULL; \
+	(b)->chip_id = g14x ? 0x6021 : 0x8103; \
+	(b)->unk_454 = 1; (b)->unk_458 = 1; (b)->unk_460 = 1; \
+	(b)->unk_464 = 1; (b)->unk_468 = 1; (b)->unk_47c = 1; \
+	(b)->unk_484 = 1; (b)->unk_48c = 1; \
+	(b)->base_clock_khz = 24000; \
+	(b)->power_sample_period = pwr->power_sample_period; \
+	(b)->unk_49c = 1; (b)->unk_4a0 = 1; (b)->unk_4a4 = 1; \
+	(b)->unk_4c0 = 0x1f; (b)->unk_4f0 = 1; (b)->unk_4f4 = 1; \
+	(b)->unk_504 = 0x31; (b)->unk_524 = 1; \
+	(b)->num_frags = id->num_frags * id->num_clusters; \
+	(b)->unk_554 = 1; (b)->uat_ttb_base.value = uat_ttb_base; \
+	(b)->gpu_core_id = g14x ? 17 : 11; \
+	(b)->gpu_rev_id = g14x && id->gpu_rev_id == 4 ? 3 : id->gpu_rev_id; \
+	(b)->num_cores = id->num_cores * id->num_clusters; \
+	(b)->max_pstate = pwr->num_perf_states - 1; \
+	(b)->unk_b10 = 1; (b)->unk_b24 = 1; (b)->unk_b28 = 1; \
+	(b)->unk_b2c = 1; \
+	for (i = 0; i < 12; i++) (b)->unk_b38[i] = 0xffffffffU; \
+	for (i = 0; i < pwr->num_perf_states; i++) { \
+		const struct agx_power_pstate *ps = &pwr->perf_states[i]; \
+		uint32_t sram; \
+		(b)->frequencies[i] = ps->freq_hz / 1000000; \
+		for (j = 0; j < 8; j++) { \
+			uint32_t mv = ps->volt_mv[j < nvolt ? j : 0]; \
+			sram = pwr->min_sram_microvolt / 1000; \
+			if (sram < mv) sram = mv; \
+			(b)->voltages[i][j] = mv; \
+			(b)->voltages_sram[i][j] = sram; \
+		} \
+		(b)->sram_k[i] = 0x3f828f5c; /* f32(1.02) */ \
+		(b)->rel_max_powers[i] = (uint64_t)ps->pwr_mw * 100 / pwr->max_power_mw; \
+		if (i > pwr->perf_base_pstate) \
+			(b)->rel_boost_freqs[i] = (ps->freq_hz - base_freq) / boost_div; \
+	} \
+} while (0)
+
+int
+agx_initdata_hw_b(void *dst, size_t len, unsigned major, unsigned minor,
+    const struct agx_power_config *pwr, const struct agx_identity *id,
+    uint64_t uat_ttb_base)
+{
+	uint32_t base_freq, max_freq, boost_div;
+	unsigned i, j;
+	size_t size;
+	int g14x;
+	unsigned int nvolt;
+	if (major == 12 && minor == 3)
+		size = sizeof(struct agx_fw_hwdata_b_12_3);
+	else if (major == 13 && minor == 5)
+		size = sizeof(struct agx_fw_hwdata_b_13_5);
+	else
+		return EINVAL;
+	if (dst == NULL || pwr == NULL || id == NULL || len < size ||
+	    ((uintptr_t)dst & 3) != 0 || pwr->num_perf_states == 0 ||
+	    pwr->num_perf_states > AGX_POWER_MAX_PSTATES ||
+	    pwr->perf_base_pstate >= pwr->num_perf_states ||
+	    pwr->perf_max_pstate >= pwr->num_perf_states ||
+	    pwr->max_power_mw == 0 || id->num_clusters == 0 ||
+	    id->num_cores == 0 || id->num_frags == 0)
+		return EINVAL;
+	g14x = id->gpu_gen == 14 && id->gpu_variant == 'C';
+	if (g14x) {
+		if (major != 13 || id->num_clusters > 4 || pwr->num_voltages != 4 ||
+		    pwr->num_cs_states == 0 || pwr->num_cs_states > 16 ||
+		    pwr->num_afr_states == 0 || pwr->num_afr_states > 8)
+			return EINVAL;
+		nvolt = 4;
+	} else {
+		if (id->num_clusters != 1)
+			return EINVAL;
+		nvolt = 1;
+	}
+	base_freq = pwr->perf_states[pwr->perf_base_pstate].freq_hz;
+	max_freq = pwr->perf_states[pwr->perf_max_pstate].freq_hz;
+	if (max_freq < base_freq)
+		return EINVAL;
+	boost_div = (max_freq - base_freq) / 100;
+	for (i = pwr->perf_base_pstate + 1; i < pwr->num_perf_states; i++) {
+		if (boost_div == 0 || pwr->perf_states[i].freq_hz < base_freq)
+			return EINVAL;
+	}
+	for (i = 0; i < pwr->num_perf_states; i++) {
+		if ((uint64_t)pwr->perf_states[i].pwr_mw * 100 /
+		    pwr->max_power_mw > 0xffffffffU)
+			return EINVAL;
+	}
+	memset(dst, 0, size);
+	if (major == 12) {
+		struct agx_fw_hwdata_b_12_3 *b = dst;
+		AGX_INIT_B_COMMON(b);
+		b->unk_0.value = 0x1300000000ULL;
+		b->unk_10.value = 0x100000000ULL;
+		b->num_pstates = pwr->num_perf_states;
+		b->min_sram_volt = pwr->min_sram_microvolt / 1000;
+		b->unk_ab8 = 0x48; b->unk_abc = 8; b->unk_ac0 = 0x1020;
+		b->unk_ae4[1] = 0xf; b->unk_ae4[2] = 0x3f; b->unk_ae4[3] = 0x3f;
+	} else if (g14x) {
+		struct agx_fw_hwdata_b_g14x_13_5 *b = dst;
+		uint32_t mv, sram;
+
+		AGX_INIT_B_COMMON(b);
+		b->unk_4e0.value = 4;
+		b->unk_ae4[1] = 3; b->unk_ae4[2] = 7; b->unk_ae4[3] = 7;
+		b->unk_b38_0 = 1; b->unk_b38_4 = 1; b->unk_c3c = 0x1a;
+		for (i = 0; i < 16; i++) b->unk_arr_0[i] = i;
+		b->aux_ps.cs_max_pstate = pwr->num_cs_states - 1;
+		b->aux_ps.afr_max_pstate = pwr->num_afr_states - 1;
+		for (i = 0; i < pwr->num_cs_states; i++) {
+			mv = pwr->cs_states[i].volt_mv[0];
+			sram = pwr->csafr_min_sram_microvolt / 1000;
+			if (sram < mv) sram = mv;
+			b->aux_ps.cs_frequencies[i] = pwr->cs_states[i].freq_hz / 1000000;
+			b->aux_ps.cs_voltages[i][0] = mv;
+			b->aux_ps.cs_voltages_sram[i][0] = sram;
+		}
+		for (i = 0; i < pwr->num_afr_states; i++) {
+			mv = pwr->afr_states[i].volt_mv[0];
+			sram = pwr->csafr_min_sram_microvolt / 1000;
+			if (sram < mv) sram = mv;
+			b->aux_ps.afr_frequencies[i] = pwr->afr_states[i].freq_hz / 1000000;
+			b->aux_ps.afr_voltages[i][0] = mv;
+			b->aux_ps.afr_voltages_sram[i][0] = sram;
+		}
+	} else {
+		struct agx_fw_hwdata_b_13_5 *b = dst;
+		AGX_INIT_B_COMMON(b);
+		b->unk_ae4[1] = 3; b->unk_ae4[2] = 7; b->unk_ae4[3] = 7;
+		b->unk_b38_0 = 1; b->unk_b38_4 = 1; b->unk_c3c = 0x1a;
+		for (i = 0; i < 16; i++) b->unk_arr_0[i] = i;
+	}
+	return 0;
+}
+#undef AGX_INIT_B_COMMON
