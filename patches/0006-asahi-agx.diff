--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_context.c	Mon Nov 16 01:18:56 2026
@@ -0,0 +1,465 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* VM and firmware queue-context ownership. */
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/rwlock.h>
+#include <sys/systm.h>
+
+#include "agx_context.h"
+#include "agx_fw.h"
+#include "agx_object.h"
+#include "agx_queue.h"
+#include "agx_uat.h"
+
+struct agx_context_vm {
+	struct rwlock lock;
+	unsigned int refs;
+	int dying;
+	struct agx_vm *vm;
+	struct agx_heap shared, private;
+	struct agx_heap_vm shared_map, private_map;
+	int (*release)(void *);
+	void *release_cookie;
+};
+
+struct agx_gpu_context {
+	struct rwlock lock;
+	unsigned int refs, bindings, tails;
+	int dying, poisoned, closing, invalidated;
+	struct agx_context_vm *vm;
+	struct agx_fw_devctl *devctl;
+	struct agx_object *data;
+	agx_context_release_fn release;
+	void *release_cookie;
+};
+
+int
+agx_context_vm_create(struct agx_uat_handoff *handoff, bus_dma_tag_t dmat,
+    uint64_t start, uint64_t end, struct agx_fwctl *fwctl,
+    struct agx_fw_devctl *devctl, struct agx_context_vm **out)
+{
+	struct agx_context_vm *cv;
+	int error, cleanup;
+
+	if (handoff == NULL || dmat == NULL || fwctl == NULL ||
+	    devctl == NULL || out == NULL)
+		return EINVAL;
+	*out = NULL;
+	cv = malloc(sizeof(*cv), M_DEVBUF, M_WAITOK | M_ZERO);
+	rw_init(&cv->lock, "agxcvm");
+	cv->refs = 1;
+	error = agx_vm_create(handoff, dmat, start, end, &cv->vm);
+	if (error != 0)
+		goto fail_free;
+	error = agx_heap_vm_init(&cv->shared, &cv->shared_map, cv->vm, dmat,
+	    AGX_VM_GPU_SHARED, 0x8000, 0x80000, agx_fwctl_flush, fwctl);
+	if (error != 0)
+		goto fail_vm;
+	error = agx_heap_vm_init(&cv->private, &cv->private_map, cv->vm, dmat,
+	    AGX_VM_GPU_FW_PRIVATE, 0x8000, 0x10000, agx_fwctl_flush, fwctl);
+	if (error != 0)
+		goto fail_shared;
+	error = agx_heap_enable_quarantine(&cv->private, agx_fw_flush_cache,
+	    devctl);
+	if (error != 0)
+		goto fail_private;
+	*out = cv;
+	return 0;
+
+fail_private:
+	cleanup = agx_heap_destroy(&cv->private);
+	if (cleanup == 0)
+		cleanup = agx_heap_vm_fini(&cv->private_map);
+	if (cleanup != 0) {
+		printf("agx: retaining failed VM heap initialization (%d)\n", cleanup);
+		return error;
+	}
+fail_shared:
+	cleanup = agx_heap_destroy(&cv->shared);
+	if (cleanup == 0)
+		cleanup = agx_heap_vm_fini(&cv->shared_map);
+	if (cleanup != 0) {
+		printf("agx: retaining failed VM heap initialization (%d)\n", cleanup);
+		return error;
+	}
+fail_vm:
+	cleanup = agx_vm_put(cv->vm);
+	if (cleanup != 0) {
+		printf("agx: retaining failed VM initialization (%d)\n", cleanup);
+		return error;
+	}
+fail_free:
+	free(cv, M_DEVBUF, sizeof(*cv));
+	return error;
+}
+
+int
+agx_context_vm_get(struct agx_context_vm *cv)
+{
+	int error = 0;
+
+	if (cv == NULL)
+		return EINVAL;
+	rw_enter_write(&cv->lock);
+	if (cv->dying)
+		error = ENODEV;
+	else if (cv->refs == UINT_MAX)
+		error = EOVERFLOW;
+	else
+		cv->refs++;
+	rw_exit_write(&cv->lock);
+	return error;
+}
+
+int
+agx_context_vm_set_release(struct agx_context_vm *cv, int (*release)(void *),
+    void *cookie)
+{
+	int error = 0;
+
+	if (cv == NULL || release == NULL)
+		return EINVAL;
+	rw_enter_write(&cv->lock);
+	if (cv->dying || cv->refs != 1 || cv->release != NULL)
+		error = EBUSY;
+	else {
+		cv->release = release;
+		cv->release_cookie = cookie;
+	}
+	rw_exit_write(&cv->lock);
+	return error;
+}
+
+void
+agx_context_vm_put(struct agx_context_vm *cv)
+{
+	int error;
+
+	if (cv == NULL)
+		return;
+	rw_enter_write(&cv->lock);
+	KASSERT(!cv->dying && cv->refs != 0);
+	if (--cv->refs != 0) {
+		rw_exit_write(&cv->lock);
+		return;
+	}
+	cv->dying = 1;
+	rw_exit_write(&cv->lock);
+
+	/* No new users can enter.  Keep all remaining backing on any error. */
+	if (cv->release != NULL) {
+		error = cv->release(cv->release_cookie);
+		if (error != 0)
+			goto retain;
+	}
+	error = agx_heap_destroy(&cv->private);
+	if (error != 0)
+		goto retain;
+	error = agx_heap_vm_fini(&cv->private_map);
+	if (error != 0)
+		goto retain;
+	error = agx_heap_destroy(&cv->shared);
+	if (error != 0)
+		goto retain;
+	error = agx_heap_vm_fini(&cv->shared_map);
+	if (error != 0)
+		goto retain;
+	error = agx_vm_put(cv->vm);
+	if (error != 0)
+		goto retain;
+	free(cv, M_DEVBUF, sizeof(*cv));
+	return;
+retain:
+	printf("agx: retaining poisoned VM context (%d)\n", error);
+}
+
+struct agx_vm *
+agx_context_vm_raw(struct agx_context_vm *cv)
+{
+	return cv->vm;
+}
+
+struct dma_resv *
+agx_context_vm_resv(struct agx_context_vm *cv)
+{
+	return agx_vm_resv(cv->vm);
+}
+
+struct agx_heap *
+agx_context_vm_shared_heap(struct agx_context_vm *cv)
+{
+	return &cv->shared;
+}
+
+struct agx_heap *
+agx_context_vm_private_heap(struct agx_context_vm *cv)
+{
+	return &cv->private;
+}
+
+int
+agx_gpu_context_create(struct agx_context_vm *vm, struct agx_heap *heap,
+    struct agx_fw_devctl *devctl, agx_context_release_fn release, void *cookie,
+    struct agx_gpu_context **out)
+{
+	struct agx_gpu_context *ctx;
+	int error;
+
+	if (vm == NULL || heap == NULL || devctl == NULL || release == NULL ||
+	    out == NULL)
+		return EINVAL;
+	*out = NULL;
+	ctx = malloc(sizeof(*ctx), M_DEVBUF, M_WAITOK | M_ZERO);
+	rw_init(&ctx->lock, "agxctx");
+	ctx->refs = 1;
+	error = agx_context_vm_get(vm);
+	if (error != 0)
+		goto fail;
+	ctx->vm = vm;
+	error = agx_object_alloc(heap, sizeof(struct agx_fw_gpu_context_data),
+	    0, &ctx->data);
+	if (error != 0)
+		goto fail_vm;
+	if (ctx->data->cpu == NULL) {
+		error = EINVAL;
+		agx_object_free(ctx->data);
+		goto fail_vm;
+	}
+	agx_wq_context_init(ctx->data->cpu);
+	ctx->devctl = devctl;
+	ctx->release = release;
+	ctx->release_cookie = cookie;
+	*out = ctx;
+	return 0;
+fail_vm:
+	agx_context_vm_put(vm);
+fail:
+	free(ctx, M_DEVBUF, sizeof(*ctx));
+	return error;
+}
+
+int
+agx_gpu_context_get(struct agx_gpu_context *ctx)
+{
+	int error = 0;
+
+	if (ctx == NULL)
+		return EINVAL;
+	rw_enter_write(&ctx->lock);
+	if (ctx->dying || ctx->poisoned || ctx->closing)
+		error = ENODEV;
+	else if (ctx->refs == UINT_MAX)
+		error = EOVERFLOW;
+	else
+		ctx->refs++;
+	rw_exit_write(&ctx->lock);
+	return error;
+}
+
+void
+agx_gpu_context_put(struct agx_gpu_context *ctx)
+{
+	int error;
+
+	if (ctx == NULL)
+		return;
+	rw_enter_write(&ctx->lock);
+	KASSERT(!ctx->dying && ctx->refs != 0);
+	if (--ctx->refs != 0) {
+		rw_exit_write(&ctx->lock);
+		return;
+	}
+	KASSERT(ctx->bindings == 0 && ctx->tails == 0);
+	ctx->dying = 1;
+	if (ctx->poisoned) {
+		rw_exit_write(&ctx->lock);
+		printf("agx: retaining poisoned GPU context\n");
+		return;
+	}
+	if (!ctx->invalidated) {
+		/* No reference remains with which to race a new submission. */
+		error = agx_fw_destroy_context(ctx->devctl, ctx->data->cpu,
+		    ctx->data->gpu);
+		if (error != 0) {
+			ctx->poisoned = 1;
+			rw_exit_write(&ctx->lock);
+			goto retain;
+		}
+		ctx->invalidated = 1;
+	}
+	rw_exit_write(&ctx->lock);
+	error = ctx->release(ctx->release_cookie);
+	if (error != 0)
+		goto retain;
+	agx_object_free(ctx->data);
+	agx_context_vm_put(ctx->vm);
+	free(ctx, M_DEVBUF, sizeof(*ctx));
+	return;
+retain:
+	printf("agx: retaining poisoned GPU context (%d)\n", error);
+}
+
+int
+agx_gpu_context_invalidate(struct agx_gpu_context *ctx)
+{
+	int error;
+
+	if (ctx == NULL)
+		return EINVAL;
+	rw_enter_write(&ctx->lock);
+	if (ctx->dying || ctx->poisoned) {
+		error = ENODEV;
+		goto out;
+	}
+	if (ctx->invalidated) {
+		error = 0;
+		goto out;
+	}
+	if (ctx->bindings != 0) {
+		error = EBUSY;
+		goto out;
+	}
+	ctx->closing = 1;
+	/* The lock serializes the acknowledgement with bind and tail changes. */
+	error = agx_fw_destroy_context(ctx->devctl, ctx->data->cpu,
+	    ctx->data->gpu);
+	if (error != 0)
+		ctx->poisoned = 1;
+	else
+		ctx->invalidated = 1;
+out:
+	rw_exit_write(&ctx->lock);
+	return error;
+}
+
+struct agx_context_vm *
+agx_gpu_context_vm(struct agx_gpu_context *ctx)
+{
+	return ctx->vm;
+}
+
+struct agx_fw_gpu_context_data *
+agx_gpu_context_cpu(struct agx_gpu_context *ctx)
+{
+	return ctx->data->cpu;
+}
+
+uint64_t
+agx_gpu_context_gpu(struct agx_gpu_context *ctx)
+{
+	return ctx->data->gpu;
+}
+
+int
+agx_gpu_context_bind(struct agx_gpu_context *ctx, uint32_t *slot,
+    const int *cancel, const int *stopped)
+{
+	int error;
+
+	if (slot == NULL)
+		return EINVAL;
+	error = agx_gpu_context_get(ctx);
+	if (error != 0)
+		return error;
+	rw_enter_write(&ctx->lock);
+	if (ctx->closing || ctx->poisoned) {
+		rw_exit_write(&ctx->lock);
+		agx_gpu_context_put(ctx);
+		return ENODEV;
+	}
+	/* Reserve before waiting in the VM: invalidation must see pending binds. */
+	ctx->bindings++;
+	rw_exit_write(&ctx->lock);
+	error = agx_vm_bind(ctx->vm->vm, slot, cancel, stopped);
+	if (error != 0) {
+		rw_enter_write(&ctx->lock);
+		ctx->bindings--;
+		rw_exit_write(&ctx->lock);
+		agx_gpu_context_put(ctx);
+		return error;
+	}
+	return 0;
+}
+
+int
+agx_gpu_context_unbind(struct agx_gpu_context *ctx)
+{
+	int error;
+
+	if (ctx == NULL)
+		return EINVAL;
+	rw_enter_write(&ctx->lock);
+	if (ctx->poisoned) {
+		rw_exit_write(&ctx->lock);
+		return ENODEV;
+	}
+	if (ctx->bindings == 0) {
+		rw_exit_write(&ctx->lock);
+		return EINVAL;
+	}
+	/* Keep the binding visible until the VM slot is actually released. */
+	error = agx_vm_unbind(ctx->vm->vm);
+	if (error != 0) {
+		ctx->poisoned = 1;
+		rw_exit_write(&ctx->lock);
+		return error;
+	}
+	ctx->bindings--;
+	rw_exit_write(&ctx->lock);
+	agx_gpu_context_put(ctx);
+	return 0;
+}
+
+int
+agx_gpu_context_tail_pin(struct agx_gpu_context *ctx, uint32_t *slot)
+{
+	int error;
+
+	if (ctx == NULL || slot == NULL)
+		return EINVAL;
+	rw_enter_write(&ctx->lock);
+	if (ctx->dying || ctx->poisoned || ctx->closing)
+		error = ENODEV;
+	else if (ctx->bindings == 0)
+		error = EINVAL;
+	else if (ctx->refs == UINT_MAX || ctx->tails == UINT_MAX)
+		error = EOVERFLOW;
+	else {
+		error = agx_vm_tail_pin(ctx->vm->vm, slot);
+		if (error == 0) {
+			ctx->refs++;
+			ctx->tails++;
+		}
+	}
+	rw_exit_write(&ctx->lock);
+	return error;
+}
+
+int
+agx_gpu_context_tail_unpin(struct agx_gpu_context *ctx)
+{
+	int error;
+
+	if (ctx == NULL)
+		return EINVAL;
+	rw_enter_write(&ctx->lock);
+	if (ctx->poisoned) {
+		rw_exit_write(&ctx->lock);
+		return ENODEV;
+	}
+	if (ctx->tails == 0) {
+		rw_exit_write(&ctx->lock);
+		return EINVAL;
+	}
+	error = agx_vm_tail_unpin(ctx->vm->vm);
+	if (error != 0) {
+		ctx->poisoned = 1;
+		rw_exit_write(&ctx->lock);
+		return error;
+	}
+	ctx->tails--;
+	rw_exit_write(&ctx->lock);
+	agx_gpu_context_put(ctx);
+	return 0;
+}
