+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef _AGX_CHANNEL_BANK_H_
+#define _AGX_CHANNEL_BANK_H_
+
+#include <sys/types.h>
+#include "agx_fw.h"
+
+struct agx_channel_bank;
+struct agx_wq_ring;
+struct rtkit_state;
+
+/* The heaps and RTKit must outlive the bank. Creation is sleepable. */
+int agx_channel_bank_create(struct agx_fw_heaps *, unsigned int, unsigned int,
+    struct rtkit_state *, struct agx_channel_bank **);
+/* Process context, not from a bank error handler: permanently stop submissions
+ * and deferred doorbells, waiting for retries. Call after retiring work, or to
+ * contain a crash without freeing GPU resources. Does not prove GPU stop. */
+void agx_channel_bank_stop(struct agx_channel_bank *);
+/* Stop firmware/GPU and quiesce all users and RX callbacks before destruction. */
+void agx_channel_bank_destroy(struct agx_channel_bank *);
+/* Fills only channel descriptors and fwlog_buf; preserves other init fields. */
+void agx_channel_bank_describe(struct agx_channel_bank *,
+    struct agx_runtime_init *, struct agx_fw_channel_ring *);
+struct agx_channel *agx_channel_bank_fwctl(struct agx_channel_bank *);
+struct agx_channel *agx_channel_bank_devctl(struct agx_channel_bank *);
+/* Identity/access for queue construction only; never put directly to a pipe. */
+struct agx_channel *agx_channel_bank_pipe(struct agx_channel_bank *,
+    unsigned int, unsigned int);
+
+/* Register a non-NULL handler before submissions; handler and cookie outlive
+ * the bank. Deferred hard doorbell errors run in process context, unlocked. */
+void agx_channel_bank_set_error_handler(struct agx_channel_bank *,
+    void (*)(void *, int), void *);
+/* Reserve one channel entry in every selected pipe (bits 0..2), acquiring
+ * locks in pipe order. The caller must preflight its own workqueues before
+ * changing thresholds. Each selected pipe may be submitted once. Release on
+ * every successful acquire, including after a failed/partial submission. */
+int agx_channel_bank_acquire(struct agx_channel_bank *, unsigned int, unsigned int);
+void agx_channel_bank_release(struct agx_channel_bank *, unsigned int, unsigned int);
+/* Caller serializes its workqueue and retains committed jobs until retirement.
+ * After acquire, publish under the runtime's IRQ-safe crash gate; this does
+ * not sleep, take locks, send a doorbell, or schedule a timer. Each selected
+ * pipe may be published once. Exit the crash gate before notify_locked, while
+ * retaining the bank locks. notify_locked may schedule deferred doorbell retry.
+ * A failure after publication must not release firmware-visible resources. */
+int agx_channel_bank_publish_locked(struct agx_channel_bank *, struct agx_wq_ring *,
+    const uint64_t *, uint32_t, uint32_t, int *);
+int agx_channel_bank_notify_locked(struct agx_channel_bank *, struct agx_wq_ring *);
+
+struct agx_channel_bank_ops {
+	void (*event)(void *, const struct agx_fw_event_msg *);
+	void (*fwlog)(void *, unsigned int, const struct agx_fw_log_msg *,
+	    const struct agx_fw_log_payload_msg *);
+	void (*ktrace)(void *, const struct agx_fw_ktrace_msg *);
+	void (*stats)(void *, const void *, size_t);
+};
+/* Process context. Caller serializes polling and keeps callbacks alive. The
+ * event callback is mandatory. Invalid log entries have a NULL payload.
+ * EAGAIN means the batch budget was reached: schedule another poll. */
+int agx_channel_bank_poll(struct agx_channel_bank *,
+    const struct agx_channel_bank_ops *, void *);
+#endif
