+		    offsetof(struct agx_fw_notifier_state_13_5, unk_buf);
+		/* Firmware 13.5 requires the notifier buffer to start at all-ones. */
+		memset(n->state.unk_buf, 0xff, sizeof(n->state.unk_buf));
