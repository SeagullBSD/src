--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_timestamp.c	Wed Nov 11 17:07:16 2026
@@ -0,0 +1,352 @@
+/* SPDX-License-Identifier: MIT */
+/* Special per-file timestamp objects, derived from the Asahi Linux driver. */
+#include <sys/types.h>
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/queue.h>
+#include <sys/rwlock.h>
+#include <sys/systm.h>
+
+#include <drm/drm_file.h>
+#include <drm/drm_gem.h>
+#include <drm/drm_mm.h>
+#include <uapi/drm/asahi_drm.h>
+
+#include "agx_device.h"
+#include "agx_mem.h"
+#include "agx_timestamp.h"
+#include "agx_uat.h"
+
+struct agx_timestamp_pool {
+	struct rwlock lock;
+	struct drm_mm va;
+	struct agx_uat_pt *pt;
+	TAILQ_HEAD(, agx_timestamp) garbage;
+	unsigned int files, mappings;
+};
+
+struct agx_timestamp_file {
+	struct rwlock lock;
+	struct agx_timestamp_pool *pool;
+	TAILQ_HEAD(, agx_timestamp) objects;
+};
+
+struct agx_timestamp {
+	TAILQ_ENTRY(agx_timestamp) link;
+	struct agx_timestamp_pool *pool;
+	struct drm_mm_node node;
+	struct drm_gem_object *gem;
+	struct agx_mem *mem;
+	uint64_t size;
+	uint32_t handle;
+	unsigned int refs;
+};
+
+int
+agx_timestamp_pool_create(struct agx_uat_pt *pt, struct agx_timestamp_pool **out)
+{
+	struct agx_timestamp_pool *pool;
+
+	if (pt == NULL || out == NULL)
+		return EINVAL;
+	*out = NULL;
+	pool = malloc(sizeof(*pool), M_DEVBUF, M_WAITOK | M_ZERO);
+	rw_init(&pool->lock, "agxtspool");
+	drm_mm_init(&pool->va, AGX_TIMESTAMP_BASE, AGX_TIMESTAMP_SIZE);
+	TAILQ_INIT(&pool->garbage);
+	pool->pt = pt;
+	*out = pool;
+	return 0;
+}
+
+/* Caller holds pool lock; on failure the VA and backing remain reserved. */
+static int
+agx_timestamp_unmap(struct agx_timestamp *ts)
+{
+	struct agx_timestamp_pool *pool = ts->pool;
+	int error;
+
+	/* FW_SHARED_RW is uncached: UAT unmap includes the required TLBI. */
+	error = agx_uat_pt_unmap(pool->pt, ts->node.start, ts->size);
+	if (error != 0)
+		return error;
+	drm_mm_remove_node(&ts->node);
+	pool->mappings--;
+	return 0;
+}
+
+static void
+agx_timestamp_free(struct agx_timestamp *ts)
+{
+	agx_mem_unpin(ts->mem);
+	drm_gem_object_put(ts->gem);
+	free(ts, M_DEVBUF, sizeof(*ts));
+}
+
+int
+agx_timestamp_pool_collect(struct agx_timestamp_pool *pool)
+{
+	struct agx_timestamp *ts;
+	int error;
+
+	if (pool == NULL)
+		return EINVAL;
+	for (;;) {
+		rw_enter_write(&pool->lock);
+		ts = TAILQ_FIRST(&pool->garbage);
+		if (ts == NULL) {
+			rw_exit_write(&pool->lock);
+			return 0;
+		}
+		error = agx_timestamp_unmap(ts);
+		if (error != 0) {
+			rw_exit_write(&pool->lock);
+			return error;
+		}
+		TAILQ_REMOVE(&pool->garbage, ts, link);
+		rw_exit_write(&pool->lock);
+		agx_timestamp_free(ts);
+	}
+}
+
+int
+agx_timestamp_pool_destroy(struct agx_timestamp_pool *pool)
+{
+	int error;
+
+	if (pool == NULL)
+		return EINVAL;
+	error = agx_timestamp_pool_collect(pool);
+	if (error != 0)
+		return error;
+	rw_enter_write(&pool->lock);
+	if (pool->files != 0 || pool->mappings != 0) {
+		rw_exit_write(&pool->lock);
+		return EBUSY;
+	}
+	drm_mm_takedown(&pool->va);
+	rw_exit_write(&pool->lock);
+	free(pool, M_DEVBUF, sizeof(*pool));
+	return 0;
+}
+
+int
+agx_timestamp_file_create(struct agx_timestamp_pool *pool,
+    struct agx_timestamp_file **out)
+{
+	struct agx_timestamp_file *file;
+
+	if (pool == NULL || out == NULL)
+		return EINVAL;
+	*out = NULL;
+	file = malloc(sizeof(*file), M_DEVBUF, M_WAITOK | M_ZERO);
+	rw_init(&file->lock, "agxtsfile");
+	TAILQ_INIT(&file->objects);
+	file->pool = pool;
+	rw_enter_write(&pool->lock);
+	if (pool->files == UINT_MAX) {
+		rw_exit_write(&pool->lock);
+		free(file, M_DEVBUF, sizeof(*file));
+		return EOVERFLOW;
+	}
+	pool->files++;
+	rw_exit_write(&pool->lock);
+	*out = file;
+	return 0;
+}
+
+void
+agx_timestamp_put(struct agx_timestamp *ts)
+{
+	struct agx_timestamp_pool *pool;
+	int error;
+
+	if (ts == NULL)
+		return;
+	pool = ts->pool;
+	rw_enter_write(&pool->lock);
+	KASSERT(ts->refs != 0);
+	if (--ts->refs != 0) {
+		rw_exit_write(&pool->lock);
+		return;
+	}
+	error = agx_timestamp_unmap(ts);
+	if (error != 0)
+		TAILQ_INSERT_TAIL(&pool->garbage, ts, link);
+	rw_exit_write(&pool->lock);
+	if (error == 0)
+		agx_timestamp_free(ts);
+}
+
+void
+agx_timestamp_file_destroy(struct agx_timestamp_file *file)
+{
+	struct agx_timestamp_pool *pool;
+	struct agx_timestamp *ts;
+
+	if (file == NULL)
+		return;
+	pool = file->pool;
+	/* Caller excludes concurrent file operations. */
+	while ((ts = TAILQ_FIRST(&file->objects)) != NULL) {
+		TAILQ_REMOVE(&file->objects, ts, link);
+		agx_timestamp_put(ts);
+	}
+	rw_enter_write(&pool->lock);
+	pool->files--;
+	rw_exit_write(&pool->lock);
+	free(file, M_DEVBUF, sizeof(*file));
+}
+
+static int
+agx_timestamp_bind(struct agx_timestamp_file *file, struct drm_file *drmfile,
+    struct drm_asahi_gem_bind_object *args)
+{
+	struct agx_timestamp_pool *pool = file->pool;
+	struct agx_timestamp *ts, *pos;
+	struct drm_gem_object *gem;
+	struct agx_bo *bo;
+	uint32_t id;
+	int error;
+
+	if (args->flags != DRM_ASAHI_BIND_OBJECT_USAGE_TIMESTAMPS ||
+	    args->range == 0 || ((args->offset | args->range) & AGX_PAGE_MASK) ||
+	    args->offset > UINT64_MAX - args->range)
+		return EINVAL;
+	gem = drm_gem_object_lookup(drmfile, args->handle);
+	if (gem == NULL)
+		return ENOENT;
+	bo = agx_bo_from_gem(gem);
+	/* A VM-private BO cannot be mapped in the kernel VM. */
+	if (bo == NULL || bo->mem == NULL || bo->private_vm != NULL ||
+	    args->offset > gem->size || args->range > gem->size - args->offset) {
+		drm_gem_object_put(gem);
+		return EINVAL;
+	}
+	error = agx_mem_pin(bo->mem, 0);
+	if (error != 0) {
+		drm_gem_object_put(gem);
+		return error;
+	}
+	ts = malloc(sizeof(*ts), M_DEVBUF, M_WAITOK | M_ZERO);
+	ts->pool = pool;
+	ts->gem = gem;
+	ts->mem = bo->mem;
+	ts->size = args->range;
+	ts->refs = 1;
+	rw_enter_write(&pool->lock);
+	error = drm_mm_insert_node_generic(&pool->va, &ts->node, args->range,
+	    AGX_PAGE_SIZE, 0, DRM_MM_INSERT_LOW);
+	if (error != 0) {
+		error = -error;
+		rw_exit_write(&pool->lock);
+		agx_timestamp_free(ts);
+		return error;
+	}
+	error = agx_uat_pt_map_kernel(pool->pt, ts->node.start, bo->mem,
+	    args->offset, args->range, AGX_UAT_FW_SHARED_RW);
+	if (error != 0) {
+		drm_mm_remove_node(&ts->node);
+		rw_exit_write(&pool->lock);
+		agx_timestamp_free(ts);
+		return error;
+	}
+	pool->mappings++;
+	rw_exit_write(&pool->lock);
+
+	/* Keep the list sorted so every handle, including UINT32_MAX, is usable. */
+	rw_enter_write(&file->lock);
+	id = 1;
+	TAILQ_FOREACH(pos, &file->objects, link) {
+		if (pos->handle != id)
+			break;
+		if (id == UINT32_MAX) {
+			rw_exit_write(&file->lock);
+			agx_timestamp_put(ts);
+			return ENOSPC;
+		}
+		id++;
+	}
+	ts->handle = id;
+	if (pos != NULL)
+		TAILQ_INSERT_BEFORE(pos, ts, link);
+	else
+		TAILQ_INSERT_TAIL(&file->objects, ts, link);
+	args->object_handle = id;
+	rw_exit_write(&file->lock);
+	return 0;
+}
+
+int
+agx_timestamp_ioctl(struct agx_timestamp_file *file, struct drm_file *drmfile,
+    struct drm_asahi_gem_bind_object *args)
+{
+	struct agx_timestamp *ts;
+
+	if (file == NULL || drmfile == NULL || args == NULL || args->pad != 0 ||
+	    args->vm_id != 0)
+		return EINVAL;
+	if (args->op == DRM_ASAHI_BIND_OBJECT_OP_BIND)
+		return agx_timestamp_bind(file, drmfile, args);
+	if (args->op != DRM_ASAHI_BIND_OBJECT_OP_UNBIND || args->range != 0 ||
+	    args->offset != 0 || args->flags != 0 || args->handle != 0)
+		return EINVAL;
+	rw_enter_write(&file->lock);
+	TAILQ_FOREACH(ts, &file->objects, link) {
+		if (ts->handle == args->object_handle)
+			break;
+	}
+	if (ts != NULL)
+		TAILQ_REMOVE(&file->objects, ts, link);
+	rw_exit_write(&file->lock);
+	if (ts == NULL)
+		return ENOENT;
+	agx_timestamp_put(ts);
+	return 0;
+}
+
+int
+agx_timestamp_lookup(struct agx_timestamp_file *file, uint32_t handle,
+    uint32_t offset, struct agx_timestamp **out, uint64_t *gpu)
+{
+	struct agx_timestamp *ts;
+	int error = 0;
+
+	if (file == NULL || out == NULL || gpu == NULL)
+		return EINVAL;
+	*out = NULL;
+	*gpu = 0;
+	if (handle == 0)
+		return 0;
+	rw_enter_read(&file->lock);
+	TAILQ_FOREACH(ts, &file->objects, link) {
+		if (ts->handle == handle)
+			break;
+	}
+	if (ts == NULL)
+		error = ENOENT;
+	else if (offset > UINT32_MAX - 8)
+		error = EINVAL;
+	else if ((uint64_t)offset + 8 > ts->size)
+		error = ERANGE;
+	else {
+		rw_enter_write(&file->pool->lock);
+		if (ts->refs == UINT_MAX)
+			error = EOVERFLOW;
+		else {
+			ts->refs++;
+			*out = ts;
+			*gpu = ts->node.start + offset;
+		}
+		rw_exit_write(&file->pool->lock);
+	}
+	rw_exit_read(&file->lock);
+	return error;
+}
+
+struct drm_gem_object *
+agx_timestamp_gem(struct agx_timestamp *ts)
+{
+	return ts != NULL ? ts->gem : NULL;
+}
