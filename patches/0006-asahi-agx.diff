@@ -0,0 +1,423 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* IRQ-to-process bridge for one queue event allocation. */
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/mutex.h>
+#include <sys/systm.h>
+#include <sys/task.h>
+#include <machine/intr.h>
+
+#include "agx_queue_event.h"
+
+/* Bounded before registration: no allocation in the event callback path. */
+#define AGX_QUEUE_EVENT_RECORDS 128
+
+enum agx_queue_event_kind {
+	AGX_QUEUE_EVENT_SIGNAL,
+	AGX_QUEUE_EVENT_ERROR,
+	AGX_QUEUE_EVENT_FAIL
+};
+
+struct agx_queue_event_record {
+	enum agx_queue_event_kind kind;
+	struct agx_event_token token;
+	uint32_t current, wait;
+	struct agx_event_error error;
+};
+
+struct agx_queue_event {
+	struct mutex lock;
+	struct task dispatch, destroy;
+	struct agx_event_guard guard;
+	struct agx_event_slots *manager;
+	struct agx_queue_event_info info;
+	struct agx_queue_event_ops ops;
+	void *cookie;
+	uint64_t queue_va;
+	uint32_t pipe;
+	struct agx_queue_event_record records[AGX_QUEUE_EVENT_RECORDS];
+	struct agx_queue_event_record failure;
+	unsigned int head, count, refs, users;
+	int ready, scheduled, closing, quarantine, released;
+	int overflow, overflow_delivered, failure_pending;
+};
+
+static void agx_queue_event_dispatch(void *);
+static void agx_queue_event_destroy(void *);
+static void agx_queue_event_owner_ref(void *);
+static void agx_queue_event_owner_unref(void *);
+static void agx_queue_event_signal(void *, struct agx_event_token, uint32_t);
+static void agx_queue_event_error(void *, struct agx_event_token, uint32_t,
+    uint32_t, const struct agx_event_error *);
+static void agx_queue_event_fail(void *, struct agx_event_token, uint32_t,
+    const struct agx_event_error *);
+static int agx_queue_event_recover(void *, struct agx_event_token, uint32_t,
+    uint32_t, uint32_t, const struct agx_event_error *, uint64_t *);
+static void agx_queue_event_recover_put(void *);
+
+static const struct agx_event_owner_ops agx_queue_event_owner_ops = {
+	.ref = agx_queue_event_owner_ref,
+	.unref = agx_queue_event_owner_unref,
+	.signal = agx_queue_event_signal,
+	.mark_error = agx_queue_event_error,
+	.fail_all = agx_queue_event_fail,
+	.recover = agx_queue_event_recover,
+	.recover_put = agx_queue_event_recover_put,
+};
+
+/* lock held.  One task reference covers the entire scheduled dispatch. */
+static void
+agx_queue_event_schedule(struct agx_queue_event *event)
+{
+	if (!event->ready || event->scheduled)
+		return;
+	KASSERT(event->refs != UINT_MAX);
+	event->refs++;
+	event->scheduled = 1;
+	task_add(systqmp, &event->dispatch);
+}
+
+/* The final owner must queue destruction only after releasing event->lock. */
+static int
+agx_queue_event_drop_locked(struct agx_queue_event *event)
+{
+	KASSERT(event->refs != 0);
+	return --event->refs == 0;
+}
+
+static void
+agx_queue_event_owner_ref(void *cookie)
+{
+	struct agx_queue_event *event = cookie;
+
+	mtx_enter(&event->lock);
+	KASSERT(event->refs != 0 && event->refs != UINT_MAX);
+	event->refs++;
+	mtx_leave(&event->lock);
+}
+
+static void
+agx_queue_event_owner_unref(void *cookie)
+{
+	struct agx_queue_event *event = cookie;
+	int destroy;
+
+	mtx_enter(&event->lock);
+	destroy = agx_queue_event_drop_locked(event);
+	mtx_leave(&event->lock);
+	if (destroy)
+		task_add(systqmp, &event->destroy);
+}
+
+int
+agx_queue_event_create(struct agx_event_reservation *reservation,
+    const struct agx_event_token *previous, const struct agx_queue_event_ops *ops,
+    void *cookie, uint32_t pipe, uint64_t queue_va, struct agx_queue_event **out)
+{
+	struct agx_queue_event *event;
+	int error;
+
+	if (out == NULL)
+		return EINVAL;
+	*out = NULL;
+	if (reservation == NULL || reservation->manager == NULL || ops == NULL ||
+	    cookie == NULL || queue_va == 0 ||
+	    ops->signal == NULL || ops->mark_error == NULL || ops->recover == NULL ||
+	    ops->fail_all == NULL || ops->overflow == NULL || ops->release == NULL)
+		return EINVAL;
+	event = malloc(sizeof(*event), M_DEVBUF, M_WAITOK | M_ZERO);
+	mtx_init(&event->lock, IPL_TTY);
+	task_set(&event->dispatch, agx_queue_event_dispatch, event);
+	task_set(&event->destroy, agx_queue_event_destroy, event);
+	event->ops = *ops;
+	event->cookie = cookie;
+	event->manager = reservation->manager;
+	event->pipe = pipe;
+	event->queue_va = queue_va;
+	event->refs = event->users = 1;
+	error = agx_event_slot_get_reserved(reservation, previous,
+	    &agx_queue_event_owner_ops, event, &event->guard);
+	if (error != 0) {
+		free(event, M_DEVBUF, sizeof(*event));
+		return error;
+	}
+	event->info.token = event->guard.token;
+	event->info.gpu_stamp = event->guard.gpu_stamp;
+	event->info.gpu_fw_stamp = event->guard.gpu_fw_stamp;
+	event->info.changed = event->guard.changed;
+	event->info.initial = agx_event_slot_current(&event->guard);
+	*out = event;
+	return 0;
+}
+
+void
+agx_queue_event_start(struct agx_queue_event *event)
+{
+	mtx_enter(&event->lock);
+	KASSERT(!event->ready && event->users != 0);
+	event->ready = 1;
+	if (event->count || event->overflow || event->failure_pending)
+		agx_queue_event_schedule(event);
+	mtx_leave(&event->lock);
+}
+
+void
+agx_queue_event_ref(struct agx_queue_event *event)
+{
+	mtx_enter(&event->lock);
+	KASSERT(event->users != 0 && event->users != UINT_MAX &&
+	    event->refs != UINT_MAX);
+	event->users++;
+	event->refs++;
+	mtx_leave(&event->lock);
+}
+
+void
+agx_queue_event_unref(struct agx_queue_event *event)
+{
+	int destroy;
+
+	mtx_enter(&event->lock);
+	KASSERT(event->users != 0);
+	if (--event->users == 0) {
+		KASSERT(event->closing);
+		agx_queue_event_schedule(event);
+	}
+	destroy = agx_queue_event_drop_locked(event);
+	mtx_leave(&event->lock);
+	if (destroy)
+		task_add(systqmp, &event->destroy);
+}
+
+void
+agx_queue_event_close(struct agx_queue_event *event, int quarantine)
+{
+	mtx_enter(&event->lock);
+	KASSERT(event->users != 0 && !event->closing);
+	event->closing = 1;
+	event->quarantine = quarantine != 0;
+	mtx_leave(&event->lock);
+}
+
+
+void
+agx_queue_event_info(struct agx_queue_event *event,
+    struct agx_queue_event_info *info)
+{
+	*info = event->info;
+}
+
+uint32_t
+agx_queue_event_current(struct agx_queue_event *event)
+{
+	return agx_event_slot_current(&event->guard);
+}
+
+static void
+agx_queue_event_capture(struct agx_queue_event *event,
+    const struct agx_queue_event_record *record)
+{
+	struct agx_queue_event_record *last;
+	unsigned int index;
+	int freeze = 0;
+
+	mtx_enter(&event->lock);
+	if (record->kind == AGX_QUEUE_EVENT_FAIL) {
+		/* fail_all is once per manager and has reserved storage. */
+		event->failure = *record;
+		event->failure_pending = 1;
+	} else if (!event->overflow) {
+		if (record->kind == AGX_QUEUE_EVENT_SIGNAL && event->count) {
+			index = (event->head + event->count - 1) %
+			    AGX_QUEUE_EVENT_RECORDS;
+			last = &event->records[index];
+			if (last->kind == AGX_QUEUE_EVENT_SIGNAL &&
+			    last->token.generation == record->token.generation &&
+			    last->token.slot == record->token.slot) {
+				if (agx_event_value_delta(record->current,
+				    last->current) > 0)
+					last->current = record->current;
+				goto scheduled;
+			}
+		}
+		if (event->count == AGX_QUEUE_EVENT_RECORDS) {
+			event->overflow = 1;
+			freeze = 1;
+		} else {
+			index = (event->head + event->count) %
+			    AGX_QUEUE_EVENT_RECORDS;
+			event->records[index] = *record;
+			event->count++;
+		}
+	}
+scheduled:
+	agx_queue_event_schedule(event);
+	mtx_leave(&event->lock);
+	/* Do not invert manager->lock against event->lock.  A callback's manager
+	 * reference keeps the manager alive until this invocation returns. */
+	if (freeze)
+		agx_event_slots_freeze(event->manager);
+}
+
+static int
+agx_queue_event_recover(void *cookie, struct agx_event_token token,
+    uint32_t current, uint32_t pipe, uint32_t wait,
+    const struct agx_event_error *error, uint64_t *queue_va)
+{
+	struct agx_queue_event *event = cookie;
+	return event->ops.recover(event->cookie, event, token, current, pipe,
+	    wait, error, queue_va);
+}
+
+int
+agx_queue_event_recover_pin(struct agx_queue_event *event,
+    struct agx_event_token token, uint32_t current, uint32_t pipe,
+    uint32_t wait, const struct agx_event_error *error, uint64_t *queue_va)
+{
+	struct agx_queue_event_record record = { .kind = AGX_QUEUE_EVENT_ERROR,
+	    .token = token, .current = current, .wait = wait, .error = *error };
+	unsigned int index;
+	int result = 0;
+
+	mtx_enter(&event->lock);
+	if (!event->ready || event->closing || event->released ||
+	    event->users == 0 || event->overflow || event->pipe != pipe ||
+	    token.slot != event->info.token.slot ||
+	    token.generation != event->info.token.generation ||
+	    agx_event_value_delta(wait, event->info.initial) <= 0 ||
+	    agx_event_value_delta(current, wait) >= 0)
+		/* The error callback retires through current before marking the
+		 * boundary.  A reached boundary would report the failed work as
+		 * successful, so recovery is no longer unambiguous. */
+		result = EIO;
+	else if (event->count == AGX_QUEUE_EVENT_RECORDS ||
+	    event->users == UINT_MAX || event->refs == UINT_MAX)
+		result = EOVERFLOW;
+	else {
+		/* This user pin prevents slot recycling and keeps the queue's
+		 * event reference, and hence its firmware allocations, alive. */
+		event->users++;
+		event->refs++;
+		index = (event->head + event->count) % AGX_QUEUE_EVENT_RECORDS;
+		event->records[index] = record;
+		event->count++;
+		*queue_va = event->queue_va;
+		agx_queue_event_schedule(event);
+	}
+	mtx_leave(&event->lock);
+	return result;
+}
+
+static void
+agx_queue_event_recover_put(void *cookie)
+{
+	agx_queue_event_unref(cookie);
+}
+
+static void
+agx_queue_event_signal(void *cookie, struct agx_event_token token, uint32_t cur)
+{
+	struct agx_queue_event_record record = { .kind = AGX_QUEUE_EVENT_SIGNAL,
+	    .token = token, .current = cur };
+
+	agx_queue_event_capture(cookie, &record);
+}
+
+static void
+agx_queue_event_error(void *cookie, struct agx_event_token token, uint32_t cur,
+    uint32_t wait, const struct agx_event_error *error)
+{
+	struct agx_queue_event_record record = { .kind = AGX_QUEUE_EVENT_ERROR,
+	    .token = token, .current = cur, .wait = wait, .error = *error };
+
+	agx_queue_event_capture(cookie, &record);
+}
+
+static void
+agx_queue_event_fail(void *cookie, struct agx_event_token token, uint32_t cur,
+    const struct agx_event_error *error)
+{
+	struct agx_queue_event_record record = { .kind = AGX_QUEUE_EVENT_FAIL,
+	    .token = token, .current = cur, .error = *error };
+
+	agx_queue_event_capture(cookie, &record);
+}
+
+static void
+agx_queue_event_dispatch(void *cookie)
+{
+	struct agx_queue_event *event = cookie;
+	struct agx_queue_event_record record;
+	int destroy, release, quarantine, overflow;
+
+	for (;;) {
+		mtx_enter(&event->lock);
+		overflow = event->overflow && !event->overflow_delivered;
+		if (overflow) {
+			event->overflow_delivered = 1;
+			mtx_leave(&event->lock);
+			event->ops.overflow(event->cookie);
+			continue;
+		}
+		/* Once an error record was lost no subsequent stamp can prove
+		 * success.  Keep the records until stopped fail_all instead. */
+		if (!event->overflow && event->count != 0) {
+			record = event->records[event->head];
+			event->head = (event->head + 1) % AGX_QUEUE_EVENT_RECORDS;
+			event->count--;
+		} else if (event->failure_pending) {
+			record = event->failure;
+			event->failure_pending = 0;
+			if (event->overflow)
+				record.current = event->info.initial;
+		} else {
+			release = event->closing && event->users == 0 &&
+			    !event->released;
+			quarantine = event->quarantine || event->overflow;
+			if (release)
+				event->released = 1;
+			else {
+				event->scheduled = 0;
+				destroy = agx_queue_event_drop_locked(event);
+			}
+			mtx_leave(&event->lock);
+			if (!release) {
+				if (destroy)
+					task_add(systqmp, &event->destroy);
+				return;
+			}
+			if (quarantine)
+				agx_event_slot_quarantine(&event->guard);
+			else
+				agx_event_slot_put(&event->guard);
+			continue;
+		}
+		mtx_leave(&event->lock);
+		if (record.token.slot != event->info.token.slot ||
+		    record.token.generation != event->info.token.generation)
+			continue;
+		switch (record.kind) {
+		case AGX_QUEUE_EVENT_SIGNAL:
+			event->ops.signal(event->cookie, record.token, record.current);
+			break;
+		case AGX_QUEUE_EVENT_ERROR:
+			event->ops.mark_error(event->cookie, record.token,
+			    record.current, record.wait, &record.error);
+			break;
+		case AGX_QUEUE_EVENT_FAIL:
+			event->ops.fail_all(event->cookie, record.token,
+			    record.current, &record.error);
+			break;
+		}
+	}
+}
+
+static void
+agx_queue_event_destroy(void *cookie)
+{
+	struct agx_queue_event *event = cookie;
+
+	event->ops.release(event->cookie);
+	free(event, M_DEVBUF, sizeof(*event));
+}
Index: sys/dev/pci/drm/asahi/agx_queue_event.h
===================================================================
--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_queue_event.h	Tue Nov 10 16:34:40 2026
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* A queue's shared, reference-pinned firmware event allocation. */
+#ifndef _AGX_QUEUE_EVENT_H_
+#define _AGX_QUEUE_EVENT_H_
+
+#include "agx_event_slots.h"
+
+struct agx_queue_event;
+
+struct agx_queue_event_info {
+	struct agx_event_token token;
+	uint64_t gpu_stamp, gpu_fw_stamp;
+	uint32_t initial;
+	int changed;
+};
+
+/*
+ * All methods execute serially in process context, without bridge locks.
+ * mark_error must first retire genuinely completed work through current, then
+ * mark outstanding work through wait_value; ignore wait_value at/before the
+ * epoch's initial value.  Both current and wait_value can arrive out of order.
+ * fail_all is delivered only after the event manager has been told the GPU is
+ * stopped.  overflow must contain/fail the device, not complete its work.
+ *
+ * The table is copied at creation.  The caller keeps cookie alive until release
+ * is called, including through quarantine and stopped reap.  release is the
+ * last callback; it may drop an independent cookie reference.  If that cookie
+ * owns an epoch reference, it must close and drop it explicitly to avoid a
+ * cycle.  No callbacks are delivered before start; initialize cookie and
+ * install the epoch in its pipe before starting it.  On create failure no
+ * callback, including release, is made.
+ */
+struct agx_queue_event_ops {
+	void (*signal)(void *, struct agx_event_token, uint32_t);
+	void (*mark_error)(void *, struct agx_event_token, uint32_t, uint32_t,
+	    const struct agx_event_error *);
+	void (*fail_all)(void *, struct agx_event_token, uint32_t,
+	    const struct agx_event_error *);
+	int (*recover)(void *, struct agx_queue_event *, struct agx_event_token,
+	    uint32_t, uint32_t, uint32_t, const struct agx_event_error *,
+	    uint64_t *);
+	void (*overflow)(void *);
+	void (*release)(void *);
+};
+
+int agx_queue_event_create(struct agx_event_reservation *,
+    const struct agx_event_token *, const struct agx_queue_event_ops *,
+    void *, uint32_t, uint64_t, struct agx_queue_event **);
+/* Queue state lock held; called only by the recover callback. */
+int agx_queue_event_recover_pin(struct agx_queue_event *,
+    struct agx_event_token, uint32_t, uint32_t, uint32_t,
+    const struct agx_event_error *, uint64_t *);
+/* Call exactly once on every successful creation, before dropping its ref. */
+void agx_queue_event_start(struct agx_queue_event *);
+/* ref requires an existing strong reference; ref/unref are IPL_TTY safe. */
+void agx_queue_event_ref(struct agx_queue_event *);
+void agx_queue_event_unref(struct agx_queue_event *);
+/*
+ * Close exactly once, then drop the owner's reference.  Existing job and
+ * encoded-barrier references keep the same slot pinned.  Normal close promises
+ * all firmware use has retired before the last reference is dropped.
+ * Quarantine retains registration and cookie until stopped reap.  Freeze or
+ * crash alone is not stop proof.  Last unref schedules slot release on systqmp;
+ * drain it from another context after all job/barrier refs are dropped and
+ * before agx_event_slots_reap_stopped().  Stop and fail_all, quiesce manager
+ * callbacks and drain their delivery before dropping those refs.  Never wait
+ * for epoch delivery or release from a systqmp task.
+ */
+void agx_queue_event_close(struct agx_queue_event *, int quarantine);
+void agx_queue_event_info(struct agx_queue_event *, struct agx_queue_event_info *);
+/* Requires a strong reference; do not race against stopped manager teardown. */
+uint32_t agx_queue_event_current(struct agx_queue_event *);
+
+#endif
Index: sys/dev/pci/drm/asahi/agx_queue_job.c
