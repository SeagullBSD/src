+	    version == 12 ? sizeof(*scene12) : sizeof(*scene13);
+	tpc_size = (tile->tpc_size + 0x3fff) & ~(size_t)0x3fff;
+	memset(&s, 0, sizeof(s));
+	s.g14x = g14x;
+	s.clusters = clusters;
+	preempt_clusters = clusters > 1 ? clusters + 1 : 1;
+	s.preempt2_offset = preempt_clusters * 0x540;
+	s.preempt3_offset = s.preempt2_offset + preempt_clusters * 0x280;
+	error = agx_scene_object(user, clusters > 1 ? 0x10080 : 0x80, 1,
+	    &s.user_buffer);
+	if (error != 0)
+		goto fail;
+	error = agx_scene_object(user, 0x200 + tile->layermeta_size, 1, &s.heapmeta);
+	if (error != 0)
+		goto fail;
+	error = agx_scene_object(user, tile->tilemap_size, 1, &s.tilemap);
+	if (error != 0)
+		goto fail;
+	error = agx_scene_object(user, s.preempt3_offset +
+	    preempt_clusters * (g14x ? 0x40 : 0x20), 1, &s.preempt);
+	if (error != 0)
+		goto fail;
+	error = agx_scene_object(private, tpc_size, 0x4000, &s.tpc);
+	if (error != 0)
+		goto fail;
+	if (clusters > 1) {
+		s.meta1_offset = tile->layermeta_size * 64;
+		s.meta2_offset = s.meta1_offset +
+		    ((tile->meta1_blocks * (size_t)0x44 + 0x7f) & ~(size_t)0x7f);
+		s.meta3_offset = s.meta2_offset + 0xc00;
+		s.meta4_offset = s.meta3_offset + 0x2800;
+		meta_size = s.meta4_offset + 0x800;
+		error = agx_scene_object(user, tile->tilemap_size * 64, 1,
+		    &s.cluster_tilemaps);
+		if (error != 0)
+			goto fail;
+		error = agx_scene_object(user, meta_size, 1, &s.cluster_meta);
+		if (error != 0)
+			goto fail;
+	}
+	if (g14x) {
+		error = agx_scene_object(gpu, sizeof(uint32_t), 1, &s.control_word);
+		if (error != 0)
+			goto fail;
+	}
+	error = agx_scene_object(shared, scene_size, 1, &s.scene);
+	if (error != 0)
+		goto fail;
+	if (version == 12) {
+		scene12 = s.scene->cpu;
+		scene12->user_buffer = s.user_buffer->gpu;
+		scene12->stats = stats_va;
+	} else if (g14x) {
+		sceneg = s.scene->cpu;
+		sceneg->control_word = sceneg->control_word2 = s.control_word->gpu;
+		sceneg->user_buffer = s.user_buffer->gpu;
+		sceneg->stats = stats_va;
+	} else {
+		scene13 = s.scene->cpu;
+		scene13->user_buffer = s.user_buffer->gpu;
+		scene13->stats = stats_va;
+	}
+	*out = s;
+	return 0;
+fail:
+	agx_scene_free(&s);
+	return error;
+}
+
+int
+agx_render_microseq(struct agx_microseq *seq, unsigned int version, int fragment,
+    const struct agx_render_microseq_args *a)
+{
+	struct agx_fw_start_vertex_12_3 sv12;
+	struct agx_fw_start_vertex_13_5 sv13;
+	struct agx_fw_start_vertex_g14x_13_5 svg;
+	struct agx_fw_finalize_vertex_12_3 ev12;
+	struct agx_fw_finalize_vertex_13_5 ev13;
+	struct agx_fw_start_fragment_12_3 sf12;
+	struct agx_fw_start_fragment_13_5 sf13;
+	struct agx_fw_start_fragment_g14x_13_5 sfg;
+	struct agx_fw_finalize_fragment_12_3 ef12;
+	struct agx_fw_finalize_fragment_13_5 ef13;
+	struct agx_fw_microseq_timestamp_12_3 ts12;
+	struct agx_fw_microseq_timestamp_13_5 ts13;
+	uint64_t p1 = 0, p2 = 0, regs = 0, tiling = 0, unk, jobbuf, busy = 0, overflow = 0;
+	uint64_t flag = 0, cmdtime, tsptr, userts, unktime = 0;
+	uint32_t op;
+	int32_t start, off, ignored;
+	size_t original;
+	int error, i;
+
+	if ((version != 12 && version != 13) || (a->g14x && version != 13) ||
+	    (fragment != 0 && fragment != 1) ||
+	    a->work_va == 0 || a->scene_va == 0 || a->buffer_va == 0 ||
+	    a->stats_va == 0 || a->queue_va == 0 || a->fw_stamp_va == 0 ||
+	    (version == 13 && a->notifier_buf_va == 0) ||
+	    a->attachments.count > AGX_MAX_ATTACHMENTS ||
+	    a->work_va > UINT64_MAX - (a->g14x ?
+	    sizeof(struct agx_fw_fragment_g14x_13_5) :
+	    sizeof(struct agx_fw_fragment_13_5)))
+		return EINVAL;
+#define BASE_OFF(type) do { \
+	unk = a->work_va + offsetof(type, unk_pointee); \
+	jobbuf = a->work_va + offsetof(type, unk_buf_0); \
+	cmdtime = a->work_va + offsetof(type, command_time); \
+	tsptr = a->work_va + offsetof(type, timestamp_pointers); \
+	userts = a->work_va + offsetof(type, user_timestamp_pointers); \
+} while (0)
+#define COMMON_OFF(type) do { \
+	BASE_OFF(type); \
+	p1 = a->work_va + offsetof(type, job_params1); \
+	p2 = a->work_va + offsetof(type, job_params2); \
+} while (0)
+#define VTX_OFF(type) do { \
+	COMMON_OFF(type); tiling = a->work_va + offsetof(type, tiling_params); \
+} while (0)
+#define FRAG_OFF(type) do { \
+	COMMON_OFF(type); busy = a->work_va + offsetof(type, busy_flag); \
+	overflow = a->work_va + offsetof(type, tvb_overflow_count); \
+	flag = a->work_va + offsetof(type, unk_758_flag); \
+} while (0)
+	if (!fragment && version == 12) {
+		VTX_OFF(struct agx_fw_vertex_12_3);
+	} else if (!fragment && a->g14x) {
+		BASE_OFF(struct agx_fw_vertex_g14x_13_5);
+		regs = a->work_va + offsetof(struct agx_fw_vertex_g14x_13_5, registers);
+		unktime = a->work_va + offsetof(struct agx_fw_vertex_g14x_13_5, unk_ts);
+	} else if (!fragment) {
+		VTX_OFF(struct agx_fw_vertex_13_5);
+		unktime = a->work_va + offsetof(struct agx_fw_vertex_13_5, unk_ts);
+	} else if (version == 12) {
+		FRAG_OFF(struct agx_fw_fragment_12_3);
+	} else if (a->g14x) {
+		BASE_OFF(struct agx_fw_fragment_g14x_13_5);
+		regs = a->work_va + offsetof(struct agx_fw_fragment_g14x_13_5, registers);
+		busy = a->work_va + offsetof(struct agx_fw_fragment_g14x_13_5, busy_flag);
+		overflow = a->work_va + offsetof(struct agx_fw_fragment_g14x_13_5, tvb_overflow_count);
+		flag = a->work_va + offsetof(struct agx_fw_fragment_g14x_13_5, unk_758_flag);
+		unktime = a->work_va + offsetof(struct agx_fw_fragment_g14x_13_5, unk_ts);
+	} else {
+		FRAG_OFF(struct agx_fw_fragment_13_5);
+		unktime = a->work_va + offsetof(struct agx_fw_fragment_13_5, unk_ts);
+	}
+#undef FRAG_OFF
+#undef VTX_OFF
+#undef COMMON_OFF
+#undef BASE_OFF
+	original = seq->size;
+#define VSTART(s) do { \
+	memset(&(s), 0, sizeof(s)); (s).header = AGX_FW_OP_START_VERTEX; \
+	(s).tiling_params = tiling; (s).job_params1 = p1; \
+	(s).buffer = a->buffer_va; (s).scene = a->scene_va; \
+	(s).stats = a->stats_va; (s).work_queue = a->queue_va; \
+	(s).vm_slot = a->vm_slot; (s).unk_38 = 1; \
+	(s).event_generation = a->event_generation; (s).buffer_slot = a->buffer_slot; \
+	(s).event_seq.value = a->event_seq; (s).unk_pointer = unk; \
+	(s).unk_job_buf = jobbuf; (s).attachments = a->attachments; \
+} while (0)
+#define FSTART(s) do { \
+	memset(&(s), 0, sizeof(s)); (s).header = AGX_FW_OP_START_FRAGMENT; \
+	(s).job_params1 = p1; (s).job_params2 = p2; (s).scene = a->scene_va; \
+	(s).stats = a->stats_va; (s).busy_flag = busy; (s).tvb_overflow_count = overflow; \
+	(s).unk_pointer = unk; (s).work_queue = a->queue_va; (s).work_item = a->work_va; \
+	(s).vm_slot = a->vm_slot; (s).unk_50 = 1; \
+	(s).event_generation = a->event_generation; (s).buffer_slot = a->buffer_slot; \
+	(s).event_seq.value = a->event_seq; (s).unk_758_flag = flag; \
+	(s).unk_job_buf = jobbuf; (s).attachments = a->attachments; \
+} while (0)
+	if (!fragment && version == 12) {
+		VSTART(sv12); error = agx_microseq_append(seq, &sv12, sizeof(sv12), &start);
+	} else if (!fragment && a->g14x) {
+		VSTART(svg); svg.registers = regs; svg.counter.value = a->counter;
+		svg.notifier_buf = a->notifier_buf_va; svg.unk_178 = 1;
+		error = agx_microseq_append(seq, &svg, sizeof(svg), &start);
+	} else if (!fragment) {
+		VSTART(sv13); sv13.counter.value = a->counter;
+		sv13.notifier_buf = a->notifier_buf_va; sv13.unk_178 = 1;
+		error = agx_microseq_append(seq, &sv13, sizeof(sv13), &start);
+	} else if (version == 12) {
+		FSTART(sf12); error = agx_microseq_append(seq, &sf12, sizeof(sf12), &start);
+	} else if (a->g14x) {
+		FSTART(sfg); sfg.registers = regs; sfg.counter.value = a->counter;
+		sfg.notifier_buf = a->notifier_buf_va;
+		error = agx_microseq_append(seq, &sfg, sizeof(sfg), &start);
+	} else {
+		FSTART(sf13); sf13.counter.value = a->counter;
+		sf13.notifier_buf = a->notifier_buf_va;
+		error = agx_microseq_append(seq, &sf13, sizeof(sf13), &start);
+	}
+#undef FSTART
+#undef VSTART
+	if (error != 0)
+		goto fail;
+	for (i = 0; i < 2; i++) {
+		if (i == 1) {
+			op = a->g14x ? AGX_FW_OP_WAIT_IDLE2 :
+			    AGX_FW_OP_WAIT_IDLE | ((fragment ? AGX_FW_MICROSEQ_PIPE_FRAGMENT :
+			    AGX_FW_MICROSEQ_PIPE_VERTEX) << 8);
+			error = agx_microseq_append(seq, &op, sizeof(op), &ignored);
+			if (error != 0)
+				goto fail;
+		}
+		if (!a->timestamps)
+			continue;
+#define TIMESTAMP(t) do { \
+	memset(&(t), 0, sizeof(t)); \
+	(t).header = AGX_FW_OP_TIMESTAMP | (i == 0 ? 0x80000000U : 0); \
+	(t).command_time = cmdtime; (t).ts_pointers = tsptr; \
+	(t).update_ts = tsptr + (i == 0 ? 0 : sizeof(uint64_t)); \
+	(t).work_queue = a->queue_va; (t).user_ts_pointers = userts; \
+} while (0)
+		if (version == 12) {
+			TIMESTAMP(ts12); error = agx_microseq_append(seq, &ts12, sizeof(ts12), &ignored);
+		} else {
+			TIMESTAMP(ts13); ts13.unk_ts = unktime;
+			error = agx_microseq_append(seq, &ts13, sizeof(ts13), &ignored);
+		}
+#undef TIMESTAMP
+		if (error != 0)
+			goto fail;
+	}
+	error = agx_microseq_branch(seq, start, &off);
+	if (error != 0)
+		goto fail;
+#define VFINAL(s) do { \
+	memset(&(s), 0, sizeof(s)); (s).header = AGX_FW_OP_FINALIZE_VERTEX; \
+	(s).scene = a->scene_va; (s).buffer = a->buffer_va; (s).stats = a->stats_va; \
+	(s).work_queue = a->queue_va; (s).vm_slot = a->vm_slot; (s).unk_pointer = unk; \
+	(s).fw_stamp = a->fw_stamp_va; (s).stamp_value = a->stamp_value; \
+	(s).restart_branch_offset = off; (s).has_attachments = a->attachments.count != 0; \
+} while (0)
+#define FFINAL(s) do { \
+	memset(&(s), 0, sizeof(s)); (s).header = AGX_FW_OP_FINALIZE_FRAGMENT; \
+	(s).fw_stamp = a->fw_stamp_va; (s).stamp_value = a->stamp_value; \
+	(s).scene = a->scene_va; (s).buffer = a->buffer_va; (s).unk_2c.value = 1; \
+	(s).stats = a->stats_va; (s).unk_pointer = unk; (s).busy_flag = busy; \
+	(s).work_queue = a->queue_va; (s).work_item = a->work_va; \
+	(s).vm_slot = a->vm_slot; (s).unk_758_flag = flag; \
+	(s).restart_branch_offset = off; (s).has_attachments = a->attachments.count != 0; \
+} while (0)
+	if (!fragment && version == 12) {
+		VFINAL(ev12); error = agx_microseq_append(seq, &ev12, sizeof(ev12), &ignored);
+	} else if (!fragment) {
+		VFINAL(ev13); error = agx_microseq_append(seq, &ev13, sizeof(ev13), &ignored);
+	} else if (version == 12) {
+		FFINAL(ef12); error = agx_microseq_append(seq, &ef12, sizeof(ef12), &ignored);
+	} else {
+		FFINAL(ef13); error = agx_microseq_append(seq, &ef13, sizeof(ef13), &ignored);
+	}
+#undef FFINAL
+#undef VFINAL
+	if (error != 0)
+		goto fail;
+	op = AGX_FW_OP_RETIRE_STAMP;
+	error = agx_microseq_append(seq, &op, sizeof(op), &ignored);
+	if (error == 0)
+		return 0;
+fail:
+	seq->size = original;
+	return error;
+}
