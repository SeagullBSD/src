--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_queue.c	Tue Nov 17 16:17:08 2026
@@ -0,0 +1,208 @@
+/* SPDX-License-Identifier: MIT */
+/* Stable Asahi command stream validation. */
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <drm/asahi_drm.h>
+#include <drm/drm_gem.h>
+#include <drm/drm_syncobj.h>
+
+#include "agx_queue.h"
+
+static int
+agx_decode_command(void *dst, size_t dstlen, const uint8_t *src, size_t len)
+{
+	size_t n, i;
+
+	n = MIN(dstlen, len);
+	memset(dst, 0, dstlen);
+	memcpy(dst, src, n);
+	for (i = n; i < len; i++) {
+		if (src[i] != 0)
+			return EINVAL;
+	}
+	return 0;
+}
+
+int
+agx_build_attachments(const void *data, size_t size,
+    struct agx_fw_attachments *out)
+{
+	const uint8_t *p = data;
+	struct agx_fw_attachments result;
+	struct drm_asahi_attachment att;
+	uint64_t lines;
+	size_t i, count;
+
+	if (size % sizeof(att) != 0 || size / sizeof(att) > AGX_MAX_ATTACHMENTS)
+		return EINVAL;
+	memset(&result, 0, sizeof(result));
+	count = size / sizeof(att);
+	for (i = 0; i < count; i++) {
+		memcpy(&att, p + i * sizeof(att), sizeof(att));
+		lines = (att.size >> 7) + ((att.size & 127) != 0);
+		if (att.flags != 0 || att.pad != 0 || lines > UINT32_MAX)
+			return EINVAL;
+		memcpy(&result.list[i].address, &att.pointer, sizeof(att.pointer));
+		result.list[i].size = lines;
+		result.list[i].unk_c = 0x17;
+		result.list[i].unk_e = 1;
+	}
+	result.count = count;
+	*out = result;
+	return 0;
+}
+
+int
+agx_validate_sync(const struct drm_asahi_sync *sync, int output)
+{
+	switch (sync->sync_type) {
+	case DRM_ASAHI_SYNC_SYNCOBJ:
+		return sync->timeline_value == 0 ? 0 : EINVAL;
+	case DRM_ASAHI_SYNC_SHARED_BO:
+		return !output && sync->timeline_value == 0 ? 0 : EINVAL;
+	case DRM_ASAHI_SYNC_TIMELINE_SYNCOBJ:
+		return 0;
+	default:
+		return EINVAL;
+	}
+}
+
+void
+agx_sync_cleanup(struct agx_sync *sync)
+{
+	if (sync->chain != NULL)
+		dma_fence_chain_free(sync->chain);
+	dma_fence_put(sync->dependency);
+	if (sync->object != NULL)
+		drm_syncobj_put(sync->object);
+	if (sync->gem != NULL)
+		drm_gem_object_put(sync->gem);
+	memset(sync, 0, sizeof(*sync));
+}
+
+int
+agx_sync_prepare(struct drm_file *file, const struct drm_asahi_sync *item,
+    int output, struct agx_sync *sync)
+{
+	int error;
+
+	memset(sync, 0, sizeof(*sync));
+	error = agx_validate_sync(item, output);
+	if (error != 0)
+		return error;
+	if (item->sync_type == DRM_ASAHI_SYNC_SHARED_BO) {
+		sync->gem = drm_gem_object_lookup(file, item->handle);
+		return sync->gem != NULL ? 0 : ENOENT;
+	}
+	sync->object = drm_syncobj_find(file, item->handle);
+	if (sync->object == NULL)
+		return ENOENT;
+	sync->point = item->timeline_value;
+	sync->is_output = output != 0;
+	if (output && item->sync_type == DRM_ASAHI_SYNC_TIMELINE_SYNCOBJ) {
+		sync->chain = dma_fence_chain_alloc();
+		if (sync->chain == NULL) {
+			error = ENOMEM;
+			goto fail;
+		}
+	} else if (!output) {
+		sync->dependency = drm_syncobj_fence_get(sync->object);
+		if (sync->dependency == NULL) {
+			error = EINVAL;
+			goto fail;
+		}
+		if (item->sync_type == DRM_ASAHI_SYNC_TIMELINE_SYNCOBJ) {
+			error = dma_fence_chain_find_seqno(&sync->dependency,
+			    sync->point);
+			if (error != 0) {
+				error = -error;
+				goto fail;
+			}
+			/* A collected, already-signaled point has no fence. */
+			if (sync->dependency == NULL)
+				sync->dependency = dma_fence_get_stub();
+		}
+	}
+	return 0;
+fail:
+	agx_sync_cleanup(sync);
+	return error;
+}
+
+
+int
+agx_validate_cmdbuf(const void *buffer, size_t size, struct agx_cmd_counts *out)
+{
+	const uint8_t *p = buffer;
+	struct drm_asahi_cmd_header h;
+	struct drm_asahi_cmd_render render;
+	struct drm_asahi_cmd_compute compute;
+	struct drm_asahi_attachment att;
+	struct agx_cmd_counts counts = { 0, 0 };
+	struct agx_tile_info tile;
+	uint64_t lines;
+	size_t i;
+	int error;
+
+	while (size != 0) {
+		if (size < sizeof(h))
+			return EINVAL;
+		memcpy(&h, p, sizeof(h));
+		p += sizeof(h);
+		size -= sizeof(h);
+		if (h.size > size)
+			return EINVAL;
+		switch (h.cmd_type) {
+		case DRM_ASAHI_CMD_RENDER:
+		case DRM_ASAHI_CMD_COMPUTE:
+			if ((h.vdm_barrier != DRM_ASAHI_BARRIER_NONE &&
+			    h.vdm_barrier > counts.render) ||
+			    (h.cdm_barrier != DRM_ASAHI_BARRIER_NONE &&
+			    h.cdm_barrier > counts.compute))
+				return EINVAL;
+			if (h.cmd_type == DRM_ASAHI_CMD_RENDER) {
+				error = agx_decode_command(&render, sizeof(render), p, h.size);
+				if (error != 0)
+					return error;
+				error = agx_render_tiling(&render, 1, &tile);
+				if (error != 0)
+					return error;
+				counts.render++;
+			} else {
+				error = agx_decode_command(&compute, sizeof(compute), p, h.size);
+				if (error != 0)
+					return error;
+				if (compute.flags != 0)
+					return EINVAL;
+				counts.compute++;
+			}
+			if (counts.render + counts.compute > AGX_MAX_COMMANDS)
+				return EINVAL;
+			break;
+		case DRM_ASAHI_SET_VERTEX_ATTACHMENTS:
+		case DRM_ASAHI_SET_FRAGMENT_ATTACHMENTS:
+		case DRM_ASAHI_SET_COMPUTE_ATTACHMENTS:
+			if (h.vdm_barrier != DRM_ASAHI_BARRIER_NONE ||
+			    h.cdm_barrier != DRM_ASAHI_BARRIER_NONE ||
+			    h.size % sizeof(att) != 0 ||
+			    h.size / sizeof(att) > AGX_MAX_ATTACHMENTS)
+				return EINVAL;
+			for (i = 0; i < h.size; i += sizeof(att)) {
+				memcpy(&att, p + i, sizeof(att));
+				lines = (att.size >> 7) + ((att.size & 127) != 0);
+				if (att.flags != 0 || att.pad != 0 || lines > UINT32_MAX)
+					return EINVAL;
+			}
+			break;
+		default:
+			return EINVAL;
+		}
+		p += h.size;
+		size -= h.size;
+	}
+	if (counts.render + counts.compute == 0)
+		return EINVAL;
+	*out = counts;
+	return 0;
+}
