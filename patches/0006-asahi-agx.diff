+};
+/* Ranges are disjoint 32K-aligned halves of the VM's reserved range. */
+int	agx_vm_internal_range(struct agx_vm *, enum agx_vm_internal_kind,
+	    uint64_t *, uint64_t *);
+int	agx_vm_map_internal(struct agx_vm *, uint64_t, struct agx_mem *,
+	    uint64_t, enum agx_vm_internal_kind);
+int	agx_vm_unmap_internal(struct agx_vm *, uint64_t, uint64_t,
+	    enum agx_vm_internal_kind, agx_uat_flush_fn, void *);
+
+/*
+ * A private, lower-half GPU-only translation table.  This is a page-table
+ * primitive, not a VM or binding: the caller must enforce its VM's reserved
+ * VA range, track and retain backing memory, and synchronize GPU users.
+ * The physical root remains valid until destroy.  Destroy only after the
+ * hardware can no longer walk it.  Mapping does not replace existing PTEs.
+ */
+int	agx_uat_pt_create(bus_dma_tag_t, unsigned int, struct agx_uat_pt **);
+/* Root and its existing children are bootloader-owned and remain borrowed. */
+int	agx_uat_pt_create_kernel(bus_dma_tag_t, bus_space_tag_t, paddr_t,
+	    unsigned int, struct agx_uat_pt **);
+unsigned int agx_uat_pt_oas(const struct agx_uat_pt *);
+unsigned int agx_vm_oas(const struct agx_vm *);
+void	agx_uat_pt_destroy(struct agx_uat_pt *);
+paddr_t	agx_uat_pt_root(struct agx_uat_pt *);
+int	agx_uat_pt_map(struct agx_uat_pt *, uint64_t, struct agx_mem *,
+	    uint64_t, uint64_t, enum agx_uat_gpu_prot, int);
+/* Existing mappings use break-before-make; caller must quiesce GPU work.
+ * A pending firmware cache flush blocks replacement until safe unmap. */
+int	agx_uat_pt_replace(struct agx_uat_pt *, uint64_t, struct agx_mem *,
+	    uint64_t, uint64_t, enum agx_uat_gpu_prot, int);
+/* Maps a zeroed, retained page at the firmware-reserved dummy address. */
+int	agx_uat_pt_map_dummy(struct agx_uat_pt *, struct agx_mem *);
+int	agx_uat_pt_map_kernel(struct agx_uat_pt *, uint64_t, struct agx_mem *,
+	    uint64_t, uint64_t, enum agx_uat_fw_prot);
+/* Cached mappings require this flush path; serialize overlapping operations. */
+int	agx_uat_pt_unmap_cached(struct agx_uat_pt *, struct agx_uat_handoff *,
+	    uint64_t, uint64_t, agx_uat_flush_fn, void *);
+int	agx_uat_pt_unmap_after_reset(struct agx_uat_pt *,
+	    struct agx_uat_handoff *, uint64_t, uint64_t);
+int	agx_uat_pt_map_io(struct agx_uat_pt *, uint64_t, paddr_t, uint64_t,
+	    int);
+int	agx_uat_pt_map_fw_shared_phys(struct agx_uat_pt *, uint64_t, paddr_t,
+	    uint64_t);
+int	agx_uat_pt_unmap(struct agx_uat_pt *, uint64_t, uint64_t);
+
+#endif
