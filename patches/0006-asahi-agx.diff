+
+#include <sys/types.h>
+
+/* IEEE 754 binary32 bit patterns; no hardware floating point is used. */
+typedef uint32_t agx_f32;
+
+agx_f32 agx_f32_from_u32(uint32_t);
+agx_f32 agx_f32_from_i32(int32_t);
+agx_f32 agx_f32_neg(agx_f32);
