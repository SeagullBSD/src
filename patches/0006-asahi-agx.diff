@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Linux Asahi regs.rs:get_gpu_id and hw/{t8103,t602x}.rs. */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/bus.h>
+#include <dev/ofw/openfirm.h>
+
+#include "agx_device.h"
+#include "agx_hw_t8103.h"
+#include "agx_identity.h"
+
+#define AGX_ID_VERSION		0xd04000
+#define AGX_ID_UNK08		0xd04008
+#define AGX_ID_COUNTS_1		0xd04010
+#define AGX_ID_COUNTS_2		0xd04014
+#define AGX_ID_UNK18		0xd04018
+#define AGX_ID_CLUSTERS		0xd0401c
+#define AGX_CORE_MASK_0		0xd01500
+#define AGX_CORE_MASK_1		0xd01514
+#define AGX_CORE_MASK_G14X	0xe01500
+
+int
+agx_identity_read(const struct agx_resources *res, struct agx_identity *out)
+{
+	struct agx_identity id;
+	uint32_t mask, valid, rev, bit;
+	unsigned int n, i, total_bits;
+	int g14c;
+
+	if (res == NULL || out == NULL)
+		return EINVAL;
+	if (res->node == 0)
+		return ENODEV;
+	if (OF_is_compatible(res->node, "apple,agx-t8103"))
+		g14c = 0;
+	else if (OF_is_compatible(res->node, "apple,agx-t6021"))
+		g14c = 1;
+	else
+		return ENODEV;
+	if (res->sgx_size < (g14c ? AGX_CORE_MASK_G14X + 3 * sizeof(uint32_t) :
+	    AGX_ID_CLUSTERS + sizeof(uint32_t)))
+		return ENODEV;
+	memset(&id, 0, sizeof(id));
+#define RD(reg) bus_space_read_4(res->iot, res->sgx, (reg))
+	id.id_version = RD(AGX_ID_VERSION);
+	id.id_unk08 = RD(AGX_ID_UNK08);
+	id.id_counts_1 = RD(AGX_ID_COUNTS_1);
+	id.id_counts_2 = RD(AGX_ID_COUNTS_2);
+	id.id_unk18 = RD(AGX_ID_UNK18);
+	id.id_clusters = RD(AGX_ID_CLUSTERS);
+	if (g14c) {
+		for (i = 0; i < 3; i++)
+			id.core_masks_packed[i] = RD(AGX_CORE_MASK_G14X + 4 * i);
+	} else {
+		id.core_masks_packed[0] = RD(AGX_CORE_MASK_0);
+		id.core_masks_packed[1] = RD(AGX_CORE_MASK_1);
+	}
+#undef RD
+	if (((id.id_version >> 24) & 0xff) != (g14c ? 6 : 4) ||
+	    ((id.id_version >> 16) & 0xff) != (g14c ? 4 : 2))
+		return ENODEV;
+	id.gpu_gen = g14c ? 14 : 13;
+	id.gpu_variant = g14c ? 'C' : 'G';
+	rev = (id.id_version >> 8) & 0xff;
+	switch (rev) {
+	case 0x00: id.gpu_rev_id = 1; break;
+	case 0x01: id.gpu_rev_id = 2; break;
+	case 0x10: id.gpu_rev_id = 3; break;
+	case 0x11: id.gpu_rev_id = 4; break;
+	case 0x20: id.gpu_rev_id = 5; break;
+	case 0x21: id.gpu_rev_id = 6; break;
+	default: return ENODEV;
+	}
+	id.gpu_rev = rev;
+	if (g14c) {
+		/* T6021 is one die, with at most four clusters. */
+		if (((id.id_counts_1 >> 16) & 0xf) != 1)
+			return ENODEV;
+		id.num_clusters = (id.id_counts_1 >> 8) & 0xff;
+	} else
+		id.num_clusters = (id.id_clusters >> 12) & 0xff;
+	id.num_cores = id.id_counts_1 & 0xff;
+	id.num_frags = id.num_cores;
+	id.num_gps = (id.id_counts_2 >> 16) & 0xff;
+
+	if (g14c) {
+		if (id.num_clusters == 0 || id.num_clusters > 4 ||
+		    id.num_cores == 0 || id.num_cores > 10 ||
+		    id.num_gps == 0 || id.num_gps > 4)
+			return ENODEV;
+		total_bits = id.num_clusters * id.num_cores;
+		/* Masks are concatenated least-significant cluster first. */
+		for (i = 0; i < 96; i++) {
+			bit = (id.core_masks_packed[i / 32] >> (i % 32)) & 1U;
+			if (i >= total_bits) {
+				if (bit != 0)
+					return ENODEV;
+				continue;
+			}
+			id.core_masks[i / id.num_cores] |=
+			    bit << (i % id.num_cores);
+			id.total_active_cores += bit;
+		}
+		if (id.total_active_cores == 0)
+			return ENODEV;
+		*out = id;
+		return 0;
+	}
+	if (id.num_clusters != AGX_T8103_MAX_CLUSTERS ||
+	    id.num_cores == 0 || id.num_cores > AGX_T8103_MAX_CORES ||
+	    id.num_frags > AGX_T8103_MAX_FRAGS || id.num_gps == 0 ||
+	    id.num_gps > AGX_T8103_MAX_GPS)
+		return ENODEV;
+	valid = (1U << id.num_cores) - 1;
+	mask = id.core_masks_packed[0];
+	if ((mask & ~valid) != 0 || id.core_masks_packed[1] != 0)
+		return ENODEV;
+	id.core_masks[0] = mask;
+	for (n = 0; n < id.num_cores; n++)
+		id.total_active_cores += (mask >> n) & 1;
+	if (id.total_active_cores != 7 && id.total_active_cores != 8)
+		return ENODEV;
+	*out = id;
+	return 0;
+}
