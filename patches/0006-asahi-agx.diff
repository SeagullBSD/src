--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_ioctl.c	Wed Nov 18 20:50:04 2026
@@ -0,0 +1,826 @@
+/* SPDX-License-Identifier: MIT */
+#include <sys/types.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/rwlock.h>
+#include <sys/queue.h>
+#include <sys/atomic.h>
+#include <linux/idr.h>
+#include <linux/slab.h>
+
+#include <drm/drm_device.h>
+#include <drm/drm_file.h>
+#include <uapi/drm/asahi_drm.h>
+
+#include "agx_device.h"
+#include "agx_context.h"
+#include "agx_fw.h"
+#include "agx_mem.h"
+#include "agx_queue.h"
+#include "agx_queue_owner.h"
+#include "agx_sched.h"
+#include "agx_uat.h"
+#include "agx_timestamp.h"
+#include "agx_submit.h"
+#include "agx_init_runtime.h"
+#include "agx_hw_t8103.h"
+#if AGX_T8103_BASE_CLOCK_HZ != 24000000
+#error "Update the GPU timestamp conversion for the T8103 clock"
+#endif
+
+struct agx_bind_ticket {
+	TAILQ_ENTRY(agx_bind_ticket) link;
+	struct agx_context_vm *cvm;
+	struct drm_gem_object *gem;
+	volatile unsigned int canceled;
+};
+
+struct agx_file {
+	struct rwlock lock;
+	struct idr queues;
+	struct idr vms;
+	TAILQ_HEAD(, agx_bind_ticket) binds;
+	unsigned int active_binds;
+	int closing, postclosing;
+	struct agx_timestamp_file *timestamps;
+};
+
+struct agx_file_queue {
+	struct rwlock lock;
+	struct rwlock submit_lock;
+	unsigned int refs;
+	int closing;
+	struct agx_queue_owner *owner;
+};
+
+static unsigned long agx_queue_serial;
+static unsigned long agx_submit_serial;
+
+int
+agx_file_open(struct drm_device *dev, struct drm_file *file)
+{
+	struct agx_softc *sc = dev->dev_private;
+	struct agx_file *af;
+	int error;
+
+	if (sc == NULL || !atomic_load_int(&sc->ready))
+		return -ENODEV;
+	membar_consumer();
+	if (agx_fw_is_crashed(sc->runtime))
+		return -ENODEV;
+	af = malloc(sizeof(*af), M_DEVBUF, M_WAITOK | M_ZERO);
+	rw_init(&af->lock, "agxfile");
+	idr_init(&af->vms);
+	idr_init(&af->queues);
+	TAILQ_INIT(&af->binds);
+	error = agx_timestamp_file_create(agx_runtime_timestamp_pool(sc->runtime),
+	    &af->timestamps);
+	if (error != 0) {
+		idr_destroy(&af->queues);
+		idr_destroy(&af->vms);
+		free(af, M_DEVBUF, sizeof(*af));
+		return -error;
+	}
+	file->driver_priv = af;
+	return 0;
+}
+
+int
+agx_file_queue_lookup(struct drm_file *file, uint32_t id,
+    struct agx_file_queue **out)
+{
+	struct agx_file *af = file->driver_priv;
+	struct agx_file_queue *queue;
+	int error = 0;
+
+	if (af == NULL || out == NULL)
+		return -EINVAL;
+	*out = NULL;
+	rw_enter_read(&af->lock);
+	queue = af->closing ? NULL : idr_find(&af->queues, id);
+	if (queue == NULL)
+		error = ENOENT;
+	else {
+		rw_enter_write(&queue->lock);
+		if (queue->refs == UINT_MAX)
+			error = EOVERFLOW;
+		else {
+			queue->refs++;
+			*out = queue;
+		}
+		rw_exit_write(&queue->lock);
+	}
+	rw_exit_read(&af->lock);
+	return -error;
+}
+
+void
+agx_file_queue_put(struct agx_file_queue *queue)
+{
+	int last;
+
+	rw_enter_write(&queue->lock);
+	last = --queue->refs == 0;
+	rw_exit_write(&queue->lock);
+	if (last) {
+		agx_queue_owner_put(queue->owner);
+		free(queue, M_DEVBUF, sizeof(*queue));
+	}
+}
+
+struct agx_queue_owner *
+agx_file_queue_owner(struct agx_file_queue *queue)
+{
+	return queue->owner;
+}
+
+void
+agx_file_queue_lock(struct agx_file_queue *queue)
+{
+	rw_enter_write(&queue->submit_lock);
+}
+
+int
+agx_file_queue_try_admit(struct agx_file_queue *queue)
+{
+	if (rw_enter(&queue->submit_lock, RW_WRITE | RW_NOSLEEP) != 0)
+		return EAGAIN;
+	if (queue->closing) {
+		rw_exit_write(&queue->submit_lock);
+		return ENODEV;
+	}
+	return 0;
+}
+
+void
+agx_file_queue_unlock(struct agx_file_queue *queue)
+{
+	rw_exit_write(&queue->submit_lock);
+}
+
+int
+agx_queue_create_ioctl(struct drm_device *dev, void *data,
+    struct drm_file *file)
+{
+	struct drm_asahi_queue_create *args = data;
+	struct agx_softc *sc = dev->dev_private;
+	struct agx_file *af = file->driver_priv;
+	struct agx_context_vm *cvm;
+	struct agx_fw_heaps *heaps;
+	struct agx_queue_owner *owner;
+	struct agx_file_queue *queue;
+	uint64_t serial;
+	int error, id;
+
+	if (args->flags != 0 || args->priority >= DRM_ASAHI_PRIORITY_HIGH)
+		return -EINVAL;
+	if (sc == NULL || af == NULL || agx_fw_is_crashed(sc->runtime))
+		return -ENODEV;
+	error = agx_file_vm_lookup(file, args->vm_id, &cvm);
+	if (error != 0)
+		return error;
+	heaps = agx_runtime_heaps(sc->runtime);
+	serial = atomic_inc_long_nv(&agx_queue_serial);
+	if (serial == 0) {
+		agx_context_vm_put(cvm);
+		return -EOVERFLOW;
+	}
+	/* The VM ref and AGX locks protect setup; keep the IDR below under BKL. */
+	KERNEL_ASSERT_LOCKED();
+	KERNEL_UNLOCK();
+	error = agx_queue_owner_create(cvm,
+	    agx_fw_heap(heaps, AGX_FW_HEAP_SHARED),
+	    agx_fw_heap(heaps, AGX_FW_HEAP_PRIVATE), sc->devctl,
+	    agx_runtime_channels(sc->runtime), agx_runtime_rtkit(sc->runtime),
+	    agx_runtime_tvb(sc->runtime), agx_runtime_events(sc->runtime),
+	    sc->runtime, sc->resources.fw_major, serial, args->usc_exec_base,
+	    DRM_ASAHI_PRIORITY_REALTIME - args->priority, &owner);
+	KERNEL_LOCK();
+	agx_context_vm_put(cvm);
+	if (error != 0)
+		return -error;
+	queue = malloc(sizeof(*queue), M_DEVBUF, M_WAITOK | M_ZERO);
+	rw_init(&queue->lock, "agxqref");
+	rw_init(&queue->submit_lock, "agxqsub");
+	queue->refs = 1;
+	queue->owner = owner;
+	rw_enter_write(&af->lock);
+	id = af->closing ? -ENODEV :
+	    idr_alloc(&af->queues, queue, 1, 0, GFP_KERNEL);
+	rw_exit_write(&af->lock);
+	if (id < 0) {
+		agx_file_queue_put(queue);
+		return id;
+	}
+	args->queue_id = id;
+	return 0;
+}
+
+int
+agx_queue_destroy_ioctl(struct drm_device *dev, void *data,
+    struct drm_file *file)
+{
+	struct drm_asahi_queue_destroy *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct agx_file_queue *queue;
+
+	if (af == NULL || args->pad != 0)
+		return -EINVAL;
+	rw_enter_write(&af->lock);
+	queue = idr_remove(&af->queues, args->queue_id);
+	rw_exit_write(&af->lock);
+	if (queue == NULL)
+		return -ENOENT;
+	agx_file_queue_lock(queue);
+	queue->closing = 1;
+	agx_queue_jobs_stop_admission(queue->owner);
+	agx_sched_stop_queued(agx_queue_owner_sched(queue->owner));
+	agx_file_queue_unlock(queue);
+	agx_file_queue_put(queue);
+	return 0;
+}
+
+struct agx_timestamp_file *
+agx_file_timestamp(struct drm_file *file)
+{
+	struct agx_file *af = file->driver_priv;
+
+	return af == NULL ? NULL : af->timestamps;
+}
+
+int
+agx_gem_bind_object_ioctl(struct drm_device *dev, void *data,
+    struct drm_file *file)
+{
+	struct agx_timestamp_file *timestamps = agx_file_timestamp(file);
+
+	if (timestamps == NULL)
+		return -ENODEV;
+	return -agx_timestamp_ioctl(timestamps, file, data);
+}
+
+int
+agx_file_vm_lookup(struct drm_file *file, uint32_t id,
+    struct agx_context_vm **out)
+{
+	struct agx_file *af = file->driver_priv;
+	struct agx_context_vm *cvm;
+	int error;
+
+	if (af == NULL || out == NULL)
+		return -EINVAL;
+	*out = NULL;
+	rw_enter_read(&af->lock);
+	cvm = af->closing ? NULL : idr_find(&af->vms, id);
+	error = cvm == NULL ? ENOENT : agx_context_vm_get(cvm);
+	if (error == 0)
+		*out = cvm;
+	rw_exit_read(&af->lock);
+	return -error;
+}
+
+void
+agx_file_bo_close(struct drm_gem_object *obj, struct drm_file *file)
+{
+	struct agx_file *af = file->driver_priv;
+	struct agx_context_vm *cvm;
+	struct agx_bind_ticket *ticket;
+	int id, error;
+
+	if (af == NULL)
+		return;
+	rw_enter_write(&af->lock);
+	TAILQ_FOREACH(ticket, &af->binds, link) {
+		if (ticket->gem == obj)
+			__atomic_store_n(&ticket->canceled, 1, __ATOMIC_RELEASE);
+	}
+	idr_for_each_entry(&af->vms, cvm, id) {
+		error = agx_vm_unmap_bo_revoke(agx_context_vm_raw(cvm), af, obj);
+		if (error != 0)
+			printf("agx: cannot unmap closing GEM object: %d\n", error);
+	}
+	rw_exit_write(&af->lock);
+}
+
+void
+agx_file_postclose(struct drm_device *dev, struct drm_file *file)
+{
+	struct agx_file *af = file->driver_priv;
+	struct agx_context_vm *cvm;
+	struct agx_file_queue *queue;
+	struct agx_bind_ticket *ticket;
+	int id = 0, error, release;
+
+	if (af == NULL)
+		return;
+	rw_enter_write(&af->lock);
+	af->closing = 1;
+	af->postclosing = 1;
+	TAILQ_FOREACH(ticket, &af->binds, link)
+		__atomic_store_n(&ticket->canceled, 1, __ATOMIC_RELEASE);
+	while ((queue = idr_get_next(&af->queues, &id)) != NULL) {
+		idr_remove(&af->queues, id);
+		rw_exit_write(&af->lock);
+		agx_file_queue_lock(queue);
+		queue->closing = 1;
+		agx_queue_jobs_stop_admission(queue->owner);
+		agx_sched_stop_queued(agx_queue_owner_sched(queue->owner));
+		agx_file_queue_unlock(queue);
+		agx_file_queue_put(queue);
+		rw_enter_write(&af->lock);
+	}
+	idr_destroy(&af->queues);
+	agx_timestamp_file_destroy(af->timestamps);
+	af->timestamps = NULL;
+	id = 0;
+	while ((cvm = idr_get_next(&af->vms, &id)) != NULL) {
+		error = agx_vm_unmap_all_revoke(agx_context_vm_raw(cvm));
+		if (error != 0) {
+			/* Keep the VM and its backing pinned on an unsafe teardown. */
+			printf("agx: retaining VM after close failure: %d\n", error);
+			id++;
+			continue;
+		}
+		idr_remove(&af->vms, id);
+		agx_context_vm_put(cvm);
+	}
+	af->postclosing = 0;
+	release = idr_is_empty(&af->vms) && af->active_binds == 0;
+	file->driver_priv = NULL;
+	rw_exit_write(&af->lock);
+	if (release) {
+		idr_destroy(&af->vms);
+		free(af, M_DEVBUF, sizeof(*af));
+	}
+}
+
+int
+agx_vm_create_ioctl(struct drm_device *dev, void *data, struct drm_file *file)
+{
+	struct drm_asahi_vm_create *args = data;
+	struct agx_softc *sc = dev->dev_private;
+	struct agx_file *af = file->driver_priv;
+	struct agx_context_vm *cvm;
+	int error, id;
+
+	error = agx_validate_vm_create(args);
+	if (error != 0)
+		return error;
+	if (af == NULL || sc == NULL || agx_fw_is_crashed(sc->runtime))
+		return -ENODEV;
+	error = agx_context_vm_create(sc->uat, sc->resources.dmat,
+	    args->kernel_start, args->kernel_end, sc->fwctl, sc->devctl, &cvm);
+	if (error != 0)
+		return -error;
+	rw_enter_write(&af->lock);
+	id = af->closing ? -ENODEV :
+	    idr_alloc(&af->vms, cvm, 1, 0, GFP_KERNEL);
+	rw_exit_write(&af->lock);
+	if (id < 0) {
+		agx_context_vm_put(cvm);
+		return id;
+	}
+	args->vm_id = id;
+	return 0;
+}
+
+int
+agx_vm_destroy_ioctl(struct drm_device *dev, void *data, struct drm_file *file)
+{
+	struct drm_asahi_vm_destroy *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct agx_context_vm *cvm;
+	struct agx_bind_ticket *ticket;
+	int error;
+
+	if (args->pad != 0 || af == NULL)
+		return -EINVAL;
+	rw_enter_write(&af->lock);
+	cvm = idr_find(&af->vms, args->vm_id);
+	if (cvm == NULL) {
+		rw_exit_write(&af->lock);
+		return -ENOENT;
+	}
+	TAILQ_FOREACH(ticket, &af->binds, link) {
+		if (ticket->cvm == cvm)
+			__atomic_store_n(&ticket->canceled, 1, __ATOMIC_RELEASE);
+	}
+	error = agx_vm_unmap_all_revoke(agx_context_vm_raw(cvm));
+	if (error == 0)
+		idr_remove(&af->vms, args->vm_id);
+	rw_exit_write(&af->lock);
+	if (error != 0)
+		return -error;
+	agx_context_vm_put(cvm);
+	return 0;
+}
+
+int
+agx_gem_create_ioctl(struct drm_device *dev, void *data, struct drm_file *file)
+{
+	struct drm_asahi_gem_create *args = data;
+	struct agx_context_vm *cvm = NULL;
+	struct agx_bo *bo;
+	u32 handle;
+	int error;
+
+	error = agx_validate_gem_create(args);
+	if (error != 0)
+		return error;
+	if (args->flags & DRM_ASAHI_GEM_VM_PRIVATE) {
+		error = agx_file_vm_lookup(file, args->vm_id, &cvm);
+		if (error != 0)
+			return error;
+	}
+	error = agx_bo_create(dev, args->size, cvm,
+	    (args->flags & DRM_ASAHI_GEM_WRITEBACK) != 0,
+	    (args->flags & DRM_ASAHI_GEM_NONBLOCK) != 0, &bo);
+	if (cvm != NULL)
+		agx_context_vm_put(cvm);
+	if (error != 0)
+		return error;
+	error = drm_gem_handle_create(file, &bo->gem, &handle);
+	drm_gem_object_put(&bo->gem);
+	if (error != 0)
+		return error;
+	args->handle = handle;
+	return 0;
+}
+int
+agx_vm_bind_ioctl(struct drm_device *dev, void *data, struct drm_file *file)
+{
+	struct drm_asahi_vm_bind *args = data;
+	struct agx_file *af = file->driver_priv;
+	struct agx_context_vm *cvm = NULL;
+	struct agx_bind_ticket ticket;
+	struct drm_asahi_gem_bind_op op;
+	struct drm_gem_object *obj;
+	struct agx_bo *bo;
+	enum agx_uat_gpu_prot prot;
+	uint8_t small[sizeof(op)], *bytes, *p;
+	size_t size, n, j;
+	uint32_t i;
+	int error = 0, release = 0;
+
+	if (af == NULL || args->pad != 0 || args->stride == 0 ||
+	    (args->num_binds != 0 && args->stride > SIZE_MAX / args->num_binds))
+		return -EINVAL;
+	size = (size_t)args->stride * args->num_binds;
+	if (size > MALLOC_MAX)
+		return -ENOMEM;
+	if (size == 0)
+		return 0;
+	/* Mesa normally submits one bind; do not fail it on transient kmem
+	 * pressure while copying its small request. */
+	if (size <= sizeof(small))
+		bytes = small;
+	else {
+		bytes = malloc(size, M_TEMP, M_NOWAIT | M_CANFAIL);
+		if (bytes == NULL)
+			return -ENOMEM;
+	}
+	error = copyin((const void *)(uintptr_t)args->userptr, bytes, size);
+	if (error != 0)
+		goto out;
+	rw_enter_write(&af->lock);
+	cvm = idr_find(&af->vms, args->vm_id);
+	if (af->closing || cvm == NULL)
+		error = ENOENT;
+	else if (af->active_binds == UINT_MAX)
+		error = EOVERFLOW;
+	else {
+		error = agx_context_vm_get(cvm);
+		if (error == 0)
+			af->active_binds++;
+	}
+	rw_exit_write(&af->lock);
+	if (error != 0)
+		goto out;
+	for (i = 0; i < args->num_binds; i++) {
+		p = bytes + (size_t)i * args->stride;
+		memset(&op, 0, sizeof(op));
+		n = MIN((size_t)args->stride, sizeof(op));
+		memcpy(&op, p, n);
+		for (j = sizeof(op); j < args->stride; j++) {
+			if (p[j] != 0) {
+				error = EINVAL;
+				goto done;
+			}
+		}
+		if (op.flags & DRM_ASAHI_BIND_UNBIND) {
+			error = -agx_validate_bind(&op, 0);
+			if (error == 0)
+				error = agx_vm_unmap(agx_context_vm_raw(cvm),
+				    op.addr, op.range);
+		} else {
+			/* Register a cancellation ticket before close can see the BO. */
+			rw_enter_write(&af->lock);
+			if (af->closing || idr_find(&af->vms, args->vm_id) != cvm) {
+				rw_exit_write(&af->lock);
+				error = ENOENT;
+				break;
+			}
+			obj = drm_gem_object_lookup(file, op.handle);
+			if (obj == NULL) {
+				rw_exit_write(&af->lock);
+				error = ENOENT;
+				break;
+			}
+			bo = agx_bo_from_gem(obj);
+			if (bo == NULL || (bo->private_vm != NULL &&
+			    bo->private_vm != cvm))
+				error = EINVAL;
+			else
+				error = -agx_validate_bind(&op, obj->size);
+			if (error != 0) {
+				rw_exit_write(&af->lock);
+				drm_gem_object_put(obj);
+				break;
+			}
+			memset(&ticket, 0, sizeof(ticket));
+			ticket.cvm = cvm;
+			ticket.gem = obj;
+			TAILQ_INSERT_TAIL(&af->binds, &ticket, link);
+			rw_exit_write(&af->lock);
+			if (op.flags & DRM_ASAHI_BIND_READ)
+				prot = (op.flags & DRM_ASAHI_BIND_WRITE) ?
+				    AGX_UAT_GPU_RW : AGX_UAT_GPU_RO;
+			else
+				prot = AGX_UAT_GPU_WO;
+			error = agx_vm_replace_cancelable(agx_context_vm_raw(cvm), af,
+			    op.addr, obj, bo->mem, op.offset, op.range, prot,
+			    (op.flags & DRM_ASAHI_BIND_SINGLE_PAGE) != 0,
+			    &ticket.canceled,
+			    (op.flags & DRM_ASAHI_BIND_NONBLOCK) != 0);
+			rw_enter_write(&af->lock);
+			TAILQ_REMOVE(&af->binds, &ticket, link);
+			rw_exit_write(&af->lock);
+			drm_gem_object_put(obj);
+		}
+		if (error != 0)
+			break;
+	}
+done:
+	agx_context_vm_put(cvm);
+	rw_enter_write(&af->lock);
+	af->active_binds--;
+	release = af->closing && !af->postclosing && af->active_binds == 0 &&
+	    idr_is_empty(&af->vms);
+	rw_exit_write(&af->lock);
+	if (release) {
+		idr_destroy(&af->vms);
+		free(af, M_DEVBUF, sizeof(*af));
+	}
+out:
+	if (bytes != small)
+		free(bytes, M_TEMP, size);
+	return -error;
+}
+
+int
+agx_get_params_ioctl(struct drm_device *dev, void *data, struct drm_file *file)
+{
+	struct drm_asahi_get_params *args = data;
+	struct agx_softc *sc = dev->dev_private;
+	struct drm_asahi_params_global params;
+	size_t size, i;
+	uint32_t chip_id;
+	int error;
+
+	if (args->param_group != 0 || args->pad != 0)
+		return -EINVAL;
+	if (sc == NULL || agx_fw_is_crashed(sc->runtime))
+		return -ENODEV;
+	if (sc->identity.gpu_gen == 13 && sc->identity.gpu_variant == 'G' &&
+	    sc->identity.num_clusters == 1)
+		chip_id = AGX_T8103_CHIP_ID;
+	else if (sc->identity.gpu_gen == 14 && sc->identity.gpu_variant == 'C' &&
+	    sc->identity.num_clusters > 0 && sc->identity.num_clusters <= 4)
+		chip_id = 0x6021;
+	else
+		return -EIO;
+	if (sc->power.perf_max_pstate >= sc->power.num_perf_states ||
+	    sc->power.perf_max_pstate >= AGX_POWER_MAX_PSTATES)
+		return -EIO;
+	memset(&params, 0, sizeof(params));
+	params.features = sc->features | DRM_ASAHI_FEATURE_SHARED_BO_SYNC;
+	if (agx_mem_native_tag(sc->resources.dmat))
+		params.features |= DRM_ASAHI_FEATURE_NONBLOCK_BO |
+		    DRM_ASAHI_FEATURE_NONBLOCK_SHAREABLE;
+	params.gpu_generation = sc->identity.gpu_gen;
+	params.gpu_variant = sc->identity.gpu_variant;
+	params.gpu_revision = sc->identity.gpu_rev;
+	params.chip_id = chip_id;
+	params.num_dies = AGX_T8103_NUM_DIES;
+	params.num_clusters_total = sc->identity.num_clusters;
+	params.num_cores_per_cluster = sc->identity.num_cores;
+	for (i = 0; i < sc->identity.num_clusters; i++)
+		params.core_masks[i] = sc->identity.core_masks[i];
+	params.max_frequency_khz =
+	    sc->power.perf_states[sc->power.perf_max_pstate].freq_hz / 1000;
+	params.vm_start = AGX_UAT_USER_BASE;
+	params.vm_end = AGX_UAT_USER_TOP;
+	params.vm_kernel_min_size = 0x20000000;
+	params.max_commands_per_submission = AGX_MAX_COMMANDS;
+	params.max_attachments = AGX_MAX_ATTACHMENTS;
+	/* Both supported generations use AGX2 and the legacy HAL. */
+	params.usc_generation = 2;
+	params.gpu_hal_generation = DRM_ASAHI_GPU_HAL_LEGACY;
+	params.command_timestamp_frequency_hz = 1000000000;
+	size = args->size < sizeof(params) ? args->size : sizeof(params);
+	error = copyout(&params, (void *)(uintptr_t)args->pointer, size);
+	return -error;
+}
+
+int
+agx_validate_vm_create(const struct drm_asahi_vm_create *args)
+{
+	if (args->pad != 0 ||
+	    ((args->kernel_start | args->kernel_end) & AGX_PAGE_MASK) != 0 ||
+	    args->kernel_start < AGX_UAT_USER_BASE ||
+	    args->kernel_end > AGX_UAT_USER_TOP ||
+	    args->kernel_end < args->kernel_start ||
+	    args->kernel_end - args->kernel_start < 0x20000000ULL)
+		return -EINVAL;
+	return 0;
+}
+
+int
+agx_validate_gem_create(const struct drm_asahi_gem_create *args)
+{
+	uint32_t allowed = DRM_ASAHI_GEM_WRITEBACK | DRM_ASAHI_GEM_VM_PRIVATE |
+	    DRM_ASAHI_GEM_NONBLOCK;
+
+	if (args->pad != 0 || (args->flags & ~allowed) != 0 ||
+	    (!(args->flags & DRM_ASAHI_GEM_VM_PRIVATE) && args->vm_id != 0) ||
+	    args->size == 0 || args->size > SIZE_MAX - AGX_PAGE_MASK)
+		return -EINVAL;
+	return 0;
+}
+
+/* Validate a copied bind operation and the selected object's extent. */
+int
+agx_validate_bind(const struct drm_asahi_gem_bind_op *op, uint64_t bo_size)
+{
+	uint32_t allowed = DRM_ASAHI_BIND_READ | DRM_ASAHI_BIND_WRITE |
+	    DRM_ASAHI_BIND_SINGLE_PAGE | DRM_ASAHI_BIND_NONBLOCK;
+	uint64_t extent;
+
+	if ((op->addr | op->range | op->offset) & AGX_PAGE_MASK ||
+	    op->range == 0 || op->addr < AGX_UAT_USER_BASE ||
+	    op->addr >= AGX_UAT_USER_TOP ||
+	    op->range > AGX_UAT_USER_TOP - op->addr)
+		return -EINVAL;
+	if (op->flags & DRM_ASAHI_BIND_UNBIND) {
+		if (op->flags != DRM_ASAHI_BIND_UNBIND || op->handle != 0 ||
+		    op->offset != 0)
+			return -EINVAL;
+		return 0;
+	}
+	if ((op->flags & ~allowed) != 0 ||
+	    (op->flags & (DRM_ASAHI_BIND_READ | DRM_ASAHI_BIND_WRITE)) == 0)
+		return -EINVAL;
+	extent = (op->flags & DRM_ASAHI_BIND_SINGLE_PAGE) ?
+	    AGX_PAGE_SIZE : op->range;
+	if (op->offset > bo_size || extent > bo_size - op->offset)
+		return -EINVAL;
+	return 0;
+}
+
+/* T8103's GPU firmware timestamps use the 24 MHz physical counter. */
+int
+agx_get_time_ioctl(struct drm_device *dev, void *data, struct drm_file *file)
+{
+	struct drm_asahi_get_time *args = data;
+	uint64_t ticks;
+
+	if (args->flags != 0)
+		return -EINVAL;
+	__asm volatile("mrs %0, cntpct_el0" : "=r" (ticks));
+	/* 1e9 / 24e6 = 125 / 3; divide first to avoid intermediate overflow. */
+	args->gpu_timestamp = (ticks / 3) * 125 + (ticks % 3) * 125 / 3;
+	return 0;
+}
+
+int
+agx_submit_ioctl(struct drm_device *dev, void *data, struct drm_file *file)
+{
+	struct drm_asahi_submit *args = data;
+	struct agx_softc *sc = dev->dev_private;
+	struct agx_file_queue *queue;
+	struct agx_queue_owner *owner;
+	struct agx_init_runtime_view view;
+	struct agx_fw_heaps *heaps;
+	struct agx_submit_config config;
+	struct drm_asahi_sync *items = NULL;
+	struct agx_sync *syncs = NULL;
+	uint64_t small_commands[64];
+	void *commands = NULL;
+	size_t count, prepared = 0, sync_size;
+	uint64_t total;
+	int error, shared = 0;
+
+	if (args->flags != 0 || args->pad != 0 || args->cmdbuf_size == 0)
+		return -EINVAL;
+	if (sc == NULL || agx_fw_is_crashed(sc->runtime))
+		return -ENODEV;
+	total = (uint64_t)args->in_sync_count + args->out_sync_count;
+	if (total > SIZE_MAX / sizeof(*items) ||
+	    total > SIZE_MAX / sizeof(*syncs))
+		return -EINVAL;
+	if (args->cmdbuf_size > MALLOC_MAX ||
+	    total > MALLOC_MAX / sizeof(*items) ||
+	    total > MALLOC_MAX / sizeof(*syncs))
+		return -ENOMEM;
+	count = total;
+	sync_size = count * sizeof(*items);
+	error = agx_file_queue_lookup(file, args->queue_id, &queue);
+	if (error != 0)
+		return error;
+	/* The submit parser copies commands before asynchronous scheduling. */
+	if (args->cmdbuf_size <= sizeof(small_commands))
+		commands = small_commands;
+	else {
+		commands = malloc(args->cmdbuf_size, M_TEMP, M_NOWAIT | M_CANFAIL);
+		if (commands == NULL) {
+			error = ENOMEM;
+			goto out;
+		}
+	}
+	error = copyin((const void *)(uintptr_t)args->cmdbuf, commands,
+	    args->cmdbuf_size);
+	if (error != 0)
+		goto out;
+	if (count != 0) {
+		items = malloc(sync_size, M_TEMP, M_NOWAIT | M_CANFAIL);
+		syncs = mallocarray(count, sizeof(*syncs), M_TEMP,
+		    M_NOWAIT | M_CANFAIL | M_ZERO);
+		if (items == NULL || syncs == NULL) {
+			error = ENOMEM;
+			goto out;
+		}
+		error = copyin((const void *)(uintptr_t)args->syncs, items, sync_size);
+		if (error != 0)
+			goto out;
+		for (prepared = 0; prepared < count; prepared++) {
+			error = agx_sync_prepare(file, &items[prepared],
+			    prepared >= args->in_sync_count, &syncs[prepared]);
+			if (error != 0)
+				goto out;
+			if (syncs[prepared].gem != NULL)
+				shared = 1;
+		}
+	}
+	heaps = agx_runtime_heaps(sc->runtime);
+	error = agx_init_runtime_view(agx_runtime_graph(sc->runtime), &view);
+	if (error != 0)
+		goto out;
+	owner = agx_file_queue_owner(queue);
+	memset(&config, 0, sizeof(config));
+	config.shared = agx_fw_heap(heaps, AGX_FW_HEAP_SHARED);
+	config.private = agx_fw_heap(heaps, AGX_FW_HEAP_PRIVATE);
+	config.gpu_ro = agx_fw_heap(heaps, AGX_FW_HEAP_GPU_RO);
+	config.gpu = agx_fw_heap(heaps, AGX_FW_HEAP_GPU);
+	config.timestamps = agx_file_timestamp(file);
+	config.stats_vtx = view.stats_vtx;
+	config.stats_frag = view.stats_frag;
+	config.stats_comp = view.stats_comp;
+	config.usc_exec_base = owner->usc_exec_base;
+	config.core_mask[0] = sc->identity.core_masks_packed[0];
+	config.core_mask[1] = sc->identity.core_masks_packed[1];
+	config.core_mask[2] = sc->identity.core_masks_packed[2];
+	config.queue_id = (uint32_t)owner->id;
+	config.version = sc->resources.fw_major;
+	config.g14x = (sc->identity.id_version >> 24) == 6;
+	config.clusters = sc->identity.num_clusters;
+	if (shared) {
+		/* Queue lookup retains the owner while preparation runs unlocked. */
+		error = agx_submit(agx_queue_owner_sched(owner), owner, &config,
+		    commands, args->cmdbuf_size, syncs, args->in_sync_count,
+		    args->out_sync_count, atomic_inc_long_nv(&agx_submit_serial),
+		    queue);
+	} else {
+		agx_file_queue_lock(queue);
+		if (queue->closing || agx_fw_is_crashed(sc->runtime))
+			error = ENODEV;
+		else
+			error = agx_submit(agx_queue_owner_sched(owner), owner, &config,
+			    commands, args->cmdbuf_size, syncs, args->in_sync_count,
+			    args->out_sync_count, atomic_inc_long_nv(&agx_submit_serial),
+			    NULL);
+		agx_file_queue_unlock(queue);
+	}
+out:
+	while (prepared != 0)
+		agx_sync_cleanup(&syncs[--prepared]);
+	if (syncs != NULL)
+		free(syncs, M_TEMP, count * sizeof(*syncs));
+	if (items != NULL)
+		free(items, M_TEMP, sync_size);
+	if (commands != NULL && commands != small_commands)
+		free(commands, M_TEMP, args->cmdbuf_size);
+	agx_file_queue_put(queue);
+	return -error;
+}
