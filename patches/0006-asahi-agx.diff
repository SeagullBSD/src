+/* SPDX-License-Identifier: MIT */
+/* T8103 render tiling, translated from Asahi queue/render.rs. */
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <drm/asahi_drm.h>
+
+#include "agx_queue.h"
+#include "agx_object.h"
+
+_Static_assert(offsetof(struct agx_fw_vertex_g14x_13_5, registers) ==
+    offsetof(struct agx_fw_vertex_13_5, job_params1), "G14X vertex registers");
+_Static_assert(offsetof(struct agx_fw_fragment_g14x_13_5, registers) ==
+    offsetof(struct agx_fw_fragment_13_5, job_params1), "G14X fragment registers");
+_Static_assert(offsetof(struct agx_fw_start_vertex_g14x_13_5, registers) ==
+    offsetof(struct agx_fw_start_vertex_13_5, buffer), "G14X vertex start registers");
+_Static_assert(offsetof(struct agx_fw_start_fragment_g14x_13_5, registers) ==
+    offsetof(struct agx_fw_start_fragment_13_5, scene), "G14X fragment start registers");
+
+static uint32_t
+agx_round_up_u32(uint32_t n, uint32_t a)
+{
+	return (n + a - 1) / a * a;
+}
+
+int
+agx_render_tiling(const struct drm_asahi_cmd_render *cmd, uint32_t clusters,
+    struct agx_tile_info *out)
+{
+	struct agx_tile_info t;
+	uint32_t ux, uy, ut, mx, my, mt, rgn, stride, minblocks;
+	uint32_t flags = DRM_ASAHI_RENDER_VERTEX_SCRATCH |
+	    DRM_ASAHI_RENDER_PROCESS_EMPTY_TILES |
+	    DRM_ASAHI_RENDER_NO_VERTEX_CLUSTERING | DRM_ASAHI_RENDER_DBIAS_IS_INT;
+
+	if ((cmd->flags & ~flags) != 0 || cmd->width_px == 0 ||
+	    cmd->height_px == 0 || cmd->width_px > 16384 ||
+	    cmd->height_px > 16384 || cmd->layers == 0 || cmd->layers > 2048 ||
+	    (cmd->samples != 1 && cmd->samples != 2 && cmd->samples != 4) ||
+	    clusters == 0 || clusters > DRM_ASAHI_MAX_CLUSTERS)
+		return EINVAL;
+	if (!((cmd->utile_width_px == 32 && cmd->utile_height_px == 32) ||
+	    (cmd->utile_width_px == 32 && cmd->utile_height_px == 16) ||
+	    (cmd->utile_width_px == 16 && cmd->utile_height_px == 16)))
+		return EINVAL;
+
+	memset(&t, 0, sizeof(t));
+	t.utile_width = cmd->utile_width_px;
+	t.utile_height = cmd->utile_height_px;
+	ux = 32 / t.utile_width;
+	uy = 32 / t.utile_height;
+	ut = ux * uy;
+	t.tiles_x = (cmd->width_px + 31) / 32;
+	t.tiles_y = (cmd->height_px + 31) / 32;
+	t.tiles = t.tiles_x * t.tiles_y;
+	mx = agx_round_up_u32((t.tiles_x + 3) / 4, 4);
+	my = agx_round_up_u32((t.tiles_y + 3) / 4, 4);
+	mt = mx * my;
+	t.tiles_per_mtile_x = mx;
+	t.tiles_per_mtile_y = my;
+	t.utiles_per_mtile_x = mx * ux;
+	t.utiles_per_mtile_y = my * uy;
+	rgn = agx_round_up_u32(5 * mt * ut, 4) / 4;
+	stride = 8 * ut * mt / 4;
+	t.tilemap_size = (size_t)4 * rgn * 16 * cmd->layers;
+	t.tpc_size = (size_t)4 * stride * 16 * cmd->layers * clusters;
+	if (clusters > 1) {
+		t.meta1_layer_stride =
+		    (agx_round_up_u32(t.tiles_x, 2) *
+		    agx_round_up_u32(t.tiles_y, 4) * ut + 0x197f) / 0x1980;
+	}
+	t.meta1_blocks = t.meta1_layer_stride * cmd->layers;
+	t.layermeta_size = cmd->layers > 1 ? 0x100 : 0;
+	minblocks = agx_round_up_u32((t.tiles + 127) / 128, 8);
+	if (clusters > 1)
+		minblocks = MAX(minblocks, 7U + 2U * cmd->layers);
+	t.min_tvb_blocks = minblocks;
+	t.params.rgn_size = rgn;
+	t.params.unk_4 = 0x88;
+	t.params.ppp_ctrl = cmd->ppp_ctrl;
+	t.params.x_max = cmd->width_px - 1;
+	t.params.y_max = cmd->height_px - 1;
+	t.params.te_screen = ((t.tiles_y - 1) << 12) | (t.tiles_x - 1);
+	t.params.te_mtile1 = 3 * mx | (2 * mx << 9) | (mx << 18);
+	t.params.te_mtile2 = 3 * my | (2 * my << 9) | (my << 18);
+	t.params.tiles_per_mtile = mt;
+	t.params.tpc_stride = stride;
+	t.params.unk_24 = 0x100;
+	t.params.unk_28 = cmd->layers > 1 ? 0xe000 | (cmd->layers - 1) : 0x8000;
+	t.params.helper_cfg = cmd->vertex_helper.cfg;
+	*out = t;
+	return 0;
+}
+static void
+agx_render_reg(struct agx_fw_register_array *r, uint32_t number, uint64_t value)
+{
+	r->registers[r->count].number = number;
+	r->registers[r->count++].value.value = value;
+	r->length += sizeof(r->registers[0]);
+}
+
+
+int
+agx_vertex_work(void *dst, size_t size, unsigned int version,
+    const struct drm_asahi_cmd_render *cmd, const struct agx_tile_info *tile,
+    const struct agx_scene_resources *scene, const struct agx_vertex_work_args *a)
+{
+	struct agx_fw_vertex_params1 params1;
+	struct agx_fw_vertex_params2 params2;
+	struct agx_fw_encoder_params encoder;
+	uint32_t samples_log2;
+	size_t needed;
+
+	if (version == 12 && !scene->g14x)
+		needed = sizeof(struct agx_fw_vertex_12_3);
+	else if (version == 13)
+		needed = scene->g14x ? sizeof(struct agx_fw_vertex_g14x_13_5) :
+		    sizeof(struct agx_fw_vertex_13_5);
+	else
+		return EINVAL;
+	if (size < needed || scene->scene == NULL || scene->heapmeta == NULL ||
+	    scene->tilemap == NULL || scene->preempt == NULL || scene->tpc == NULL ||
+	    a->notifier_va == 0 || a->buffer_va == 0 || a->kernel_buffer_va == 0 ||
+	    a->microseq_va == 0 || a->microseq_size == 0 || a->stamp_va == 0 ||
+	    a->fw_stamp_va == 0 || a->timestamps_start_va == 0 ||
+	    a->timestamps_end_va == 0 || a->buffer_slot >= 127 ||
+	    a->stamp_slot >= 128 || a->fragment_stamp_slot >= 128 ||
+	    a->flush_stamps > 1 ||
+	    (!scene->g14x && (a->core_mask[0] | a->core_mask[1]) == 0) ||
+	    (scene->g14x && (a->work_va == 0 || a->work_va > UINT64_MAX - needed)) ||
+	    (cmd->samples != 1 && cmd->samples != 2 && cmd->samples != 4))
+		return EINVAL;
+	samples_log2 = cmd->samples == 4 ? 2 : cmd->samples == 2 ? 1 : 0;
+	memset(&params1, 0, sizeof(params1));
+	memset(&params2, 0, sizeof(params2));
+	memset(&encoder, 0, sizeof(encoder));
+	params1.unk_0.value = 0x200;
+	params1.unk_8 = params1.unk_c = 0x1e3ce508;
+	params1.tvb_tilemap = scene->tilemap->gpu;
+	params1.tpc = scene->tpc->gpu;
+	params1.tvb_heapmeta = scene->heapmeta->gpu | 0x8000000000000000ULL;
+	params1.iogpu_unk_54.value = 0x3a0012006b0003ULL;
+	params1.iogpu_unk_56.value = 1;
+	params1.utile_config = ((tile->utile_width / 16) << 12) |
+	    ((tile->utile_height / 16) << 14) | samples_log2;
+	params1.ppp_multisamplectl.value = cmd->ppp_multisamplectl;
+	params1.tvb_layermeta = scene->heapmeta->gpu + 0x200;
+	params1.core_mask[0] = a->core_mask[0];
+	params1.core_mask[1] = a->core_mask[1];
+	params1.preempt_buf1 = scene->preempt->gpu;
+	params1.preempt_buf2 = scene->preempt->gpu + scene->preempt2_offset;
+	params1.unk_80.value = 1;
+	params1.preempt_buf3 = (scene->preempt->gpu + scene->preempt3_offset) |
+	    0x4000000000000ULL;
+	params1.vdm_ctrl_stream_base.value = cmd->vdm_ctrl_stream_base;
+	params1.tiling_control = 0xa041;
+	params1.usc_exec_base_ta.value = a->usc_exec_base;
+	params1.unk_f0.value = 0x1c;
+	params1.unk_f8.value = 0x8c60;
+	params1.helper_program = cmd->vertex_helper.binary;
+	params1.helper_arg.value = cmd->vertex_helper.data;
+	params1.unk_118 = 0x1c;
+	params2.preempt_buf1 = scene->preempt->gpu;
+	encoder.unk_mask = 0xffffffff;
+	encoder.sampler_array.value = cmd->sampler_heap;
+	encoder.sampler_count = cmd->sampler_count;
+	encoder.sampler_max = (uint32_t)cmd->sampler_count + 1;
+	memset(dst, 0, needed);
+#define VERTEX(w) do { \
+	(w)->tag = AGX_FW_CMD_VERTEX; (w)->vm_slot = a->vm_slot; \
+	(w)->notifier = a->notifier_va; (w)->buffer_slot = a->buffer_slot; \
+	(w)->buffer = a->buffer_va; (w)->scene = scene->scene->gpu; \
+	(w)->unk_buffer_buf = a->kernel_buffer_va; (w)->tpc = scene->tpc->gpu; \
+	(w)->tpc_size.value = tile->tpc_size; (w)->microsequence = a->microseq_va; \
+	(w)->microsequence_size = a->microseq_size; \
+	(w)->fragment_stamp_slot = a->fragment_stamp_slot; \
+	(w)->fragment_stamp_value = a->fragment_stamp_value; \
+	(w)->job_params2 = params2; (w)->encoder_params = encoder; \
+	(w)->uses_scratch = (cmd->flags & DRM_ASAHI_RENDER_VERTEX_SCRATCH) != 0; \
+	(w)->meta.stamp = a->stamp_va; (w)->meta.fw_stamp = a->fw_stamp_va; \
+	(w)->meta.stamp_value = a->stamp_value; (w)->meta.stamp_slot = a->stamp_slot; \
+	(w)->meta.flush_stamps = a->flush_stamps; (w)->meta.event_seq = (uint32_t)a->event_seq; \
+	(w)->timestamp_pointers.start_addr = a->timestamps_start_va; \
+	(w)->timestamp_pointers.end_addr = a->timestamps_end_va; \
+	(w)->user_timestamp_pointers.start_addr = a->user_start_va; \
+	(w)->user_timestamp_pointers.end_addr = a->user_end_va; \
+	(w)->client_sequence = (uint8_t)a->queue_id; \
+} while (0)
+	if (version == 12) {
+		struct agx_fw_vertex_12_3 *w = dst;
+		VERTEX(w);
+		w->job_params1 = params1; w->tiling_params = tile->params;
+	} else if (!scene->g14x) {
+		struct agx_fw_vertex_13_5 *w = dst;
+		VERTEX(w);
+		w->job_params1 = params1; w->tiling_params = tile->params;
+		w->counter.value = a->counter;
