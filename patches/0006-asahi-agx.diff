@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* Derived from the Asahi Linux GPU allocator and slot allocator. */
+#ifndef _AGX_OBJECT_H_
+#define _AGX_OBJECT_H_
+
+#include <sys/types.h>
+#include <sys/rwlock.h>
+#include <sys/queue.h>
+#include <drm/drm_mm.h>
+
+/* map must map exactly [va, va + size), and return an owning handle.
+ * unmap returns zero only after the mapping is inaccessible to the GPU; on
+ * failure it retains the backing and must be retryable.  Callbacks may sleep
+ * with the heap lock held.  Failed map must undo any partial mapping.
+ * Return positive OpenBSD errno. */
+/* Callers serialize heap/slot destruction against new operations.  Objects
+ * stay live until firmware and GPU work referencing them has retired. */
+struct agx_heap_ops {
+	int (*map)(void *, uint64_t, size_t, void **, void **);
+	int (*unmap)(void *, uint64_t, size_t, void *);
+};
+
+#include "agx_uat.h"
+struct agx_heap;
+struct agx_heap_uat {
+	bus_dma_tag_t dmat;
+	struct agx_uat_pt *pt;
+	enum agx_uat_fw_prot prot;
+	struct agx_uat_handoff *handoff;
+	agx_uat_flush_fn flush;
+	void *flush_cookie;
+	struct agx_heap *heap;
+	int reset_teardown;
+};
+extern const struct agx_heap_ops agx_heap_uat_ops;
+
+struct agx_heap_block;
+struct agx_object;
+struct agx_heap {
+	struct rwlock lock;
+	struct drm_mm va;
+	TAILQ_HEAD(, agx_heap_block) blocks;
+	TAILQ_HEAD(, agx_object) garbage;
+	const struct agx_heap_ops *ops;
+	void *cookie;
+	size_t block_size, min_align;
+	size_t garbage_bytes, garbage_count;
+	int (*flush_cache)(void *);
+	int cache_fault;
+	void *flush_cookie;
+	unsigned int live;
+	int cpu_mapped;
+};
+
+/* Keep this context alive until the heap is destroyed and fini succeeds. */
+struct agx_heap_vm {
+	bus_dma_tag_t dmat;
+	struct agx_vm *vm;
+	enum agx_vm_internal_kind kind;
+	agx_uat_flush_fn flush;
+	void *flush_cookie;
+	int reset_teardown;
+};
+int agx_heap_vm_init(struct agx_heap *, struct agx_heap_vm *, struct agx_vm *,
+    bus_dma_tag_t, enum agx_vm_internal_kind, size_t, size_t,
+    agx_uat_flush_fn, void *);
+int agx_heap_vm_fini(struct agx_heap_vm *);
+
+struct agx_object {
+	TAILQ_ENTRY(agx_object) garbage_link;
+	struct drm_mm_node node;
+	struct agx_heap *heap;
+	struct agx_heap_block *block;
+	void *cpu;
+	uint64_t gpu;
+	size_t size;
+};
+
+int agx_heap_init(struct agx_heap *, uint64_t, uint64_t, size_t, size_t,
+    int, const struct agx_heap_ops *, void *);
+int agx_heap_destroy(struct agx_heap *);
+/* Requires the corresponding UAT handoff's verified stopped/reset state. */
+int agx_heap_destroy_after_reset(struct agx_heap *);
+/* Enable before the first allocation; callback synchronously flushes all FW cache. */
+int agx_heap_enable_quarantine(struct agx_heap *, int (*)(void *), void *);
+int agx_heap_collect(struct agx_heap *);
+int agx_object_alloc(struct agx_heap *, size_t, size_t, struct agx_object **);
+void agx_object_free(struct agx_object *);
+
+struct agx_slot_token { uint64_t time; uint32_t slot; };
+struct agx_slot_entry {
+	void *item;
+	uint64_t get_time, drop_time;
+	int available;
+};
+struct agx_slots {
+	struct rwlock lock;
+	struct agx_slot_entry *entries;
+	uint64_t gets, drops;
+	uint32_t count, limit, active, waiters;
+	void *cookie;
+	void (*release)(void *, uint32_t, void *);
+};
+struct agx_slot_guard {
+	struct agx_slots *slots;
+	struct agx_slot_token token;
+	void *item;
+	int changed;
+};
+int agx_slots_init(struct agx_slots *, uint32_t, void **, void *,
+    void (*)(void *, uint32_t, void *));
+int agx_slots_destroy(struct agx_slots *);
+int agx_slots_limit(struct agx_slots *, uint32_t);
+int agx_slot_get(struct agx_slots *, const struct agx_slot_token *,
+    struct agx_slot_guard *);
+void agx_slot_put(struct agx_slot_guard *);
+#endif
Index: sys/dev/pci/drm/asahi/agx_power.c
===================================================================
--- /dev/null	Sat Nov 21 01:50:46 2026
+++ sys/dev/pci/drm/asahi/agx_power.c	Sun Nov  8 22:58:06 2026
@@ -0,0 +1,226 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <dev/ofw/openfirm.h>
+
+#include "agx_hw_t8103.h"
+#include "agx_power.h"
+
+/* All scalar properties, including F32 values, are big-endian FDT cells. */
+static int
+agx_power_cell(int node, char *name, uint32_t *value, int required,
+    uint32_t def)
+{
+	int len = OF_getproplen(node, name);
+
+	if (len == -1 && !required) {
+		*value = def;
+		return 0;
+	}
+	if (len != sizeof(*value) ||
+	    OF_getpropintarray(node, name, value, sizeof(*value)) != sizeof(*value))
+		return EINVAL;
+	return 0;
+}
+
+static int
+agx_power_opps(int node, char *property, struct agx_power_pstate *states,
+    uint32_t *count, unsigned int capacity, unsigned int nvolt, int main,
+    struct agx_power_config *cfg)
+{
+	uint32_t phandle, hz[2], uv[4], uw;
+	uint64_t freq;
+	int table, opp, error;
+	unsigned int i;
+	struct agx_power_pstate *ps;
+
+	error = agx_power_cell(node, property, &phandle, 1, 0);
+	if (error || phandle == 0 || (table = OF_getnodebyphandle(phandle)) == 0)
+		return EINVAL;
+	for (opp = OF_child(table); opp; opp = OF_peer(opp)) {
+		if (*count == capacity)
+			return E2BIG;
+		if (OF_getproplen(opp, "opp-hz") != sizeof(hz) ||
+		    OF_getpropintarray(opp, "opp-hz", hz, sizeof(hz)) != sizeof(hz) ||
+		    OF_getproplen(opp, "opp-microvolt") != nvolt * sizeof(*uv) ||
+		    OF_getpropintarray(opp, "opp-microvolt", uv,
+		    nvolt * sizeof(*uv)) != nvolt * sizeof(*uv) ||
+		    (main && agx_power_cell(opp, "opp-microwatt", &uw, 1, 0)))
+			return EINVAL;
+		freq = ((uint64_t)hz[0] << 32) | hz[1];
+		if (freq > 0xffffffffU)
+			return ERANGE;
+		ps = &states[(*count)++];
+		ps->freq_hz = freq;
+		for (i = 0; i < nvolt; i++)
+			ps->volt_mv[i] = uv[i] / 1000;
+		if (main) {
+			ps->pwr_mw = uw / 1000;
+			if (ps->pwr_mw > cfg->max_power_mw)
+				cfg->max_power_mw = ps->pwr_mw;
+			if (ps->freq_hz / 1000000 > cfg->max_freq_mhz)
+				cfg->max_freq_mhz = ps->freq_hz / 1000000;
+		}
+	}
+	return *count ? 0 : EINVAL;
+}
+
+static int
+agx_power_array(int node, char *name, uint32_t *values, unsigned int count)
+{
+	int len = count * sizeof(*values);
+
+	if (OF_getproplen(node, name) != len ||
+	    OF_getpropintarray(node, name, values, len) != len)
+		return EINVAL;
+	return 0;
+}
+
+int
+agx_power_load(int node, struct agx_power_config *cfg)
+{
+	uint32_t zones[AGX_POWER_MAX_ZONES * 3], val;
+	int error, len, i, g14x;
+
+	memset(cfg, 0, sizeof(*cfg));
+	if (node <= 0) {
+		error = EINVAL;
+		goto fail;
+	}
+	g14x = OF_is_compatible(node, "apple,agx-t6021");
+	cfg->num_voltages = g14x ? 4 : 1;
+	error = agx_power_opps(node, "operating-points-v2", cfg->perf_states,
+	    &cfg->num_perf_states, AGX_POWER_MAX_PSTATES, cfg->num_voltages, 1, cfg);
+	if (error)
+		goto fail;
+	cfg->perf_max_pstate = cfg->num_perf_states - 1;
+	if (g14x) {
+		error = agx_power_opps(node, "apple,cs-opp", cfg->cs_states,
+		    &cfg->num_cs_states, nitems(cfg->cs_states), 1, 0, cfg);
+		if (error) goto fail;
+		error = agx_power_opps(node, "apple,afr-opp", cfg->afr_states,
+		    &cfg->num_afr_states, nitems(cfg->afr_states), 1, 0, cfg);
+		if (error) goto fail;
+		if ((error = agx_power_array(node, "apple,cs-leak-coef",
+		    &cfg->cs_leak_coef, 1)) != 0 ||
+		    (error = agx_power_array(node, "apple,afr-leak-coef",
+		    &cfg->afr_leak_coef, 1)) != 0 ||
+		    (error = agx_power_cell(node, "apple,csafr-min-sram-microvolt",
+		    &cfg->csafr_min_sram_microvolt, 1, 0)) != 0)
+			goto fail;
+	}
+
+	len = OF_getproplen(node, "apple,power-zones");
+	if (len == -1)
+		len = 0;
+	if (len < 0 || len > sizeof(zones) || len % (3 * sizeof(uint32_t)) ||
+	    (len && OF_getpropintarray(node, "apple,power-zones", zones, len) != len)) {
+		error = EINVAL;
+		goto fail;
+	}
+	cfg->num_power_zones = len / (3 * sizeof(uint32_t));
+	for (i = 0; i < cfg->num_power_zones; i++) {
+		cfg->power_zones[i].target = zones[3 * i];
+		cfg->power_zones[i].target_offset = zones[3 * i + 1];
+		cfg->power_zones[i].filter_tc = zones[3 * i + 2];
+	}
+
+#define REQ(field, name) do { \
+	if ((error = agx_power_cell(node, "apple," name, &cfg->field, 1, 0)) != 0) \
+		goto fail; \
+} while (0)
+#define OPT(field, name, def) do { \
+	if ((error = agx_power_cell(node, "apple," name, &cfg->field, 0, def)) != 0) \
+		goto fail; \
+} while (0)
+	if ((error = agx_power_array(node, "apple,core-leak-coef",
+	    cfg->core_leak_coef, cfg->num_voltages)) != 0 ||
+	    (error = agx_power_array(node, "apple,sram-leak-coef",
+	    cfg->sram_leak_coef, cfg->num_voltages)) != 0)
+		goto fail;
+	OPT(perf_base_pstate, "perf-base-pstate", 1);
+	REQ(min_sram_microvolt, "min-sram-microvolt");
+	REQ(avg_power_filter_tc_ms, "avg-power-filter-tc-ms");
+	REQ(avg_power_ki_only, "avg-power-ki-only");
+	REQ(avg_power_kp, "avg-power-kp");
+	REQ(avg_power_min_duty_cycle, "avg-power-min-duty-cycle");
+	REQ(avg_power_target_filter_tc, "avg-power-target-filter-tc");
+	REQ(fast_die0_integral_gain, "fast-die0-integral-gain");
+	REQ(fast_die0_proportional_gain, "fast-die0-proportional-gain");
+	OPT(fast_die0_prop_tgt_delta, "fast-die0-prop-tgt-delta", 0);
+	OPT(fast_die0_release_temp, "fast-die0-release-temp", 80);
+	OPT(fender_idle_off_delay_ms, "fender-idle-off-delay-ms", 40);
+	OPT(fw_early_wake_timeout_ms, "fw-early-wake-timeout-ms", 5);
+	OPT(idle_off_delay_ms, "idle-off-delay-ms", 2);
+	OPT(idle_off_standby_timer, "idleoff-standby-timer", g14x ? 700 : 0);
+	OPT(perf_boost_ce_step, "perf-boost-ce-step", 25);
+	OPT(perf_boost_min_util, "perf-boost-min-util", 100);
+	REQ(perf_filter_drop_threshold, "perf-filter-drop-threshold");
+	REQ(perf_filter_time_constant2, "perf-filter-time-constant2");
+	REQ(perf_filter_time_constant, "perf-filter-time-constant");
+	REQ(perf_integral_gain2, "perf-integral-gain2");
+	OPT(perf_integral_gain, "perf-integral-gain", 0x40fca970);
+	REQ(perf_integral_min_clamp, "perf-integral-min-clamp");
+	REQ(perf_proportional_gain2, "perf-proportional-gain2");
+	OPT(perf_proportional_gain, "perf-proportional-gain", 0x416b53d1);
+	OPT(perf_reset_iters, "perf-reset-iters", 6);
+	REQ(perf_tgt_utilization, "perf-tgt-utilization");
+	REQ(power_sample_period, "power-sample-period");
+	REQ(ppm_filter_time_constant_ms, "ppm-filter-time-constant-ms");
+	REQ(ppm_ki, "ppm-ki");
+	REQ(ppm_kp, "ppm-kp");
+	OPT(pwr_filter_time_constant, "pwr-filter-time-constant", 313);
+	OPT(pwr_integral_gain, "pwr-integral-gain", 0x3ca59586);
+	OPT(pwr_integral_min_clamp, "pwr-integral-min-clamp", 0);
+	REQ(pwr_min_duty_cycle, "pwr-min-duty-cycle");
+	OPT(pwr_proportional_gain, "pwr-proportional-gain", 0x40a90fdb);
+	if (cfg->power_sample_period > 0xffffffffU / (AGX_T8103_BASE_CLOCK_HZ / 1000)) {
+		error = ERANGE;
+		goto fail;
+	}
+	OPT(pwr_sample_period_aic_clks, "pwr-sample-period-aic-clks",
+	    (AGX_T8103_BASE_CLOCK_HZ / 1000) * cfg->power_sample_period);
+	if ((error = agx_power_cell(node, "apple,se-engagement-criteria", &val, 0,
+	    0xffffffffU)) != 0)
+		goto fail;
+	cfg->se_engagement_criteria = (int32_t)val;
+	OPT(se_filter_time_constant, "se-filter-time-constant", 9);
+	OPT(se_filter_time_constant_1, "se-filter-time-constant-1", 3);
+	OPT(se_inactive_threshold, "se-inactive-threshold", 2500);
+	OPT(se_ki, "se-ki", 0xc2480000);
+	OPT(se_ki_1, "se-ki-1", 0xc2c80000);
+	OPT(se_kp, "se-kp", 0xc0a00000);
+	OPT(se_kp_1, "se-kp-1", 0xc1200000);
+	OPT(se_reset_criteria, "se-reset-criteria", 50);
+#undef REQ
+#undef OPT
+	if (cfg->perf_base_pstate > cfg->perf_max_pstate ||
+	    cfg->power_sample_period == 0 ||
+	    cfg->ppm_filter_time_constant_ms < cfg->power_sample_period ||
+	    cfg->avg_power_filter_tc_ms < cfg->power_sample_period ||
+	    cfg->perf_filter_time_constant == 0 ||
+	    cfg->perf_filter_time_constant2 == 0 ||
+	    cfg->avg_power_target_filter_tc == 0 ||
+	    cfg->pwr_filter_time_constant == 0) {
+		error = EINVAL;
+		goto fail;
+	}
+	for (i = 0; i < cfg->num_power_zones; i++) {
+		if (cfg->power_zones[i].filter_tc == 0 ||
+		    cfg->power_zones[i].target_offset > cfg->power_zones[i].target) {
+			error = EINVAL;
+			goto fail;
+		}
+	}
+	return 0;
+fail:
+	agx_power_fini(cfg);
+	return error;
+}
+
+void
+agx_power_fini(struct agx_power_config *cfg)
+{
+	memset(cfg, 0, sizeof(*cfg));
+}
