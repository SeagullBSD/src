+static int
+agx_hw_a_product(uint32_t a, uint32_t b, uint32_t *out)
+{
+	uint64_t v = (uint64_t)a * b;
+	if (v > UINT32_MAX)
+		return EOVERFLOW;
+	*out = v;
+	return 0;
