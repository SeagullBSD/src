+/* Firmware allocations shared by a userspace queue's three workqueues. */
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/systm.h>
+#include <linux/jiffies.h>
+
+#include "agx_channel_bank.h"
+#include "agx_context.h"
+#include "agx_device.h"
+#include "agx_fw.h"
+#include "agx_object.h"
+#include "agx_queue_owner.h"
+#include "agx_sched.h"
+
+#define AGX_QUEUE_GPU_BUFFER_SIZE 0x2c18
+
+static void agx_queue_owner_teardown(void *);
+static void agx_queue_owner_retry(void *);
+
+
+static int
+agx_queue_owner_release(void *cookie)
+{
+	struct agx_queue_owner *owner = cookie;
+	unsigned int i;
+	int error;
+
+	error = agx_queue_jobs_fini(owner);
+	if (error != 0)
+		return error;
+	if (owner->tvb_initialized) {
+		error = agx_tvb_fini(&owner->tvb);
+		if (error != 0)
+			return error;
+		owner->tvb_initialized = 0;
+	}
+
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		agx_object_free(owner->pipes[i].info);
+		agx_object_free(owner->pipes[i].gpu_buffer);
+		agx_object_free(owner->pipes[i].entries);
+		agx_object_free(owner->pipes[i].state);
+	}
+	agx_object_free(owner->notifier);
+	agx_object_free(owner->threshold_object);
+	agx_object_free(owner->notifier_list);
+	agx_queue_jobs_reap(owner);
+	free(owner, M_DEVBUF, sizeof(*owner));
+	return 0;
+}
+
+static int
+agx_queue_owner_alloc(struct agx_heap *heap, size_t size,
+    struct agx_object **out)
+{
+	int error;
+
+	error = agx_object_alloc(heap, size, 0, out);
+	if (error != 0)
+		return error;
+	if ((*out)->cpu == NULL)
+		return EINVAL;
+	memset((*out)->cpu, 0, size);
+	return 0;
+}
+
+int
+agx_queue_owner_create(struct agx_context_vm *vm, struct agx_heap *shared,
+    struct agx_heap *private, struct agx_fw_devctl *devctl,
+    struct agx_channel_bank *bank, struct rtkit_state *rtkit,
+    struct agx_tvb_manager *tvb_manager, struct agx_event_slots *events,
+    struct agx_runtime *runtime, unsigned int version, uint64_t id,
+    uint64_t usc_exec_base, uint32_t priority,
+    struct agx_queue_owner **out)
+{
+	struct agx_queue_owner *owner;
+	struct agx_queue_owner_pipe *pipe;
+	struct agx_fw_notifier_list *list;
+	struct agx_wq_info_args args;
+	size_t info_size, notifier_size;
+	unsigned int i;
+	int error, g14x;
+
+	/* Queue setup uses its own heap and owner locks, not the global lock. */
+	KERNEL_ASSERT_UNLOCKED();
