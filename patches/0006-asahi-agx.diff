@@ -0,0 +1,322 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+/* T8103 initdata ownership graph, derived from Asahi Linux initdata.rs. */
+#include <sys/types.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/systm.h>
+
+#include "agx_fw.h"
+#include "agx_fw_hwdata_a.h"
+#include "agx_fw_hwdata_b.h"
+#include "agx_fw_hwdata_a_g14x.h"
+#include "agx_identity.h"
+#include "agx_object.h"
+#include "agx_mem.h"
+#include "agx_init_hw_a.h"
+#include "agx_init_hw_b.h"
+#include "agx_globals.h"
+#include "agx_channel_bank.h"
+#include "agx_init_runtime.h"
+
+#define AGX_BUFMGR_LOW  0x2000000000ULL
+#define AGX_BUFMGR_HIGH 0xffffffaeffff0000ULL
+
+enum agx_init_object {
+	ROOT, RUNTIME, HWA, HWB, GLOBALS, STATUS, UNKBUF,
+	STATS_VTX, STATS_FRAG, STATS_COMP, UNK190, UNK198,
+	UNK1B8, UNK1C0, UNK1C8, OBJECT_COUNT
+};
+
+struct agx_init_runtime {
+	struct agx_object *obj[OBJECT_COUNT];
+	struct agx_mem *bufmgr;
+	struct agx_uat_pt *kernel_pt, *lower_pt;
+	struct agx_fw_iomaps iomaps;
+	int low_mapped, high_mapped;
+	unsigned int major, minor;
+};
+
+static int
+agx_init_alloc(struct agx_init_runtime *g, struct agx_fw_heaps *heaps,
+    enum agx_init_object n, enum agx_fw_heap_kind kind, size_t size)
+{
+	int error;
+
+	error = agx_object_alloc(agx_fw_heap(heaps, kind), size, 0x80,
+	    &g->obj[n]);
+	if (error != 0)
+		return error;
+	if (g->obj[n]->cpu == NULL)
+		return EINVAL;
+	memset(g->obj[n]->cpu, 0, size);
+	return 0;
+}
+
+int
+agx_init_runtime_destroy(struct agx_init_runtime *g)
+{
+	int error, i;
+
+	if (g == NULL)
+		return 0;
+	if (g->high_mapped) {
+		error = agx_uat_pt_unmap(g->kernel_pt, AGX_BUFMGR_HIGH,
+		    AGX_PAGE_SIZE);
+		if (error)
+			return error;
+		g->high_mapped = 0;
+	}
+	if (g->low_mapped) {
+		error = agx_uat_pt_unmap(g->lower_pt, AGX_BUFMGR_LOW,
+		    AGX_PAGE_SIZE);
+		if (error)
+			return error;
+		g->low_mapped = 0;
+	}
+	error = agx_hw_unmap_firmware_io(&g->iomaps);
+	if (error)
+		return error;
+	if (g->bufmgr != NULL)
+		agx_mem_free(g->bufmgr);
+	for (i = OBJECT_COUNT - 1; i >= 0; i--)
+		agx_object_free(g->obj[i]);
+	free(g, M_DEVBUF, sizeof(*g));
+	return 0;
+}
+
+uint64_t
+agx_init_runtime_root(const struct agx_init_runtime *g)
+{
+	return g != NULL && g->obj[ROOT] != NULL ? g->obj[ROOT]->gpu : 0;
+}
+
+uint32_t *
+agx_init_runtime_pending(struct agx_init_runtime *g)
+{
+	struct agx_object *globals;
+
+	if (g == NULL || (globals = g->obj[GLOBALS]) == NULL ||
+	    globals->cpu == NULL)
+		return NULL;
+	if (g->major == 12 && g->minor == 3)
+		return &((struct agx_fw_globals_12_3 *)globals->cpu)->pending_submissions;
+	if (g->major == 13 && g->minor == 5) {
+		if (globals->size == sizeof(struct agx_fw_globals_g14x_13_5))
+			return &((struct agx_fw_globals_g14x_13_5 *)globals->cpu)->pending_submissions;
+		return &((struct agx_fw_globals_13_5 *)globals->cpu)->pending_submissions;
+	}
+	return NULL;
+}
+
+int
+agx_init_runtime_view(const struct agx_init_runtime *g,
+    struct agx_init_runtime_view *view)
+{
+	if (g == NULL || view == NULL || g->obj[ROOT] == NULL ||
+	    g->obj[STATUS] == NULL || g->obj[GLOBALS] == NULL ||
+	    g->obj[STATS_VTX] == NULL || g->obj[STATS_FRAG] == NULL ||
+	    g->obj[STATS_COMP] == NULL)
+		return EINVAL;
+	view->stats_vtx = g->obj[STATS_VTX]->gpu;
+	view->stats_frag = g->obj[STATS_FRAG]->gpu;
+	view->stats_comp = g->obj[STATS_COMP]->gpu;
+	view->globals = g->obj[GLOBALS]->cpu;
+	view->globals_size = g->obj[GLOBALS]->size;
+	view->status = g->obj[STATUS]->cpu;
+	view->major = g->major;
+	view->minor = g->minor;
+	return 0;
+}
+
+static int
+agx_init_runtime_encode_g14x(struct agx_fw_runtime_pointers_g14x *out,
+    const struct agx_runtime_init *in)
+{
+	unsigned int i;
+
+	if (out == NULL || in == NULL || !in->device_control.state ||
+	    !in->device_control.ring || !in->event.state || !in->event.ring ||
+	    !in->fw_log.state || !in->fw_log.ring || !in->ktrace.state ||
+	    !in->ktrace.ring || !in->stats.state || !in->stats.ring ||
+	    !in->stats_vtx || !in->stats_frag || !in->stats_comp ||
+	    !in->hwdata_a || !in->hwdata_b || !in->fwlog_buf ||
+	    !in->unkptr_190 || !in->unkptr_198 || !in->unkptr_1b8)
+		return EINVAL;
+	for (i = 0; i < 4; i++)
+		if (!in->pipes[i].vtx.state || !in->pipes[i].vtx.ring ||
+		    !in->pipes[i].frag.state || !in->pipes[i].frag.ring ||
+		    !in->pipes[i].comp.state || !in->pipes[i].comp.ring)
+			return EINVAL;
+	memset(out, 0, sizeof(*out));
+	memcpy(out->pipes, in->pipes, sizeof(out->pipes));
+	out->device_control = in->device_control; out->event = in->event;
+	out->fw_log = in->fw_log; out->ktrace = in->ktrace; out->stats = in->stats;
+	out->stats_vtx = in->stats_vtx; out->stats_frag = in->stats_frag;
+	out->stats_comp = in->stats_comp; out->hwdata_a = in->hwdata_a;
+	out->hwdata_b = out->hwdata_b_2 = in->hwdata_b;
+	out->fwlog_buf = in->fwlog_buf; out->unkptr_190 = in->unkptr_190;
+	out->unkptr_198 = in->unkptr_198; out->unkptr_1b8 = in->unkptr_1b8;
+	out->buffer_mgr_ctl_gpu_addr.value = AGX_BUFMGR_LOW;
+	out->buffer_mgr_ctl_fw_addr.value = AGX_BUFMGR_HIGH;
+	out->unk_6b38 = 0xff;
+	return 0;
+}
+
+int
+agx_init_runtime_create(bus_dma_tag_t dmat, struct agx_fw_heaps *heaps,
+    struct agx_uat_pt *kernel_pt, struct agx_uat_pt *lower_pt,
+    const struct agx_power_config *power, const struct agx_identity *identity,
+    unsigned int major, unsigned int minor, uint64_t ttb, uint32_t fault_control,
+    struct agx_channel_bank *bank, struct agx_init_runtime **out)
+{
+	struct agx_init_runtime *g;
+	struct agx_runtime_init runtime;
+	struct agx_fw_channel_ring fwctl;
+	struct agx_initdata_addrs addrs;
+	struct agx_fw_io_mapping *io;
+	struct agx_fw_global_stats_frag *frag;
+	uint64_t sram_va;
+	size_t a_size, b_size, globals_size, root_size, io_count, runtime_size, frag_size;
+	int error, cleanup, g14x;
+
+	if (out == NULL)
+		return EINVAL;
+	*out = NULL;
+	if (dmat == NULL || heaps == NULL || kernel_pt == NULL ||
+	    lower_pt == NULL || power == NULL || identity == NULL ||
+	    bank == NULL || ttb == 0 ||
+	    agx_uat_pt_oas(kernel_pt) != agx_uat_pt_oas(lower_pt))
+		return EINVAL;
+	g14x = identity->gpu_gen == 14 && identity->gpu_variant == 'C';
+	if (g14x && (major != 13 || minor != 5))
+		return EOPNOTSUPP;
+	runtime_size = g14x ? sizeof(struct agx_fw_runtime_pointers_g14x) :
+	    sizeof(struct agx_fw_runtime_pointers);
+	frag_size = g14x ? sizeof(struct agx_fw_global_stats_frag_g14x) :
+	    sizeof(struct agx_fw_global_stats_frag);
+	if (major == 12 && minor == 3) {
+		a_size = sizeof(struct agx_fw_hwdata_a_12_3);
+		b_size = sizeof(struct agx_fw_hwdata_b_12_3);
+		globals_size = sizeof(struct agx_fw_globals_12_3);
+		root_size = sizeof(struct agx_fw_init_data_12_3);
+		io_count = AGX_FW_IO_MAPPING_COUNT_12_3;
+	} else if (major == 13 && minor == 5) {
+		a_size = g14x ? sizeof(struct agx_fw_hwdata_a_g14x_13_5) :
+		    sizeof(struct agx_fw_hwdata_a_13_5);
+		b_size = g14x ? sizeof(struct agx_fw_hwdata_b_g14x_13_5) :
+		    sizeof(struct agx_fw_hwdata_b_13_5);
+		globals_size = g14x ? sizeof(struct agx_fw_globals_g14x_13_5) :
+		    sizeof(struct agx_fw_globals_13_5);
+		root_size = sizeof(struct agx_fw_init_data_13_5);
+		io_count = AGX_FW_IO_MAPPING_COUNT_13_5;
+	} else
+		return EOPNOTSUPP;
+	g = malloc(sizeof(*g), M_DEVBUF, M_WAITOK | M_ZERO);
+	g->kernel_pt = kernel_pt;
+	g->lower_pt = lower_pt;
+	g->major = major;
+	g->minor = minor;
+#define ALLOC(n, kind, size) do { \
+	error = agx_init_alloc(g, heaps, n, kind, size); \
+	if (error) goto fail; \
+} while (0)
+	ALLOC(ROOT, AGX_FW_HEAP_PRIVATE, root_size);
+	ALLOC(RUNTIME, AGX_FW_HEAP_PRIVATE, runtime_size);
+	ALLOC(HWA, AGX_FW_HEAP_PRIVATE, a_size);
+	ALLOC(HWB, AGX_FW_HEAP_PRIVATE, b_size);
+	ALLOC(GLOBALS, AGX_FW_HEAP_PRIVATE, globals_size);
+	ALLOC(STATUS, AGX_FW_HEAP_SHARED, sizeof(struct agx_fw_status));
+	ALLOC(UNKBUF, AGX_FW_HEAP_SHARED_RO, 0x4000);
+	ALLOC(STATS_VTX, AGX_FW_HEAP_PRIVATE, sizeof(struct agx_fw_global_stats_vtx));
+	ALLOC(STATS_FRAG, AGX_FW_HEAP_PRIVATE, frag_size);
+	ALLOC(STATS_COMP, AGX_FW_HEAP_PRIVATE, sizeof(struct agx_fw_gpu_stats_comp));
+	ALLOC(UNK190, AGX_FW_HEAP_PRIVATE, 0x80);
+	ALLOC(UNK198, AGX_FW_HEAP_PRIVATE, 0xc0);
+	ALLOC(UNK1B8, AGX_FW_HEAP_PRIVATE, 0x1000);
+	if (!g14x) {
+		ALLOC(UNK1C0, AGX_FW_HEAP_PRIVATE, 0x300);
+		ALLOC(UNK1C8, AGX_FW_HEAP_PRIVATE, 0x1000);
+	}
+#undef ALLOC
+	if (g14x) {
+		struct agx_fw_global_stats_frag_g14x *f = g->obj[STATS_FRAG]->cpu;
+		f->stats.cur_stamp_id = -1; f->stats.unk_id = -1;
+	} else {
+		frag = g->obj[STATS_FRAG]->cpu;
+		frag->stats.cur_stamp_id = -1; frag->stats.unk_id = -1;
+	}
+	error = agx_initdata_hw_a(g->obj[HWA]->cpu, a_size, major, minor,
+	    power, identity);
+	if (error) goto fail;
+	error = agx_initdata_hw_b(g->obj[HWB]->cpu, b_size, major, minor,
+	    power, identity, ttb);
+	if (error) goto fail;
+	error = agx_initdata_globals(g->obj[GLOBALS]->cpu, globals_size,
+	    major, minor, power, identity, fault_control);
+	if (error) goto fail;
+	if (major == 12)
+		io = ((struct agx_fw_hwdata_b_12_3 *)g->obj[HWB]->cpu)->io_mappings;
+	else if (g14x)
+		io = ((struct agx_fw_hwdata_b_g14x_13_5 *)g->obj[HWB]->cpu)->io_mappings;
+	else
+		io = ((struct agx_fw_hwdata_b_13_5 *)g->obj[HWB]->cpu)->io_mappings;
+	error = agx_hw_map_firmware_io(&g->iomaps, kernel_pt, io, io_count,
+	    identity, &sram_va);
+	if (error) goto fail;
+	if (g14x)
+		((struct agx_fw_hwdata_b_g14x_13_5 *)g->obj[HWB]->cpu)->
+		    sgx_sram_ptr.value = sram_va;
+	error = agx_mem_alloc(dmat, AGX_PAGE_SIZE, agx_uat_pt_oas(lower_pt),
+	    &g->bufmgr);
+	if (error) goto fail;
+	memset(g->bufmgr->kva, 0, AGX_PAGE_SIZE);
+	error = agx_uat_pt_map(lower_pt, AGX_BUFMGR_LOW, g->bufmgr, 0,
+	    AGX_PAGE_SIZE, AGX_UAT_GPU_RW, 0);
+	if (error) goto fail;
+	g->low_mapped = 1;
+	error = agx_uat_pt_map_kernel(kernel_pt, AGX_BUFMGR_HIGH, g->bufmgr,
+	    0, AGX_PAGE_SIZE, AGX_UAT_FW_SHARED_RW);
+	if (error) goto fail;
+	g->high_mapped = 1;
+	memset(&runtime, 0, sizeof(runtime));
+	memset(&fwctl, 0, sizeof(fwctl));
+	agx_channel_bank_describe(bank, &runtime, &fwctl);
+	runtime.stats_vtx = g->obj[STATS_VTX]->gpu;
+	runtime.stats_frag = g->obj[STATS_FRAG]->gpu;
+	runtime.stats_comp = g->obj[STATS_COMP]->gpu;
+	runtime.hwdata_a = g->obj[HWA]->gpu;
+	runtime.hwdata_b = g->obj[HWB]->gpu;
+	runtime.unkptr_190 = g->obj[UNK190]->gpu;
+	runtime.unkptr_198 = g->obj[UNK198]->gpu;
+	runtime.unkptr_1b8 = g->obj[UNK1B8]->gpu;
+	if (!g14x) {
+		runtime.unkptr_1c0 = g->obj[UNK1C0]->gpu;
+		runtime.unkptr_1c8 = g->obj[UNK1C8]->gpu;
+	}
+	if (g14x)
+		error = agx_init_runtime_encode_g14x(g->obj[RUNTIME]->cpu, &runtime);
+	else
+		error = agx_fw_encode_runtime(g->obj[RUNTIME]->cpu, &runtime);
+	if (error) goto fail;
+	error = agx_fw_encode_status(g->obj[STATUS]->cpu, &fwctl);
+	if (error) goto fail;
+	addrs.unk_buf = g->obj[UNKBUF]->gpu;
+	addrs.runtime_pointers = g->obj[RUNTIME]->gpu;
+	addrs.globals = g->obj[GLOBALS]->gpu;
+	addrs.fw_status = g->obj[STATUS]->gpu;
+	addrs.uat_oas = agx_uat_pt_oas(kernel_pt);
+	error = agx_fw_encode_initdata(g->obj[ROOT]->cpu, root_size, major,
+	    minor, &addrs);
+	if (error) goto fail;
+	if (g14x) {
+		struct agx_fw_init_data_13_5 *root = g->obj[ROOT]->cpu;
+		root->ver_info[0] = 0xb390; root->ver_info[1] = 0x70f8;
+	}
+	*out = g;
+	return 0;
+fail:
+	cleanup = agx_init_runtime_destroy(g);
+	if (cleanup != 0)
+		*out = g;
+	return error;
+}
