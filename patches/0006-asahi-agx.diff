@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef _DEV_PCI_DRM_ASAHI_AGX_IDENTITY_H_
+#define _DEV_PCI_DRM_ASAHI_AGX_IDENTITY_H_
+
+#include <sys/types.h>
+
+struct agx_resources;
+
+/* UAPI generation, variant and revision; rev_id is the firmware enum. */
+struct agx_identity {
+	uint32_t gpu_gen, gpu_variant, gpu_rev, gpu_rev_id;
+	uint32_t num_clusters, num_cores, num_frags, num_gps;
+	uint32_t total_active_cores;
+	/* G14C has up to four clusters and three packed mask registers. */
+	uint32_t core_masks[4], core_masks_packed[3];
+	/* Raw ID registers, in increasing register-offset order. */
+	uint32_t id_version, id_unk08, id_counts_1, id_counts_2;
+	uint32_t id_unk18, id_clusters;
+};
+
+/*
+ * Decode T8103 or T6021 registers after SGX power and mapping.  Success
+ * identifies the GPU only; it does not imply that attachment is supported.
+ * The output is unchanged on failure.
+ */
+int agx_identity_read(const struct agx_resources *, struct agx_identity *);
+
+#endif
