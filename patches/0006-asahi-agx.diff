+	    agx_queue_owner_release, owner, &owner->context);
+	if (error != 0)
+		goto fail;
+	for (i = 0; i < AGX_QUEUE_PIPES; i++) {
+		pipe = &owner->pipes[i];
+		memset(&args, 0, sizeof(args));
+		args.state_va = pipe->state->gpu;
+		args.ring_va = pipe->entries->gpu;
+		args.notifier_list_va = owner->notifier_list->gpu;
+		args.gpu_buf_va = pipe->gpu_buffer->gpu;
+		args.gpu_context_va = agx_gpu_context_gpu(owner->context);
+		args.priority = priority;
+		args.pipe = i;
+		args.queue_id = (uint32_t)id;
+		args.g14x = g14x;
