+/* SPDX-License-Identifier: MIT */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/errno.h>
+#include <machine/cpufunc.h>
+
+#include <uvm/uvm_extern.h>
+#include <linux/dma-buf.h>
+#include <linux/err.h>
+#include <linux/iosys-map.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+
+#include <drm/drm_device.h>
+#include <drm/drm_file.h>
+#include <drm/drm_gem.h>
+#include <drm/drm_prime.h>
+#include <drm/drm_vma_manager.h>
+#include <uapi/drm/asahi_drm.h>
+
+#include "agx_device.h"
+#include "agx_context.h"
+#include "agx_mem.h"
+
+/* The core GEM pager forwards faults to the driver and holds GEM references. */
+extern const struct uvm_pagerops drm_pgops;
+
+static int
+agx_gem_object_init(struct drm_device *dev, struct drm_gem_object *obj,
+    size_t size, bool nonblock)
+{
+	drm_gem_private_object_init(dev, obj, size);
+	if (nonblock) {
+		if (!uvm_obj_init_try(&obj->uobj, &drm_pgops, 1)) {
+			drm_gem_private_object_fini(obj);
+			return ENOMEM;
+		}
+	} else
+		uvm_obj_init(&obj->uobj, &drm_pgops, 1);
+	return 0;
+}
+
+static void
+agx_bo_free(struct drm_gem_object *obj)
+{
+	struct agx_bo *bo = container_of(obj, struct agx_bo, gem);
+
+	agx_mem_free(bo->mem);
+	if (bo->import_sgt != NULL)
+		drm_prime_gem_destroy(obj, bo->import_sgt);
+	drm_gem_object_release(obj);
+	if (bo->private_vm != NULL)
+		agx_context_vm_put(bo->private_vm);
+	free(bo, M_DEVBUF, sizeof(*bo));
+}
+
+static struct dma_buf *
+agx_bo_export(struct drm_gem_object *obj, int flags)
+{
+	struct agx_bo *bo = container_of(obj, struct agx_bo, gem);
+	struct dma_buf *buf;
+
+	if (!bo->exportable)
+		return ERR_PTR(-EINVAL);
+	buf = drm_gem_prime_export(obj, flags);
+	if (!IS_ERR(buf) && obj->import_attach == NULL)
+		buf->cpu_access_safe = true;
+	return buf;
+}
+
+/* vmap is also reached under the reservation ww lock; never reverse that
+ * order from a cache-transition callback. */
+static int
+agx_bo_ensure_vmap(struct agx_bo *bo)
+{
+	int error;
+
+	dma_resv_cache_lock(bo->gem.resv);
+	error = agx_mem_vmap(bo->mem);
+	dma_resv_cache_unlock(bo->gem.resv);
+	return error;
+}
+
+static int
+agx_bo_pin(struct drm_gem_object *obj)
+{
+	struct agx_bo *bo = container_of(obj, struct agx_bo, gem);
+
+	return -agx_mem_pin(bo->mem, 0);
+}
+
+static void
+agx_bo_unpin(struct drm_gem_object *obj)
+{
+	struct agx_bo *bo = container_of(obj, struct agx_bo, gem);
+
+	agx_mem_unpin(bo->mem);
+}
+
+static struct sg_table *
+agx_bo_get_sg_table(struct drm_gem_object *obj)
+{
+	struct agx_bo *bo = container_of(obj, struct agx_bo, gem);
+	struct vm_page *page;
+	struct sg_table *sgt;
+	struct scatterlist *sg;
+	paddr_t pa, previous = 0;
+	size_t offset, count, runs = 0;
+	unsigned int length = 0;
+	int error;
+
+	if (bo->import_sgt != NULL)
+		return ERR_PTR(-EINVAL);
+	/* PRIME ignores vmap failure for coherent importers.  Ensure that a
+	 * deferred mapping failure is reported before exposing the SG table. */
+	if (bo->mem->lazy_kva) {
+		error = agx_bo_ensure_vmap(bo);
+		if (error != 0)
+			return ERR_PTR(-error);
+	}
+	count = obj->size / AGX_PAGE_SIZE;
+	if (count == 0 || count > UINT_MAX)
+		return ERR_PTR(-EOVERFLOW);
+	/* Like shmem PRIME, describe contiguous physical pages as one run.
+	 * Validate every original UAT page before allocating the smaller table. */
+	for (offset = 0; offset < obj->size; offset += AGX_PAGE_SIZE) {
+		error = agx_mem_phys(bo->mem, offset, &pa);
+		if (error || PHYS_TO_VM_PAGE(pa) == NULL)
+			return ERR_PTR(-EINVAL);
+		if (offset == 0 || pa != previous + AGX_PAGE_SIZE ||
+		    length > UINT_MAX - AGX_PAGE_SIZE) {
+			runs++;
+			length = AGX_PAGE_SIZE;
+		} else
+			length += AGX_PAGE_SIZE;
+		previous = pa;
+	}
+	sgt = kzalloc(sizeof(*sgt), GFP_KERNEL);
+	if (sgt == NULL)
+		return ERR_PTR(-ENOMEM);
+	error = sg_alloc_table(sgt, runs, GFP_KERNEL);
+	if (error) {
+		kfree(sgt);
+		return ERR_PTR(error);
+	}
+	sg = sgt->sgl;
+	length = 0;
+	for (offset = 0; offset < obj->size; offset += AGX_PAGE_SIZE) {
+		/* The PRIME attachment holds the backing pinned. */
+		agx_mem_phys(bo->mem, offset, &pa);
+		if (length == 0 || pa != previous + AGX_PAGE_SIZE ||
+		    length > UINT_MAX - AGX_PAGE_SIZE) {
+			if (length != 0)
+				sg = sg_next(sg);
+			page = PHYS_TO_VM_PAGE(pa);
+			length = AGX_PAGE_SIZE;
+			sg_set_page(sg, page, length, 0);
+		} else {
+			length += AGX_PAGE_SIZE;
+			sg->length = length;
+		}
+		previous = pa;
+	}
+	return sgt;
+}
+
+static int
+agx_bo_vmap(struct drm_gem_object *obj, struct iosys_map *map)
+{
+	struct agx_bo *bo = container_of(obj, struct agx_bo, gem);
+	int error;
+
+	if (obj->import_attach != NULL)
+		return dma_buf_vmap(obj->import_attach->dmabuf, map);
+	error = agx_mem_pin(bo->mem, 0);
+	if (error != 0)
+		return -error;
+	if (bo->mem->lazy_kva) {
+		error = agx_bo_ensure_vmap(bo);
+		if (error != 0) {
+			agx_mem_unpin(bo->mem);
+			return -error;
+		}
+	}
+	iosys_map_set_vaddr(map, bo->mem->kva);
+	return 0;
+}
+
+static void
+agx_bo_vunmap(struct drm_gem_object *obj, struct iosys_map *map)
+{
+	if (obj->import_attach != NULL)
+		dma_buf_vunmap(obj->import_attach->dmabuf, map);
+	else {
+		struct agx_bo *bo = container_of(obj, struct agx_bo, gem);
+
+		iosys_map_clear(map);
+		agx_mem_unpin(bo->mem);
+	}
+}
+
+/* The page-map contract carries the exporter's cache attributes. */
+static int
+agx_bo_page_map(struct drm_gem_object *obj, off_t offset, vm_prot_t prot,
+    paddr_t *paddr)
+{
+	struct agx_bo *bo = container_of(obj, struct agx_bo, gem);
+
+	if (offset < 0 || (uint64_t)offset >= obj->size ||
+	    (offset & PAGE_MASK) != 0)
+		return -EINVAL;
+	if (obj->import_attach != NULL)
+		return dma_buf_page_map(obj->import_attach->dmabuf, offset,
+		    prot, paddr);
+	*paddr = agx_mem_mmap(bo->mem, offset, prot);
+	return *paddr == (paddr_t)-1 ? -EACCES : 0;
+}
+
+/* The caller serializes cache transitions with dma_resv_cache_lock(). */
+static int
+agx_bo_cache_sync(struct drm_gem_object *obj, off_t offset, size_t size, int ops)
+{
+	struct agx_bo *bo = container_of(obj, struct agx_bo, gem);
+	int error;
+
+	if (offset < 0 || (uint64_t)offset > obj->size ||
+	    size > obj->size - (uint64_t)offset)
+		return -EINVAL;
+	if (obj->import_attach != NULL)
+		return dma_buf_cache_sync(obj->import_attach->dmabuf, offset,
+		    size, ops);
+	error = agx_mem_pin(bo->mem, 0);
+	if (error != 0)
+		return -error;
+	if (bo->mem->lazy_kva)
+		error = agx_mem_vmap(bo->mem);
+	if (error == 0)
+		error = agx_mem_sync(bo->mem, offset, size, ops);
+	agx_mem_unpin(bo->mem);
+	return -error;
+}
+
+/* The cache lock and exclusive ownership of the covered lines are required. */
+static int
+agx_bo_cache_postread_preserve(struct drm_gem_object *obj, off_t offset,
+    size_t size)
+{
+	struct agx_bo *bo = container_of(obj, struct agx_bo, gem);
+	int error;
+
+	if (offset < 0 || size == 0 || (uint64_t)offset > obj->size ||
+	    size > obj->size - (uint64_t)offset)
+		return -EINVAL;
+	if (obj->import_attach != NULL)
+		return dma_buf_cache_postread_preserve(obj->import_attach->dmabuf,
+		    offset, size);
+	if (dcache_line_size <= 0 || (uint64_t)offset % dcache_line_size != 0 ||
+	    size % dcache_line_size != 0)
+		return -EINVAL;
+	error = agx_mem_pin(bo->mem, 0);
+	if (error != 0)
+		return -error;
+	if (bo->mem->lazy_kva)
+		error = agx_mem_vmap(bo->mem);
+	if (error == 0)
+		error = agx_mem_sync(bo->mem, offset, size,
+		    BUS_DMASYNC_POSTREAD | BUS_DMASYNC_POSTWRITE);
+	agx_mem_unpin(bo->mem);
+	return -error;
+}
+
+static const struct drm_gem_object_funcs agx_bo_funcs = {
+	.free = agx_bo_free,
+	.close = agx_file_bo_close,
+	.export = agx_bo_export,
+	.pin = agx_bo_pin,
+	.unpin = agx_bo_unpin,
+	.mmap_pin = agx_bo_pin,
+	.mmap_unpin = agx_bo_unpin,
+	.get_sg_table = agx_bo_get_sg_table,
+	.vmap = agx_bo_vmap,
+	.vunmap = agx_bo_vunmap,
+	.page_map = agx_bo_page_map,
+	.cache_sync = agx_bo_cache_sync,
+	.cache_postread_preserve = agx_bo_cache_postread_preserve,
+};
+
+struct agx_bo *
+agx_bo_from_gem(struct drm_gem_object *obj)
+{
+	if (obj == NULL || obj->funcs != &agx_bo_funcs)
+		return NULL;
+	return container_of(obj, struct agx_bo, gem);
+}
+
+/* Return a GEM reference.  The caller transfers or drops that reference. */
+int
+agx_bo_create(struct drm_device *dev, size_t size,
+    struct agx_context_vm *private_vm, bool writeback, bool nonblock,
+    struct agx_bo **out)
+{
+	struct agx_bo *bo;
+	int error;
+
+	if (out == NULL || size == 0 || size > SIZE_MAX - AGX_PAGE_MASK)
+		return -EINVAL;
+	*out = NULL;
+	size = (size + AGX_PAGE_MASK) & ~AGX_PAGE_MASK;
+	if (private_vm != NULL) {
+		error = agx_context_vm_get(private_vm);
+		if (error != 0)
+			return -error;
+	}
+	bo = malloc(sizeof(*bo), M_DEVBUF,
+	    (nonblock ? M_NOWAIT : M_WAITOK) | M_CANFAIL | M_ZERO);
+	if (bo == NULL) {
+		if (private_vm != NULL)
+			agx_context_vm_put(private_vm);
+		return -ENOMEM;
+	}
+	bo->private_vm = private_vm;
+	bo->exportable = private_vm == NULL;
+	if (private_vm != NULL)
+		bo->gem.resv = agx_context_vm_resv(private_vm);
+	bo->gem.funcs = &agx_bo_funcs;
+	error = agx_gem_object_init(dev, &bo->gem, size, nonblock);
+	if (error != 0) {
+		if (private_vm != NULL)
+			agx_context_vm_put(private_vm);
+		free(bo, M_DEVBUF, sizeof(*bo));
+		return -error;
+	}
+	error = agx_mem_alloc_gem(dev->dmat, size,
+	    writeback ? AGX_MEM_WRITEBACK : AGX_MEM_NOCACHE,
+	    ((struct agx_softc *)dev->dev_private)->resources.uat_oas,
+	    nonblock, &bo->mem);
+	if (error) {
+		drm_gem_object_release(&bo->gem);
+		if (private_vm != NULL)
+			agx_context_vm_put(private_vm);
+		free(bo, M_DEVBUF, sizeof(*bo));
+		return -error;
+	}
+	*out = bo;
+	return 0;
+}
+
+/* The PRIME core retains attach and sgt until the GEM object is freed. */
+struct drm_gem_object *
+agx_bo_import_sg_table(struct drm_device *dev,
+    struct dma_buf_attachment *attach, struct sg_table *sgt)
+{
+	struct agx_bo *bo;
+	size_t size = attach->dmabuf->size;
+	int error;
+
+	if (size == 0 || (size & AGX_PAGE_MASK) != 0)
+		return ERR_PTR(-EINVAL);
+	if (!dma_buf_cache_postread_preserve_supported(attach->dmabuf))
+		return ERR_PTR(-EOPNOTSUPP);
+	/* UAT consumes original physical pages, never a bus_dma bounce copy. */
+	if (sgt->dmamap == NULL || sgt->dmamap->_dm_nused != 0)
+		return ERR_PTR(-EINVAL);
+	bo = malloc(sizeof(*bo), M_DEVBUF, M_WAITOK | M_CANFAIL | M_ZERO);
+	if (bo == NULL)
+		return ERR_PTR(-ENOMEM);
+	bo->gem.funcs = &agx_bo_funcs;
+	(void)agx_gem_object_init(dev, &bo->gem, size, false);
+	error = agx_mem_import_sg(sgt, size,
+	    ((struct agx_softc *)dev->dev_private)->resources.uat_oas, &bo->mem);
+	if (error) {
+		drm_gem_object_release(&bo->gem);
+		free(bo, M_DEVBUF, sizeof(*bo));
+		return ERR_PTR(-error);
+	}
+	bo->exportable = true;
+	bo->import_sgt = sgt;
+	return &bo->gem;
+}
+
+int
+agx_gem_mmap_offset_ioctl(struct drm_device *dev, void *data,
+    struct drm_file *file)
+{
+	struct drm_asahi_gem_mmap_offset *args = data;
+	struct drm_gem_object *obj;
+	int error;
+
+	if (args->flags != 0)
+		return -EINVAL;
+	obj = drm_gem_object_lookup(file, args->handle);
+	if (obj == NULL)
+		return -ENOENT;
+	error = drm_gem_create_mmap_offset(obj);
+	if (error == 0)
+		args->offset = drm_vma_node_offset_addr(&obj->vma_node);
+	drm_gem_object_put(obj);
+	return error;
+}
+
+int
+agx_gem_fault(struct drm_gem_object *obj, struct uvm_faultinfo *ufi,
+    off_t offset, vaddr_t vaddr, struct vm_page **pps, int npages,
+    int centeridx, vm_prot_t access_type, int flags)
+{
+	struct uvm_object *uobj = ufi->entry->object.uvm_obj;
+	uint64_t base = drm_vma_node_offset_addr(&obj->vma_node);
+	paddr_t paddr;
+	vm_prot_t mapprot = ufi->entry->protection;
+	int i, error = 0;
+
+	if (obj->funcs != &agx_bo_funcs || offset < 0 ||
+	    (uint64_t)offset < base) {
+		error = EACCES;
+		goto out;
+	}
+	offset -= base;
+	for (i = 0; i < npages; i++, offset += PAGE_SIZE, vaddr += PAGE_SIZE) {
+		if (((flags & PGO_ALLPAGES) == 0 && i != centeridx) ||
+		    pps[i] == PGO_DONTCARE)
+			continue;
+		error = agx_bo_page_map(obj, offset, mapprot, &paddr);
+		if (error != 0) {
+			error = -error;
+			break;
+		}
+		if (pmap_enter(ufi->orig_map->pmap, vaddr, paddr, mapprot,
+		    PMAP_CANFAIL | mapprot) != 0) {
+			pmap_update(ufi->orig_map->pmap);
+			uvmfault_unlockall(ufi, ufi->entry->aref.ar_amap, uobj);
+			uvm_wait("agxgem");
+			return ERESTART;
+		}
+	}
+	pmap_update(ufi->orig_map->pmap);
+out:
+	uvmfault_unlockall(ufi, ufi->entry->aref.ar_amap, uobj);
+	return error;
+}
