+/* SPDX-License-Identifier: GPL-2.0-only OR MIT */
+#ifndef _AGX_QUEUE_OWNER_H_
+#define _AGX_QUEUE_OWNER_H_
+
+#include <sys/types.h>
+#include <sys/task.h>
+#include <sys/timeout.h>
+#include "agx_queue.h"
+
+#include "agx_tvb.h"
+struct agx_channel_bank;
+struct agx_channel;
+struct agx_context_vm;
+struct agx_fw_devctl;
+struct agx_gpu_context;
+struct agx_heap;
+struct agx_object;
+struct agx_event_slots;
+struct agx_queue_job;
+struct agx_queue_state;
+struct agx_runtime;
+struct agx_sched;
+struct rtkit_state;
+
+#define AGX_QUEUE_PIPES 3
+#define AGX_QUEUE_RING_SIZE 0x500
+
+struct agx_queue_owner_pipe {
+	struct agx_wq_ring ring;
+	struct agx_channel *channel;
+	struct agx_object *state, *entries, *info, *gpu_buffer;
+};
+
+/* Firmware allocation/context ownership plus an independent queue-state
+ * machine. Assembly excludes VM command construction only; runtime progress
+ * uses state -> ordered shared channels -> bounded IRQ-safe admission. The
+ * event bridge owns callback capture/delivery. Published work survives crashes
+ * until captured retirement or explicit proven-stop delivery. */
+struct agx_queue_owner {
+	struct rwlock ref_lock, assembly_lock;
+	unsigned int refs;
+	struct agx_queue_owner_pipe pipes[AGX_QUEUE_PIPES];
+	struct agx_gpu_context *context;
+	struct agx_tvb tvb;
+	int tvb_initialized;
+	struct agx_channel_bank *bank;
+	struct agx_sched *scheduler;
+	struct agx_queue_state *state;
+	struct task teardown_task;
+	struct timeout teardown_retry;
+	struct agx_runtime *runtime;
+	struct rtkit_state *rtkit;
+	struct agx_object *notifier_list, *notifier, *threshold_object;
+	uint64_t *threshold;
+	uint64_t notifier_va, notifier_buf_va;
+	struct agx_event_slots *events;
+	uint64_t id, counter, usc_exec_base;
+};
+
+/* shared/private heaps and channel set must outlive the GPU context, including
+ * a context retained after a failed DestroyContext. Both heaps must be CPU
+ * accessible and coherent as required by their firmware mappings. */
+int agx_queue_owner_create(struct agx_context_vm *, struct agx_heap *,
+    struct agx_heap *, struct agx_fw_devctl *, struct agx_channel_bank *,
+    struct rtkit_state *, struct agx_tvb_manager *, struct agx_event_slots *,
+    struct agx_runtime *, unsigned int, uint64_t, uint64_t, uint32_t,
+    struct agx_queue_owner **);
+/* Caller serializes the owner and the selected shared channels until commit.
+ * This checks work-ring capacity, not event-stamp capacity or TX space. */
+int agx_queue_owner_preflight(struct agx_queue_owner *, const uint32_t [3],
+    const uint32_t [3]);
+/* Sleepable references. Jobs and deferred event work must hold their own
+ * references; the last put is permitted only after no work or callbacks can
+ * access the queue. A crash alone does not establish GPU quiescence. The
+ * final context put invalidates firmware state before releasing allocations;
+ * failed invalidation retains all backing. */
+int agx_queue_owner_get(struct agx_queue_owner *);
+void agx_queue_owner_put(struct agx_queue_owner *);
+/* The scheduler is valid while the caller holds an owner reference. */
+struct agx_sched *agx_queue_owner_sched(struct agx_queue_owner *);
+/* Reserve n consecutive 13.5 firmware command counters in queue order. */
+int agx_queue_owner_counters(struct agx_queue_owner *, uint32_t, uint64_t *);
+/* Hold across deferred construction, VM binding and queue reservation. */
+void agx_queue_owner_assemble_enter(struct agx_queue_owner *);
+void agx_queue_owner_assemble_leave(struct agx_queue_owner *);
+
+/* Stage j (one based) uses start_value + (j << 8), modulo 2^32.
+ * The command buffer has the requested capacity, including barriers and
+ * init-buffer records. Actual count may be reduced before submission. */
+struct agx_queue_job_event {
+	uint64_t stamp_va, fw_stamp_va, queue_va, cmd_seq, event_seq;
+	uint32_t slot, start_value;
+	int error; /* positive errno if the accepted predecessor was canceled */
+};
+/* Process context, never systqmp or with the queue state lock held. Slot
+ * exhaustion waits without partial reservations; cancel/stopped must remain
+ * valid until return and are polled so timeout and teardown can abort it. */
+int agx_queue_job_prepare(struct agx_queue_owner *, const uint32_t [3],
+    const uint32_t [3], void (*)(void *), void *, const int *, const int *,
+    struct agx_queue_job **);
+int agx_queue_job_pipe(struct agx_queue_job *, unsigned int,
+    struct agx_queue_job_event *, uint64_t **);
+int agx_queue_job_set_count(struct agx_queue_job *, unsigned int, uint32_t);
+/* The returned predecessor was retained atomically by prepare, including its
+ * event epoch; index-zero barriers must use this snapshot, not an owner tail. */
+int agx_queue_job_predecessor(struct agx_queue_job *, unsigned int,
+    struct agx_queue_job_event *, int *);
+int agx_queue_job_depend_pipe(struct agx_queue_job *, unsigned int);
+/* Register a callback, invoked once per pipe after actual ring publication. */
+int agx_queue_job_set_commit(struct agx_queue_job *,
+    void (*)(void *, unsigned int), void *);
+/* Called at scheduler enqueue's point of no return; positive errno on failure. */
+int agx_queue_job_accept(struct agx_queue_job *);
+/* A positive return means no pipe was published and no callback will occur.
+ * Otherwise completion runs once after retirement, proven stop, or cancellation
+ * before any publication. Crash/error notification alone is not retirement.
+ * Partial publication retains all work and retries missing pipes/notifications. */
+int agx_queue_job_submit(struct agx_queue_job *, void (*)(void *, int), void *);
+/* Before any publication, synchronously invalidate dependent reservations. */
+void agx_queue_job_abort(struct agx_queue_job *, int);
+void agx_queue_job_timeout(struct agx_queue_job *);
+/* Returns zero if completed; a published timeout also freezes the runtime. */
+int agx_queue_job_timeout_pending(struct agx_queue_job *);
+void agx_queue_job_put(struct agx_queue_job *);
+
+/* Queue-owner construction/destruction only. close is a nonblocking software
+ * epoch-drain check, never GPU quiescence. fini follows acknowledged context
+ * invalidation; reap follows successful final owner resource destruction. */
+int agx_queue_jobs_init(struct agx_queue_owner *);
+/* Serialize close with the first firmware publication; retain progress. */
+void agx_queue_jobs_stop_admission(struct agx_queue_owner *);
+int agx_queue_jobs_close(struct agx_queue_owner *);
+int agx_queue_jobs_fini(struct agx_queue_owner *);
+void agx_queue_jobs_reap(struct agx_queue_owner *);
+struct taskq *agx_queue_jobs_taskq(struct agx_queue_owner *);
+
+#endif
